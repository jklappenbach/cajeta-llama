package dev.cajeta.llm.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.llm.gen.SampleParams;
import dev.cajeta.llm.gen.Sampler;
import dev.cajeta.llm.gen.TokenSink;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.sched.Request;
import dev.cajeta.llm.sched.Scheduler;
import dev.cajeta.llm.tok.Tokenizer;
import cajeta.lang.Cajeta;
import cajeta.lang.Math;
import cajeta.lang.String;
import cajeta.collection.ArrayList;
import cajeta.math.Tensor;

/**
 * cajeta-llm plan Unit 14 TDD — sampling and the generation loop
 * (spec 8.1–8.8, 13.10).
 *
 * Sampler arithmetic is asserted AT THE SAMPLER on fixed logits (8.6): it
 * tests the RNG and the top-k/top-p/penalty math, which are reproducible,
 * without depending on the model's floating point, which is not. The
 * fixed-logits fixture is FIX below; every reference number is derived
 * in-test from Math.exp on the same values, never hardcoded floating
 * output.
 *
 * Loop-level behavior (stop conditions, streaming, per-sequence streams)
 * runs the Unit 9 scheduler over the ForwardTest toy model, whose greedy
 * output is exactly reproducible — and with temperature 0 the SAMPLED
 * path is deterministic too, which several tests exploit.
 */
public class GenTest {

    public GenTest() { return; }

    // Fixed logits: argmax is 1; descending order is 1(3.0), 5(2.5),
    // 2(2.0), 0(1.0), 3(0.5), 6(0.0), 7(-0.5), 4(-1.0).
    static #Tensor<float32> fix() {
        float32[] d = [ 1.0f, 3.0f, 2.0f, 0.5f, -1.0f, 2.5f, 0.0f, -0.5f ];
        int64[] s #= heap int64[1];
        s[0] = 8;
        Tensor<float32> t #= Tensor.of<float32>(d, s);
        return #t;
    }

    static boolean near(float32 a, float32 b) {
        float32 d = a - b;
        if (d < 0.0f) { d = 0.0f - d; }
        return d < 0.0001f;
    }

    // ── 14.1.1 — temperature 0 selects the argmax ───────────────────────

    @Test
    public void tempZeroSelectsArgmax() {
        SampleParams p #= heap SampleParams(0.0f, 42L);
        Sampler s #= heap Sampler(#p, 8);
        Tensor<float32> l #= GenTest.fix();
        int32[] noHist #= heap int32[1];
        Assert.equals(1L, (int64) s.sample(l, noHist, 0, 0));
        // Repeatedly: no RNG dependence at temperature 0.
        Assert.equals(1L, (int64) s.sample(l, noHist, 0, 0));
        Assert.equals(1L, (int64) s.sample(l, noHist, 0, 0));
    }

    // ── 14.1.2 — each knob matches the reference on fixed logits ───────

    @Test
    public void temperatureScalesLogitsBeforeSoftmax() {
        // probs ∝ exp(l / T): the ratio p[1]/p[2] must be exp((3-2)/T).
        SampleParams p #= heap SampleParams(2.0f, 42L);
        Sampler s #= heap Sampler(#p, 8);
        Tensor<float32> l #= GenTest.fix();
        int32[] noHist #= heap int32[1];
        int32 n = s.prepare(l, noHist, 0, 0);
        Assert.equals(8L, (int64) n);   // no filters: all 8 survive
        float32 want = Math.exp((3.0f - 2.0f) / 2.0f);
        Assert.isTrue(GenTest.near(s.preparedProb(1) / s.preparedProb(2), want));
        // Distribution normalizes.
        float32 sum = 0.0f;
        int32 i = 0;
        while (i < 8) {
            sum = sum + s.preparedProb(i);
            i = i + 1;
        }
        Assert.isTrue(GenTest.near(sum, 1.0f));
    }

    @Test
    public void topKRestrictsToKHighest() {
        SampleParams p #= heap SampleParams(1.0f, 42L);
        p.topK = 3;
        Sampler s #= heap Sampler(#p, 8);
        Tensor<float32> l #= GenTest.fix();
        int32[] noHist #= heap int32[1];
        int32 n = s.prepare(l, noHist, 0, 0);
        Assert.equals(3L, (int64) n);
        // Survivors are exactly {1, 5, 2}; everything else is excluded.
        Assert.isTrue(s.preparedProb(1) > 0.0f);
        Assert.isTrue(s.preparedProb(5) > 0.0f);
        Assert.isTrue(s.preparedProb(2) > 0.0f);
        Assert.isTrue(s.preparedProb(0) == 0.0f);
        Assert.isTrue(s.preparedProb(3) == 0.0f);
        Assert.isTrue(s.preparedProb(4) == 0.0f);
        Assert.isTrue(s.preparedProb(6) == 0.0f);
        Assert.isTrue(s.preparedProb(7) == 0.0f);
        // Renormalized over survivors, ratios preserved: p1/p2 = exp(1).
        float32 sum = s.preparedProb(1) + s.preparedProb(5) + s.preparedProb(2);
        Assert.isTrue(GenTest.near(sum, 1.0f));
        Assert.isTrue(GenTest.near(s.preparedProb(1) / s.preparedProb(2),
            Math.exp(1.0f)));
    }

    @Test
    public void topPKeepsSmallestCumulativeSet() {
        // Full softmax at T=1: p[1] ≈ .4367, p[5] ≈ .2648 — the smallest
        // set reaching 0.7 is exactly {1, 5} (cum ≈ .7015).
        SampleParams p #= heap SampleParams(1.0f, 42L);
        p.topP = 0.7f;
        Sampler s #= heap Sampler(#p, 8);
        Tensor<float32> l #= GenTest.fix();
        int32[] noHist #= heap int32[1];
        int32 n = s.prepare(l, noHist, 0, 0);
        Assert.equals(2L, (int64) n);
        Assert.isTrue(s.preparedProb(1) > 0.0f);
        Assert.isTrue(s.preparedProb(5) > 0.0f);
        Assert.isTrue(s.preparedProb(2) == 0.0f);
        Assert.isTrue(GenTest.near(s.preparedProb(1) + s.preparedProb(5), 1.0f));
        // Ratio within the kept set: exp(3.0 - 2.5).
        Assert.isTrue(GenTest.near(s.preparedProb(1) / s.preparedProb(5),
            Math.exp(0.5f)));
    }

    @Test
    public void repetitionPenaltyDampensHistory() {
        // Penalty 2 on emitted token 1: its 3.0 logit becomes 1.5, so the
        // argmax moves to 5 — and at T=1 the ratio p5/p1 is exp(2.5-1.5).
        SampleParams g #= heap SampleParams(0.0f, 42L);
        g.repeatPenalty = 2.0f;
        Sampler sg #= heap Sampler(#g, 8);
        Tensor<float32> l #= GenTest.fix();
        int32[] hist #= heap int32[1];
        hist[0] = 1;
        Assert.equals(5L, (int64) sg.sample(l, hist, 0, 1));

        SampleParams p #= heap SampleParams(1.0f, 42L);
        p.repeatPenalty = 2.0f;
        Sampler s #= heap Sampler(#p, 8);
        int32 n = s.prepare(l, hist, 0, 1);
        Assert.equals(8L, (int64) n);
        Assert.isTrue(GenTest.near(s.preparedProb(5) / s.preparedProb(1),
            Math.exp(1.0f)));
        // A NEGATIVE logit is penalized by multiplication, further down:
        // token 4 at -1.0 becomes -2.0.
        int32[] hist4 #= heap int32[1];
        hist4[0] = 4;
        SampleParams p4 #= heap SampleParams(1.0f, 42L);
        p4.repeatPenalty = 2.0f;
        Sampler s4 #= heap Sampler(#p4, 8);
        s4.prepare(l, hist4, 0, 1);
        // p[6]/p[4] = exp(0 - (-2)) = exp(2).
        Assert.isTrue(GenTest.near(s4.preparedProb(6) / s4.preparedProb(4),
            Math.exp(2.0f)));
    }

    // ── 14.1.3 — fixed logits + fixed seed → same selection ────────────

    @Test
    public void fixedSeedFixedLogitsIsDeterministic() {
        Tensor<float32> l #= GenTest.fix();
        int32[] noHist #= heap int32[1];
        // A fresh sampler with the same seed draws the same 12-token
        // sequence every time — this pins the RNG stream, not one draw.
        int32[] first #= heap int32[12];
        int32 trial = 0;
        while (trial < 5) {
            SampleParams p #= heap SampleParams(0.9f, 1234L);
            p.topK = 5;
            p.topP = 0.95f;
            Sampler s #= heap Sampler(#p, 8);
            int32 i = 0;
            while (i < 12) {
                int32 tok = s.sample(l, noHist, 0, 0);
                if (trial == 0) {
                    first[i] = tok;
                } else {
                    Assert.equals((int64) first[i], (int64) tok);
                }
                i = i + 1;
            }
            trial = trial + 1;
        }
    }

    // ── 14.1.6 — zero heap allocations per sampled token ───────────────

    @Test
    public void samplerAllocatesNothingPerToken() {
        SampleParams p #= heap SampleParams(0.9f, 7L);
        p.topK = 4;
        p.topP = 0.9f;
        p.repeatPenalty = 1.3f;
        Sampler s #= heap Sampler(#p, 8);
        Tensor<float32> l #= GenTest.fix();
        int32[] hist #= heap int32[2];
        hist[0] = 1;
        hist[1] = 5;
        // Warm: first call pays any one-time costs.
        s.sample(l, hist, 0, 2);
        int64 live0 = Cajeta.liveCount();
        int64 b0 = Cajeta.allocatedBytes();
        int32 i = 0;
        while (i < 100) {
            s.sample(l, hist, 0, 2);
            i = i + 1;
        }
        Assert.equals(0L, Cajeta.allocatedBytes() - b0);
        Assert.equals(live0, Cajeta.liveCount());
    }

    // ── loop-level: the toy model + scheduler ───────────────────────────

    /** Greedy oracle through the SAMPLED path: temperature 0. */
    static #SampleParams greedy() {
        SampleParams p #= heap SampleParams(0.0f, 0L);
        return #p;
    }

    // ── 14.1.4 — EOS, stop strings, budget: halt + report ──────────────

    @Test
    public void budgetHaltsAndReports() {
        CausalLM m #= SchedulerTest.mk("g_budget", 2, 0);
        Scheduler sch #= heap Scheduler(m, 8);
        int32[] pr #= SchedulerTest.promptOf(6, 3);
        SampleParams gp #= GenTest.greedy();
        int32 id = sch.submitSampled(pr, 6, 5, #gp);
        sch.runAll(64);
        Request r = sch.request(id);
        Assert.equals(5L, (int64) r.generatedCount());
        Assert.equals((int64) Request.FINISH_BUDGET, (int64) r.finishReason());
    }

    @Test
    public void eosTokenHaltsAndReports() {
        // Learn what greedy emits, then declare one of its tokens to be
        // EOS: generation must halt at that token's FIRST occurrence and
        // say why. The toy model's greedy stream repeats early, so the
        // expected halt is located by scanning the oracle, not assumed —
        // preferring a stop token whose first occurrence is past index 0
        // when the stream offers one.
        int32[] pr #= SchedulerTest.promptOf(6, 3);
        int32[] oracle #= SchedulerTest.solo(pr, 6, 8);
        int32 stopTok = oracle[0];
        int32 j = 1;
        while (j < 8) {
            boolean seen = false;
            int32 q = 0;
            while (q < j) {
                if (oracle[q] == oracle[j]) {
                    seen = true;
                }
                q = q + 1;
            }
            if (seen == false) {
                stopTok = oracle[j];
                break;
            }
            j = j + 1;
        }
        int32 firstIdx = 0;
        while (oracle[firstIdx] != stopTok) {
            firstIdx = firstIdx + 1;
        }
        CausalLM m #= SchedulerTest.mk("g_eos", 2, 0);
        Scheduler sch #= heap Scheduler(m, 8);
        SampleParams p #= heap SampleParams(0.0f, 0L);
        int32[] stopToks #= heap int32[1];
        stopToks[0] = stopTok;
        p.stopTokens #= stopToks;
        int32 id = sch.submitSampled(pr, 6, 8, #p);
        sch.runAll(64);
        Request r = sch.request(id);
        // Halts exactly at the first occurrence; the EOS itself is kept.
        Assert.equals((int64) (firstIdx + 1), (int64) r.generatedCount());
        Assert.equals((int64) stopTok, (int64) r.generatedAt(firstIdx));
        Assert.equals((int64) Request.FINISH_EOS, (int64) r.finishReason());
    }

    @Test
    public void stopStringHaltsAndReports() {
        // The stop string is the DECODED text of greedy's 2nd token, so
        // the rolling detok window must catch it as soon as it lands.
        int32[] pr #= SchedulerTest.promptOf(6, 3);
        int32[] oracle #= SchedulerTest.solo(pr, 6, 8);
        Tokenizer tk #= Tokenizer.fromHfJson(TokTest.LLAMA);
        int32[] one #= heap int32[1];
        one[0] = oracle[1];
        int8[] piece #= tk.decode(one, 1);
        int32 pn = (int32) piece.count();
        Assert.isTrue(pn > 0);
        String stop #= heap String(#piece, pn);
        CausalLM m #= SchedulerTest.mk("g_stop", 2, 0);
        Scheduler sch #= heap Scheduler(m, 8);
        sch.setTokenizer(tk);
        SampleParams p #= heap SampleParams(0.0f, 0L);
        ArrayList<String> stops #= heap ArrayList<String>();
        stops.add(#stop);
        p.stops #= stops;
        int32 id = sch.submitSampled(pr, 6, 8, #p);
        sch.runAll(64);
        Request r = sch.request(id);
        Assert.equals(2L, (int64) r.generatedCount());
        Assert.equals((int64) Request.FINISH_STOP, (int64) r.finishReason());
    }

    // ── 14.1.5 — the streaming callback fires per token, in step ───────

    @Test
    public void streamingCallbackFiresPerTokenBeforeNextStep() {
        CausalLM m #= SchedulerTest.mk("g_stream", 2, 0);
        Scheduler sch #= heap Scheduler(m, 8);
        RecordingSink sink #= heap RecordingSink(sch);
        sch.setSink(sink);
        int32[] pr #= SchedulerTest.promptOf(6, 3);
        SampleParams gp #= GenTest.greedy();
        int32 id = sch.submitSampled(pr, 6, 6, #gp);
        sch.runAll(64);
        Request r = sch.request(id);
        Assert.equals((int64) r.generatedCount(), (int64) sink.count());
        int32 i = 0;
        while (i < r.generatedCount()) {
            Assert.equals((int64) r.generatedAt(i), (int64) sink.tokenAt(i));
            i = i + 1;
        }
        // "Before the next step": each token was delivered during the very
        // step that produced it, so the recorded step numbers strictly
        // increase — a sink that batched at the end would record one step.
        i = 1;
        while (i < sink.count()) {
            Assert.isTrue(sink.stepAt(i) > sink.stepAt(i - 1));
            i = i + 1;
        }
    }

    // ── 14.1.7 — per-token allocations outside forward+sampler bounded ─

    @Test
    public void perTokenAllocationsAreBoundedSmall() {
        // Two sampled runs, 4 and 12 new tokens, with a stop string armed
        // (the detok window is the per-token allocator under test; it
        // never fires — the string can't appear). The marginal cost of the
        // extra 8 tokens stays under a small per-token constant.
        Tokenizer tk #= Tokenizer.fromHfJson(TokTest.LLAMA);
        String stop = "@@never@@";
        int32[] pr #= SchedulerTest.promptOf(6, 3);

        CausalLM mA #= SchedulerTest.mk("g_alloc_a", 2, 0);
        Scheduler sa #= heap Scheduler(mA, 8);
        sa.setTokenizer(tk);
        SampleParams pa #= heap SampleParams(0.0f, 0L);
        ArrayList<String> stopsA #= heap ArrayList<String>();
        stopsA.add(stop);
        pa.stops #= stopsA;
        sa.submitSampled(pr, 6, 4, #pa);
        int64 b0 = Cajeta.allocatedBytes();
        sa.runAll(64);
        int64 bytesShort = Cajeta.allocatedBytes() - b0;

        CausalLM mB #= SchedulerTest.mk("g_alloc_b", 2, 0);
        Scheduler sb #= heap Scheduler(mB, 8);
        sb.setTokenizer(tk);
        SampleParams pb #= heap SampleParams(0.0f, 0L);
        ArrayList<String> stopsB #= heap ArrayList<String>();
        stopsB.add(stop);
        pb.stops #= stopsB;
        sb.submitSampled(pr, 6, 12, #pb);
        int64 b1 = Cajeta.allocatedBytes();
        sb.runAll(64);
        int64 bytesLong = Cajeta.allocatedBytes() - b1;

        int64 marginal = bytesLong - bytesShort;
        if (marginal < 0L) {
            marginal = 0L;
        }
        // 8 extra tokens; the window decode + one candidate String each.
        Assert.isTrue(marginal < 8L * 4096L);
    }

    // ── 14.1.8 — per-sequence parameters and RNG streams ────────────────

    @Test
    public void batchedSampledSequencesMatchTheirSoloRuns() {
        // Two sampled requests (T=0.8, per-request seeds) in ONE batch
        // must reproduce their SOLO sampled runs token for token. A
        // shared RNG stream fails this: interleaving perturbs the draws.
        int32[] prA #= SchedulerTest.promptOf(6, 3);
        int32[] prB #= SchedulerTest.promptOf(7, 11);

        int32[] soloA #= GenTest.soloSampled(prA, 6, 6, 21L);
        int32[] soloB #= GenTest.soloSampled(prB, 7, 6, 99L);

        CausalLM m #= SchedulerTest.mk("g_batch", 2, 0);
        Scheduler sch #= heap Scheduler(m, 8);
        SampleParams pa #= heap SampleParams(0.8f, 21L);
        pa.topK = 12;
        SampleParams pb #= heap SampleParams(0.8f, 99L);
        pb.topK = 12;
        int32 ia = sch.submitSampled(prA, 6, 6, #pa);
        int32 ib = sch.submitSampled(prB, 7, 6, #pb);
        sch.runAll(128);
        Request ra = sch.request(ia);
        Request rb = sch.request(ib);
        Assert.equals(6L, (int64) ra.generatedCount());
        Assert.equals(6L, (int64) rb.generatedCount());
        int32 i = 0;
        while (i < 6) {
            Assert.equals((int64) soloA[i], (int64) ra.generatedAt(i));
            Assert.equals((int64) soloB[i], (int64) rb.generatedAt(i));
            i = i + 1;
        }
    }

    /** Solo sampled run: one request, unconstrained model. */
    static #int32[] soloSampled(int32[] prompt, int32 promptLen,
            int32 maxNew, int64 seed) {
        CausalLM m #= SchedulerTest.mk("g_solo_s", 1, 0);
        Scheduler sch #= heap Scheduler(m, 8);
        SampleParams p #= heap SampleParams(0.8f, seed);
        p.topK = 12;
        int32 id = sch.submitSampled(prompt, promptLen, maxNew, #p);
        sch.runAll(128);
        Request r = sch.request(id);
        int32[] out #= heap int32[maxNew];
        int32 i = 0;
        while (i < maxNew) {
            out[i] = r.generatedAt(i);
            i = i + 1;
        }
        return #out;
    }
}

/** Test sink: records every streamed token and the step it arrived in. */
class RecordingSink implements TokenSink {
    Scheduler sch;   // borrow — read stepCount() at fire time
    int32[] toks;
    int32[] steps;
    int32 n;

    RecordingSink(Scheduler sch) {
        this.sch #= sch;
        this.toks = heap int32[256];
        this.steps = heap int32[256];
        this.n = 0;
    }

    public void onToken(int32 reqId, int32 token) {
        this.toks[this.n] = token;
        this.steps[this.n] = this.sch.stepCount();
        this.n = this.n + 1;
        return;
    }

    public int32 count() {
        return this.n;
    }

    public int32 tokenAt(int32 i) {
        return this.toks[i];
    }

    public int32 stepAt(int32 i) {
        return this.steps[i];
    }
}
