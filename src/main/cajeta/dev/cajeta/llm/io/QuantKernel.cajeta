            int64 rows, int64 outDim, int64 cols) {
        int64 wgL = (outDim / 128L) * (rows / 128L);
        KernelStream s = QuantKernel.stream();
        // 2026-08-26: the BN=256 pair this replaces held SIXTEEN
        // accumulators per warp and spilled 74 VGPRs -- ACO put 68
        // scratch_store + 76 scratch_load INSIDE the k-loop, against 64
        // wmma. Eight accumulators (X1/X3) cost arithmetic intensity on
        // paper and won 55-70% in fact: 8.55 -> 13.53 TMAC/s at 4096^2,
        // 8.96 -> 14.85 at gate/up, 7.35 -> 12.58 at ffn_down, against
        // llama.cpp-Vulkan's own 9.30 / 10.63 / 8.62 on the same box.
        // X3's 32x64 warp tile wins both K=4096 shapes, X1's 64x32 wins
        // K=14336.
        if (rows % 128L == 0L && outDim % 128L == 0L && wgL >= 1L) {
            if (cols > 8192L) {
                q6kF16CoopX1Kernel.launch(s,
                    grid: [(uint32) wgL], block: [256])
                    (y, packed, xh, (uint32) rows, (uint32) outDim,
                     (uint32) (outDim / 128L), cols / 256L);
                return;
            }
            q6kF16CoopX3Kernel.launch(s,
                grid: [(uint32) wgL], block: [256])
                (y, packed, xh, (uint32) rows, (uint32) outDim,
                 (uint32) (outDim / 128L), cols / 256L);
            return;
        }
        if (wgL < 64L) {
            int64 nRowTiles = outDim / 64L;
            q6kF16CoopM64Kernel.launch(s,
                grid: [(uint32) (nRowTiles * (rows / 64L))], block: [128])
