            q50F16CoopX1Kernel.launch(s,
                grid: [(uint32) wgL], block: [256])
                (y, packed, xh, (uint32) rows, (uint32) outDim,
                 (uint32) (outDim / 128L), cols / 32L);
            return;
        }
        q50F16CoopX3Kernel.launch(s,
            grid: [(uint32) wgL], block: [256])
