                a10.mma(t1, u0);
                a11.mma(t1, u1);
                a12.mma(t1, u2);
                a13.mma(t1, u3);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 2L;
        }
        uint32 rb = to * 128 + warpR * 32;
        uint32 cb = tt * 128 + warpC * 64;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a02.store(y, (cb + 32) * outDim + rb, 1, outDim);
        a03.store(y, (cb + 48) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a12.store(y, (cb + 32) * outDim + rb + 16, 1, outDim);
        a13.store(y, (cb + 48) * outDim + rb + 16, 1, outDim);
    }

    /** Shape-selected Q2_K coop launch — X3 (32x64 warp tile) below
     *  K=8192, X1 (64x32) above, the split the Q4_K router measured. */
    public static void q2kF16CoopAutoLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            int64 rows, int64 outDim, int64 cols) {
        int64 wgL = (outDim / 128L) * (rows / 128L);
        KernelStream s = QuantKernel.stream();
        if (cols > 8192L) {
            q2kF16CoopX1Kernel.launch(s,
                grid: [(uint32) wgL], block: [256])
                (y, packed, xh, (uint32) rows, (uint32) outDim,
                 (uint32) (outDim / 128L), cols / 256L);
            return;
        }
        q2kF16CoopX3Kernel.launch(s,
            grid: [(uint32) wgL], block: [256])
            (y, packed, xh, (uint32) rows, (uint32) outDim,
             (uint32) (outDim / 128L), cols / 256L);
        return;
    }

    /**
     * Q3_K coop GEMM, 64x32 warp tile. Staging is a port of
     * Quant's host block decoder onto the dword view; the compute half is
     * the same eight-accumulator tile the Q4_K/Q6_K pair uses (sixteen
     * spilled 74 VGPRs into the k-loop -- see q4kF16CoopAutoLaunchNoSync).
     * Layout: Q3_K { u8 hmask[32]; u8 qs[64]; u8 scales[12]; f16 d }, byte-padded 110 -> 112.
     */
    @Kernel
    public static void q3kF16CoopX1Kernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        Shared<float16> sa = shared float16[128 * 72];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 nTokTiles = tokens / 128;
        uint32 tt = wg % nTokTiles;
        uint32 to = wg / nTokTiles;
        uint32 aRow = lane & 127;
        uint32 aHalf = lane >> 7;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 2;
        uint32 warpC = sg / 2;
        int64 rowWords = blocksPerRow * 28L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a20; a20.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a21; a21.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a30; a30.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a31; a31.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
            int64 kbh = kb + (int64) aHalf;
            int64 sBase = (int64) aRow * 72L + (int64) (32 * aHalf);
            int64 rowBase = ((int64) (to * 128 + aRow)) * rowWords;
            int64 blk = kbh >> 3;
            int32 g32 = (int32) (kbh & 7L);
            int64 ro = rowBase + blk * 28L;
            float32 d = GgufFile.halfBitsToF32(packed[ro + 27L] & 65535);
            // 12 packed bytes -> 16 six-bit scales, minus 32. Only the two
            // this sub-block needs are decoded.
            int32 kA = 2 * g32;
            int32 kB = kA + 1;
            // if-form, never `?:` — a ternary in a kernel body is
            // skipped on one backend and MISCOMPILED on another.
            int32 loA = kA;
            int32 loB = kB;
            if (kA >= 8) { loA = kA - 8; }
            if (kB >= 8) { loB = kB - 8; }
            int32 bA = (packed[ro + (int64) (24 + (loA >> 2))]
                >> (8 * (loA & 3))) & 255;
            int32 bB = (packed[ro + (int64) (24 + (loB >> 2))]
                >> (8 * (loB & 3))) & 255;
            int32 nA = bA & 15;
            int32 nB = bB & 15;
            if (kA >= 8) { nA = bA >> 4; }
            if (kB >= 8) { nB = bB >> 4; }
            // bytes 104..107 are dword 26 (96 + 8 = 104, and 8/4 = 2)
            int32 hA = (packed[ro + 26L] >> (8 * (kA & 3))) & 255;
            int32 hB = (packed[ro + 26L] >> (8 * (kB & 3))) & 255;
            int32 scA = (nA | (((hA >> (2 * (kA >> 2))) & 3) << 4)) - 32;
            int32 scB = (nB | (((hB >> (2 * (kB >> 2))) & 3) << 4)) - 32;
            float32 dA = d * (float32) scA;
            float32 dB = d * (float32) scB;
            int32 gg = g32 >> 2;
            int32 ss = 2 * (g32 & 3);
            Vector<int32,8> qlv = packed.vload<8>(ro + (int64) (8 + 8 * gg));
            Vector<int32,8> hv = packed.vload<8>(ro);
            int32 e = 0;
            while (e < 8) {
                int32 w = qlv[e];
                int32 hw2 = hv[e];
                float32 dsc = dA;
                if (e >= 4) { dsc = dB; }
                int32 bi = 0;
                while (bi < 4) {
                    int32 ql = ((w >> (8 * bi)) >> ss) & 3;
                    int32 hb = ((hw2 >> (8 * bi)) >> g32) & 1;
                    int32 q = ql - ((hb ^ 1) << 2);
                    sa[sBase + (int64) (4 * e + bi)] = (float16)
                        (dsc * (float32) q);
                    bi = bi + 1;
                }
                e = e + 1;
            }
            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 4) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 64) * 72 + ko;
                uint32 bb2 = (uint32) (((int64) (tt * 128
                    + warpC * 32)) * cols + kb * 32L + (int64) ko);
                uint32 cst = (uint32) cols;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                CooperativeMatrix<float16,16,16,0> t2;
                CooperativeMatrix<float16,16,16,0> t3;
                t0.load(sa, ab, 0, 72);
                t1.load(sa, ab + 1152, 0, 72);
                t2.load(sa, ab + 2304, 0, 72);
                t3.load(sa, ab + 3456, 0, 72);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                u0.load(xh, bb2, 1, cst);
                u1.load(xh, bb2 + 16 * cst, 1, cst);
                a00.mma(t0, u0);
                a01.mma(t0, u1);
                a10.mma(t1, u0);
                a11.mma(t1, u1);
                a20.mma(t2, u0);
                a21.mma(t2, u1);
                a30.mma(t3, u0);
                a31.mma(t3, u1);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 2L;
        }
        uint32 rb = to * 128 + warpR * 64;
        uint32 cb = tt * 128 + warpC * 32;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a20.store(y, cb * outDim + rb + 32, 1, outDim);
        a21.store(y, (cb + 16) * outDim + rb + 32, 1, outDim);
        a30.store(y, cb * outDim + rb + 48, 1, outDim);
        a31.store(y, (cb + 16) * outDim + rb + 48, 1, outDim);
    }

    /**
     * Q3_K coop GEMM, 32x64 warp tile. Staging is a port of
     * Quant's host block decoder onto the dword view; the compute half is
     * the same eight-accumulator tile the Q4_K/Q6_K pair uses (sixteen
     * spilled 74 VGPRs into the k-loop -- see q4kF16CoopAutoLaunchNoSync).
     * Layout: Q3_K { u8 hmask[32]; u8 qs[64]; u8 scales[12]; f16 d }, byte-padded 110 -> 112.
     */
    @Kernel
    public static void q3kF16CoopX3Kernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        Shared<float16> sa = shared float16[128 * 72];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 nTokTiles = tokens / 128;
        uint32 tt = wg % nTokTiles;
        uint32 to = wg / nTokTiles;
        uint32 aRow = lane & 127;
        uint32 aHalf = lane >> 7;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 4;
        uint32 warpC = sg / 4;
        int64 rowWords = blocksPerRow * 28L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
            int64 kbh = kb + (int64) aHalf;
            int64 sBase = (int64) aRow * 72L + (int64) (32 * aHalf);
            int64 rowBase = ((int64) (to * 128 + aRow)) * rowWords;
            int64 blk = kbh >> 3;
            int32 g32 = (int32) (kbh & 7L);
            int64 ro = rowBase + blk * 28L;
            float32 d = GgufFile.halfBitsToF32(packed[ro + 27L] & 65535);
            // 12 packed bytes -> 16 six-bit scales, minus 32. Only the two
            // this sub-block needs are decoded.
            int32 kA = 2 * g32;
            int32 kB = kA + 1;
            // if-form, never `?:` — a ternary in a kernel body is
            // skipped on one backend and MISCOMPILED on another.
            int32 loA = kA;
            int32 loB = kB;
            if (kA >= 8) { loA = kA - 8; }
            if (kB >= 8) { loB = kB - 8; }
            int32 bA = (packed[ro + (int64) (24 + (loA >> 2))]
                >> (8 * (loA & 3))) & 255;
            int32 bB = (packed[ro + (int64) (24 + (loB >> 2))]
                >> (8 * (loB & 3))) & 255;
            int32 nA = bA & 15;
            int32 nB = bB & 15;
            if (kA >= 8) { nA = bA >> 4; }
            if (kB >= 8) { nB = bB >> 4; }
            // bytes 104..107 are dword 26 (96 + 8 = 104, and 8/4 = 2)
            int32 hA = (packed[ro + 26L] >> (8 * (kA & 3))) & 255;
            int32 hB = (packed[ro + 26L] >> (8 * (kB & 3))) & 255;
            int32 scA = (nA | (((hA >> (2 * (kA >> 2))) & 3) << 4)) - 32;
            int32 scB = (nB | (((hB >> (2 * (kB >> 2))) & 3) << 4)) - 32;
            float32 dA = d * (float32) scA;
            float32 dB = d * (float32) scB;
            int32 gg = g32 >> 2;
            int32 ss = 2 * (g32 & 3);
            Vector<int32,8> qlv = packed.vload<8>(ro + (int64) (8 + 8 * gg));
            Vector<int32,8> hv = packed.vload<8>(ro);
            int32 e = 0;
            while (e < 8) {
                int32 w = qlv[e];
                int32 hw2 = hv[e];
                float32 dsc = dA;
                if (e >= 4) { dsc = dB; }
                int32 bi = 0;
                while (bi < 4) {
                    int32 ql = ((w >> (8 * bi)) >> ss) & 3;
                    int32 hb = ((hw2 >> (8 * bi)) >> g32) & 1;
                    int32 q = ql - ((hb ^ 1) << 2);
                    sa[sBase + (int64) (4 * e + bi)] = (float16)
                        (dsc * (float32) q);
                    bi = bi + 1;
                }
                e = e + 1;
            }
            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 4) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 32) * 72 + ko;
                uint32 bb2 = (uint32) (((int64) (tt * 128
                    + warpC * 64)) * cols + kb * 32L + (int64) ko);
                uint32 cst = (uint32) cols;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                t0.load(sa, ab, 0, 72);
                t1.load(sa, ab + 1152, 0, 72);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                CooperativeMatrix<float16,16,16,1> u2;
                CooperativeMatrix<float16,16,16,1> u3;
                u0.load(xh, bb2, 1, cst);
                u1.load(xh, bb2 + 16 * cst, 1, cst);
                u2.load(xh, bb2 + 32 * cst, 1, cst);
                u3.load(xh, bb2 + 48 * cst, 1, cst);
                a00.mma(t0, u0);
                a01.mma(t0, u1);
                a02.mma(t0, u2);
                a03.mma(t0, u3);
                a10.mma(t1, u0);
                a11.mma(t1, u1);
                a12.mma(t1, u2);
                a13.mma(t1, u3);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 2L;
        }
        uint32 rb = to * 128 + warpR * 32;
        uint32 cb = tt * 128 + warpC * 64;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a02.store(y, (cb + 32) * outDim + rb, 1, outDim);
        a03.store(y, (cb + 48) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a12.store(y, (cb + 32) * outDim + rb + 16, 1, outDim);
        a13.store(y, (cb + 48) * outDim + rb + 16, 1, outDim);
    }

    /** Shape-selected Q3_K coop launch — X3 (32x64 warp tile) below
     *  K=8192, X1 (64x32) above, the split the Q4_K router measured. */
    public static void q3kF16CoopAutoLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            int64 rows, int64 outDim, int64 cols) {
        int64 wgL = (outDim / 128L) * (rows / 128L);
        KernelStream s = QuantKernel.stream();
        if (cols > 8192L) {
            q3kF16CoopX1Kernel.launch(s,
                grid: [(uint32) wgL], block: [256])
                (y, packed, xh, (uint32) rows, (uint32) outDim,
                 (uint32) (outDim / 128L), cols / 256L);
            return;
        }
        q3kF16CoopX3Kernel.launch(s,
            grid: [(uint32) wgL], block: [256])
            (y, packed, xh, (uint32) rows, (uint32) outDim,
             (uint32) (outDim / 128L), cols / 256L);
        return;
    }

    /**
     * Q5_K coop GEMM, 64x32 warp tile. Staging is a port of
     * Quant's host block decoder onto the dword view; the compute half is
     * the same eight-accumulator tile the Q4_K/Q6_K pair uses (sixteen
     * spilled 74 VGPRs into the k-loop -- see q4kF16CoopAutoLaunchNoSync).
     * Layout: Q5_K { f16 d; f16 dmin; u8 scales[12]; u8 qh[32]; u8 qs[128] }, 44 dwords, already aligned.
     */
    @Kernel
    public static void q5kF16CoopX1Kernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        Shared<float16> sa = shared float16[128 * 72];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 nTokTiles = tokens / 128;
        uint32 tt = wg % nTokTiles;
        uint32 to = wg / nTokTiles;
        uint32 aRow = lane & 127;
        uint32 aHalf = lane >> 7;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 2;
        uint32 warpC = sg / 2;
        int64 rowWords = blocksPerRow * 44L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a20; a20.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a21; a21.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a30; a30.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a31; a31.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
            int64 kbh = kb + (int64) aHalf;
            int64 sBase = (int64) aRow * 72L + (int64) (32 * aHalf);
            int64 rowBase = ((int64) (to * 128 + aRow)) * rowWords;
            int64 blk = kbh >> 3;
            int32 g32 = (int32) (kbh & 7L);
            int64 ro = rowBase + blk * 44L;
            // Q5_K's header is byte-for-byte Q4_K's: d, dmin, scales[12].
            Vector<int32,4> hw = packed.vload<4>(ro);
            int32 h0 = hw[0];
            float32 d = GgufFile.halfBitsToF32(h0 & 65535);
            float32 dmin = GgufFile.halfBitsToF32((h0 >> 16) & 65535);
            int32 hA = hw[1];
            int32 hB = hw[2];
            int32 hC = hw[3];
            int32 sRaw = 0;
            int32 mRaw = 0;
            if (g32 < 4) {
                sRaw = (hA >> (8 * g32)) & 63;
                mRaw = (hB >> (8 * g32)) & 63;
            } else {
                int32 j2 = g32 - 4;
                int32 kk = (hC >> (8 * j2)) & 255;
                int32 dd = (hA >> (8 * j2)) & 255;
                int32 mm = (hB >> (8 * j2)) & 255;
                sRaw = (kk & 15) | ((dd >> 2) & 48);
                mRaw = (kk >> 4) | ((mm >> 2) & 48);
            }
            float32 sc = d * (float32) sRaw;
            float32 mn = dmin * (float32) mRaw;
            int32 gg = g32 >> 1;
            int32 sl = 4 * (g32 & 1);
            Vector<int32,8> qlv = packed.vload<8>(ro + (int64) (12 + 8 * gg));
            Vector<int32,8> qhv = packed.vload<8>(ro + 4L);
            int32 e = 0;
            while (e < 8) {
                int32 w = qlv[e];
                int32 hw2 = qhv[e];
                int32 bi = 0;
                while (bi < 4) {
                    int32 ql = ((w >> (8 * bi)) >> sl) & 15;
                    int32 hb = ((hw2 >> (8 * bi)) >> g32) & 1;
                    int32 q = ql | (hb << 4);
                    sa[sBase + (int64) (4 * e + bi)] = (float16)
                        (sc * (float32) q - mn);
                    bi = bi + 1;
                }
                e = e + 1;
            }
            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 4) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 64) * 72 + ko;
                uint32 bb2 = (uint32) (((int64) (tt * 128
                    + warpC * 32)) * cols + kb * 32L + (int64) ko);
                uint32 cst = (uint32) cols;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                CooperativeMatrix<float16,16,16,0> t2;
                CooperativeMatrix<float16,16,16,0> t3;
                t0.load(sa, ab, 0, 72);
                t1.load(sa, ab + 1152, 0, 72);
                t2.load(sa, ab + 2304, 0, 72);
                t3.load(sa, ab + 3456, 0, 72);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                u0.load(xh, bb2, 1, cst);
                u1.load(xh, bb2 + 16 * cst, 1, cst);
                a00.mma(t0, u0);
                a01.mma(t0, u1);
                a10.mma(t1, u0);
                a11.mma(t1, u1);
                a20.mma(t2, u0);
                a21.mma(t2, u1);
                a30.mma(t3, u0);
                a31.mma(t3, u1);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 2L;
        }
        uint32 rb = to * 128 + warpR * 64;
        uint32 cb = tt * 128 + warpC * 32;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a20.store(y, cb * outDim + rb + 32, 1, outDim);
        a21.store(y, (cb + 16) * outDim + rb + 32, 1, outDim);
        a30.store(y, cb * outDim + rb + 48, 1, outDim);
        a31.store(y, (cb + 16) * outDim + rb + 48, 1, outDim);
    }

    /**
     * Q5_K coop GEMM, 32x64 warp tile. Staging is a port of
     * Quant's host block decoder onto the dword view; the compute half is
     * the same eight-accumulator tile the Q4_K/Q6_K pair uses (sixteen
     * spilled 74 VGPRs into the k-loop -- see q4kF16CoopAutoLaunchNoSync).
     * Layout: Q5_K { f16 d; f16 dmin; u8 scales[12]; u8 qh[32]; u8 qs[128] }, 44 dwords, already aligned.
     */
    @Kernel
    public static void q5kF16CoopX3Kernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        Shared<float16> sa = shared float16[128 * 72];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 nTokTiles = tokens / 128;
        uint32 tt = wg % nTokTiles;
        uint32 to = wg / nTokTiles;
        uint32 aRow = lane & 127;
        uint32 aHalf = lane >> 7;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 4;
        uint32 warpC = sg / 4;
        int64 rowWords = blocksPerRow * 44L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
            int64 kbh = kb + (int64) aHalf;
            int64 sBase = (int64) aRow * 72L + (int64) (32 * aHalf);
            int64 rowBase = ((int64) (to * 128 + aRow)) * rowWords;
            int64 blk = kbh >> 3;
            int32 g32 = (int32) (kbh & 7L);
            int64 ro = rowBase + blk * 44L;
            // Q5_K's header is byte-for-byte Q4_K's: d, dmin, scales[12].
            Vector<int32,4> hw = packed.vload<4>(ro);
            int32 h0 = hw[0];
            float32 d = GgufFile.halfBitsToF32(h0 & 65535);
            float32 dmin = GgufFile.halfBitsToF32((h0 >> 16) & 65535);
            int32 hA = hw[1];
            int32 hB = hw[2];
            int32 hC = hw[3];
            int32 sRaw = 0;
            int32 mRaw = 0;
            if (g32 < 4) {
                sRaw = (hA >> (8 * g32)) & 63;
                mRaw = (hB >> (8 * g32)) & 63;
            } else {
                int32 j2 = g32 - 4;
                int32 kk = (hC >> (8 * j2)) & 255;
                int32 dd = (hA >> (8 * j2)) & 255;
                int32 mm = (hB >> (8 * j2)) & 255;
                sRaw = (kk & 15) | ((dd >> 2) & 48);
                mRaw = (kk >> 4) | ((mm >> 2) & 48);
            }
            float32 sc = d * (float32) sRaw;
            float32 mn = dmin * (float32) mRaw;
            int32 gg = g32 >> 1;
            int32 sl = 4 * (g32 & 1);
            Vector<int32,8> qlv = packed.vload<8>(ro + (int64) (12 + 8 * gg));
            Vector<int32,8> qhv = packed.vload<8>(ro + 4L);
            int32 e = 0;
            while (e < 8) {
                int32 w = qlv[e];
                int32 hw2 = qhv[e];
                int32 bi = 0;
                while (bi < 4) {
                    int32 ql = ((w >> (8 * bi)) >> sl) & 15;
                    int32 hb = ((hw2 >> (8 * bi)) >> g32) & 1;
                    int32 q = ql | (hb << 4);
                    sa[sBase + (int64) (4 * e + bi)] = (float16)
                        (sc * (float32) q - mn);
                    bi = bi + 1;
                }
                e = e + 1;
            }
            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 4) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 32) * 72 + ko;
                uint32 bb2 = (uint32) (((int64) (tt * 128
                    + warpC * 64)) * cols + kb * 32L + (int64) ko);
                uint32 cst = (uint32) cols;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                t0.load(sa, ab, 0, 72);
                t1.load(sa, ab + 1152, 0, 72);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                CooperativeMatrix<float16,16,16,1> u2;
                CooperativeMatrix<float16,16,16,1> u3;
                u0.load(xh, bb2, 1, cst);
                u1.load(xh, bb2 + 16 * cst, 1, cst);
                u2.load(xh, bb2 + 32 * cst, 1, cst);
                u3.load(xh, bb2 + 48 * cst, 1, cst);
                a00.mma(t0, u0);
                a01.mma(t0, u1);
                a02.mma(t0, u2);
                a03.mma(t0, u3);
                a10.mma(t1, u0);
                a11.mma(t1, u1);
                a12.mma(t1, u2);
                a13.mma(t1, u3);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 2L;
        }
        uint32 rb = to * 128 + warpR * 32;
        uint32 cb = tt * 128 + warpC * 64;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a02.store(y, (cb + 32) * outDim + rb, 1, outDim);
        a03.store(y, (cb + 48) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a12.store(y, (cb + 32) * outDim + rb + 16, 1, outDim);
        a13.store(y, (cb + 48) * outDim + rb + 16, 1, outDim);
    }

    /** Shape-selected Q5_K coop launch — X3 (32x64 warp tile) below
     *  K=8192, X1 (64x32) above, the split the Q4_K router measured. */
    public static void q5kF16CoopAutoLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            int64 rows, int64 outDim, int64 cols) {
        int64 wgL = (outDim / 128L) * (rows / 128L);
        KernelStream s = QuantKernel.stream();
        if (cols > 8192L) {
            q5kF16CoopX1Kernel.launch(s,
                grid: [(uint32) wgL], block: [256])
                (y, packed, xh, (uint32) rows, (uint32) outDim,
                 (uint32) (outDim / 128L), cols / 256L);
            return;
        }
        q5kF16CoopX3Kernel.launch(s,
            grid: [(uint32) wgL], block: [256])
            (y, packed, xh, (uint32) rows, (uint32) outDim,
             (uint32) (outDim / 128L), cols / 256L);
        return;
    }

    /**
     * Generic block byte-pad, {@link #q6kPadKernel} without the hard-coded
     * 210/212 — for Q3_K (110 -> 112), whose hmask/qs/scales/d already land
     * on dword boundaries and only need the block STRIDE made a multiple of
     * four. One wave per block, lane l copying bytes l, l+64, ...
     */
    @Kernel
    public static void blockPadKernel(KernelBuffer<int8> dst,
            KernelBuffer<int8> src, uint32 nBlocks, uint32 srcBytes,
            uint32 dstBytes) {
        uint32 lane = KernelThread.x();
        uint32 b = KernelThread.globalIdX() / 64;
        if (b < nBlocks) {
            int64 so = (int64) b * (int64) srcBytes;
            int64 dof = (int64) b * (int64) dstBytes;
            uint32 i = lane;
            while (i < srcBytes) {
                dst[dof + (int64) i] = src[so + (int64) i];
                i = i + 64;
            }
        }
    }

    /**
     * Block REPACK for the legacy 32-value formats. Q4_0/Q5_0/Q8_0 all open
     * with a 2-byte f16 scale and then a payload that a plain byte-pad would
     * leave at offset 2 — never dword-addressable. Moving the payload to
     * offset 4 costs two bytes per block and makes the whole thing a dword
     * array: w0 = d, w1.. = payload. Runs once per tensor.
     */
    @Kernel
    public static void blockRepack2Kernel(KernelBuffer<int8> dst,
            KernelBuffer<int8> src, uint32 nBlocks, uint32 srcBytes,
            uint32 dstBytes) {
        uint32 lane = KernelThread.x();
        uint32 b = KernelThread.globalIdX() / 64;
        if (b < nBlocks) {
            int64 so = (int64) b * (int64) srcBytes;
            int64 dof = (int64) b * (int64) dstBytes;
            if (lane < 2) {
                dst[dof + (int64) lane] = src[so + (int64) lane];
                dst[dof + 2L + (int64) lane] = (int8) 0;
            }
            uint32 i = lane;
            while (i < srcBytes - 2) {
                dst[dof + 4L + (int64) i] = src[so + 2L + (int64) i];
                i = i + 64;
            }
        }
    }

    public static void blockPadLaunch(KernelBuffer<int8> dst,
            KernelBuffer<int8> src, int64 nBlocks, int32 srcBytes,
            int32 dstBytes) {
        KernelStream s = QuantKernel.stream();
        blockPadKernel.launch(s, grid: [(uint32) nBlocks], block: [64])
            (dst, src, (uint32) nBlocks, (uint32) srcBytes,
             (uint32) dstBytes);
        s.sync();
        return;
    }

    public static void blockRepack2Launch(KernelBuffer<int8> dst,
            KernelBuffer<int8> src, int64 nBlocks, int32 srcBytes,
            int32 dstBytes) {
        KernelStream s = QuantKernel.stream();
        blockRepack2Kernel.launch(s, grid: [(uint32) nBlocks], block: [64])
            (dst, src, (uint32) nBlocks, (uint32) srcBytes,
             (uint32) dstBytes);
        s.sync();
        return;
    }

    /**
     * The DEVICE block stride in dwords for the coop GEMM, per ggml type —
     * the single place the repack sizes and the kernels' `rowWords` must
     * agree. Zero for a type with no coop kernel.
     */
    public static int32 coopBlockWords(int32 ty) {
        if (ty == Quant.GG_Q4_0) { return 5; }
        if (ty == Quant.GG_Q5_0) { return 6; }
        if (ty == Quant.GG_Q8_0) { return 9; }
        if (ty == Quant.GG_Q2_K) { return 21; }
        if (ty == Quant.GG_Q3_K) { return 28; }
        if (ty == Quant.GG_Q4_K) { return 36; }
        if (ty == Quant.GG_Q5_K) { return 44; }
        if (ty == Quant.GG_Q6_K) { return 53; }
        return 0;
    }

    /** True when {@link #coopBlockWords} differs from the ggml block size,
     *  i.e. the tensor needs a one-time device repack before the GEMM. */
    public static boolean coopNeedsRepack(int32 ty) {
        return ty == Quant.GG_Q4_0 || ty == Quant.GG_Q5_0
            || ty == Quant.GG_Q8_0 || ty == Quant.GG_Q3_K
            || ty == Quant.GG_Q6_K;
    }

    /** Dispatch the coop (f16-staged) batched GEMM by weight type. */
    public static void coopBatchLaunchNoSync(int32 ty,
            KernelBuffer<float32> y, KernelBuffer<int32> packed,
            KernelBuffer<float16> xh, int64 rows, int64 outDim,
            int64 cols) {
        if (ty == Quant.GG_Q4_K) {
            QuantKernel.q4kF16CoopAutoLaunchNoSync(y, packed, xh, rows,
                outDim, cols);
        } else if (ty == Quant.GG_Q6_K) {
            QuantKernel.q6kF16CoopAutoLaunchNoSync(y, packed, xh, rows,
                outDim, cols);
        } else if (ty == Quant.GG_Q5_K) {
            QuantKernel.q5kF16CoopAutoLaunchNoSync(y, packed, xh, rows,
                outDim, cols);
        } else if (ty == Quant.GG_Q8_0) {
            QuantKernel.q80F16CoopAutoLaunchNoSync(y, packed, xh, rows,
                outDim, cols);
        } else if (ty == Quant.GG_Q5_0) {
            QuantKernel.q50F16CoopAutoLaunchNoSync(y, packed, xh, rows,
                outDim, cols);
        } else if (ty == Quant.GG_Q4_0) {
            QuantKernel.q40F16CoopAutoLaunchNoSync(y, packed, xh, rows,
                outDim, cols);
        } else if (ty == Quant.GG_Q3_K) {
            QuantKernel.q3kF16CoopAutoLaunchNoSync(y, packed, xh, rows,
                outDim, cols);
        } else if (ty == Quant.GG_Q2_K) {
            QuantKernel.q2kF16CoopAutoLaunchNoSync(y, packed, xh, rows,
                outDim, cols);
        } else {
            throw heap LlmException("coopBatchLaunch: no coop GEMM for "
                + "packed type " + ty);
        }
        return;
    }

    /** True when the coop batched GEMM covers this weight type. */
    public static boolean coopSupports(int32 ty) {
        return QuantKernel.coopBlockWords(ty) != 0;
    }

    /**
     * Can the coop GEMM tile THIS width for THIS type? The k-quants'
     * superblock is 256 elements, so their staging needs cols % 256; the
     * legacy 32-element formats have no such structure and only the
     * compute tile's BK=64 constrains them. The distinction is the whole
     * reason Qwen2.5-VL-72B's ffn_down ([8192, 29568], 29568 % 256 = 128
     * but % 64 = 0) can prefill batched at all — and one type failing
     * this used to demote ALL 963 tensors to per-row (batchReady is
     * all-or-nothing).
     */
    public static boolean coopColsOk(int32 ty, int64 cols) {
        if (!QuantKernel.coopSupports(ty)) { return false; }
        if (ty == Quant.GG_Q4_0 || ty == Quant.GG_Q5_0
                || ty == Quant.GG_Q8_0) {
            return cols % 64L == 0L;
        }
        return cols % 256L == 0L;
    }

    /** f32 -> f16 elementwise (activation conversion for the coop GEMM). */
    @Kernel
    public static void f32ToF16Kernel(KernelBuffer<float16> dst,
            KernelBuffer<float32> src, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            dst[(int64) i] = (float16) src[(int64) i];
        }
    }

    public static void f32ToF16LaunchNoSync(KernelBuffer<float16> dst,
            KernelBuffer<float32> src, int64 n) {
        KernelStream s = QuantKernel.stream();
        f32ToF16Kernel.launch(s, grid: [(uint32) ((n + 255L) / 256L)],
            block: [256])(dst, src, (uint32) n);
        return;
    }

    /** `rows` is the PADDED token count (multiple of 128); y and xh must
     *  be allocated at that height. */
    public static void q4kF16CoopLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            int64 rows, int64 outDim, int64 cols) {
        int64 nRowTiles = outDim / 128L;
        int64 nTokTiles = rows / 128L;
        KernelStream s = QuantKernel.stream();
        q4kF16CoopKernel.launch(s,
            grid: [(uint32) (nRowTiles * nTokTiles)], block: [128])
            (y, packed, xh, (uint32) rows, (uint32) outDim,
             (uint32) nRowTiles, cols / 256L);
        return;
    }

    public static void q4kQ8MmqLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<int32> xp,
            int64 rows, int64 outDim, int64 cols) {
        int64 nRowTiles = (outDim + 63L) / 64L;
        int64 nTokTiles = (rows + 63L) / 64L;
        KernelStream s = QuantKernel.stream();
        q4kQ8MmqKernel.launch(s,
            grid: [(uint32) (nRowTiles * nTokTiles)], block: [256])
            (y, packed, xp, (uint32) rows, (uint32) outDim,
             (uint32) nRowTiles, cols / 256L);
        return;
    }

    /** One workgroup of 32 per (output row, 32-token tile). */
    public static void q4kQ8BatchMatMulLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 outDim, int64 cols) {
        int64 nTiles = (rows + 31L) / 32L;
        KernelStream s = QuantKernel.stream();
        q4kQ8BatchMatMulKernel.launch(s,
            grid: [(uint32) (nTiles * outDim)], block: [32])
            (y, packed, xp, (uint32) rows, (uint32) outDim,
             (uint32) nTiles, cols / 256L,
             (uint32) QuantKernel.batchMode);
        return;
    }

    public static void q4kQ8BatchMatMulLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 outDim, int64 cols) {
        QuantKernel.q4kQ8BatchMatMulLaunchNoSync(y, packed, xp, rows,
            outDim, cols);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    /**
     * BATCHED Q6_K x Q8_K, the twin of {@link #q4kQ8BatchMatMulKernel}
     * and needed for the same reason it is: Q4_K_M is a MIXTURE. `attn_v`
     * and some `ffn_down` are Q6_K, so a batched path that only knew Q4_K
     * failed `batchReady` on the first Q6_K projection and silently ran
     * the whole prefill per-row — 34.3 s -> 32.8 s, which reads as "the
     * batching did not help" when it never ran.
     *
     * The lane is the prompt token, as in the Q4_K twin. Each lane walks
     * all sixteen 16-element sub-blocks of a block itself, where the
     * mat-vec kernel gives one sub-block to each of 16 lanes.
     */
    @Kernel
    public static void q6kQ8BatchMatMulKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, uint32 outDim, uint32 nTiles,
            int64 blocksPerRow) {
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 32;
        uint32 tile = wg / outDim;
        uint32 i32 = wg % outDim;
        uint32 r = tile * 32 + lane;
        if (tile < nTiles && r < rows) {
            int64 i = (int64) i32;
            int64 rowBytes = blocksPerRow * 210L;
            int64 xRowBytes = blocksPerRow * 320L;
            int64 xBase = (int64) r * xRowBytes;
            float32 acc = 0.0f;
            Vector<int32,4> z4 = heap Vector<int32,4>(0, 0, 0, 0);
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 210L;
                float32 d = QuantKernel.f16AtDev(packed, ro + 208L);
                int64 xb = xBase + b * 320L;
                Vector<int8,4> dvs = xp.vload<4>(xb + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dvs[0] & 255)
                    | (((int32) dvs[1] & 255) << 8)
                    | (((int32) dvs[2] & 255) << 16)
                    | (((int32) dvs[3] & 255) << 24));
                int32 sb = 0;
                while (sb < 16) {
                    int32 g = sb / 8;
                    int32 r0 = sb * 16 - g * 128;
                    int32 sl = r0 / 64;
                    int32 l64 = r0 - sl * 64;
                    int32 shi = r0 / 32;
                    int32 l32 = r0 - shi * 32;
                    Vector<int8,16> qlv = packed.vload<16>(
                        ro + (int64) (64 * g + l64));
                    Vector<int8,16> qhv = packed.vload<16>(
                        ro + (int64) (128 + 32 * g + l32));
                    Vector<int8,16> lo = qlv & 15;
                    if (sl == 1) { lo = (qlv >> 4) & 15; }
                    Vector<int8,16> hi = (qhv >> (2 * shi)) & 3;
                    Vector<uint8,16> qu = (lo | (hi << 4)).asUnsigned();
                    Vector<int8,16> a = xp.vload<16>(
                        xb + (int64) (sb * 16));
                    Vector<uint8,16> ones = (qu ^ qu) | 1;
                    Vector<int32,4> dv = qu.dotAccum(a, z4);
                    Vector<int32,4> sv = ones.dotAccum(a, z4);
                    int32 dot = dv[0] + dv[1] + dv[2] + dv[3];
                    int32 asum = sv[0] + sv[1] + sv[2] + sv[3];
                    int32 sc = (int32) packed[ro + (int64) (192 + sb)];
                    // Accumulated in FLOAT per sub-block, exactly as the
                    // mat-vec kernel does. Summing the integer terms first
                    // would be faster and would also trap: cajeta's int32
                    // multiply traps on signed overflow rather than
                    // wrapping.
                    acc = acc + d * xs
                        * (float32) (sc * (dot - 32 * asum));
                    sb = sb + 1;
                }
                b = b + 1;
            }
            y[(int64) r * (int64) outDim + i] = acc;
        }
    }

    public static void q6kQ8BatchMatMulLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 outDim, int64 cols) {
        int64 nTiles = (rows + 31L) / 32L;
        KernelStream s = QuantKernel.stream();
        q6kQ8BatchMatMulKernel.launch(s,
            grid: [(uint32) (nTiles * outDim)], block: [32])
            (y, packed, xp, (uint32) rows, (uint32) outDim,
             (uint32) nTiles, cols / 256L);
        return;
    }

    /** Dispatch the batched GEMM by weight type. */
    public static void batchMatMulLaunch(int32 ty, KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 outDim, int64 cols) {
        if (ty == Quant.GG_Q4_K) {
            if (QuantKernel.batch4) {
                QuantKernel.q4kQ8Batch4MatMulLaunchNoSync(y, packed, xp,
                    rows, outDim, cols);
            } else {
                QuantKernel.q4kQ8BatchMatMulLaunchNoSync(y, packed, xp,
                    rows, outDim, cols);
            }
        } else if (ty == Quant.GG_Q6_K) {
            QuantKernel.q6kQ8BatchMatMulLaunchNoSync(y, packed, xp, rows,
                outDim, cols);
        } else {
            throw heap LlmException("no batched GEMM for packed type "
                + ty);
        }
        // NoSync since unit 41b: every consumer is stream-ordered —
        // matmulInto owns its own sync before the download, and the
        // keep-chain (gemmKeepAt -> GLU -> down -> combine) never
        // reads on the host. The per-call sync here serialized 10962
        // independent GEMMs per prefill pass: 1247 ms of the 2.0 s.
        return;
    }

    /**
     * Arm for 10.12.4: four tokens per lane, or one. DEFAULT OFF — four
     * measured 3989 ms against one at 3514 on the same prefill, which
     * refutes the reason it was written. Four tokens a lane cuts the
     * passes over the weights from 16 to 4, so a bandwidth-bound GEMM
     * would have been ~4x faster; it was 13% SLOWER. The GEMM is issue-
     * and occupancy-bound, and four Vector<int32,8> accumulators plus
     * eight live activation vectors per lane cost more in registers than
     * the traffic was worth.
     */
    static boolean batch4 = false;
    static int32 batchMode = 0;

    public static void setBatchMode(int32 m) { QuantKernel.batchMode = m; }

    public static void setBatch4(boolean on) { QuantKernel.batch4 = on; }

    /**
     * PURE `dotAccum` THROUGHPUT (plan 10.12.9) — no memory in the loop.
     *
     * The GEMM sustains 1.17 TMAC/s and none of bandwidth (0%), decode
     * (5%) or the activation loads (15%) explains it. Before optimizing
     * the remaining 80% it has to be known whether that is near the
     * instrument's ceiling or far below it: a null result is worth
     * nothing until the instrument is validated.
     *
     * Four independent accumulator chains so this measures THROUGHPUT
     * rather than latency, and a per-iteration bump of one operand so the
     * loop cannot be strength-reduced to a multiply. The caller checks
     * that doubling `iters` doubles the TIME — a hoisted loop would not.
     */
    @Kernel
    public static void dotCeilingKernel(KernelBuffer<float32> out,
            KernelBuffer<int8> src, uint32 iters) {
        uint32 id = KernelThread.globalIdX();
        Vector<int32,8> zv = heap Vector<int32,8>(0, 0, 0, 0, 0, 0, 0, 0);
        Vector<int8,32> a0 = src.vload<32>(0L);
        Vector<int8,32> a1 = src.vload<32>(32L);
        Vector<int8,32> a2 = src.vload<32>(64L);
        Vector<int8,32> a3 = src.vload<32>(96L);
        Vector<uint8,32> w0 = src.vload<32>(128L).asUnsigned();
        Vector<uint8,32> w1 = src.vload<32>(160L).asUnsigned();
        Vector<uint8,32> w2 = src.vload<32>(192L).asUnsigned();
        Vector<uint8,32> w3 = src.vload<32>(224L).asUnsigned();
        Vector<int32,8> t0 = zv;
        Vector<int32,8> t1 = zv;
        Vector<int32,8> t2 = zv;
        Vector<int32,8> t3 = zv;
        uint32 k = 0;
        while (k < iters) {
            t0 = t0 + w0.dotAccum(a0, zv);
            t1 = t1 + w1.dotAccum(a1, zv);
            t2 = t2 + w2.dotAccum(a2, zv);
            t3 = t3 + w3.dotAccum(a3, zv);
            a0 = a0 + 1;
            k = k + 1;
        }
        Vector<int32,8> tt = t0 + t1 + t2 + t3;
        out[id] = (float32) (tt[0] + tt[1] + tt[2] + tt[3]
                           + tt[4] + tt[5] + tt[6] + tt[7]);
    }

    /** Launch the ceiling probe over `groups` workgroups of 32. */
    public static void dotCeilingLaunch(KernelBuffer<float32> out,
            KernelBuffer<int8> src, int64 groups, int32 iters) {
        KernelStream s = QuantKernel.stream();
        dotCeilingKernel.launch(s, grid: [(uint32) groups], block: [32])
            (out, src, (uint32) iters);
        s.sync();
        return;
    }

    /** True when the batched GEMM has a kernel for `ty`. */
    public static boolean hasBatchKernel(int32 ty) {
        return ty == Quant.GG_Q4_K || ty == Quant.GG_Q6_K;
    }

    /** {@link #q4kQ8MatVecLaunch} over the packed activation buffer. */
    public static void q4kQ8PackedMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        uint32 ur = (uint32) rows;
        uint32 blk = (uint32) QuantKernel.ROWS_PER_BLOCK;
        KernelStream s = QuantKernel.stream();
        q4kQ8PackedMatVecKernel.launch(s,
            grid: [(ur + blk - 1) / blk], block: [blk])
            (y, packed, xp, ur, cols / 256L, yOff);
        return;
    }

    public static void q4kQ8PackedMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        QuantKernel.q4kQ8PackedMatVecLaunchNoSync(y, packed, xp, rows, cols, yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }


    /**
     * WAVE-COOPERATIVE Q4_K x q8_K — llama.cpp's mmvq decomposition
     * (plan 11.1).
     *
     * Every mat-vec kernel here so far gives ONE OUTPUT ROW to ONE WORK
     * ITEM. llama.cpp gives one output row to one WAVE. On gfx1151 that is
     * not a guess: RDNA3.5 takes their MMVQ_PARAMETERS_RDNA2 table, which
     * resolves `nwarps = 1` and `rows_per_cuda_block = 1`, so a CUDA block
     * is 32 threads = one wave32 = one row, the lanes split each weight
     * block between them, and the row finishes with a wave reduction.
     *
     * Two things follow, and they are the two problems 10.5's buckets
     * found:
     *
     *   OCCUPANCY. One item per row gives a 1024-row weight 32 waves for
     *   160 SIMDs. One wave per row gives it 1024 — the wave count stops
     *   being rows/32 and becomes rows.
     *
     *   LOCALITY. Under one-item-per-row a wave's 32 lanes read 32
     *   addresses `rowBytes` apart. Here four consecutive lanes read one
     *   block's 128 contiguous quant bytes, so a wave reads eight runs of
     *   128 bytes. 9.6 refuted "uncoalesced reads are the problem" by
     *   moving the BYTES while keeping one item per row; this moves the
     *   decomposition instead, which is the variable that test held fixed.
     *
     * The lane split is chosen so that no byte is read twice: lane `l`
     * takes block `l/4` of the eight in flight and, within it, the
     * 32-byte chunk `l%4` — which is exactly one iteration of the serial
     * kernel's `g` loop, carrying sub-blocks 2g and 2g+1. Four lanes
     * therefore cover a block's 128 quant bytes and its 256 activation
     * bytes exactly once each.
     */
    @Kernel
    public static void q4kQ8WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, int64 blocksPerRow, int64 yOff, uint32 accum) {
        uint32 lane = KernelThread.x();
        uint32 wave = KernelThread.globalIdX() / 32;
        // Unit 47: four lanes per block, so a row shorter than eight
        // blocks would idle the rest of the wave (a 3-block row ran
        // at 92 GB/s where 8-block rows ran 277). Short rows pack
        // rowsPerWave rows per wave in lane segments.
        //
        // Unit 58/60: rows of eight or more blocks take FOUR rows per
        // wave, in slots — the q6k kernel's shape. A lane's block index
        // and sub-block pair are fixed by its lane number, so its 64
        // bytes of x are the same for every row: loaded once per block
        // trip they serve all four slots, where one row per wave paid
        // the x loads and the wave's whole fixed cost per row (4096
        // one-row waves on a 4.7 MB launch measured 134 GB/s where the
        // four-slot q6k measured 156 for MORE bytes). All four slots'
        // loads are in flight together; out-of-range slots clamp to the
        // last row and weigh zero, so every load is unconditional.
        uint32 lpr = 4 * (uint32) blocksPerRow;
        uint32 rpw = 1;
        uint32 rl = lane;
        uint32 sub = 0;
        uint32 R = 4;
        if (lpr < 32) { rpw = 32 / lpr; sub = lane / lpr; rl = lane - sub * lpr; R = 1; }
        uint32 row0 = wave * R * rpw + sub;
        // Unit 61: every offset in uint32 (a slab is far below 4 GB) — int64
        // index math was a v_mad_u64_u32 pair per offset and a two-
        // instruction add per load address; a zext'd 32-bit offset lets
        // the backend address loads as SGPR base + VGPR offset.
        uint32 rowBytes = (uint32) blocksPerRow * 144;
        uint32 bpr = (uint32) blocksPerRow;
        float32 acc0 = 0.0f;
        float32 acc1 = 0.0f;
        float32 acc2 = 0.0f;
        float32 acc3 = 0.0f;
        if (sub < rpw && row0 < rows) {
            uint32 last = rows - 1;
            uint32 r1 = row0 + 1; if (r1 > last) { r1 = last; }
            uint32 r2 = row0 + 2; if (r2 > last) { r2 = last; }
            uint32 r3 = row0 + 3; if (r3 > last) { r3 = last; }
            float32 w1 = 0.0f; if (R > 1 && row0 + 1 < rows) { w1 = 1.0f; }
            float32 w2 = 0.0f; if (R > 1 && row0 + 2 < rows) { w2 = 1.0f; }
            float32 w3 = 0.0f; if (R > 1 && row0 + 3 < rows) { w3 = 1.0f; }
            uint32 rb0 = row0 * rowBytes;
            uint32 rb1 = r1 * rowBytes;
            uint32 rb2 = r2 * rowBytes;
            uint32 rb3 = r3 * rowBytes;
            int32 g = (int32) (rl % 4);
            uint32 b = rl / 4;
            int32 sh0 = 16 * (g & 1);
            int32 sh1 = sh0 + 8;
            Vector<int32,8> zv = heap Vector<int32,8>(0, 0, 0, 0, 0, 0, 0, 0);
            while (b < bpr) {
                // The header — { f16 d; f16 dmin; u8 scales[12] } = 16 bytes,
                // and this lane's 32 bytes of quants (sub-blocks 2g, 2g+1:
                // Q4_K packs sub-blocks 0-3 and 4-7 in different fields,
                // and reading field `g` instead of sub-block `2g` was the
                // shape of the first version, wrong on every row).
                uint32 xb = b * 320 + (uint32) (64 * g);
                uint32 xr = b * 320;
                Vector<int8,32> a0 = xp.vload<32>((int64) xb);
                Vector<int8,32> a1 = xp.vload<32>((int64) xb + 32L);
                Vector<int8,4> dv = xp.vload<4>((int64) xr + 288L);
                uint32 ro0 = rb0 + b * 144;
                uint32 rw0 = ro0 + (uint32) (32 * g);
                Vector<int8,16> hv0 = packed.vload<16>((int64) ro0);
                Vector<uint8,32> raw0 = packed.vload<32>(
                    (int64) rw0 + 16L).asUnsigned();
                uint32 ro1 = rb1 + b * 144;
                uint32 rw1 = ro1 + (uint32) (32 * g);
                Vector<int8,16> hv1 = packed.vload<16>((int64) ro1);
                Vector<uint8,32> raw1 = packed.vload<32>(
                    (int64) rw1 + 16L).asUnsigned();
                uint32 ro2 = rb2 + b * 144;
                uint32 rw2 = ro2 + (uint32) (32 * g);
                Vector<int8,16> hv2 = packed.vload<16>((int64) ro2);
                Vector<uint8,32> raw2 = packed.vload<32>(
                    (int64) rw2 + 16L).asUnsigned();
                uint32 ro3 = rb3 + b * 144;
                uint32 rw3 = ro3 + (uint32) (32 * g);
                Vector<int8,16> hv3 = packed.vload<16>((int64) ro3);
                Vector<uint8,32> raw3 = packed.vload<32>(
                    (int64) rw3 + 16L).asUnsigned();
                float32 xs = Cajeta.bitsToF32(((int32) dv[0] & 255)
                    | (((int32) dv[1] & 255) << 8)
                    | (((int32) dv[2] & 255) << 16)
                    | (((int32) dv[3] & 255) << 24));
                // The dmin term needs the sum of THIS LANE's activations:
                // llama.cpp's `dp4a(0x01010101, u)`, any lane granularity.
                Vector<uint8,32> ones = (a0 ^ a0).asUnsigned() | 1;
                // Unit 61: the activation sums and the two dot sums are reduced
                // FIRST and scaled as scalars — integer-exact, so bit-identical to
                // scaling the eight lanes, and 2 quarter-rate multiplies where
                // there were 16 (v_mul_lo/v_mad_u64 are 4-cycle on RDNA).
                Vector<int32,8> os0 = ones.dotAccum(a0, zv);
                Vector<int32,8> os1 = ones.dotAccum(a1, zv);
                int32 as0 = os0[0] + os0[1] + os0[2] + os0[3]
                    + os0[4] + os0[5] + os0[6] + os0[7];
                int32 as1 = os1[0] + os1[1] + os1[2] + os1[3]
                    + os1[4] + os1[5] + os1[6] + os1[7];
                float32 d0 = GgufFile.halfBitsToF32(((int32) hv0[0] & 255)
                    | (((int32) hv0[1] & 255) << 8));
                float32 dmin0 = GgufFile.halfBitsToF32(((int32) hv0[2] & 255)
                    | (((int32) hv0[3] & 255) << 8));
                // Unit 60: the scale bytes by WORD and runtime SHIFT, not by
                // runtime lane index — `hv[4 + j]` with j from the lane
                // number lowered to a 16-way compare/select chain per
                // byte (600 v_cndmask_b16 in the kernel), and both g
                // branches executed. Words 1..3 of the header are the
                // scale, min and high fields; the lane's two bytes sit at
                // shift 8j, 8j + 8 with j = 2 (g & 1) in EITHER branch.
                Vector<int32,4> hw0 = hv0.asWords();
                int32 scw0 = hw0[1];
                int32 mnw0 = hw0[2];
                int32 hiw0 = hw0[3];
                int32 sA0 = (scw0 >> sh0) & 255;
                int32 sB0 = (scw0 >> sh1) & 255;
                int32 mC0 = (mnw0 >> sh0) & 255;
                int32 mD0 = (mnw0 >> sh1) & 255;
                int32 sc0_0 = sA0 & 63;
                int32 sc1_0 = sB0 & 63;
                int32 mn0_0 = mC0 & 63;
                int32 mn1_0 = mD0 & 63;
                if (g >= 2) {
                    int32 k0 = (hiw0 >> sh0) & 255;
                    int32 k1 = (hiw0 >> sh1) & 255;
                    sc0_0 = (k0 & 15) | ((sA0 >> 2) & 48);
                    sc1_0 = (k1 & 15) | ((sB0 >> 2) & 48);
                    mn0_0 = (k0 >> 4) | ((mC0 >> 2) & 48);
                    mn1_0 = (k1 >> 4) | ((mD0 >> 2) & 48);
                }
                Vector<int32,8> rw0 = raw0.asWords();
                Vector<uint8,32> lo0 = (rw0 & 252645135).asBytes().asUnsigned();
                Vector<uint8,32> hi0 = ((rw0 >> 4) & 252645135).asBytes().asUnsigned();
                Vector<int32,8> dl0 = lo0.dotAccum(a0, zv);
                Vector<int32,8> dh0 = hi0.dotAccum(a1, zv);
                int32 sumi0 = (dl0[0] + dl0[1] + dl0[2] + dl0[3]
                    + dl0[4] + dl0[5] + dl0[6] + dl0[7]) * sc0_0
                             + (dh0[0] + dh0[1] + dh0[2] + dh0[3]
                                 + dh0[4] + dh0[5] + dh0[6] + dh0[7]) * sc1_0;
                int32 dmins0 = as0 * mn0_0 + as1 * mn1_0;
                acc0 = acc0 + d0 * xs * (float32) sumi0
                          - dmin0 * xs * (float32) dmins0;
                float32 d1 = GgufFile.halfBitsToF32(((int32) hv1[0] & 255)
                    | (((int32) hv1[1] & 255) << 8));
                float32 dmin1 = GgufFile.halfBitsToF32(((int32) hv1[2] & 255)
                    | (((int32) hv1[3] & 255) << 8));
                // Unit 60: the scale bytes by WORD and runtime SHIFT, not by
                // runtime lane index — `hv[4 + j]` with j from the lane
                // number lowered to a 16-way compare/select chain per
                // byte (600 v_cndmask_b16 in the kernel), and both g
                // branches executed. Words 1..3 of the header are the
                // scale, min and high fields; the lane's two bytes sit at
                // shift 8j, 8j + 8 with j = 2 (g & 1) in EITHER branch.
                Vector<int32,4> hw1 = hv1.asWords();
                int32 scw1 = hw1[1];
                int32 mnw1 = hw1[2];
                int32 hiw1 = hw1[3];
                int32 sA1 = (scw1 >> sh0) & 255;
                int32 sB1 = (scw1 >> sh1) & 255;
                int32 mC1 = (mnw1 >> sh0) & 255;
                int32 mD1 = (mnw1 >> sh1) & 255;
                int32 sc0_1 = sA1 & 63;
                int32 sc1_1 = sB1 & 63;
                int32 mn0_1 = mC1 & 63;
                int32 mn1_1 = mD1 & 63;
                if (g >= 2) {
                    int32 k0 = (hiw1 >> sh0) & 255;
                    int32 k1 = (hiw1 >> sh1) & 255;
                    sc0_1 = (k0 & 15) | ((sA1 >> 2) & 48);
                    sc1_1 = (k1 & 15) | ((sB1 >> 2) & 48);
                    mn0_1 = (k0 >> 4) | ((mC1 >> 2) & 48);
                    mn1_1 = (k1 >> 4) | ((mD1 >> 2) & 48);
                }
                Vector<int32,8> rw1 = raw1.asWords();
                Vector<uint8,32> lo1 = (rw1 & 252645135).asBytes().asUnsigned();
                Vector<uint8,32> hi1 = ((rw1 >> 4) & 252645135).asBytes().asUnsigned();
                Vector<int32,8> dl1 = lo1.dotAccum(a0, zv);
                Vector<int32,8> dh1 = hi1.dotAccum(a1, zv);
                int32 sumi1 = (dl1[0] + dl1[1] + dl1[2] + dl1[3]
                    + dl1[4] + dl1[5] + dl1[6] + dl1[7]) * sc0_1
                             + (dh1[0] + dh1[1] + dh1[2] + dh1[3]
                                 + dh1[4] + dh1[5] + dh1[6] + dh1[7]) * sc1_1;
                int32 dmins1 = as0 * mn0_1 + as1 * mn1_1;
                acc1 = acc1 + d1 * xs * (float32) sumi1
                          - dmin1 * xs * (float32) dmins1;
                float32 d2 = GgufFile.halfBitsToF32(((int32) hv2[0] & 255)
                    | (((int32) hv2[1] & 255) << 8));
                float32 dmin2 = GgufFile.halfBitsToF32(((int32) hv2[2] & 255)
                    | (((int32) hv2[3] & 255) << 8));
                // Unit 60: the scale bytes by WORD and runtime SHIFT, not by
                // runtime lane index — `hv[4 + j]` with j from the lane
                // number lowered to a 16-way compare/select chain per
                // byte (600 v_cndmask_b16 in the kernel), and both g
                // branches executed. Words 1..3 of the header are the
                // scale, min and high fields; the lane's two bytes sit at
                // shift 8j, 8j + 8 with j = 2 (g & 1) in EITHER branch.
                Vector<int32,4> hw2 = hv2.asWords();
                int32 scw2 = hw2[1];
                int32 mnw2 = hw2[2];
                int32 hiw2 = hw2[3];
                int32 sA2 = (scw2 >> sh0) & 255;
                int32 sB2 = (scw2 >> sh1) & 255;
                int32 mC2 = (mnw2 >> sh0) & 255;
                int32 mD2 = (mnw2 >> sh1) & 255;
                int32 sc0_2 = sA2 & 63;
                int32 sc1_2 = sB2 & 63;
                int32 mn0_2 = mC2 & 63;
                int32 mn1_2 = mD2 & 63;
                if (g >= 2) {
                    int32 k0 = (hiw2 >> sh0) & 255;
                    int32 k1 = (hiw2 >> sh1) & 255;
                    sc0_2 = (k0 & 15) | ((sA2 >> 2) & 48);
                    sc1_2 = (k1 & 15) | ((sB2 >> 2) & 48);
                    mn0_2 = (k0 >> 4) | ((mC2 >> 2) & 48);
                    mn1_2 = (k1 >> 4) | ((mD2 >> 2) & 48);
                }
                Vector<int32,8> rw2 = raw2.asWords();
                Vector<uint8,32> lo2 = (rw2 & 252645135).asBytes().asUnsigned();
                Vector<uint8,32> hi2 = ((rw2 >> 4) & 252645135).asBytes().asUnsigned();
                Vector<int32,8> dl2 = lo2.dotAccum(a0, zv);
                Vector<int32,8> dh2 = hi2.dotAccum(a1, zv);
                int32 sumi2 = (dl2[0] + dl2[1] + dl2[2] + dl2[3]
                    + dl2[4] + dl2[5] + dl2[6] + dl2[7]) * sc0_2
                             + (dh2[0] + dh2[1] + dh2[2] + dh2[3]
                                 + dh2[4] + dh2[5] + dh2[6] + dh2[7]) * sc1_2;
                int32 dmins2 = as0 * mn0_2 + as1 * mn1_2;
                acc2 = acc2 + d2 * xs * (float32) sumi2
                          - dmin2 * xs * (float32) dmins2;
                float32 d3 = GgufFile.halfBitsToF32(((int32) hv3[0] & 255)
                    | (((int32) hv3[1] & 255) << 8));
                float32 dmin3 = GgufFile.halfBitsToF32(((int32) hv3[2] & 255)
                    | (((int32) hv3[3] & 255) << 8));
                // Unit 60: the scale bytes by WORD and runtime SHIFT, not by
                // runtime lane index — `hv[4 + j]` with j from the lane
                // number lowered to a 16-way compare/select chain per
                // byte (600 v_cndmask_b16 in the kernel), and both g
                // branches executed. Words 1..3 of the header are the
                // scale, min and high fields; the lane's two bytes sit at
                // shift 8j, 8j + 8 with j = 2 (g & 1) in EITHER branch.
                Vector<int32,4> hw3 = hv3.asWords();
                int32 scw3 = hw3[1];
                int32 mnw3 = hw3[2];
                int32 hiw3 = hw3[3];
                int32 sA3 = (scw3 >> sh0) & 255;
                int32 sB3 = (scw3 >> sh1) & 255;
                int32 mC3 = (mnw3 >> sh0) & 255;
                int32 mD3 = (mnw3 >> sh1) & 255;
                int32 sc0_3 = sA3 & 63;
                int32 sc1_3 = sB3 & 63;
                int32 mn0_3 = mC3 & 63;
                int32 mn1_3 = mD3 & 63;
                if (g >= 2) {
                    int32 k0 = (hiw3 >> sh0) & 255;
                    int32 k1 = (hiw3 >> sh1) & 255;
                    sc0_3 = (k0 & 15) | ((sA3 >> 2) & 48);
                    sc1_3 = (k1 & 15) | ((sB3 >> 2) & 48);
                    mn0_3 = (k0 >> 4) | ((mC3 >> 2) & 48);
                    mn1_3 = (k1 >> 4) | ((mD3 >> 2) & 48);
                }
                Vector<int32,8> rw3 = raw3.asWords();
                Vector<uint8,32> lo3 = (rw3 & 252645135).asBytes().asUnsigned();
                Vector<uint8,32> hi3 = ((rw3 >> 4) & 252645135).asBytes().asUnsigned();
                Vector<int32,8> dl3 = lo3.dotAccum(a0, zv);
                Vector<int32,8> dh3 = hi3.dotAccum(a1, zv);
                int32 sumi3 = (dl3[0] + dl3[1] + dl3[2] + dl3[3]
                    + dl3[4] + dl3[5] + dl3[6] + dl3[7]) * sc0_3
                             + (dh3[0] + dh3[1] + dh3[2] + dh3[3]
                                 + dh3[4] + dh3[5] + dh3[6] + dh3[7]) * sc1_3;
                int32 dmins3 = as0 * mn0_3 + as1 * mn1_3;
                acc3 = acc3 + d3 * xs * (float32) sumi3
                          - dmin3 * xs * (float32) dmins3;
                b = b + 8;
            }
            acc1 = acc1 * w1;
            acc2 = acc2 * w2;
            acc3 = acc3 * w3;
        }
        // ONE subgroup reduction per row slot (2026-08-26: a five-barrier
        // LDS tree moved through memory what the hardware reduces across
        // lanes; the shuffle butterfly tried in 2026-08 was wrong and no
        // faster).
        if (R > 1) {
            float32 t0 = Wave.reduceSumF32(acc0);
            float32 t1 = Wave.reduceSumF32(acc1);
            float32 t2 = Wave.reduceSumF32(acc2);
            float32 t3 = Wave.reduceSumF32(acc3);
            if (lane == 0) {
                int64 o = yOff + (int64) row0;
                if (accum != 0) {
                    if (row0 < rows) { y[o] = y[o] + t0; }
                    if (row0 + 1 < rows) { y[o + 1L] = y[o + 1L] + t1; }
                    if (row0 + 2 < rows) { y[o + 2L] = y[o + 2L] + t2; }
                    if (row0 + 3 < rows) { y[o + 3L] = y[o + 3L] + t3; }
                } else {
                    if (row0 < rows) { y[o] = t0; }
                    if (row0 + 1 < rows) { y[o + 1L] = t1; }
                    if (row0 + 2 < rows) { y[o + 2L] = t2; }
                    if (row0 + 3 < rows) { y[o + 3L] = t3; }
                }
            }
        } else {
            uint32 r = 0;
            while (r < rpw) {
                float32 part = 0.0f;
                if (sub == r) { part = acc0; }
                float32 tot = Wave.reduceSumF32(part);
                if (lane == 0 && wave * rpw + r < rows) {
                    // Unit 48: accumulate form — the decode o-projection
                    // folds its residual add into the store.
                    if (accum != 0) {
                        y[yOff + (int64) (wave * rpw + r)] =
                            y[yOff + (int64) (wave * rpw + r)] + tot;
                    } else {
                        y[yOff + (int64) (wave * rpw + r)] = tot;
                    }
                }
                r = r + 1;
            }
        }
    }


    /**
     * Unit 49: the decode q, k and v projections in ONE launch. Waves
     * 0..rowsQ-1 own q rows, the next rowsKv own k rows, the next
     * rowsKv own v rows — all against the one staged activation, each
     * from its own packed weight; v may be Q6_K (`vQ6`), the Q4_K_M
     * recipe's half. k and v are ~0.6 MB each and paid a launch's
     * latency floor apiece; here they ride q's launch. The bodies are
     * the wave kernels' (bit-identical per row), one copy per weight
     * parameter: the lowering knows buffer PARAMETERS only — a
     * KernelBuffer local is "index on non-buffer" and the kernel is
     * skipped, which the first build of this learned from a launch
     * that silently did nothing. Rows are 8+ blocks, one per wave;
     * the caller falls back below that.
     */
    @Kernel
    public static void qkvWaveMatVecKernel(KernelBuffer<float32> yq,
            KernelBuffer<float32> yk, KernelBuffer<float32> yv,
            KernelBuffer<int8> wq, KernelBuffer<int8> wk,
            KernelBuffer<int8> wv, KernelBuffer<int8> xp,
            uint32 rowsQ, uint32 rowsKv, int64 blocksPerRow, uint32 vQ6) {
        uint32 lane = KernelThread.x();
        uint32 rl = lane;
        uint32 wave = KernelThread.globalIdX() / 32;
        float32 acc = 0.0f;
        uint32 which = 0;
        uint32 row = wave;
        if (wave >= rowsQ + rowsKv) { which = 2; row = wave - rowsQ - rowsKv; }
        else if (wave >= rowsQ) { which = 1; row = wave - rowsQ; }
        uint32 limit = rowsQ;
        if (which != 0) { limit = rowsKv; }
        if (row < limit && which == 0) {
            uint32 rowBytes = (uint32) blocksPerRow * 144;   // unit 61: uint32 offsets
            uint32 bpr = (uint32) blocksPerRow;
            uint32 rb = row * rowBytes;
            int32 g = (int32) (rl % 4);
            int32 sh0 = 16 * (g & 1);
            int32 sh1 = sh0 + 8;
            uint32 b = rl / 4;
            Vector<int32,8> zv = heap Vector<int32,8>(0, 0, 0, 0, 0, 0, 0, 0);
            while (b < bpr) {
                uint32 ro = rb + b * 144;
                uint32 rw = ro + (uint32) (32 * g);

                // The header — { f16 d; f16 dmin; u8 scales[12] } = 16 bytes.
                // Read by all four lanes of the block; it is 16 bytes and it
                // is in cache after the first.
                Vector<int8,16> hv = wq.vload<16>((int64) ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                // Only THIS lane's two sub-blocks are unpacked, where the
                // serial kernel unpacks all eight — and the two forms are
                // NOT interchangeable. Q4_K packs sub-blocks 0-3 and 4-7 in
                // different fields, and a lane owning `g` needs sub-blocks
                // 2g and 2g+1, so g < 2 lands entirely in the first field
                // and g >= 2 entirely in the second. Reading field `g`
                // instead of sub-block `2g` is the shape of the first
                // version of this kernel, which was wrong on every row.
                // Unit 60: scale bytes by word and runtime shift (no runtime
                // lane index — that lowered to a 16-way select chain per byte).
                Vector<int32,4> hvw = hv.asWords();
                int32 hvsA = (hvw[1] >> sh0) & 255;
                int32 hvsB = (hvw[1] >> sh1) & 255;
                int32 hvmC = (hvw[2] >> sh0) & 255;
                int32 hvmD = (hvw[2] >> sh1) & 255;
                int32 sc0 = hvsA & 63;
                int32 sc1 = hvsB & 63;
                int32 mn0 = hvmC & 63;
                int32 mn1 = hvmD & 63;
                if (g >= 2) {
                    int32 k0 = (hvw[3] >> sh0) & 255;
                    int32 k1 = (hvw[3] >> sh1) & 255;
                    sc0 = (k0 & 15) | ((hvsA >> 2) & 48);
                    sc1 = (k1 & 15) | ((hvsB >> 2) & 48);
                    mn0 = (k0 >> 4) | ((hvmC >> 2) & 48);
                    mn1 = (k1 >> 4) | ((hvmD >> 2) & 48);
                }

                Vector<uint8,32> raw = wq.vload<32>(
                    (int64) rw + 16L).asUnsigned();
                Vector<int32,8> raww = raw.asWords();
                Vector<uint8,32> lo = (raww & 252645135).asBytes().asUnsigned();
                Vector<uint8,32> hi = ((raww >> 4) & 252645135).asBytes().asUnsigned();
                uint32 xb = b * 320 + (uint32) (64 * g);
                uint32 xr = b * 320;
                Vector<int8,32> a0 = xp.vload<32>((int64) xb);
                Vector<int8,32> a1 = xp.vload<32>((int64) xb + 32L);
                Vector<int32,8> dl = lo.dotAccum(a0, zv);
                Vector<int32,8> dh = hi.dotAccum(a1, zv);
                int32 sumi = (dl[0] + dl[1] + dl[2] + dl[3]
                    + dl[4] + dl[5] + dl[6] + dl[7]) * sc0
                             + (dh[0] + dh[1] + dh[2] + dh[3]
                                 + dh[4] + dh[5] + dh[6] + dh[7]) * sc1;

                // The dmin term needs the sum of THIS LANE's activations,
                // and the packed block's precomputed sums are per 32-element
                // sub-block — which only helps a lane that owns a whole one.
                // llama.cpp does not read a precomputed sum at all: it takes
                // `dp4a(0x01010101, u)`, so any lane granularity is free.
                // Same trick here, and it drops a 32-byte load per lane per
                // block as well.
                Vector<uint8,32> ones = (lo ^ lo) | 1;
                // Unit 61: the activation sums and the two dot sums are reduced
                // FIRST and scaled as scalars — integer-exact, so bit-identical to
                // scaling the eight lanes, and 2 quarter-rate multiplies where
                // there were 16 (v_mul_lo/v_mad_u64 are 4-cycle on RDNA).
                Vector<int32,8> os0 = ones.dotAccum(a0, zv);
                Vector<int32,8> os1 = ones.dotAccum(a1, zv);
                int32 as0 = os0[0] + os0[1] + os0[2] + os0[3]
                    + os0[4] + os0[5] + os0[6] + os0[7];
                int32 as1 = os1[0] + os1[1] + os1[2] + os1[3]
                    + os1[4] + os1[5] + os1[6] + os1[7];
                int32 dmins = as0 * mn0 + as1 * mn1;

                Vector<int8,4> dv = xp.vload<4>((int64) xr + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dv[0] & 255)
                    | (((int32) dv[1] & 255) << 8)
                    | (((int32) dv[2] & 255) << 16)
                    | (((int32) dv[3] & 255) << 24));

                acc = acc + d * xs * (float32) sumi
                          - dmin * xs * (float32) dmins;
                b = b + 8;
            }
        }
        if (row < limit && which == 1) {
            uint32 rowBytes = (uint32) blocksPerRow * 144;   // unit 61: uint32 offsets
            uint32 bpr = (uint32) blocksPerRow;
            uint32 rb = row * rowBytes;
            int32 g = (int32) (rl % 4);
            int32 sh0 = 16 * (g & 1);
            int32 sh1 = sh0 + 8;
            uint32 b = rl / 4;
            Vector<int32,8> zv = heap Vector<int32,8>(0, 0, 0, 0, 0, 0, 0, 0);
            while (b < bpr) {
                uint32 ro = rb + b * 144;
                uint32 rw = ro + (uint32) (32 * g);

                // The header — { f16 d; f16 dmin; u8 scales[12] } = 16 bytes.
                // Read by all four lanes of the block; it is 16 bytes and it
                // is in cache after the first.
                Vector<int8,16> hv = wk.vload<16>((int64) ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                // Only THIS lane's two sub-blocks are unpacked, where the
                // serial kernel unpacks all eight — and the two forms are
                // NOT interchangeable. Q4_K packs sub-blocks 0-3 and 4-7 in
                // different fields, and a lane owning `g` needs sub-blocks
                // 2g and 2g+1, so g < 2 lands entirely in the first field
                // and g >= 2 entirely in the second. Reading field `g`
                // instead of sub-block `2g` is the shape of the first
                // version of this kernel, which was wrong on every row.
                // Unit 60: scale bytes by word and runtime shift (no runtime
                // lane index — that lowered to a 16-way select chain per byte).
                Vector<int32,4> hvw = hv.asWords();
                int32 hvsA = (hvw[1] >> sh0) & 255;
                int32 hvsB = (hvw[1] >> sh1) & 255;
                int32 hvmC = (hvw[2] >> sh0) & 255;
                int32 hvmD = (hvw[2] >> sh1) & 255;
                int32 sc0 = hvsA & 63;
                int32 sc1 = hvsB & 63;
                int32 mn0 = hvmC & 63;
                int32 mn1 = hvmD & 63;
                if (g >= 2) {
                    int32 k0 = (hvw[3] >> sh0) & 255;
                    int32 k1 = (hvw[3] >> sh1) & 255;
                    sc0 = (k0 & 15) | ((hvsA >> 2) & 48);
                    sc1 = (k1 & 15) | ((hvsB >> 2) & 48);
                    mn0 = (k0 >> 4) | ((hvmC >> 2) & 48);
                    mn1 = (k1 >> 4) | ((hvmD >> 2) & 48);
                }

                Vector<uint8,32> raw = wk.vload<32>(
                    (int64) rw + 16L).asUnsigned();
                Vector<int32,8> raww = raw.asWords();
                Vector<uint8,32> lo = (raww & 252645135).asBytes().asUnsigned();
                Vector<uint8,32> hi = ((raww >> 4) & 252645135).asBytes().asUnsigned();
                uint32 xb = b * 320 + (uint32) (64 * g);
                uint32 xr = b * 320;
                Vector<int8,32> a0 = xp.vload<32>((int64) xb);
                Vector<int8,32> a1 = xp.vload<32>((int64) xb + 32L);
                Vector<int32,8> dl = lo.dotAccum(a0, zv);
                Vector<int32,8> dh = hi.dotAccum(a1, zv);
                int32 sumi = (dl[0] + dl[1] + dl[2] + dl[3]
                    + dl[4] + dl[5] + dl[6] + dl[7]) * sc0
                             + (dh[0] + dh[1] + dh[2] + dh[3]
                                 + dh[4] + dh[5] + dh[6] + dh[7]) * sc1;

                // The dmin term needs the sum of THIS LANE's activations,
                // and the packed block's precomputed sums are per 32-element
                // sub-block — which only helps a lane that owns a whole one.
                // llama.cpp does not read a precomputed sum at all: it takes
                // `dp4a(0x01010101, u)`, so any lane granularity is free.
                // Same trick here, and it drops a 32-byte load per lane per
                // block as well.
                Vector<uint8,32> ones = (lo ^ lo) | 1;
                // Unit 61: the activation sums and the two dot sums are reduced
                // FIRST and scaled as scalars — integer-exact, so bit-identical to
                // scaling the eight lanes, and 2 quarter-rate multiplies where
                // there were 16 (v_mul_lo/v_mad_u64 are 4-cycle on RDNA).
                Vector<int32,8> os0 = ones.dotAccum(a0, zv);
                Vector<int32,8> os1 = ones.dotAccum(a1, zv);
                int32 as0 = os0[0] + os0[1] + os0[2] + os0[3]
                    + os0[4] + os0[5] + os0[6] + os0[7];
                int32 as1 = os1[0] + os1[1] + os1[2] + os1[3]
                    + os1[4] + os1[5] + os1[6] + os1[7];
                int32 dmins = as0 * mn0 + as1 * mn1;

                Vector<int8,4> dv = xp.vload<4>((int64) xr + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dv[0] & 255)
                    | (((int32) dv[1] & 255) << 8)
                    | (((int32) dv[2] & 255) << 16)
                    | (((int32) dv[3] & 255) << 24));

                acc = acc + d * xs * (float32) sumi
                          - dmin * xs * (float32) dmins;
                b = b + 8;
            }
        }
        if (row < limit && which == 2 && vQ6 == 0) {
            uint32 rowBytes = (uint32) blocksPerRow * 144;   // unit 61: uint32 offsets
            uint32 bpr = (uint32) blocksPerRow;
            uint32 rb = row * rowBytes;
            int32 g = (int32) (rl % 4);
            int32 sh0 = 16 * (g & 1);
            int32 sh1 = sh0 + 8;
            uint32 b = rl / 4;
            Vector<int32,8> zv = heap Vector<int32,8>(0, 0, 0, 0, 0, 0, 0, 0);
            while (b < bpr) {
                uint32 ro = rb + b * 144;
                uint32 rw = ro + (uint32) (32 * g);

                // The header — { f16 d; f16 dmin; u8 scales[12] } = 16 bytes.
                // Read by all four lanes of the block; it is 16 bytes and it
                // is in cache after the first.
                Vector<int8,16> hv = wv.vload<16>((int64) ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                // Only THIS lane's two sub-blocks are unpacked, where the
                // serial kernel unpacks all eight — and the two forms are
                // NOT interchangeable. Q4_K packs sub-blocks 0-3 and 4-7 in
                // different fields, and a lane owning `g` needs sub-blocks
                // 2g and 2g+1, so g < 2 lands entirely in the first field
                // and g >= 2 entirely in the second. Reading field `g`
                // instead of sub-block `2g` is the shape of the first
                // version of this kernel, which was wrong on every row.
                // Unit 60: scale bytes by word and runtime shift (no runtime
                // lane index — that lowered to a 16-way select chain per byte).
                Vector<int32,4> hvw = hv.asWords();
                int32 hvsA = (hvw[1] >> sh0) & 255;
                int32 hvsB = (hvw[1] >> sh1) & 255;
                int32 hvmC = (hvw[2] >> sh0) & 255;
                int32 hvmD = (hvw[2] >> sh1) & 255;
                int32 sc0 = hvsA & 63;
                int32 sc1 = hvsB & 63;
                int32 mn0 = hvmC & 63;
                int32 mn1 = hvmD & 63;
                if (g >= 2) {
                    int32 k0 = (hvw[3] >> sh0) & 255;
                    int32 k1 = (hvw[3] >> sh1) & 255;
                    sc0 = (k0 & 15) | ((hvsA >> 2) & 48);
                    sc1 = (k1 & 15) | ((hvsB >> 2) & 48);
                    mn0 = (k0 >> 4) | ((hvmC >> 2) & 48);
                    mn1 = (k1 >> 4) | ((hvmD >> 2) & 48);
                }

                Vector<uint8,32> raw = wv.vload<32>(
                    (int64) rw + 16L).asUnsigned();
                Vector<int32,8> raww = raw.asWords();
                Vector<uint8,32> lo = (raww & 252645135).asBytes().asUnsigned();
                Vector<uint8,32> hi = ((raww >> 4) & 252645135).asBytes().asUnsigned();
                uint32 xb = b * 320 + (uint32) (64 * g);
                uint32 xr = b * 320;
                Vector<int8,32> a0 = xp.vload<32>((int64) xb);
                Vector<int8,32> a1 = xp.vload<32>((int64) xb + 32L);
                Vector<int32,8> dl = lo.dotAccum(a0, zv);
                Vector<int32,8> dh = hi.dotAccum(a1, zv);
                int32 sumi = (dl[0] + dl[1] + dl[2] + dl[3]
                    + dl[4] + dl[5] + dl[6] + dl[7]) * sc0
                             + (dh[0] + dh[1] + dh[2] + dh[3]
                                 + dh[4] + dh[5] + dh[6] + dh[7]) * sc1;

                // The dmin term needs the sum of THIS LANE's activations,
                // and the packed block's precomputed sums are per 32-element
                // sub-block — which only helps a lane that owns a whole one.
                // llama.cpp does not read a precomputed sum at all: it takes
                // `dp4a(0x01010101, u)`, so any lane granularity is free.
                // Same trick here, and it drops a 32-byte load per lane per
                // block as well.
                Vector<uint8,32> ones = (lo ^ lo) | 1;
                // Unit 61: the activation sums and the two dot sums are reduced
                // FIRST and scaled as scalars — integer-exact, so bit-identical to
                // scaling the eight lanes, and 2 quarter-rate multiplies where
                // there were 16 (v_mul_lo/v_mad_u64 are 4-cycle on RDNA).
                Vector<int32,8> os0 = ones.dotAccum(a0, zv);
                Vector<int32,8> os1 = ones.dotAccum(a1, zv);
                int32 as0 = os0[0] + os0[1] + os0[2] + os0[3]
                    + os0[4] + os0[5] + os0[6] + os0[7];
                int32 as1 = os1[0] + os1[1] + os1[2] + os1[3]
                    + os1[4] + os1[5] + os1[6] + os1[7];
                int32 dmins = as0 * mn0 + as1 * mn1;

                Vector<int8,4> dv = xp.vload<4>((int64) xr + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dv[0] & 255)
                    | (((int32) dv[1] & 255) << 8)
                    | (((int32) dv[2] & 255) << 16)
                    | (((int32) dv[3] & 255) << 24));

                acc = acc + d * xs * (float32) sumi
                          - dmin * xs * (float32) dmins;
                b = b + 8;
            }
        }
        if (row < limit && which == 2 && vQ6 != 0) {
            uint32 rowBytes = (uint32) blocksPerRow * 210;   // unit 61: uint32 offsets
            uint32 bpr = (uint32) blocksPerRow;
            uint32 rb = row * rowBytes;
            int32 m = (int32) (rl % 4);
            int32 g = m / 2;               // which 128-element half
            int32 a = m - g * 2;           // which 16-lane slice of it
            uint32 b = rl / 4;  // 8 blocks in flight
            Vector<int32,4> z4 = heap Vector<int32,4>(0, 0, 0, 0);
            while (b < bpr) {
                uint32 ro = rb + b * 210;
                uint32 rqa = ro + (uint32) (64 * g + 16 * a);
                uint32 rqh = ro + (uint32) (32 * g + 16 * a);
                uint32 rs0 = ro + (uint32) (8 * g + a);
                float32 d = QuantKernel.f16AtDev(wv, (int64) ro + 208L);
                uint32 xb = b * 320;
                uint32 xa0 = xb + (uint32) (16 * (8 * g + a));
                Vector<int8,4> dvs = xp.vload<4>((int64) xr + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dvs[0] & 255)
                    | (((int32) dvs[1] & 255) << 8)
                    | (((int32) dvs[2] & 255) << 16)
                    | (((int32) dvs[3] & 255) << 24));
                Vector<int8,16> qlA = wv.vload<16>(
                    (int64) rqa);
                Vector<int8,16> qlB = wv.vload<16>(
                    (int64) rqa + 32L);
                Vector<int8,16> qh16 = wv.vload<16>(
                    (int64) rqh + 128L);
                Vector<uint8,16> qu_0 = ((qlA.asWords() & 252645135) | ((qh16.asWords() << 4) & 808464432)).asBytes().asUnsigned();
                Vector<int8,16> a_0 = xp.vload<16>((int64) xa0);
                Vector<uint8,16> on_0 = (qu_0 ^ qu_0) | 1;
                Vector<int32,4> dv_0 = qu_0.dotAccum(a_0, z4);
                Vector<int32,4> sv_0 = on_0.dotAccum(a_0, z4);
                int32 dot_0 = dv_0[0] + dv_0[1] + dv_0[2] + dv_0[3];
                int32 as_0 = sv_0[0] + sv_0[1] + sv_0[2] + sv_0[3];
                int32 sc_0 = (int32) wv[(int64) rs0 + 192L];
                acc = acc + d * xs
                    * (float32) (sc_0 * (dot_0 - 32 * as_0));
                Vector<uint8,16> qu_1 = ((qlB.asWords() & 252645135) | ((qh16.asWords() << 2) & 808464432)).asBytes().asUnsigned();
                Vector<int8,16> a_1 = xp.vload<16>((int64) xa0 + 32L);
                Vector<uint8,16> on_1 = (qu_1 ^ qu_1) | 1;
                Vector<int32,4> dv_1 = qu_1.dotAccum(a_1, z4);
                Vector<int32,4> sv_1 = on_1.dotAccum(a_1, z4);
                int32 dot_1 = dv_1[0] + dv_1[1] + dv_1[2] + dv_1[3];
                int32 as_1 = sv_1[0] + sv_1[1] + sv_1[2] + sv_1[3];
                int32 sc_1 = (int32) wv[(int64) rs0 + 194L];
                acc = acc + d * xs
                    * (float32) (sc_1 * (dot_1 - 32 * as_1));
                Vector<uint8,16> qu_2 = (((qlA.asWords() >> 4) & 252645135) | (qh16.asWords() & 808464432)).asBytes().asUnsigned();
                Vector<int8,16> a_2 = xp.vload<16>((int64) xa0 + 64L);
                Vector<uint8,16> on_2 = (qu_2 ^ qu_2) | 1;
                Vector<int32,4> dv_2 = qu_2.dotAccum(a_2, z4);
                Vector<int32,4> sv_2 = on_2.dotAccum(a_2, z4);
                int32 dot_2 = dv_2[0] + dv_2[1] + dv_2[2] + dv_2[3];
                int32 as_2 = sv_2[0] + sv_2[1] + sv_2[2] + sv_2[3];
                int32 sc_2 = (int32) wv[(int64) rs0 + 196L];
                acc = acc + d * xs
                    * (float32) (sc_2 * (dot_2 - 32 * as_2));
                Vector<uint8,16> qu_3 = (((qlB.asWords() >> 4) & 252645135) | ((qh16.asWords() >> 2) & 808464432)).asBytes().asUnsigned();
                Vector<int8,16> a_3 = xp.vload<16>((int64) xa0 + 96L);
                Vector<uint8,16> on_3 = (qu_3 ^ qu_3) | 1;
                Vector<int32,4> dv_3 = qu_3.dotAccum(a_3, z4);
                Vector<int32,4> sv_3 = on_3.dotAccum(a_3, z4);
                int32 dot_3 = dv_3[0] + dv_3[1] + dv_3[2] + dv_3[3];
                int32 as_3 = sv_3[0] + sv_3[1] + sv_3[2] + sv_3[3];
                int32 sc_3 = (int32) wv[(int64) rs0 + 198L];
                acc = acc + d * xs
                    * (float32) (sc_3 * (dot_3 - 32 * as_3));
                b = b + 8;
            }
        }
        float32 tot = Wave.reduceSumF32(acc);
        if (lane == 0 && row < limit) {
            if (which == 0) { yq[(int64) row] = tot; }
            else if (which == 1) { yk[(int64) row] = tot; }
            else { yv[(int64) row] = tot; }
        }
    }

    public static void qkvWaveMatVecLaunchNoSync(KernelBuffer<float32> yq,
            KernelBuffer<float32> yk, KernelBuffer<float32> yv,
            KernelBuffer<int8> wq, KernelBuffer<int8> wk,
            KernelBuffer<int8> wv, KernelBuffer<int8> xp, int64 rowsQ,
            int64 rowsKv, int64 cols, boolean vQ6) {
        QuantKernel.requireOffsets32(wq, "qkvWaveMatVec");
        QuantKernel.requireOffsets32(wk, "qkvWaveMatVec");
        QuantKernel.requireOffsets32(wv, "qkvWaveMatVec");
        uint32 waves = (uint32) (rowsQ + 2L * rowsKv);
        uint32 v6 = 0;
        if (vQ6) { v6 = 1; }
        KernelStream s = QuantKernel.stream();
        qkvWaveMatVecKernel.launch(s, grid: [waves], block: [32])
            (yq, yk, yv, wq, wk, wv, xp, (uint32) rowsQ, (uint32) rowsKv,
             cols / 256L, v6);
        return;
    }

    /**
     * Unit 55: the prefetch touch — one load per 64-byte line of a
     * buffer, on a second stream, so a weight that a dependent launch
     * will stream in a moment is already in the last-level cache when
     * it does. The value feeds a store nothing can take, so the load
     * survives; the store never happens.
     */
    @Kernel
    public static void touchLinesKernel(KernelBuffer<int8> w,
            KernelBuffer<int32> sink, uint32 lines, int32 needle) {
        // FEW waves, many loads each: a wave per 1024 lines (64 KB),
        // lane l walking lines l, l+32, ... — 32 independent loads in
        // flight per lane and almost no CU occupancy, so the kernel
        // that runs beside it keeps its slots. The first form gave a
        // thread a line — 73K threads that hogged the CUs for 40 us and
        // delayed the very chain it was hiding behind.
        uint32 lane = KernelThread.x();
        uint32 wave = KernelThread.globalIdX() / 32;
        uint32 l0 = wave * 1024 + lane;
        int32 acc = 0;
        uint32 k = 0;
        while (k < 32) {
            uint32 li = l0 + k * 32;
            if (li < lines) { acc = acc + (int32) w[(int64) li * 64L]; }
            k = k + 1;
        }
        // `needle` is a runtime value the sum is steered never to hit;
        // a literal folded the loads away (a 1 us prefetch of nothing).
        if (acc == needle) { sink[0L] = acc; }
    }

    static KernelBuffer<int32> pfSink;

    /** The touch on the main stream — HeadProbe's cache oracle
     *  (unit 55). Measured: a 4.7 MB weight touched then read runs the
     *  mat-vec in 19 us where an untouched one takes 27; the bytes
     *  survive an intervening 4.7 MB read (21.7) — the large last-level
     *  cache allocates on reads. In situ, serial before the o-proj:
     *  25.3 -> 17.7 us. On a SECOND stream the hardware interleaved
     *  the touch with the DRAM-heavy q|k|v instead of the idle
     *  attention chain, and the o-proj saw nothing; the ceiling of the
     *  idea is the o-proj's 7.6 us a layer. Not wired in. */
    public static void touchLinesMainNoSync(KernelBuffer<int8> w, int64 bytes) {
        if (QuantKernel.pfSink == null) {
            QuantKernel.pfSink #= heap KernelBuffer<int32>((uint64) 4);
        }
        uint32 lines = (uint32) (bytes / 64L);
        touchLinesKernel.launch(QuantKernel.stream(),
            grid: [(lines + 1023) / 1024], block: [32])
            (w, QuantKernel.pfSink, lines, 1234567);
        return;
    }

    /** Rows one wave covers in the k-quant wave/id mat-vecs: four lanes
     *  per block, so rows shorter than eight blocks share a wave
     *  (unit 47). The kernels derive the same number in-kernel. */
    /** Unit 61: the decode kernels compute their weight offsets in
     *  uint32 (a v_mad_u64_u32 pair per offset otherwise, and a two-
     *  instruction 64-bit add per load address), so a slab they read
     *  must be under 4 GB. True when `bytes` fits. */
    public static boolean offsetsFit32(int64 bytes) {
        return bytes >= 0L && bytes < 4294967296L;
    }

    /** {@link #offsetsFit32} as a precondition: refuses the launch. */
    public static void requireOffsets32(KernelBuffer<int8> slab, String who) {
        int64 n = (int64) slab.length();
        if (!QuantKernel.offsetsFit32(n)) {
            throw heap LlmException(who + ": a " + n + "-byte slab exceeds "
                + "the 4 GB the uint32 kernel offsets address");
        }
        return;
    }

    public static int64 rowsPerWave(int64 blocksPerRow) {
        int64 lpr = 4L * blocksPerRow;
        if (lpr >= 32L) { return 1L; }
        return 32L / lpr;
    }

    /** One WAVE per rowsPerWave output rows, 32 threads each — the
     *  geometry is the point, so it is not chunked and not tunable. */
    public static void q4kQ8WaveMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        QuantKernel.requireOffsets32(packed, "q4kQ8WaveMatVec");
        uint32 ur = (uint32) rows;
        int64 rpw = QuantKernel.rowsPerWave(cols / 256L);
        if (rpw == 1L) { rpw = 4L; }   // unit 60: four row slots per wave
        uint32 waves = (uint32) ((rows + rpw - 1L) / rpw);
        KernelStream s = QuantKernel.stream();
        q4kQ8WaveMatVecKernel.launch(s, grid: [waves], block: [32])
            (y, packed, xp, ur, cols / 256L, yOff, 0);
        return;
    }

    /** Unit 48: `y[yOff + row] += W[row] . x` — the accumulate form. */
    public static void q4kQ8WaveMatVecAccumLaunchNoSync(
            KernelBuffer<float32> y, KernelBuffer<int8> packed,
            KernelBuffer<int8> xp, int64 rows, int64 cols, int64 yOff) {
        uint32 ur = (uint32) rows;
        int64 rpw = QuantKernel.rowsPerWave(cols / 256L);
        if (rpw == 1L) { rpw = 4L; }   // unit 60: four row slots per wave
        uint32 waves = (uint32) ((rows + rpw - 1L) / rpw);
        KernelStream s = QuantKernel.stream();
        q4kQ8WaveMatVecKernel.launch(s, grid: [waves], block: [32])
            (y, packed, xp, ur, cols / 256L, yOff, 1);
        return;
    }

    public static void q4kQ8WaveMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        QuantKernel.q4kQ8WaveMatVecLaunchNoSync(y, packed, xp, rows, cols,
            yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }





    /**
     * Q6_K wave mat-vec, ZERO-REDUNDANCY lane mapping.
     *
     * The shipped twin gives each lane one CONTIGUOUS 16-element
     * sub-block, and Q6_K's packing punishes that: the two nibbles of a
     * `ql` byte belong to elements 64 apart and the four crumbs of a `qh`
     * byte to elements 32 apart, so a lane reading 16 contiguous elements
     * uses half of each ql byte and a quarter of each qh byte. Sixteen
     * lanes therefore request 512 bytes per superblock half for 192
     * unique ones -- 2.67x. Measured, that kernel reads 136 GiB/s where
     * our Q4_K reads 180 and llama.cpp's Q6_K reads 191.
     *
     * llama.cpp's mul_mat_vec_q6_k.comp has no such waste because its
     * thread owns four groups of four elements THIRTY-TWO APART, which is
     * exactly the stride that makes one qh byte's four crumbs and one ql
     * byte's two nibbles all belong to it. Same idea at 16 wide: a lane
     * owns {16a+j, 32+16a+j, 64+16a+j, 96+16a+j} for j = 0..15, so its
     * two ql loads are fully spent on both nibbles and its one qh load on
     * all four crumbs. 48 bytes requested, 48 unique, 64 elements
     * covered -- and the trip count drops 4x because a lane now does what
     * four lanes used to.
     */
    @Kernel
    public static void q6kQ8WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, int64 blocksPerRow, int64 yOff, uint32 accum) {
        uint32 lane = KernelThread.x();
        uint32 wave = KernelThread.globalIdX() / 32;
        // Unit 47: four lanes per block, so a row shorter than eight
        // blocks would idle the rest of the wave (a 3-block row ran
        // at 92 GB/s where 8-block rows ran 277). Short rows pack
        // rowsPerWave rows per wave in lane segments.
        //
        // Unit 58: rows of eight or more blocks take FOUR rows per
        // wave, in slots. A lane's block index and its (g, a) slice
        // are fixed by its lane number, so its 64 bytes of x are the
        // same for every row: loaded once per block trip, they serve
        // all four slots, where one row per wave reloaded them from
        // L0 per row — 2 KB of x per wave-block against 1.5 KB of
        // weights from DRAM. All the slots' loads are issued together
        // (12 weight vectors in flight per lane), and the out-of-range
        // slot rows are clamped to the last row and weighted zero, so
        // every load is unconditional.
        uint32 lpr = 4 * (uint32) blocksPerRow;
        uint32 rpw = 1;
        uint32 rl = lane;
        uint32 sub = 0;
        uint32 R = 4;
        if (lpr < 32) { rpw = 32 / lpr; sub = lane / lpr; rl = lane - sub * lpr; R = 1; }
        uint32 row0 = wave * R * rpw + sub;
        uint32 rowBytes = (uint32) blocksPerRow * 210;   // unit 61: uint32 offsets
        uint32 bpr = (uint32) blocksPerRow;
