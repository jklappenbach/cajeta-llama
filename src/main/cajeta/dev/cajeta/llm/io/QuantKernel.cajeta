                Vector<uint8,16> q3_1 = (((wB1 >> 4) & 252645135) | ((wH1 >> 2) & 808464432)).asBytes().asUnsigned();
                Vector<int32,4> dv0_1 = q0_1.dotAccum(a_0, z4);
                Vector<int32,4> dv1_1 = q1_1.dotAccum(a_1, z4);
                Vector<int32,4> dv2_1 = q2_1.dotAccum(a_2, z4);
                Vector<int32,4> dv3_1 = q3_1.dotAccum(a_3, z4);
                int32 t0_1 = dv0_1[0] + dv0_1[1] + dv0_1[2] + dv0_1[3] - 32 * as_0;
