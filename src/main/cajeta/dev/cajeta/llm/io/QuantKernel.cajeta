package dev.cajeta.llm.io;

import cajeta.xpu.Barrier;
import cajeta.xpu.BlockPadded;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Shared;
import cajeta.xpu.Wave;
import cajeta.xpu.Group;
import cajeta.xpu.GroupOp;
import cajeta.xpu.MemoryOrder;
import cajeta.lang.Cajeta;

/**
 * The packed mat-vecs as XPU kernels (threaded-forward-path plan Unit 3;
 * spec §4.1, §4.2).
 *
 * The decomposition is one work item per OUTPUT ROW. That is not a choice
 * so much as a reading of the existing loop: `Quant.q4kMatVecInto`'s row
 * loop already touches nothing but its own row's blocks and its own
 * `y[i]`, so the rows are independent by construction and the work is
 * re-homing the body, not rewriting it. Everything inside one row —
 * the header decode, the four sub-block folds, the final horizontal sum —
 * is left in the order the serial form performs it, which is what lets
 * `QuantKernelTest` demand BIT-IDENTICAL agreement rather than a
 * tolerance.
 *
 * `Quant.q4kMatVecInto` stays as the serial reference (spec §4.5). It is
 * what these are checked against, and it is the fallback when a backend
 * cannot take the kernel.
 */
public final class QuantKernel {

    // 10.12.35: ONE cached stream handle. Every launch wrapper used to
    // do `KernelStream s #= KernelStream.current()` — a heap object
    // whose backing is a hipMalloc, freed again on drop. rocprofv3
    // measured 1114 hipMalloc / 1102 hipFree per process (~400 us
    // each), 40.7 ms of it INSIDE the prefill's pack->GEMM gaps and a
    // large slice of decode's per-token budget (224 wrappers/token).
    // The stream is a singleton in this architecture; hold it once and
    // lend it out (View genre: plain return of interior state).
    static KernelStream curStream;
    public static KernelStream stream() {
        if (QuantKernel.curStream == null) {
            // Unit 55: a CREATED stream, not the default one. HIP's
            // legacy null stream synchronizes with every blocking
            // stream, so a second stream (the weight prefetch) could
            // never overlap it; two created streams are independent.
            // Host copies stay on the null stream, which HIP orders
            // against blocking streams' queued work.
            QuantKernel.curStream #= KernelStream.create();
        }
        return QuantKernel.curStream;
    }


    /**
     * The routing switch (plan 4.2.2): when false, `Linear.matvecInto`
     * takes the serial path for every format, kernel included.
     *
     * A static flag with a setter rather than an environment read, because
     * that is what this codebase already does for exactly this job
     * (`Quant.setPackingEnabled`) and because the 5.x scaling runs need to
     * flip it BETWEEN measurements in one process — alternating the arm
     * order, which a process-lifetime environment variable cannot do.
     */
    static boolean routeEnabled = true;

    public static void setRoutingEnabled(boolean on) {
        QuantKernel.routeEnabled = on;
    }

    public static boolean routingEnabled() {
        return QuantKernel.routeEnabled;
    }

    /**
     * MEASUREMENT INSTRUMENT, not a feature: when true, `matvecInto` returns
     * without computing anything, so a forward pass times EVERYTHING EXCEPT
     * the projections.
     *
     * It exists to check a number that was otherwise derived rather than
     * observed. The token split was solved from the worker-cap sweep
     * (32 workers 261.4 ms, 1 worker 1216.6) against the kernels' measured
     * 9.06x scaling — which assumes the non-mat-vec remainder is completely
     * unaffected by worker count. That assumption is plausible and untested,
     * and the whole parity plan rests on the answer, so it gets measured
     * directly too.
     *
     * The output is garbage while this is set. Any timing taken with it on
     * describes cost, never correctness.
     */
    static boolean skipMatvec = false;

    public static void setSkipMatvecForMeasurement(boolean on) {
        QuantKernel.skipMatvec = on;
    }

    public static boolean skipMatvecForMeasurement() {
        return QuantKernel.skipMatvec;
    }

    /**
     * `y[yOff + i] = W[i]·x` for one row per work item, W packed Q4_K.
     *
     * FOUR lanes, not sixteen, and that is measured rather than stylistic
     * (plan 6.3.3). Four shapes were raced on identical grids:
     *
     *   A  16-lane + `@Device` helper   0.790 ms @32   11.1 GB/s
     *   B  16-lane, helper inlined      0.782 ms       11.2   (1.00x vs A)
     *   C  4-lane, reduce per sub-block 0.228 ms       38.5   (3.46x vs A)
     *   D  4-lane, reduce per block     0.240 ms       36.6   (3.29x vs A)
     *
     * B ties A, so the `@Device` call was never the cost — it inlines. The
     * width is: inside a kernel the CPU backend vectorizes ACROSS work
     * items, and a body that already occupies 16 float lanes leaves it no
     * room. That is also why the HOST path keeps its 16-lane form, where
     * 4 lanes measured 2.19x SLOWER (11.75 ms against 25.76) — there is no
     * outer loop to widen there, so width is pure win.
     *
     * `q4kAcc`'s standing warning that reducing per sub-block cost more
     * than width saved is specific to 16-lane horizontal sums: at width 4,
     * C beats D.
     *
     * The block header decodes into NAMED LOCALS — a work item has no heap
     * for `headK4`'s `int32[8]` scratch — and the eight scales and minima
     * become two VECTORS, so the sub-block loop indexes them with a runtime
     * `sb` without any of it reaching memory.
     *
     * `Quant.q4kMatVecIntoLanes4` is this body on the host, in this order;
     * it exists to be the bit-identity oracle and nothing else.
     */
    @Kernel
    public static void q4kMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 144L;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 144L;

                // The header — { f16 d; f16 dmin; u8 scales[12] } = 16 bytes.
                Vector<int8,16> hv = packed.vload<16>(ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                int32 d0 = (int32) hv[4] & 255;
                int32 d1 = (int32) hv[5] & 255;
                int32 d2 = (int32) hv[6] & 255;
                int32 d3 = (int32) hv[7] & 255;
                int32 m0 = (int32) hv[8] & 255;
                int32 m1 = (int32) hv[9] & 255;
                int32 m2 = (int32) hv[10] & 255;
                int32 m3 = (int32) hv[11] & 255;
                int32 k0 = (int32) hv[12] & 255;
                int32 k1 = (int32) hv[13] & 255;
                int32 k2 = (int32) hv[14] & 255;
                int32 k3 = (int32) hv[15] & 255;

                int64 xb = xOff + b * 256L;
                Vector<float32,8> tv = x.vload<8>(xb) * 0.0f;
                Vector<float32,8> uv = tv;
                tv[0] = d * (float32) (d0 & 63);
                tv[1] = d * (float32) (d1 & 63);
                tv[2] = d * (float32) (d2 & 63);
                tv[3] = d * (float32) (d3 & 63);
                tv[4] = d * (float32) ((k0 & 15) | ((d0 >> 2) & 48));
                tv[5] = d * (float32) ((k1 & 15) | ((d1 >> 2) & 48));
                tv[6] = d * (float32) ((k2 & 15) | ((d2 >> 2) & 48));
                tv[7] = d * (float32) ((k3 & 15) | ((d3 >> 2) & 48));
                uv[0] = dmin * (float32) (m0 & 63);
                uv[1] = dmin * (float32) (m1 & 63);
                uv[2] = dmin * (float32) (m2 & 63);
                uv[3] = dmin * (float32) (m3 & 63);
                uv[4] = dmin * (float32) ((k0 >> 4) | ((m0 >> 2) & 48));
                uv[5] = dmin * (float32) ((k1 >> 4) | ((m1 >> 2) & 48));
                uv[6] = dmin * (float32) ((k2 >> 4) | ((m2 >> 2) & 48));
                uv[7] = dmin * (float32) ((k3 >> 4) | ((m3 >> 2) & 48));

                // Sub-block `sb` reads the 32 bytes at `16 + 32*(sb/2)` and
                // takes nibble half `sb%2` — Q5_K's layout minus the fifth
                // bit, which is why the two bodies look alike.
                int32 sb = 0;
                while (sb < 8) {
                    int64 bo = ro + 16L + 32L * (int64) (sb / 2);
                    Vector<int8,16> c0 = packed.vload<16>(bo);
                    Vector<int8,16> c1 = packed.vload<16>(bo + 16L);
                    Vector<int8,16> q0 = c0 & 15;
                    Vector<int8,16> q1 = c1 & 15;
                    if ((sb - (sb / 2) * 2) == 1) {
                        q0 = (c0 >> 4) & 15;
                        q1 = (c1 >> 4) & 15;
                    }
                    int64 xo = xb + (int64) (sb * 32);
                    Vector<int16,8> a0 = q0.widenLo();
                    Vector<int16,8> a1 = q0.widenHi();
                    Vector<int16,8> a2 = q1.widenLo();
                    Vector<int16,8> a3 = q1.widenHi();
                    Vector<float32,4> x0 = x.vload<4>(xo);
                    Vector<float32,4> x1 = x.vload<4>(xo + 4L);
                    Vector<float32,4> x2 = x.vload<4>(xo + 8L);
                    Vector<float32,4> x3 = x.vload<4>(xo + 12L);
                    Vector<float32,4> x4 = x.vload<4>(xo + 16L);
                    Vector<float32,4> x5 = x.vload<4>(xo + 20L);
                    Vector<float32,4> x6 = x.vload<4>(xo + 24L);
                    Vector<float32,4> x7 = x.vload<4>(xo + 28L);
                    Vector<float32,4> p = a0.widenLo().toF32() * x0;
                    p = p + a0.widenHi().toF32() * x1;
                    p = p + a1.widenLo().toF32() * x2;
                    p = p + a1.widenHi().toF32() * x3;
                    p = p + a2.widenLo().toF32() * x4;
                    p = p + a2.widenHi().toF32() * x5;
                    p = p + a3.widenLo().toF32() * x6;
                    p = p + a3.widenHi().toF32() * x7;
                    Vector<float32,4> sv = x0 + x1 + x2 + x3;
                    sv = sv + x4 + x5 + x6 + x7;
                    float32 qx = p[0] + p[1] + p[2] + p[3];
                    float32 sx = sv[0] + sv[1] + sv[2] + sv[3];
                    acc = acc + tv[sb] * qx - uv[sb] * sx;
                    sb = sb + 1;
                }
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    // ── Q6_K (plan 6.2.1) ───────────────────────────────────────────────
    //
    // Q6_K carries 25.6% of a Q4_K_M file by bytes (measured on
    // Meta-Llama-3.1-8B-Instruct-Q4_K_M: 74.4% Q4_K, 25.6% Q6_K, no Q5_K
    // and no Q8_0), and it is what `output.weight` and `attn_v` are stored
    // as — so it runs for every token. With Q4_K routed and Q6_K left
    // serial, Amdahl caps the end-to-end gain at about 3x however well the
    // Q4_K kernel scales. Routing it too is what makes the ~10x reachable.

    /** The f16 block scale at `off`, from a device buffer. */
    @Device
    static float32 f16AtDev(KernelBuffer<int8> raw, int64 off) {
        int32 h = ((int32) raw[off] & 255)
            | (((int32) raw[off + 1L] & 255) << 8);
        return GgufFile.halfBitsToF32(h);
    }


    /**
     * `y[yOff + i] = W[i]·x` for one row per work item, W packed Q6_K.
     *
     * Lifted from `Quant.q6kMatVecInto` with its 16-way sub-block loop
     * INTACT — unlike Q4_K, nothing here needs unrolling: the per-sub-block
     * scale is read straight out of the buffer (`packed[ro + 192 + sb]`)
     * rather than out of a decoded header, so there is no scratch array to
     * turn into registers and no runtime index into one.
     */
    @Kernel
    public static void q6kMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 210L;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 210L;
                float32 d = QuantKernel.f16AtDev(packed, ro + 208L);
                int64 xb = xOff + b * 256L;
                Vector<float32,4> accv = x.vload<4>(xb) * 0.0f;
                int32 sb = 0;
                while (sb < 16) {
                    int32 g = sb / 8;
                    int32 r0 = sb * 16 - g * 128;
                    int32 sl = r0 / 64;
                    int32 l64 = r0 - sl * 64;
                    int32 shi = r0 / 32;
                    int32 l32 = r0 - shi * 32;
                    Vector<int8,16> qlv = packed.vload<16>(
                        ro + (int64) (64 * g + l64));
                    Vector<int8,16> qhv = packed.vload<16>(
                        ro + (int64) (128 + 32 * g + l32));
                    Vector<int8,16> lo = qlv & 15;
                    if (sl == 1) { lo = (qlv >> 4) & 15; }
                    Vector<int8,16> hi = (qhv >> (2 * shi)) & 3;
                    // 0..63 biased by -32 -> -32..31, still int8; the widen
                    // below is SIGNED, which is what carries the bias up.
                    Vector<int8,16> q = (lo | (hi << 4)) - 32;
                    Vector<int16,8> w0 = q.widenLo();
                    Vector<int16,8> w1 = q.widenHi();
                    int64 xo = xb + (int64) (sb * 16);
                    // Fold the scale in BEFORE accumulating, so the block
                    // reduces once instead of once per sub-block.
                    float32 sc = d * (float32) packed[ro + (int64) (192 + sb)];
                    accv = accv + x.vload<4>(xo)
                        * (w0.widenLo().toF32() * sc);
                    accv = accv + x.vload<4>(xo + 4L)
                        * (w0.widenHi().toF32() * sc);
                    accv = accv + x.vload<4>(xo + 8L)
                        * (w1.widenLo().toF32() * sc);
                    accv = accv + x.vload<4>(xo + 12L)
                        * (w1.widenHi().toF32() * sc);
                    sb = sb + 1;
                }
                acc = acc + accv[0] + accv[1] + accv[2] + accv[3];
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    // ── Q8_0 (plan 6.2.1) ───────────────────────────────────────────────

    /**
     * `y[yOff + i] = W[i]·x` for one row per work item, W packed Q8_0.
     * `Quant.q8MatVecInto`'s body verbatim — no header to decode at all,
     * just one f16 scale per 32 elements.
     */
    @Kernel
    public static void q8MatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 34L;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 34L;
                float32 dv = QuantKernel.f16AtDev(packed, ro);
                int64 xo = xOff + b * 32L;
                Vector<int8,16> q0 = packed.vload<16>(ro + 2L);
                Vector<int8,16> q1 = packed.vload<16>(ro + 18L);
                Vector<int16,8> a0 = q0.widenLo();
                Vector<int16,8> a1 = q0.widenHi();
                Vector<int16,8> a2 = q1.widenLo();
                Vector<int16,8> a3 = q1.widenHi();
                Vector<float32,4> p = a0.widenLo().toF32() * x.vload<4>(xo);
                p = p + a0.widenHi().toF32() * x.vload<4>(xo + 4L);
                p = p + a1.widenLo().toF32() * x.vload<4>(xo + 8L);
                p = p + a1.widenHi().toF32() * x.vload<4>(xo + 12L);
                p = p + a2.widenLo().toF32() * x.vload<4>(xo + 16L);
                p = p + a2.widenHi().toF32() * x.vload<4>(xo + 20L);
                p = p + a3.widenLo().toF32() * x.vload<4>(xo + 24L);
                p = p + a3.widenHi().toF32() * x.vload<4>(xo + 28L);
                acc = acc + dv * (p[0] + p[1] + p[2] + p[3]);
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    // ── Q5_K (plan 6.2.1) ───────────────────────────────────────────────
    //
    // Q4_K's nibble structure plus a 5th bit held apart: the high bits for
    // the WHOLE super-block live in bytes 16..47, one bit per element, and
    // sub-block `sb` is bit `sb` of each.
    //
    // The sub-block loop stays a LOOP here rather than unrolling 8 ways
    // like Q4_K's. Q4_K unrolled because its per-sub-block scales came out
    // of `headK4`'s heap scratch arrays, which a work item has no room for;
    // Q5_K reads the same header, so the eight scales and eight minima are
    // built ONCE per block into two VECTORS and indexed by the running
    // `sb`. A vector lane read with a runtime index is a register
    // operation, an `int32[8]` in thread memory is not.

    /**
     * `y[yOff + i] = W[i]·x` for one row per work item, W packed Q5_K.
     */
    @Kernel
    public static void q5kMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 176L;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 176L;

                // The Q4_K header, byte for byte (see q4kMatVecKernel).
                Vector<int8,16> hv = packed.vload<16>(ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                int32 d0 = (int32) hv[4] & 255;
                int32 d1 = (int32) hv[5] & 255;
                int32 d2 = (int32) hv[6] & 255;
                int32 d3 = (int32) hv[7] & 255;
                int32 m0 = (int32) hv[8] & 255;
                int32 m1 = (int32) hv[9] & 255;
                int32 m2 = (int32) hv[10] & 255;
                int32 m3 = (int32) hv[11] & 255;
                int32 k0 = (int32) hv[12] & 255;
                int32 k1 = (int32) hv[13] & 255;
                int32 k2 = (int32) hv[14] & 255;
                int32 k3 = (int32) hv[15] & 255;

                // Eight scales and eight minima as VECTOR lanes, so the
                // sub-block loop can index them with a runtime `sb` without
                // any of it reaching memory.
                int64 xb = xOff + b * 256L;
                Vector<float32,8> tv = x.vload<8>(xb) * 0.0f;
                Vector<float32,8> uv = tv;
                tv[0] = d * (float32) (d0 & 63);
                tv[1] = d * (float32) (d1 & 63);
                tv[2] = d * (float32) (d2 & 63);
                tv[3] = d * (float32) (d3 & 63);
                tv[4] = d * (float32) ((k0 & 15) | ((d0 >> 2) & 48));
                tv[5] = d * (float32) ((k1 & 15) | ((d1 >> 2) & 48));
                tv[6] = d * (float32) ((k2 & 15) | ((d2 >> 2) & 48));
                tv[7] = d * (float32) ((k3 & 15) | ((d3 >> 2) & 48));
                uv[0] = dmin * (float32) (m0 & 63);
                uv[1] = dmin * (float32) (m1 & 63);
                uv[2] = dmin * (float32) (m2 & 63);
                uv[3] = dmin * (float32) (m3 & 63);
                uv[4] = dmin * (float32) ((k0 >> 4) | ((m0 >> 2) & 48));
                uv[5] = dmin * (float32) ((k1 >> 4) | ((m1 >> 2) & 48));
                uv[6] = dmin * (float32) ((k2 >> 4) | ((m2 >> 2) & 48));
                uv[7] = dmin * (float32) ((k3 >> 4) | ((m3 >> 2) & 48));

                Vector<int8,16> hbA = packed.vload<16>(ro + 16L);
                Vector<int8,16> hbB = packed.vload<16>(ro + 32L);
                int32 sb = 0;
                while (sb < 8) {
                    int64 bo = ro + 48L + 32L * (int64) (sb / 2);
                    Vector<int8,16> r0 = packed.vload<16>(bo);
                    Vector<int8,16> r1 = packed.vload<16>(bo + 16L);
                    Vector<int8,16> n0 = r0 & 15;
                    Vector<int8,16> n1 = r1 & 15;
                    if ((sb - (sb / 2) * 2) == 1) {
                        n0 = (r0 >> 4) & 15;
                        n1 = (r1 >> 4) & 15;
                    }
                    Vector<int8,16> q0 = n0 | (((hbA >> sb) & 1) << 4);
                    Vector<int8,16> q1 = n1 | (((hbB >> sb) & 1) << 4);
                    int64 xo = xb + (int64) (sb * 32);
                    Vector<int16,8> a0 = q0.widenLo();
                    Vector<int16,8> a1 = q0.widenHi();
                    Vector<int16,8> a2 = q1.widenLo();
                    Vector<int16,8> a3 = q1.widenHi();
                    Vector<float32,4> x0 = x.vload<4>(xo);
                    Vector<float32,4> x1 = x.vload<4>(xo + 4L);
                    Vector<float32,4> x2 = x.vload<4>(xo + 8L);
                    Vector<float32,4> x3 = x.vload<4>(xo + 12L);
                    Vector<float32,4> x4 = x.vload<4>(xo + 16L);
                    Vector<float32,4> x5 = x.vload<4>(xo + 20L);
                    Vector<float32,4> x6 = x.vload<4>(xo + 24L);
                    Vector<float32,4> x7 = x.vload<4>(xo + 28L);
                    Vector<float32,4> p = a0.widenLo().toF32() * x0;
                    p = p + a0.widenHi().toF32() * x1;
                    p = p + a1.widenLo().toF32() * x2;
                    p = p + a1.widenHi().toF32() * x3;
                    p = p + a2.widenLo().toF32() * x4;
                    p = p + a2.widenHi().toF32() * x5;
                    p = p + a3.widenLo().toF32() * x6;
                    p = p + a3.widenHi().toF32() * x7;
                    Vector<float32,4> sv = x0 + x1 + x2 + x3;
                    sv = sv + x4 + x5 + x6 + x7;
                    float32 qx = p[0] + p[1] + p[2] + p[3];
                    float32 sx = sv[0] + sv[1] + sv[2] + sv[3];
                    acc = acc + tv[sb] * qx - uv[sb] * sx;
                    sb = sb + 1;
                }
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    /** Rows per grid block. One work item is a whole row, so this is a
     *  scheduling width, not a tile size. */
    static final int32 ROWS_PER_BLOCK = 64;

    /** Work items per launch block — the divisor turning a target WORKGROUP
     *  count into a row count (see Linear.effectiveChunkRows). */
    public static int32 rowsPerBlock() { return QuantKernel.ROWS_PER_BLOCK; }

    /**
     * Launch {@link #q4kMatVecKernel} over device-resident buffers.
     *
     * The grid is `ceil(rows / 64)` blocks of 64, so a row count that does
     * not fill the last block is normal rather than exceptional — the
     * kernel's `gi < rows` guard is the only thing that handles it, and
     * `QuantKernelTest.q4kKernelCoversEveryRowWhenRowsDoNotFillTheGrid`
     * is what proves it does.
     */
    public static void q4kMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        uint32 ur = (uint32) rows;
        uint32 blk = (uint32) QuantKernel.ROWS_PER_BLOCK;
        KernelStream s = QuantKernel.stream();
        q4kMatVecKernel.launch(s, grid: [(ur + blk - 1) / blk], block: [blk])
            (y, packed, x, ur, cols / 256L, xOff, yOff);
        return;
    }

    public static void q4kMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        QuantKernel.q4kMatVecLaunchNoSync(y, packed, x, rows, cols, xOff, yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    /**
     * Q4_K weights against q8_K-QUANTIZED activations — the integer path.
     *
     * Same decomposition as `q4kMatVecKernel` (one output row per work
     * item, one reduce per 256-block) and a different inner loop: the
     * nibbles stay integers and meet int8 activations through `dotAccum`,
     * which on x86 with VNNI is `vpdpbusd` — unsigned weights x signed
     * activations, exactly this shape. Measured on the host form: 2.9x over
     * the f32 arm, with `vpdpbusd` confirmed in the disassembly rather than
     * assumed.
     *
     * THIS DOES NOT COMPUTE THE SAME THING. Quantizing the activations to
     * int8 is an approximation the f32 path does not make. It is the trade
     * llama.cpp makes by default, and it is why this is a separate kernel
     * behind a switch instead of a replacement.
     *
     * Both integer sums stay in int32 by construction: a nibble is at most
     * 15 and an activation quant at most 127, so 32 products cap at 60960,
     * and a 6-bit sub-block scale takes the block to about 3.8M — two
     * orders inside int32, which matters because cajeta TRAPS on signed
     * overflow rather than wrapping.
     */
    @Kernel
    public static void q4kQ8MatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xq,
            KernelBuffer<float32> xd, KernelBuffer<int32> xbsums,
            uint32 rows, int64 blocksPerRow, int64 yOff) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 144L;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 144L;

                // The header — { f16 d; f16 dmin; u8 scales[12] } = 16 bytes.
                Vector<int8,16> hv = packed.vload<16>(ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                int32 d0 = (int32) hv[4] & 255;
                int32 d1 = (int32) hv[5] & 255;
                int32 d2 = (int32) hv[6] & 255;
                int32 d3 = (int32) hv[7] & 255;
                int32 m0 = (int32) hv[8] & 255;
                int32 m1 = (int32) hv[9] & 255;
                int32 m2 = (int32) hv[10] & 255;
                int32 m3 = (int32) hv[11] & 255;
                int32 k0 = (int32) hv[12] & 255;
                int32 k1 = (int32) hv[13] & 255;
                int32 k2 = (int32) hv[14] & 255;
                int32 k3 = (int32) hv[15] & 255;

                // The sub-block scales and mins stay INTEGER here — the f32
                // kernel folds d and dmin in at this point, and the whole
                // gain is in not doing that until the block is finished.
                Vector<int32,8> zv = xbsums.vload<8>(0) * 0;
                Vector<int32,8> scv = zv;
                Vector<int32,8> mnv = zv;
                scv[0] = d0 & 63;
                scv[1] = d1 & 63;
                scv[2] = d2 & 63;
                scv[3] = d3 & 63;
                scv[4] = (k0 & 15) | ((d0 >> 2) & 48);
                scv[5] = (k1 & 15) | ((d1 >> 2) & 48);
                scv[6] = (k2 & 15) | ((d2 >> 2) & 48);
                scv[7] = (k3 & 15) | ((d3 >> 2) & 48);
                mnv[0] = m0 & 63;
                mnv[1] = m1 & 63;
                mnv[2] = m2 & 63;
                mnv[3] = m3 & 63;
                mnv[4] = (k0 >> 4) | ((m0 >> 2) & 48);
                mnv[5] = (k1 >> 4) | ((m1 >> 2) & 48);
                mnv[6] = (k2 >> 4) | ((m2 >> 2) & 48);
                mnv[7] = (k3 >> 4) | ((m3 >> 2) & 48);

                int64 xb = b * 256L;
                Vector<int32,8> tot = zv;
                int32 g = 0;
                while (g < 4) {
                    // Chunk g covers bytes [32g, 32g+32): LOW nibbles are
                    // sub-block 2g, HIGH nibbles are 2g+1.
                    //
                    // asUnsigned is load-bearing, not cosmetic: the nibbles
                    // are 0..15 but arrive in an int8 buffer, and dotAccum
                    // picks its tier from the ELEMENT TYPE. Signed here and
                    // it never reaches vpdpbusd at all.
                    Vector<uint8,32> raw = packed.vload<32>(
                        ro + 16L + (int64) (32 * g)).asUnsigned();
                    Vector<uint8,32> lo = raw & 15;
                    Vector<uint8,32> hi = (raw >> 4) & 15;
                    Vector<int8,32> a0 = xq.vload<32>(xb + (int64) (64 * g));
                    Vector<int8,32> a1 = xq.vload<32>(
                        xb + (int64) (64 * g + 32));
                    tot = tot + lo.dotAccum(a0, zv) * scv[2 * g];
                    tot = tot + hi.dotAccum(a1, zv) * scv[2 * g + 1];
                    g = g + 1;
                }
                int32 sumi = tot[0] + tot[1] + tot[2] + tot[3]
                           + tot[4] + tot[5] + tot[6] + tot[7];

                // The dmin term reads the precomputed group sums, so it never
                // leaves integer space either. Each 32-element sub-block
                // spans two 16-element groups.
                int32 dmins = 0;
                int32 sb = 0;
                while (sb < 8) {
                    dmins = dmins + mnv[sb]
                        * (xbsums[b * 16L + (int64) (2 * sb)]
                         + xbsums[b * 16L + (int64) (2 * sb + 1)]);
                    sb = sb + 1;
                }

                float32 xs = xd[b];
                acc = acc + d * xs * (float32) sumi
                          - dmin * xs * (float32) dmins;
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    /** {@link #q4kMatVecLaunch} for the Q4_K/q8_K integer path. */
    public static void q4kQ8MatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xq,
            KernelBuffer<float32> xd, KernelBuffer<int32> xbsums,
            int64 rows, int64 cols, int64 yOff) {
        uint32 ur = (uint32) rows;
        uint32 blk = (uint32) QuantKernel.ROWS_PER_BLOCK;
        KernelStream s = QuantKernel.stream();
        q4kQ8MatVecKernel.launch(s, grid: [(ur + blk - 1) / blk], block: [blk])
            (y, packed, xq, xd, xbsums, ur, cols / 256L, yOff);
        return;
    }

    public static void q4kQ8MatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xq,
            KernelBuffer<float32> xd, KernelBuffer<int32> xbsums,
            int64 rows, int64 cols, int64 yOff) {
        QuantKernel.q4kQ8MatVecLaunchNoSync(y, packed, xq, xd, xbsums, rows, cols, yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }


    /**
     * The integer path over ONE packed activation buffer (plan 10.1).
     *
     * Body for body the same arithmetic as {@link #q4kQ8MatVecKernel} —
     * same loads of the weight, same dotAccum tiers, same order of sums —
     * with the activation's three buffers replaced by `Quant.q8kPack`'s
     * self-contained 320-byte block. That is a TRANSFER change, not a
     * compute one: three driver calls per distinct activation become one,
     * and the results stay bit-identical because folding q8_K's group sums
     * into sub-block pairs is the same int32 addition performed earlier.
     *
     * The scalars are rebuilt from bytes here rather than read from typed
     * buffers. They are UNIFORM across the dispatch — their address does
     * not depend on the work item — so the assembly is scalar-unit work
     * beside the vector loads it accompanies.
     */
    @Kernel
    public static void q4kQ8PackedMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, int64 blocksPerRow, int64 yOff) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 144L;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 144L;

                // The header — { f16 d; f16 dmin; u8 scales[12] } = 16 bytes.
                Vector<int8,16> hv = packed.vload<16>(ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                int32 d0 = (int32) hv[4] & 255;
                int32 d1 = (int32) hv[5] & 255;
                int32 d2 = (int32) hv[6] & 255;
                int32 d3 = (int32) hv[7] & 255;
                int32 m0 = (int32) hv[8] & 255;
                int32 m1 = (int32) hv[9] & 255;
                int32 m2 = (int32) hv[10] & 255;
                int32 m3 = (int32) hv[11] & 255;
                int32 k0 = (int32) hv[12] & 255;
                int32 k1 = (int32) hv[13] & 255;
                int32 k2 = (int32) hv[14] & 255;
                int32 k3 = (int32) hv[15] & 255;

                // No int32 buffer to borrow a zero from any more, now that
                // the sums arrive as bytes — so the accumulator seed is
                // constructed rather than loaded.
                Vector<int32,8> zv = heap Vector<int32,8>(0, 0, 0, 0,
                                                          0, 0, 0, 0);
                Vector<int32,8> scv = zv;
                Vector<int32,8> mnv = zv;
                scv[0] = d0 & 63;
                scv[1] = d1 & 63;
                scv[2] = d2 & 63;
                scv[3] = d3 & 63;
                scv[4] = (k0 & 15) | ((d0 >> 2) & 48);
                scv[5] = (k1 & 15) | ((d1 >> 2) & 48);
                scv[6] = (k2 & 15) | ((d2 >> 2) & 48);
                scv[7] = (k3 & 15) | ((d3 >> 2) & 48);
                mnv[0] = m0 & 63;
                mnv[1] = m1 & 63;
                mnv[2] = m2 & 63;
                mnv[3] = m3 & 63;
                mnv[4] = (k0 >> 4) | ((m0 >> 2) & 48);
                mnv[5] = (k1 >> 4) | ((m1 >> 2) & 48);
                mnv[6] = (k2 >> 4) | ((m2 >> 2) & 48);
                mnv[7] = (k3 >> 4) | ((m3 >> 2) & 48);

                // The activation block: quants at [0,256), sums at [256,288),
                // scale bits at [288,292), stride 320.
                int64 xb = b * 320L;
                Vector<int32,8> tot = zv;
                int32 g = 0;
                while (g < 4) {
                    Vector<uint8,32> raw = packed.vload<32>(
                        ro + 16L + (int64) (32 * g)).asUnsigned();
                    Vector<uint8,32> lo = raw & 15;
                    Vector<uint8,32> hi = (raw >> 4) & 15;
                    Vector<int8,32> a0 = xp.vload<32>(xb + (int64) (64 * g));
                    Vector<int8,32> a1 = xp.vload<32>(
                        xb + (int64) (64 * g + 32));
                    tot = tot + lo.dotAccum(a0, zv) * scv[2 * g];
                    tot = tot + hi.dotAccum(a1, zv) * scv[2 * g + 1];
                    g = g + 1;
                }
                int32 sumi = tot[0] + tot[1] + tot[2] + tot[3]
                           + tot[4] + tot[5] + tot[6] + tot[7];

                // All eight sub-block sums in ONE aligned 32-byte load —
                // which is why they sit before the scale in the block.
                Vector<int8,32> sv = xp.vload<32>(xb + 256L);
                int32 dmins = 0;
                int32 sb = 0;
                while (sb < 8) {
                    int32 sbb = sb * 4;
                    // The top byte keeps its sign extension: `& 255` then
                    // `<< 24` would overflow int32 on a negative sum, and
                    // cajeta TRAPS rather than wrapping.
                    int32 ps = ((int32) sv[sbb] & 255)
                        | (((int32) sv[sbb + 1] & 255) << 8)
                        | (((int32) sv[sbb + 2] & 255) << 16)
                        | (((int32) sv[sbb + 3]) << 24);
                    dmins = dmins + mnv[sb] * ps;
                    sb = sb + 1;
                }

                // The scale is amax/127 and so never negative, which is what
                // lets the top byte be masked and shifted like the others.
                Vector<int8,16> dv = xp.vload<16>(xb + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dv[0] & 255)
                    | (((int32) dv[1] & 255) << 8)
                    | (((int32) dv[2] & 255) << 16)
                    | (((int32) dv[3] & 255) << 24));

                acc = acc + d * xs * (float32) sumi
                          - dmin * xs * (float32) dmins;
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    /**
     * BATCHED Q4_K x Q8_K: `y[rows x outDim] = X[rows x cols] . W^T`,
     * reading the weights ONCE per 32-token tile instead of once per
     * token (plan 10.12.1).
     *
     * THE LANE IS THE PROMPT TOKEN. One workgroup of 32 per output row;
     * lane `t` owns batch row `tile*32 + t`, walks the whole weight row,
     * and keeps a single scalar accumulator — so there is no cross-lane
     * reduction at the end and no LDS at all. All 32 lanes read the SAME
     * weight bytes, which is a broadcast: one cache line serves the wave.
     * Each lane reads only its own activation row.
     *
     * That is the entire point. The per-row path re-reads all 4.58 GB of
     * an 8B checkpoint for EVERY prompt token — 2.4 TB for a 512-token
     * prompt — because `forwardRows` loops rows on the outside and calls
     * a mat-VECTOR inside. Here a tile of 32 tokens shares one pass, so
     * the traffic is `ceil(rows/32)` passes: 16 for a 512-token prompt,
     * a 32x reduction.
     *
     * The output write `y[r*outDim + i]` is scattered across lanes rather
     * than coalesced, and that is deliberate: it is ONE float per lane
     * per workgroup, `rows x outDim x 4` bytes in total, against
     * gigabytes of weights. Transposing to coalesce it would buy nothing
     * and would make the host transpose back.
     */
    @Kernel
    public static void q4kQ8BatchMatMulKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, uint32 outDim, uint32 nTiles,
            int64 blocksPerRow, uint32 mode) {
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 32;
        // Consecutive workgroups take consecutive OUTPUT rows within one
        // tile, so a tile streams the weight matrix front to back.
        uint32 tile = wg / outDim;
        uint32 i32 = wg % outDim;
        uint32 r = tile * 32 + lane;
        if (tile < nTiles && r < rows) {
            int64 i = (int64) i32;
            int64 rowBytes = blocksPerRow * 144L;
            int64 xRowBytes = blocksPerRow * 320L;
            int64 xBase = (int64) r * xRowBytes;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 144L;

                Vector<int8,16> hv = packed.vload<16>(ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                int32 d0 = (int32) hv[4] & 255;
                int32 d1 = (int32) hv[5] & 255;
                int32 d2 = (int32) hv[6] & 255;
                int32 d3 = (int32) hv[7] & 255;
                int32 m0 = (int32) hv[8] & 255;
                int32 m1 = (int32) hv[9] & 255;
                int32 m2 = (int32) hv[10] & 255;
                int32 m3 = (int32) hv[11] & 255;
                int32 k0 = (int32) hv[12] & 255;
                int32 k1 = (int32) hv[13] & 255;
                int32 k2 = (int32) hv[14] & 255;
                int32 k3 = (int32) hv[15] & 255;

                Vector<int32,8> zv = heap Vector<int32,8>(0, 0, 0, 0,
                                                          0, 0, 0, 0);
                Vector<int32,8> scv = zv;
                Vector<int32,8> mnv = zv;
                // 10.12.4 PROBE (`mode` 1): keep every load and every dot,
                // drop only the per-block scale unpack — ~24 integer ops
                // that EVERY lane of the wave performs identically on the
                // same 16 bytes. If the GEMM is decode-bound this moves;
                // if it is bandwidth-bound it cannot. Garbage output when
                // set, by construction.
                if (mode == 1) {
                    scv[0] = d0 & 63;
                    mnv[0] = m0 & 63;
                } else {
                    scv[0] = d0 & 63;
                    scv[1] = d1 & 63;
                    scv[2] = d2 & 63;
                    scv[3] = d3 & 63;
                    scv[4] = (k0 & 15) | ((d0 >> 2) & 48);
                    scv[5] = (k1 & 15) | ((d1 >> 2) & 48);
                    scv[6] = (k2 & 15) | ((d2 >> 2) & 48);
                    scv[7] = (k3 & 15) | ((d3 >> 2) & 48);
                    mnv[0] = m0 & 63;
                    mnv[1] = m1 & 63;
                    mnv[2] = m2 & 63;
                    mnv[3] = m3 & 63;
                    mnv[4] = (k0 >> 4) | ((m0 >> 2) & 48);
                    mnv[5] = (k1 >> 4) | ((m1 >> 2) & 48);
                    mnv[6] = (k2 >> 4) | ((m2 >> 2) & 48);
                    mnv[7] = (k3 >> 4) | ((m3 >> 2) & 48);
                }

                int64 xb = xBase + b * 320L;
                Vector<int32,8> tot = zv;
                // 10.12.4 PROBE (`mode` 2): hoist the ACTIVATION loads
                // out of the g loop — two per block instead of eight,
                // every dot and every weight load unchanged. The weight
                // is reused across 32 tokens here, but the activation is
                // re-read once per OUTPUT ROW, and there are 4096 of
                // them; if that is the cost, this moves. Garbage output.
                Vector<int8,32> h0 = xp.vload<32>(xb);
                Vector<int8,32> h1 = xp.vload<32>(xb + 32L);
                int32 g = 0;
                while (g < 4) {
                    Vector<uint8,32> raw = packed.vload<32>(
                        ro + 16L + (int64) (32 * g)).asUnsigned();
                    // 10.12.8 PROBE (`mode` 3): skip the NIBBLE SPLIT,
                    // keeping the weight load and both dots. `mode` 1
                    // covered only the 24-op header unpack and measured
                    // 2%, which was then reported as "decode is 2%" —
                    // wrongly. This is the other half of the decode and
                    // it is the larger one: eight vector ops per block
                    // against eight dotAccum, every lane of the wave
                    // doing it identically. Garbage output.
                    Vector<uint8,32> lo = raw;
                    Vector<uint8,32> hi = raw;
                    if (mode != 3) {
                        lo = raw & 15;
                        hi = (raw >> 4) & 15;
                    }
                    Vector<int8,32> a0 = h0;
                    Vector<int8,32> a1 = h1;
                    if (mode != 2) {
                        a0 = xp.vload<32>(xb + (int64) (64 * g));
                        a1 = xp.vload<32>(xb + (int64) (64 * g + 32));
                    }
                    tot = tot + lo.dotAccum(a0, zv) * scv[2 * g];
                    tot = tot + hi.dotAccum(a1, zv) * scv[2 * g + 1];
                    g = g + 1;
                }
                int32 sumi = tot[0] + tot[1] + tot[2] + tot[3]
                           + tot[4] + tot[5] + tot[6] + tot[7];

                // 10.12.10 PROBE (`mode` 4): skip the DMINS TAIL — an
                // 8-iteration loop that assembles an int32 out of four
                // bytes with masks, shifts and ORs, ~96 scalar integer
                // ops per block against the 8 VECTOR dots that precede
                // it. Everything else, including both vloads, is kept.
                // Garbage output.
                Vector<int8,32> sv = xp.vload<32>(xb + 256L);
                int32 dmins = 0;
                // 10.12.10 PROBE (`mode` 4): skip the DMINS TAIL, an
                // 8-iteration loop assembling an int32 from four bytes
                // with masks, shifts and ORs — ~96 scalar ops per block
                // against the 8 VECTOR dots before it.
                //
                // The guard is on the WHOLE loop, not on its start index.
                // Writing `if (mode == 4) { sb = 8; }` made the trip count
                // runtime-dependent, the compiler stopped unrolling it,
                // and the BASELINE arm went 3588 -> 5583 ms. The probe
                // moved its own control — 2 s of the thing being measured.
                if (mode != 4) {
                    int32 sb = 0;
                    while (sb < 8) {
                        int32 sbb = sb * 4;
                        int32 ps = ((int32) sv[sbb] & 255)
                            | (((int32) sv[sbb + 1] & 255) << 8)
                            | (((int32) sv[sbb + 2] & 255) << 16)
                            | (((int32) sv[sbb + 3]) << 24);
                        dmins = dmins + mnv[sb] * ps;
                        sb = sb + 1;
                    }
                }

                Vector<int8,16> dv = xp.vload<16>(xb + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dv[0] & 255)
                    | (((int32) dv[1] & 255) << 8)
                    | (((int32) dv[2] & 255) << 16)
                    | (((int32) dv[3] & 255) << 24));

                acc = acc + d * xs * (float32) sumi
                          - dmin * xs * (float32) dmins;
                b = b + 1;
            }
            y[(int64) r * (int64) outDim + i] = acc;
        }
    }

    /**
     * BATCHED Q4_K, FOUR TOKENS PER LANE (plan 10.12.4).
     *
     * The one-token-per-lane form measured 3.51 s of a 7.89 s prefill,
     * 9.5x off the 0.37 s its weight traffic implies and 4% of the
     * chip's int8 peak. Bandwidth was not the problem — the tiling
     * already gave 16x reuse. The problem is that all 32 lanes decoded
     * the SAME weight block: the nibble unpack and the scale decode ran
     * 32 times over for one block, and that decode is comparable in cost
     * to the multiply it feeds.
     *
     * So each lane now carries FOUR tokens. The header decode, the
     * weight load and the nibble split happen once and are reused four
     * times, and a workgroup covers 128 tokens instead of 32 — which
     * also cuts the passes over the weight matrix from `ceil(rows/32)`
     * to `ceil(rows/128)`, 4 instead of 16 for a 512-token prompt.
     *
     * Lane `t` owns tokens `tile*128 + j*32 + t` for j in 0..3, so for
     * each j the 32 lanes take consecutive token rows.
     */
    @Kernel
    public static void q4kQ8Batch4MatMulKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, uint32 outDim, uint32 nTiles,
            int64 blocksPerRow) {
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 32;
        uint32 tile = wg / outDim;
        uint32 i32 = wg % outDim;
        if (tile < nTiles) {
            int64 i = (int64) i32;
            int64 rowBytes = blocksPerRow * 144L;
            int64 xRowBytes = blocksPerRow * 320L;
            uint32 r0 = tile * 128 + lane;
            uint32 r1 = r0 + 32;
            uint32 r2 = r0 + 64;
            uint32 r3 = r0 + 96;
            boolean l0 = r0 < rows;
            boolean l1 = r1 < rows;
            boolean l2 = r2 < rows;
            boolean l3 = r3 < rows;
            // A lane with no live token still walks the loop; clamping
            // its base to row 0 keeps every load in bounds and the
            // result is simply not stored.
            int64 x0 = 0L;
            int64 x1 = 0L;
            int64 x2 = 0L;
            int64 x3 = 0L;
            if (l0) { x0 = (int64) r0 * xRowBytes; }
            if (l1) { x1 = (int64) r1 * xRowBytes; }
            if (l2) { x2 = (int64) r2 * xRowBytes; }
            if (l3) { x3 = (int64) r3 * xRowBytes; }
            float32 acc0 = 0.0f;
            float32 acc1 = 0.0f;
            float32 acc2 = 0.0f;
            float32 acc3 = 0.0f;
            Vector<int32,8> zv = heap Vector<int32,8>(0, 0, 0, 0,
                                                      0, 0, 0, 0);
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 144L;

                // ── decoded ONCE, used four times ───────────────────────
                Vector<int8,16> hv = packed.vload<16>(ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                int32 d0 = (int32) hv[4] & 255;
                int32 d1 = (int32) hv[5] & 255;
                int32 d2 = (int32) hv[6] & 255;
                int32 d3 = (int32) hv[7] & 255;
                int32 m0 = (int32) hv[8] & 255;
                int32 m1 = (int32) hv[9] & 255;
                int32 m2 = (int32) hv[10] & 255;
                int32 m3 = (int32) hv[11] & 255;
                int32 k0 = (int32) hv[12] & 255;
                int32 k1 = (int32) hv[13] & 255;
                int32 k2 = (int32) hv[14] & 255;
                int32 k3 = (int32) hv[15] & 255;
                Vector<int32,8> scv = zv;
                Vector<int32,8> mnv = zv;
                scv[0] = d0 & 63;
                scv[1] = d1 & 63;
                scv[2] = d2 & 63;
                scv[3] = d3 & 63;
                scv[4] = (k0 & 15) | ((d0 >> 2) & 48);
                scv[5] = (k1 & 15) | ((d1 >> 2) & 48);
                scv[6] = (k2 & 15) | ((d2 >> 2) & 48);
                scv[7] = (k3 & 15) | ((d3 >> 2) & 48);
                mnv[0] = m0 & 63;
                mnv[1] = m1 & 63;
                mnv[2] = m2 & 63;
                mnv[3] = m3 & 63;
                mnv[4] = (k0 >> 4) | ((m0 >> 2) & 48);
                mnv[5] = (k1 >> 4) | ((m1 >> 2) & 48);
                mnv[6] = (k2 >> 4) | ((m2 >> 2) & 48);
                mnv[7] = (k3 >> 4) | ((m3 >> 2) & 48);

                Vector<int32,8> t0 = zv;
                Vector<int32,8> t1 = zv;
                Vector<int32,8> t2 = zv;
                Vector<int32,8> t3 = zv;
                int32 g = 0;
                while (g < 4) {
                    Vector<uint8,32> raw = packed.vload<32>(
                        ro + 16L + (int64) (32 * g)).asUnsigned();
                    Vector<uint8,32> lo = raw & 15;
                    Vector<uint8,32> hi = (raw >> 4) & 15;
                    int32 sA = scv[2 * g];
                    int32 sB = scv[2 * g + 1];
                    int64 o0 = (int64) (64 * g);
                    int64 o1 = (int64) (64 * g + 32);
                    Vector<int8,32> a0 = xp.vload<32>(x0 + b * 320L + o0);
                    Vector<int8,32> a1 = xp.vload<32>(x0 + b * 320L + o1);
                    t0 = t0 + lo.dotAccum(a0, zv) * sA
                            + hi.dotAccum(a1, zv) * sB;
                    Vector<int8,32> c0 = xp.vload<32>(x1 + b * 320L + o0);
                    Vector<int8,32> c1 = xp.vload<32>(x1 + b * 320L + o1);
                    t1 = t1 + lo.dotAccum(c0, zv) * sA
                            + hi.dotAccum(c1, zv) * sB;
                    Vector<int8,32> e0 = xp.vload<32>(x2 + b * 320L + o0);
                    Vector<int8,32> e1 = xp.vload<32>(x2 + b * 320L + o1);
                    t2 = t2 + lo.dotAccum(e0, zv) * sA
                            + hi.dotAccum(e1, zv) * sB;
                    Vector<int8,32> f0 = xp.vload<32>(x3 + b * 320L + o0);
                    Vector<int8,32> f1 = xp.vload<32>(x3 + b * 320L + o1);
                    t3 = t3 + lo.dotAccum(f0, zv) * sA
                            + hi.dotAccum(f1, zv) * sB;
                    g = g + 1;
                }

                // Token 0's block term. INLINED rather than a helper:
                // a static taking a KernelBuffer and calling `vload`
                // lowers as HOST code (CAJETA_ERROR_KERNEL_ONLY_OP), the
                // defect filed as 10.10.
                int32 sumi0 = t0[0] + t0[1] + t0[2] + t0[3]
                    + t0[4] + t0[5] + t0[6] + t0[7];
                Vector<int8,32> sv0 = xp.vload<32>(x0 + b * 320L + 256L);
                int32 dmins0 = 0;
                int32 sb0 = 0;
                while (sb0 < 8) {
                    int32 sbb0 = sb0 * 4;
                    int32 ps0 = ((int32) sv0[sbb0] & 255)
                        | (((int32) sv0[sbb0 + 1] & 255) << 8)
                        | (((int32) sv0[sbb0 + 2] & 255) << 16)
                        | (((int32) sv0[sbb0 + 3]) << 24);
                    dmins0 = dmins0 + mnv[sb0] * ps0;
                    sb0 = sb0 + 1;
                }
                Vector<int8,16> dv0 = xp.vload<16>(x0 + b * 320L + 288L);
                float32 xs0 = Cajeta.bitsToF32(((int32) dv0[0] & 255)
                    | (((int32) dv0[1] & 255) << 8)
                    | (((int32) dv0[2] & 255) << 16)
                    | (((int32) dv0[3] & 255) << 24));
                acc0 = acc0 + d * xs0 * (float32) sumi0
                    - dmin * xs0 * (float32) dmins0;
                // Token 1's block term. INLINED rather than a helper:
                // a static taking a KernelBuffer and calling `vload`
                // lowers as HOST code (CAJETA_ERROR_KERNEL_ONLY_OP), the
                // defect filed as 10.10.
                int32 sumi1 = t1[0] + t1[1] + t1[2] + t1[3]
                    + t1[4] + t1[5] + t1[6] + t1[7];
                Vector<int8,32> sv1 = xp.vload<32>(x1 + b * 320L + 256L);
                int32 dmins1 = 0;
                int32 sb1 = 0;
                while (sb1 < 8) {
                    int32 sbb1 = sb1 * 4;
                    int32 ps1 = ((int32) sv1[sbb1] & 255)
                        | (((int32) sv1[sbb1 + 1] & 255) << 8)
                        | (((int32) sv1[sbb1 + 2] & 255) << 16)
                        | (((int32) sv1[sbb1 + 3]) << 24);
                    dmins1 = dmins1 + mnv[sb1] * ps1;
                    sb1 = sb1 + 1;
                }
                Vector<int8,16> dv1 = xp.vload<16>(x1 + b * 320L + 288L);
                float32 xs1 = Cajeta.bitsToF32(((int32) dv1[0] & 255)
                    | (((int32) dv1[1] & 255) << 8)
                    | (((int32) dv1[2] & 255) << 16)
                    | (((int32) dv1[3] & 255) << 24));
                acc1 = acc1 + d * xs1 * (float32) sumi1
                    - dmin * xs1 * (float32) dmins1;
                // Token 2's block term. INLINED rather than a helper:
                // a static taking a KernelBuffer and calling `vload`
                // lowers as HOST code (CAJETA_ERROR_KERNEL_ONLY_OP), the
                // defect filed as 10.10.
                int32 sumi2 = t2[0] + t2[1] + t2[2] + t2[3]
                    + t2[4] + t2[5] + t2[6] + t2[7];
                Vector<int8,32> sv2 = xp.vload<32>(x2 + b * 320L + 256L);
                int32 dmins2 = 0;
                int32 sb2 = 0;
                while (sb2 < 8) {
                    int32 sbb2 = sb2 * 4;
                    int32 ps2 = ((int32) sv2[sbb2] & 255)
                        | (((int32) sv2[sbb2 + 1] & 255) << 8)
                        | (((int32) sv2[sbb2 + 2] & 255) << 16)
                        | (((int32) sv2[sbb2 + 3]) << 24);
                    dmins2 = dmins2 + mnv[sb2] * ps2;
                    sb2 = sb2 + 1;
                }
                Vector<int8,16> dv2 = xp.vload<16>(x2 + b * 320L + 288L);
                float32 xs2 = Cajeta.bitsToF32(((int32) dv2[0] & 255)
                    | (((int32) dv2[1] & 255) << 8)
                    | (((int32) dv2[2] & 255) << 16)
                    | (((int32) dv2[3] & 255) << 24));
                acc2 = acc2 + d * xs2 * (float32) sumi2
                    - dmin * xs2 * (float32) dmins2;
                // Token 3's block term. INLINED rather than a helper:
                // a static taking a KernelBuffer and calling `vload`
                // lowers as HOST code (CAJETA_ERROR_KERNEL_ONLY_OP), the
                // defect filed as 10.10.
                int32 sumi3 = t3[0] + t3[1] + t3[2] + t3[3]
                    + t3[4] + t3[5] + t3[6] + t3[7];
                Vector<int8,32> sv3 = xp.vload<32>(x3 + b * 320L + 256L);
                int32 dmins3 = 0;
                int32 sb3 = 0;
                while (sb3 < 8) {
                    int32 sbb3 = sb3 * 4;
                    int32 ps3 = ((int32) sv3[sbb3] & 255)
                        | (((int32) sv3[sbb3 + 1] & 255) << 8)
                        | (((int32) sv3[sbb3 + 2] & 255) << 16)
                        | (((int32) sv3[sbb3 + 3]) << 24);
                    dmins3 = dmins3 + mnv[sb3] * ps3;
                    sb3 = sb3 + 1;
                }
                Vector<int8,16> dv3 = xp.vload<16>(x3 + b * 320L + 288L);
                float32 xs3 = Cajeta.bitsToF32(((int32) dv3[0] & 255)
                    | (((int32) dv3[1] & 255) << 8)
                    | (((int32) dv3[2] & 255) << 16)
                    | (((int32) dv3[3] & 255) << 24));
                acc3 = acc3 + d * xs3 * (float32) sumi3
                    - dmin * xs3 * (float32) dmins3;
                b = b + 1;
            }
            if (l0) { y[(int64) r0 * (int64) outDim + i] = acc0; }
            if (l1) { y[(int64) r1 * (int64) outDim + i] = acc1; }
            if (l2) { y[(int64) r2 * (int64) outDim + i] = acc2; }
            if (l3) { y[(int64) r3 * (int64) outDim + i] = acc3; }
        }
    }

    public static void q4kQ8Batch4MatMulLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 outDim, int64 cols) {
        int64 nTiles = (rows + 127L) / 128L;
        KernelStream s = QuantKernel.stream();
        q4kQ8Batch4MatMulKernel.launch(s,
            grid: [(uint32) (nTiles * outDim)], block: [32])
            (y, packed, xp, (uint32) rows, (uint32) outDim,
             (uint32) nTiles, cols / 256L);
        return;
    }

    /**
     * BATCHED Q4_K, LDS-TILED — llama.cpp's `mul_mmq` shape adapted to
     * this DSL. Batch4 (above) still re-reads every token's activations
     * once per OUTPUT ROW and re-decodes each weight block once per
     * lane; at 512x4096x4096 that is ~10 GB of (L2-cached) activation
     * traffic per GEMM and a 32x-redundant nibble decode, and it is why
     * the Vulkan prefill sat at 8.0 s against llama.cpp's 0.43.
     *
     * One 256-thread workgroup owns a 64-output-row x 32-token tile.
     * Per 256-column super-block it stages, ONCE, into LDS:
     *   - the 64 weight rows' nibbles unpacked to uint8 (4 threads/row),
     *   - each row's 8 (scale, min) pairs and d/dmin (1 thread/row),
     *   - the 32 tokens' q8 quants (8 threads/token), block sums and
     *     activation scale (1 thread/token),
     * then every thread accumulates a 2-row x 4-token register tile
     * straight out of LDS with dotAccum. The weight decode happens once
     * per tile instead of once per lane; activation bytes come from
     * global once per 64 output rows instead of once per row.
     *
     * Same math as the mat-vec kernel, folded per super-block:
     *   acc(r,t) += d_r*xs_t*sum_g(sc_g*dot32) - dmin_r*xs_t*sum_g(mn_g*bsum_g)
     *
     * LDS: 16K nibbles + 8K quants + 2K sc + 2K mn + 1K bsums + 0.75K
     * scale floats = 30.3 KB.
     */
    @Kernel
    public static void q4kQ8MmqKernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<int32> xp,
            uint32 rows, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        // Dword-typed tiles: SPIR-V types an LDS tile by ELEMENT and Mesa
        // does not merge Workgroup byte accesses (384 scalar ds_read_u8 in
        // the byte-tiled form of this loop) — int32 tiles keep every LDS
        // access dword-shaped, with asWords()/asBytes() at the seams.
        // Block-padded: a wave's lanes step whole 64-dword rows, and an
        // unpadded stride puts every lane on the same LDS bank (32-way
        // replay on each tile read). Pad=1 dword per row -> 2-way worst.
        BlockPadded<int32,64,1> swq = shared int32[64 * 65];
        BlockPadded<int32,64,1> sxq = shared int32[64 * 65];
        BlockPadded<int32,8,1> ssc = shared int32[64 * 9];
        BlockPadded<int32,8,1> smn = shared int32[64 * 9];
        Shared<int32> sbs = shared int32[64 * 8];
        Shared<float32> sd = shared float32[64];
        Shared<float32> sdm = shared float32[64];
        Shared<float32> sxd = shared float32[64];
        uint32 tid = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 rowTile = wg % nRowTiles;
        uint32 tokTile = wg / nRowTiles;
        int64 rowWords = blocksPerRow * 36L;
        int64 xRowWords = blocksPerRow * 80L;

        // Staging roles (fixed per thread, applied each super-block):
        uint32 wRow = tid / 4;            // 64 rows, 4 threads each
        uint32 wG = tid % 4;              //   this thread's 32-byte quarter
        uint32 aTok = tid / 4;            // 64 tokens, 4 threads each
        uint32 aE = tid % 4;              //   this thread's 64-byte quarter
        uint32 gRow = rowTile * 64 + wRow;
        uint32 gTok = tokTile * 64 + aTok;
        // A dead row/token still stages (from row/token 0) so every
        // thread reaches both barriers; its results are never stored.
        int64 wBase = 0L;
        int64 aBase = 0L;
        if (gRow < outDim) { wBase = (int64) gRow * rowWords; }
        if (gTok < rows) { aBase = (int64) gTok * xRowWords; }

        // Compute roles: 2 consecutive rows x 4 consecutive tokens.
        uint32 lr0 = (tid % 32) * 2;
        uint32 lt0 = (tid / 32) * 8;
        int64 r0 = (int64) lr0 * 64L;
        int64 r1 = r0 + 64L;
        int64 a0o = (int64) lt0 * 64L;

        float32 acc00 = 0.0f;
        float32 acc01 = 0.0f;
        float32 acc02 = 0.0f;
        float32 acc03 = 0.0f;
        float32 acc04 = 0.0f;
        float32 acc05 = 0.0f;
        float32 acc06 = 0.0f;
        float32 acc07 = 0.0f;
        float32 acc10 = 0.0f;
        float32 acc11 = 0.0f;
        float32 acc12 = 0.0f;
        float32 acc13 = 0.0f;
        float32 acc14 = 0.0f;
        float32 acc15 = 0.0f;
        float32 acc16 = 0.0f;
        float32 acc17 = 0.0f;
        int64 b = 0;
        while (b < blocksPerRow) {
            // ── stage weights: nibbles + header, once per tile ──────
            // All dword-domain: byte-typed loads scalarize per byte under
            // SPIR-V logical addressing and repack with shifts; the same
            // nibble split is `w & 0x0F0F0F0F` on packed words.
            int64 ro = wBase + b * 36L;
            Vector<int32,8> qw = packed.vload<8>(ro + 4L + (int64) (8 * wG));
            int64 wq = (int64) wRow * 64L + (int64) (16 * wG);
            swq.vstore(wq, qw & 252645135);
            swq.vstore(wq + 8L, (qw >> 4) & 252645135);
            if (wG == 0) {
                Vector<int32,4> hw = packed.vload<4>(ro);
                int32 h0 = hw[0];
                sd[(int64) wRow] = GgufFile.halfBitsToF32(h0 & 65535);
                sdm[(int64) wRow] = GgufFile.halfBitsToF32(
                    (h0 >> 16) & 65535);
                int32 hA = hw[1];
                int32 hB = hw[2];
                int32 hC = hw[3];
                int32 d0 = hA & 255;
                int32 d1 = (hA >> 8) & 255;
                int32 d2 = (hA >> 16) & 255;
                int32 d3 = (hA >> 24) & 255;
                int32 m0 = hB & 255;
                int32 m1 = (hB >> 8) & 255;
                int32 m2 = (hB >> 16) & 255;
                int32 m3 = (hB >> 24) & 255;
                int32 k0 = hC & 255;
                int32 k1 = (hC >> 8) & 255;
                int32 k2 = (hC >> 16) & 255;
                int32 k3 = (hC >> 24) & 255;
                int64 sb = (int64) wRow * 8L;
                ssc[sb] = d0 & 63;
                ssc[sb + 1L] = d1 & 63;
                ssc[sb + 2L] = d2 & 63;
                ssc[sb + 3L] = d3 & 63;
                ssc[sb + 4L] = (k0 & 15) | ((d0 >> 2) & 48);
                ssc[sb + 5L] = (k1 & 15) | ((d1 >> 2) & 48);
                ssc[sb + 6L] = (k2 & 15) | ((d2 >> 2) & 48);
                ssc[sb + 7L] = (k3 & 15) | ((d3 >> 2) & 48);
                smn[sb] = m0 & 63;
                smn[sb + 1L] = m1 & 63;
                smn[sb + 2L] = m2 & 63;
                smn[sb + 3L] = m3 & 63;
                smn[sb + 4L] = (k0 >> 4) | ((m0 >> 2) & 48);
                smn[sb + 5L] = (k1 >> 4) | ((m1 >> 2) & 48);
                smn[sb + 6L] = (k2 >> 4) | ((m2 >> 2) & 48);
                smn[sb + 7L] = (k3 >> 4) | ((m3 >> 2) & 48);
            }
            // ── stage activations, once per tile ────────────────────
            int64 xb = aBase + b * 80L;
            int64 aq = (int64) aTok * 64L + (int64) (16 * aE);
            sxq.vstore(aq, xp.vload<8>(xb + (int64) (16 * aE)));
            sxq.vstore(aq + 8L, xp.vload<8>(xb + (int64) (16 * aE) + 8L));
            if (aE == 0) {
                sbs.vstore((int64) aTok * 8L, xp.vload<8>(xb + 64L));
                sxd[(int64) aTok] = Cajeta.bitsToF32(xp[xb + 72L]);
            }
            Barrier.workgroup();

            // ── register-tiled inner product, all reads from LDS ────
            // Scalar accumulators via dotSum's chained dp4a: the previous
            // <8 x i32> accumulator per (row, token) pair cost 64 VGPRs and
            // pinned the kernel at 256 VGPRs = 1 wave/SIMD (no spills — no
            // latency hiding either, and the phases that measure 1.8 ms
            // apart ran at 7.5 ms together).
            int32 si00 = 0;
            int32 si01 = 0;
            int32 si02 = 0;
            int32 si03 = 0;
            int32 si04 = 0;
            int32 si05 = 0;
            int32 si06 = 0;
            int32 si07 = 0;
            int32 si10 = 0;
            int32 si11 = 0;
            int32 si12 = 0;
            int32 si13 = 0;
            int32 si14 = 0;
            int32 si15 = 0;
            int32 si16 = 0;
            int32 si17 = 0;
            int64 s0 = (int64) lr0 * 8L;
            int32 g = 0;
            while (g < 8) {
                int64 go = (int64) (8 * g);
                Vector<uint8,32> w0 = swq.vload<8>(r0 + go).asBytes().asUnsigned();
                Vector<uint8,32> w1 = swq.vload<8>(r1 + go).asBytes().asUnsigned();
                Vector<int8,32> av0 = sxq.vload<8>(a0o + 0L + go).asBytes();
                Vector<int8,32> av1 = sxq.vload<8>(a0o + 64L + go).asBytes();
                Vector<int8,32> av2 = sxq.vload<8>(a0o + 128L + go).asBytes();
                Vector<int8,32> av3 = sxq.vload<8>(a0o + 192L + go).asBytes();
                Vector<int8,32> av4 = sxq.vload<8>(a0o + 256L + go).asBytes();
                Vector<int8,32> av5 = sxq.vload<8>(a0o + 320L + go).asBytes();
                Vector<int8,32> av6 = sxq.vload<8>(a0o + 384L + go).asBytes();
                Vector<int8,32> av7 = sxq.vload<8>(a0o + 448L + go).asBytes();
                int32 sc0 = ssc[s0 + (int64) g];
                int32 sc1 = ssc[s0 + 8L + (int64) g];
                si00 = si00 + w0.dotSum(av0, 0) * sc0;
                si01 = si01 + w0.dotSum(av1, 0) * sc0;
                si02 = si02 + w0.dotSum(av2, 0) * sc0;
                si03 = si03 + w0.dotSum(av3, 0) * sc0;
                si04 = si04 + w0.dotSum(av4, 0) * sc0;
                si05 = si05 + w0.dotSum(av5, 0) * sc0;
                si06 = si06 + w0.dotSum(av6, 0) * sc0;
                si07 = si07 + w0.dotSum(av7, 0) * sc0;
                si10 = si10 + w1.dotSum(av0, 0) * sc1;
                si11 = si11 + w1.dotSum(av1, 0) * sc1;
                si12 = si12 + w1.dotSum(av2, 0) * sc1;
                si13 = si13 + w1.dotSum(av3, 0) * sc1;
                si14 = si14 + w1.dotSum(av4, 0) * sc1;
                si15 = si15 + w1.dotSum(av5, 0) * sc1;
                si16 = si16 + w1.dotSum(av6, 0) * sc1;
                si17 = si17 + w1.dotSum(av7, 0) * sc1;
                g = g + 1;
            }
            // Fold the block term: sumi and the min/bsum correction.
            Vector<int32,8> mn0 = smn.vload<8>(s0);
            Vector<int32,8> mn1 = smn.vload<8>(s0 + 8L);
            float32 d0f = sd[(int64) lr0];
            float32 dm0 = sdm[(int64) lr0];
            float32 d1f = sd[(int64) lr0 + 1L];
            float32 dm1 = sdm[(int64) lr0 + 1L];
            {
                Vector<int32,8> bs = sbs.vload<8>((int64) (lt0 + 0) * 8L);
                float32 xs = sxd[(int64) (lt0 + 0)];
                Vector<int32,8> dmv0 = mn0 * bs;
                Vector<int32,8> dmv1 = mn1 * bs;
                int32 dms0 = dmv0[0] + dmv0[1] + dmv0[2] + dmv0[3]
                    + dmv0[4] + dmv0[5] + dmv0[6] + dmv0[7];
                int32 dms1 = dmv1[0] + dmv1[1] + dmv1[2] + dmv1[3]
                    + dmv1[4] + dmv1[5] + dmv1[6] + dmv1[7];
                acc00 = acc00 + d0f * xs * (float32) si00
                    - dm0 * xs * (float32) dms0;
                acc10 = acc10 + d1f * xs * (float32) si10
                    - dm1 * xs * (float32) dms1;
            }
            {
                Vector<int32,8> bs = sbs.vload<8>((int64) (lt0 + 1) * 8L);
                float32 xs = sxd[(int64) (lt0 + 1)];
                Vector<int32,8> dmv0 = mn0 * bs;
                Vector<int32,8> dmv1 = mn1 * bs;
                int32 dms0 = dmv0[0] + dmv0[1] + dmv0[2] + dmv0[3]
                    + dmv0[4] + dmv0[5] + dmv0[6] + dmv0[7];
                int32 dms1 = dmv1[0] + dmv1[1] + dmv1[2] + dmv1[3]
                    + dmv1[4] + dmv1[5] + dmv1[6] + dmv1[7];
                acc01 = acc01 + d0f * xs * (float32) si01
                    - dm0 * xs * (float32) dms0;
                acc11 = acc11 + d1f * xs * (float32) si11
                    - dm1 * xs * (float32) dms1;
            }
            {
                Vector<int32,8> bs = sbs.vload<8>((int64) (lt0 + 2) * 8L);
                float32 xs = sxd[(int64) (lt0 + 2)];
                Vector<int32,8> dmv0 = mn0 * bs;
                Vector<int32,8> dmv1 = mn1 * bs;
                int32 dms0 = dmv0[0] + dmv0[1] + dmv0[2] + dmv0[3]
                    + dmv0[4] + dmv0[5] + dmv0[6] + dmv0[7];
                int32 dms1 = dmv1[0] + dmv1[1] + dmv1[2] + dmv1[3]
                    + dmv1[4] + dmv1[5] + dmv1[6] + dmv1[7];
                acc02 = acc02 + d0f * xs * (float32) si02
                    - dm0 * xs * (float32) dms0;
                acc12 = acc12 + d1f * xs * (float32) si12
                    - dm1 * xs * (float32) dms1;
            }
            {
                Vector<int32,8> bs = sbs.vload<8>((int64) (lt0 + 3) * 8L);
                float32 xs = sxd[(int64) (lt0 + 3)];
                Vector<int32,8> dmv0 = mn0 * bs;
                Vector<int32,8> dmv1 = mn1 * bs;
                int32 dms0 = dmv0[0] + dmv0[1] + dmv0[2] + dmv0[3]
                    + dmv0[4] + dmv0[5] + dmv0[6] + dmv0[7];
                int32 dms1 = dmv1[0] + dmv1[1] + dmv1[2] + dmv1[3]
                    + dmv1[4] + dmv1[5] + dmv1[6] + dmv1[7];
                acc03 = acc03 + d0f * xs * (float32) si03
                    - dm0 * xs * (float32) dms0;
                acc13 = acc13 + d1f * xs * (float32) si13
                    - dm1 * xs * (float32) dms1;
            }
            {
                Vector<int32,8> bs = sbs.vload<8>((int64) (lt0 + 4) * 8L);
                float32 xs = sxd[(int64) (lt0 + 4)];
                Vector<int32,8> dmv0 = mn0 * bs;
                Vector<int32,8> dmv1 = mn1 * bs;
                int32 dms0 = dmv0[0] + dmv0[1] + dmv0[2] + dmv0[3]
                    + dmv0[4] + dmv0[5] + dmv0[6] + dmv0[7];
                int32 dms1 = dmv1[0] + dmv1[1] + dmv1[2] + dmv1[3]
                    + dmv1[4] + dmv1[5] + dmv1[6] + dmv1[7];
                acc04 = acc04 + d0f * xs * (float32) si04
                    - dm0 * xs * (float32) dms0;
                acc14 = acc14 + d1f * xs * (float32) si14
                    - dm1 * xs * (float32) dms1;
            }
            {
                Vector<int32,8> bs = sbs.vload<8>((int64) (lt0 + 5) * 8L);
                float32 xs = sxd[(int64) (lt0 + 5)];
                Vector<int32,8> dmv0 = mn0 * bs;
                Vector<int32,8> dmv1 = mn1 * bs;
                int32 dms0 = dmv0[0] + dmv0[1] + dmv0[2] + dmv0[3]
                    + dmv0[4] + dmv0[5] + dmv0[6] + dmv0[7];
                int32 dms1 = dmv1[0] + dmv1[1] + dmv1[2] + dmv1[3]
                    + dmv1[4] + dmv1[5] + dmv1[6] + dmv1[7];
                acc05 = acc05 + d0f * xs * (float32) si05
                    - dm0 * xs * (float32) dms0;
                acc15 = acc15 + d1f * xs * (float32) si15
                    - dm1 * xs * (float32) dms1;
            }
            {
                Vector<int32,8> bs = sbs.vload<8>((int64) (lt0 + 6) * 8L);
                float32 xs = sxd[(int64) (lt0 + 6)];
                Vector<int32,8> dmv0 = mn0 * bs;
                Vector<int32,8> dmv1 = mn1 * bs;
                int32 dms0 = dmv0[0] + dmv0[1] + dmv0[2] + dmv0[3]
                    + dmv0[4] + dmv0[5] + dmv0[6] + dmv0[7];
                int32 dms1 = dmv1[0] + dmv1[1] + dmv1[2] + dmv1[3]
                    + dmv1[4] + dmv1[5] + dmv1[6] + dmv1[7];
                acc06 = acc06 + d0f * xs * (float32) si06
                    - dm0 * xs * (float32) dms0;
                acc16 = acc16 + d1f * xs * (float32) si16
                    - dm1 * xs * (float32) dms1;
            }
            {
                Vector<int32,8> bs = sbs.vload<8>((int64) (lt0 + 7) * 8L);
                float32 xs = sxd[(int64) (lt0 + 7)];
                Vector<int32,8> dmv0 = mn0 * bs;
                Vector<int32,8> dmv1 = mn1 * bs;
                int32 dms0 = dmv0[0] + dmv0[1] + dmv0[2] + dmv0[3]
                    + dmv0[4] + dmv0[5] + dmv0[6] + dmv0[7];
                int32 dms1 = dmv1[0] + dmv1[1] + dmv1[2] + dmv1[3]
                    + dmv1[4] + dmv1[5] + dmv1[6] + dmv1[7];
                acc07 = acc07 + d0f * xs * (float32) si07
                    - dm0 * xs * (float32) dms0;
                acc17 = acc17 + d1f * xs * (float32) si17
                    - dm1 * xs * (float32) dms1;
            }
            Barrier.workgroup();
            b = b + 1;
        }

        // Guarded stores: y is token-major, y[token*outDim + row].
        uint32 oR0 = rowTile * 64 + lr0;
        uint32 oR1 = oR0 + 1;
        uint32 oT = tokTile * 64 + lt0;
        int64 od = (int64) outDim;
        if (oR0 < outDim) {
            if (oT + 0 < rows) { y[(int64) (oT + 0) * od + (int64) oR0] = acc00; }
            if (oT + 1 < rows) { y[(int64) (oT + 1) * od + (int64) oR0] = acc01; }
            if (oT + 2 < rows) { y[(int64) (oT + 2) * od + (int64) oR0] = acc02; }
            if (oT + 3 < rows) { y[(int64) (oT + 3) * od + (int64) oR0] = acc03; }
            if (oT + 4 < rows) { y[(int64) (oT + 4) * od + (int64) oR0] = acc04; }
            if (oT + 5 < rows) { y[(int64) (oT + 5) * od + (int64) oR0] = acc05; }
            if (oT + 6 < rows) { y[(int64) (oT + 6) * od + (int64) oR0] = acc06; }
            if (oT + 7 < rows) { y[(int64) (oT + 7) * od + (int64) oR0] = acc07; }
        }
        if (oR1 < outDim) {
            if (oT + 0 < rows) { y[(int64) (oT + 0) * od + (int64) oR1] = acc10; }
            if (oT + 1 < rows) { y[(int64) (oT + 1) * od + (int64) oR1] = acc11; }
            if (oT + 2 < rows) { y[(int64) (oT + 2) * od + (int64) oR1] = acc12; }
            if (oT + 3 < rows) { y[(int64) (oT + 3) * od + (int64) oR1] = acc13; }
            if (oT + 4 < rows) { y[(int64) (oT + 4) * od + (int64) oR1] = acc14; }
            if (oT + 5 < rows) { y[(int64) (oT + 5) * od + (int64) oR1] = acc15; }
            if (oT + 6 < rows) { y[(int64) (oT + 6) * od + (int64) oR1] = acc16; }
            if (oT + 7 < rows) { y[(int64) (oT + 7) * od + (int64) oR1] = acc17; }
        }
    }

    /**
     * One-time repack for the Q6_K mmq route: Q6_K blocks are 210 bytes,
     * which is NOT dword-aligned, so a word view of the raw tensor cannot
     * address block payloads. Pad each block to 212 bytes (53 dwords);
     * bytes 0..209 keep the ggml layout (ql 0..127, qh 128..191,
     * scales 192..207, d 208..209). One thread per block; scalar byte
     * copies are slow on this backend but this runs once per tensor.
     */
    @Kernel
    public static void q6kPadKernel(KernelBuffer<int8> dst,
            KernelBuffer<int8> src, uint32 nBlocks) {
        // One WAVE per block, lane l copies bytes l, l+64, l+128, 192+l
        // (the tail guard covers 192..209) — coalesced within the wave,
        // 4 iterations per lane instead of 210.
        uint32 lane = KernelThread.x();
        uint32 b = KernelThread.globalIdX() / 64;
        if (b < nBlocks) {
            int64 so = (int64) b * 210L;
            int64 dof = (int64) b * 212L;
            uint32 i = lane;
            while (i < 210) {
                dst[dof + (int64) i] = src[so + (int64) i];
                i = i + 64;
            }
        }
    }

    public static void q6kPadLaunch(KernelBuffer<int8> dst,
            KernelBuffer<int8> src, int64 nBlocks) {
        KernelStream s = QuantKernel.stream();
        q6kPadKernel.launch(s, grid: [(uint32) nBlocks], block: [64])
            (dst, src, (uint32) nBlocks);
        s.sync();
        return;
    }

    /**
     * BATCHED Q6_K, LDS-TILED — {@link #q4kQ8MmqKernel}'s twin over the
     * 212-byte PADDED layout ({@link #q6kPadKernel}). Same tile: one
     * 256-thread workgroup per 64-row x 32-token tile, one 256-column
     * super-block staged per step.
     *
     * The staging decodes values to `q - 32` SIGNED int8 directly (the
     * mat-vec kernel's `dot - 32*asum` correction disappears — the shift
     * is baked into the staged bytes), branchless in the dword domain:
     * with q in 0..63, q-32 per byte is `low5 | 0xE0` when bit5 is clear
     * and `low5` when set; the 0xE0 spread is shifts-and-ors, never a
     * multiply (int32 multiply traps on signed overflow).
     *
     * Per sub-block sb (16 values): the same ql/qh indexing as
     * q6kQ8BatchMatMulKernel, dword-wise; scales are SIGNED int8,
     * sign-extended at staging. Math per (row, token):
     *   acc += d_row * xs_tok * sum_sb sc[sb] * dot16(q-32, a)
     */
    @Kernel
    public static void q6kQ8MmqKernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<int32> xp,
            uint32 rows, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        BlockPadded<int32,64,1> swq = shared int32[64 * 65];
        BlockPadded<int32,64,1> sxq = shared int32[64 * 65];
        BlockPadded<int32,16,1> ssc = shared int32[64 * 17];
        Shared<float32> sd = shared float32[64];
        Shared<float32> sxd = shared float32[64];
        uint32 tid = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 rowTile = wg % nRowTiles;
        uint32 tokTile = wg / nRowTiles;
        int64 rowWords = blocksPerRow * 53L;
        int64 xRowWords = blocksPerRow * 80L;

        uint32 wRow = tid / 4;            // 64 rows, 4 threads each
        uint32 wG = tid % 4;              //   4 sub-blocks (64 values) each
        uint32 aTok = tid / 4;            // 64 tokens, 4 threads each
        uint32 aE = tid % 4;
        uint32 gRow = rowTile * 64 + wRow;
        uint32 gTok = tokTile * 64 + aTok;
        int64 wBase = 0L;
        int64 aBase = 0L;
        if (gRow < outDim) { wBase = (int64) gRow * rowWords; }
        if (gTok < rows) { aBase = (int64) gTok * xRowWords; }

        uint32 lr0 = (tid % 32) * 2;
        uint32 lt0 = (tid / 32) * 8;
        int64 r0 = (int64) lr0 * 64L;
        int64 r1 = r0 + 64L;
        int64 a0o = (int64) lt0 * 64L;

        float32 acc00 = 0.0f;
        float32 acc01 = 0.0f;
        float32 acc02 = 0.0f;
        float32 acc03 = 0.0f;
        float32 acc04 = 0.0f;
        float32 acc05 = 0.0f;
        float32 acc06 = 0.0f;
        float32 acc07 = 0.0f;
        float32 acc10 = 0.0f;
        float32 acc11 = 0.0f;
        float32 acc12 = 0.0f;
        float32 acc13 = 0.0f;
        float32 acc14 = 0.0f;
        float32 acc15 = 0.0f;
        float32 acc16 = 0.0f;
        float32 acc17 = 0.0f;
        int64 b = 0;
        while (b < blocksPerRow) {
            // ── stage weights: q-32 int8 + signed scales + d ────────
            int64 ro = wBase + b * 53L;
            int32 sb4 = 0;
            while (sb4 < 4) {
                int32 sb = (int32) wG * 4 + sb4;
                int32 g = sb / 8;
                int32 rr0 = sb * 16 - g * 128;
                int32 sl = rr0 / 64;
                int32 l64 = rr0 - sl * 64;
                int32 shi = rr0 / 32;
                int32 l32 = rr0 - shi * 32;
                Vector<int32,4> qlw = packed.vload<4>(
                    ro + (int64) (16 * g + l64 / 4));
                Vector<int32,4> qhw = packed.vload<4>(
                    ro + 32L + (int64) (8 * g + l32 / 4));
                Vector<int32,4> lo = qlw & 252645135;
                if (sl == 1) { lo = (qlw >> 4) & 252645135; }
                Vector<int32,4> hi = (qhw >> (2 * shi)) & 50529027;
                Vector<int32,4> q = lo | (hi << 4);
                // q - 32 per byte, branchless (see doc comment).
                Vector<int32,4> low5 = q & 522133279;
                Vector<int32,4> m = (q & 538976288) ^ 538976288;
                Vector<int32,4> qm = low5 | (m << 2) | (m << 1) | m;
                swq.vstore((int64) wRow * 64L + (int64) (sb * 4), qm);
                sb4 = sb4 + 1;
            }
            if (wG == 0) {
                // 16 signed scales (4 dwords at +48) and d (f16 at +52).
                Vector<int32,4> sw = packed.vload<4>(ro + 48L);
                int64 scb = (int64) wRow * 16L;
                int32 j = 0;
                while (j < 4) {
                    int32 w = sw[j];
                    ssc[scb + (int64) (4 * j)] = (w << 24) >> 24;
                    ssc[scb + (int64) (4 * j + 1)] = (w << 16) >> 24;
                    ssc[scb + (int64) (4 * j + 2)] = (w << 8) >> 24;
                    ssc[scb + (int64) (4 * j + 3)] = w >> 24;
                    j = j + 1;
                }
                sd[(int64) wRow] = GgufFile.halfBitsToF32(
                    packed[ro + 52L] & 65535);
            }
            // ── stage activations (same q8k layout as the Q4 twin) ──
            int64 xb = aBase + b * 80L;
            int64 aq = (int64) aTok * 64L + (int64) (16 * aE);
            sxq.vstore(aq, xp.vload<8>(xb + (int64) (16 * aE)));
            sxq.vstore(aq + 8L, xp.vload<8>(xb + (int64) (16 * aE) + 8L));
            if (aE == 0) {
                sxd[(int64) aTok] = Cajeta.bitsToF32(xp[xb + 72L]);
            }
            Barrier.workgroup();

            // ── register-tiled inner product ────────────────────────
            int32 si00 = 0;
            int32 si01 = 0;
            int32 si02 = 0;
            int32 si03 = 0;
            int32 si04 = 0;
            int32 si05 = 0;
            int32 si06 = 0;
            int32 si07 = 0;
            int32 si10 = 0;
            int32 si11 = 0;
            int32 si12 = 0;
            int32 si13 = 0;
            int32 si14 = 0;
            int32 si15 = 0;
            int32 si16 = 0;
            int32 si17 = 0;
            int64 s0 = (int64) lr0 * 16L;
            int32 g16 = 0;
            while (g16 < 16) {
                int64 go = (int64) (4 * g16);
                Vector<int8,16> w0 = swq.vload<4>(r0 + go).asBytes();
                Vector<int8,16> w1 = swq.vload<4>(r1 + go).asBytes();
                Vector<int8,16> av0 = sxq.vload<4>(a0o + 0L + go).asBytes();
                Vector<int8,16> av1 = sxq.vload<4>(a0o + 64L + go).asBytes();
                Vector<int8,16> av2 = sxq.vload<4>(a0o + 128L + go).asBytes();
                Vector<int8,16> av3 = sxq.vload<4>(a0o + 192L + go).asBytes();
                Vector<int8,16> av4 = sxq.vload<4>(a0o + 256L + go).asBytes();
                Vector<int8,16> av5 = sxq.vload<4>(a0o + 320L + go).asBytes();
                Vector<int8,16> av6 = sxq.vload<4>(a0o + 384L + go).asBytes();
                Vector<int8,16> av7 = sxq.vload<4>(a0o + 448L + go).asBytes();
                int32 sc0 = ssc[s0 + (int64) g16];
                int32 sc1 = ssc[s0 + 16L + (int64) g16];
                si00 = si00 + w0.dotSum(av0, 0) * sc0;
                si01 = si01 + w0.dotSum(av1, 0) * sc0;
                si02 = si02 + w0.dotSum(av2, 0) * sc0;
                si03 = si03 + w0.dotSum(av3, 0) * sc0;
                si04 = si04 + w0.dotSum(av4, 0) * sc0;
                si05 = si05 + w0.dotSum(av5, 0) * sc0;
                si06 = si06 + w0.dotSum(av6, 0) * sc0;
                si07 = si07 + w0.dotSum(av7, 0) * sc0;
                si10 = si10 + w1.dotSum(av0, 0) * sc1;
                si11 = si11 + w1.dotSum(av1, 0) * sc1;
                si12 = si12 + w1.dotSum(av2, 0) * sc1;
                si13 = si13 + w1.dotSum(av3, 0) * sc1;
                si14 = si14 + w1.dotSum(av4, 0) * sc1;
                si15 = si15 + w1.dotSum(av5, 0) * sc1;
                si16 = si16 + w1.dotSum(av6, 0) * sc1;
                si17 = si17 + w1.dotSum(av7, 0) * sc1;
                g16 = g16 + 1;
            }
            float32 d0f = sd[(int64) lr0];
            float32 d1f = sd[(int64) lr0 + 1L];
            {
                float32 xs = sxd[(int64) (lt0 + 0)];
                acc00 = acc00 + d0f * xs * (float32) si00;
                acc10 = acc10 + d1f * xs * (float32) si10;
            }
            {
                float32 xs = sxd[(int64) (lt0 + 1)];
                acc01 = acc01 + d0f * xs * (float32) si01;
                acc11 = acc11 + d1f * xs * (float32) si11;
            }
            {
                float32 xs = sxd[(int64) (lt0 + 2)];
                acc02 = acc02 + d0f * xs * (float32) si02;
                acc12 = acc12 + d1f * xs * (float32) si12;
            }
            {
                float32 xs = sxd[(int64) (lt0 + 3)];
                acc03 = acc03 + d0f * xs * (float32) si03;
                acc13 = acc13 + d1f * xs * (float32) si13;
            }
            {
                float32 xs = sxd[(int64) (lt0 + 4)];
                acc04 = acc04 + d0f * xs * (float32) si04;
                acc14 = acc14 + d1f * xs * (float32) si14;
            }
            {
                float32 xs = sxd[(int64) (lt0 + 5)];
                acc05 = acc05 + d0f * xs * (float32) si05;
                acc15 = acc15 + d1f * xs * (float32) si15;
            }
            {
                float32 xs = sxd[(int64) (lt0 + 6)];
                acc06 = acc06 + d0f * xs * (float32) si06;
                acc16 = acc16 + d1f * xs * (float32) si16;
            }
            {
                float32 xs = sxd[(int64) (lt0 + 7)];
                acc07 = acc07 + d0f * xs * (float32) si07;
                acc17 = acc17 + d1f * xs * (float32) si17;
            }
            Barrier.workgroup();
            b = b + 1;
        }

        uint32 oR0 = rowTile * 64 + lr0;
        uint32 oR1 = oR0 + 1;
        uint32 oT = tokTile * 64 + lt0;
        int64 od = (int64) outDim;
        if (oR0 < outDim) {
            if (oT + 0 < rows) { y[(int64) (oT + 0) * od + (int64) oR0] = acc00; }
            if (oT + 1 < rows) { y[(int64) (oT + 1) * od + (int64) oR0] = acc01; }
            if (oT + 2 < rows) { y[(int64) (oT + 2) * od + (int64) oR0] = acc02; }
            if (oT + 3 < rows) { y[(int64) (oT + 3) * od + (int64) oR0] = acc03; }
            if (oT + 4 < rows) { y[(int64) (oT + 4) * od + (int64) oR0] = acc04; }
            if (oT + 5 < rows) { y[(int64) (oT + 5) * od + (int64) oR0] = acc05; }
            if (oT + 6 < rows) { y[(int64) (oT + 6) * od + (int64) oR0] = acc06; }
            if (oT + 7 < rows) { y[(int64) (oT + 7) * od + (int64) oR0] = acc07; }
        }
        if (oR1 < outDim) {
            if (oT + 0 < rows) { y[(int64) (oT + 0) * od + (int64) oR1] = acc10; }
            if (oT + 1 < rows) { y[(int64) (oT + 1) * od + (int64) oR1] = acc11; }
            if (oT + 2 < rows) { y[(int64) (oT + 2) * od + (int64) oR1] = acc12; }
            if (oT + 3 < rows) { y[(int64) (oT + 3) * od + (int64) oR1] = acc13; }
            if (oT + 4 < rows) { y[(int64) (oT + 4) * od + (int64) oR1] = acc14; }
            if (oT + 5 < rows) { y[(int64) (oT + 5) * od + (int64) oR1] = acc15; }
            if (oT + 6 < rows) { y[(int64) (oT + 6) * od + (int64) oR1] = acc16; }
            if (oT + 7 < rows) { y[(int64) (oT + 7) * od + (int64) oR1] = acc17; }
        }
    }

    /** Q6_K mmq launch — `packed` is a word view of the PADDED (212-byte
     *  block) copy, `xp` a word view of the q8k activations. */
    public static void q6kQ8MmqLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<int32> xp,
            int64 rows, int64 outDim, int64 cols) {
        int64 nRowTiles = (outDim + 63L) / 64L;
        int64 nTokTiles = (rows + 63L) / 64L;
        KernelStream s = QuantKernel.stream();
        q6kQ8MmqKernel.launch(s,
            grid: [(uint32) (nRowTiles * nTokTiles)], block: [256])
            (y, packed, xp, (uint32) rows, (uint32) outDim,
             (uint32) nRowTiles, cols / 256L);
        return;
    }

    /** One 256-thread workgroup per (64-row, 64-token) output tile.
     *  `packed`/`xp` are WORD VIEWS ({@link KernelBuffer#wordView}) of the
     *  quant and q8k buffers — the kernel reads dwords only. The caller
     *  keeps the views alive across the launch. */
    /**
     * The f16-COOPMAT Q4_K GEMM (matrix cores; llama.cpp's mul_mm large
     * config): BM=128 weight rows x BN=128 tokens per 128-thread WG
     * (4 wave32 subgroups, one 64x64 quadrant each = 16 fragments of
     * 16x16x16 f16 mma, f32 accumulate), BK=32 k-slice per stage. Q4_K
     * dequantizes to f16 AT STAGING with scales folded; B loads
     * col-major from Shared and the accumulators store col-major
     * straight into y's [tokens x outDim] layout (both verified by
     * MmqProbe stage 5). ALL DIMS MUST BE MULTIPLES OF 128 on the token
     * axis (callers pad; every 8B weight shape already tiles). f16
     * accumulation is llama.cpp's own trade: validated by PERPLEXITY,
     * not token identity.
     */
    @Kernel
    public static void q4kF16CoopKernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        // BK64 (probe V7): two 32-slices staged per barrier pair.
        Shared<float16> sa = shared float16[128 * 72];
        Shared<float16> sb = shared float16[128 * 72];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 128;
        uint32 nTokTiles = tokens / 128;   // token-fastest (probe V5)
        uint32 tt = wg % nTokTiles;
        uint32 to = wg / nTokTiles;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 2;
        uint32 warpC = sg / 2;
        int64 rowWords = blocksPerRow * 36L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a20; a20.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a21; a21.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a22; a22.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a23; a23.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a30; a30.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a31; a31.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a32; a32.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a33; a33.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
          int32 halfSel = 0;
          while (halfSel < 2) {
            int64 kbh = kb + (int64) halfSel;
            int64 blk = kbh >> 3;
            int32 gq = (int32) (kbh & 7L);
            int64 ro = ((int64) (to * 128 + lane)) * rowWords
                + blk * 36L;
            Vector<int32,4> hw = packed.vload<4>(ro);
            int32 h0 = hw[0];
            float32 d = GgufFile.halfBitsToF32(h0 & 65535);
            float32 dmin = GgufFile.halfBitsToF32((h0 >> 16) & 65535);
            int32 hA = hw[1];
            int32 hB = hw[2];
            int32 hC = hw[3];
            int32 sRaw = 0;
            int32 mRaw = 0;
            if (gq < 4) {
                sRaw = (hA >> (8 * gq)) & 63;
                mRaw = (hB >> (8 * gq)) & 63;
            } else {
                int32 j = gq - 4;
                int32 kk = (hC >> (8 * j)) & 255;
                int32 dd = (hA >> (8 * j)) & 255;
                int32 mm = (hB >> (8 * j)) & 255;
                sRaw = (kk & 15) | ((dd >> 2) & 48);
                mRaw = (kk >> 4) | ((mm >> 2) & 48);
            }
            float32 sc = d * (float32) sRaw;
            float32 mn = dmin * (float32) mRaw;
            int32 rg = gq >> 1;
            int32 nib = (gq & 1) * 4;
            Vector<int32,8> qw = packed.vload<8>(ro + 4L
                + (int64) (rg * 8));
            int64 sBase = (int64) lane * 72L + (int64) (32 * halfSel);
            int32 e = 0;
            while (e < 8) {
                int32 w = qw[e];
                int32 bi = 0;
                while (bi < 4) {
                    int32 by = (w >> (8 * bi)) & 255;
                    int32 q = (by >> nib) & 15;
                    sa[sBase + (int64) (4 * e + bi)] = (float16)
                        (sc * (float32) q - mn);
                    bi = bi + 1;
                }
                e = e + 1;
            }
            int64 xBase = ((int64) (tt * 128 + lane)) * cols
                + kbh * 32L;
            int32 jj = 0;
            while (jj < 32) {
                sb[sBase + (int64) jj] = xh[xBase + (int64) jj];
                jj = jj + 1;
            }
            halfSel = halfSel + 1;
          }
            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 4) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 64) * 72 + ko;
                uint32 bb2 = (warpC * 64) * 72 + ko;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                CooperativeMatrix<float16,16,16,0> t2;
                CooperativeMatrix<float16,16,16,0> t3;
                t0.load(sa, ab, 0, 72);
                t1.load(sa, ab + 1152, 0, 72);
                t2.load(sa, ab + 2304, 0, 72);
                t3.load(sa, ab + 3456, 0, 72);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                CooperativeMatrix<float16,16,16,1> u2;
                CooperativeMatrix<float16,16,16,1> u3;
                u0.load(sb, bb2, 1, 72);
                u1.load(sb, bb2 + 1152, 1, 72);
                u2.load(sb, bb2 + 2304, 1, 72);
                u3.load(sb, bb2 + 3456, 1, 72);
                a00.mma(t0, u0); a01.mma(t0, u1);
                a02.mma(t0, u2); a03.mma(t0, u3);
                a10.mma(t1, u0); a11.mma(t1, u1);
                a12.mma(t1, u2); a13.mma(t1, u3);
                a20.mma(t2, u0); a21.mma(t2, u1);
                a22.mma(t2, u2); a23.mma(t2, u3);
                a30.mma(t3, u0); a31.mma(t3, u1);
                a32.mma(t3, u2); a33.mma(t3, u3);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 2L;
        }
        uint32 rb = to * 128 + warpR * 64;
        uint32 cb = tt * 128 + warpC * 64;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a02.store(y, (cb + 32) * outDim + rb, 1, outDim);
        a03.store(y, (cb + 48) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a12.store(y, (cb + 32) * outDim + rb + 16, 1, outDim);
        a13.store(y, (cb + 48) * outDim + rb + 16, 1, outDim);
        a20.store(y, cb * outDim + rb + 32, 1, outDim);
        a21.store(y, (cb + 16) * outDim + rb + 32, 1, outDim);
        a22.store(y, (cb + 32) * outDim + rb + 32, 1, outDim);
        a23.store(y, (cb + 48) * outDim + rb + 32, 1, outDim);
        a30.store(y, cb * outDim + rb + 48, 1, outDim);
        a31.store(y, (cb + 16) * outDim + rb + 48, 1, outDim);
        a32.store(y, (cb + 32) * outDim + rb + 48, 1, outDim);
        a33.store(y, (cb + 48) * outDim + rb + 48, 1, outDim);
    }

    /**
     * The token tile DOUBLED to 256 (256 threads, 8 warps of 64x64, BK64).
     * Measured 2026-08-26 by decomposing where V7's time actually went —
     * with the mma, loop, barriers and LDS store count held identical and
     * only what each staging half WRITES varied: mma ceiling 57%, A-side
     * load+dequant 27%, B-side 17%, and the dequant ALU just 7%. So the
     * lever was weight REUSE, not arithmetic: at BN=256 each slab is
     * staged and dequantized once per 256 tokens instead of once per 128,
     * halving the A side (B traffic is unchanged — every row tile still
     * reads every token). A is staged by thread PAIRS (row, k-half), B one
     * token row per thread, so all 256 threads move 96 values: no idle
     * half. Interleaved min-of-7 (a single-shot read could not see it
     * through ~10% run drift): 7.70 -> 8.16 TMAC/s at K=4096, 7.12 ->
     * 7.48 at K=14336. Needs rows % 256 == 0; the 128 kernel stays for
     * shorter batches.
     */
    @Kernel
    public static void q4kF16CoopN256Kernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        Shared<float16> sa = shared float16[128 * 72];
        Shared<float16> sb = shared float16[256 * 72];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 nTokTiles = tokens / 256;
        uint32 tt = wg % nTokTiles;
        uint32 to = wg / nTokTiles;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 2;
        uint32 warpC = sg / 2;
        uint32 aRow = lane & 127;
        uint32 aHalf = lane >> 7;
        int64 rowWords = blocksPerRow * 36L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a20; a20.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a21; a21.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a22; a22.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a23; a23.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a30; a30.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a31; a31.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a32; a32.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a33; a33.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
            int64 kbh = kb + (int64) aHalf;
            int64 blk = kbh >> 3;
            int32 gq = (int32) (kbh & 7L);
            int64 ro = ((int64) (to * 128 + aRow)) * rowWords
                + blk * 36L;
            Vector<int32,4> hw = packed.vload<4>(ro);
            int32 h0 = hw[0];
            float32 d = GgufFile.halfBitsToF32(h0 & 65535);
            float32 dmin = GgufFile.halfBitsToF32((h0 >> 16) & 65535);
            int32 hA = hw[1];
            int32 hB = hw[2];
            int32 hC = hw[3];
            int32 sRaw = 0;
            int32 mRaw = 0;
            if (gq < 4) {
                sRaw = (hA >> (8 * gq)) & 63;
                mRaw = (hB >> (8 * gq)) & 63;
            } else {
                int32 j = gq - 4;
                int32 kk = (hC >> (8 * j)) & 255;
                int32 dd = (hA >> (8 * j)) & 255;
                int32 mm = (hB >> (8 * j)) & 255;
                sRaw = (kk & 15) | ((dd >> 2) & 48);
                mRaw = (kk >> 4) | ((mm >> 2) & 48);
            }
            float32 sc = d * (float32) sRaw;
            float32 mn = dmin * (float32) mRaw;
            int32 rg = gq >> 1;
            int32 nib = (gq & 1) * 4;
            Vector<int32,8> qw = packed.vload<8>(ro + 4L
                + (int64) (rg * 8));
            int64 aBase = (int64) aRow * 72L + (int64) (32 * aHalf);
            int32 e = 0;
            while (e < 8) {
                int32 w = qw[e];
                int32 bi = 0;
                while (bi < 4) {
                    int32 q = (w >> (8 * bi + nib)) & 15;
                    sa[aBase + (int64) (4 * e + bi)] = (float16)
                        (sc * (float32) q - mn);
                    bi = bi + 1;
                }
                e = e + 1;
            }
            int32 hs2 = 0;
            while (hs2 < 2) {
                int64 sBase = (int64) lane * 72L + (int64) (32 * hs2);
                int64 xBase = ((int64) (tt * 256 + lane)) * cols
                    + (kb + (int64) hs2) * 32L;
                int32 jj = 0;
                while (jj < 32) {
                    Vector<float16,4> vv = xh.vload<4>(xBase
                        + (int64) jj);
                    sb.vstore(sBase + (int64) jj, vv);
                    jj = jj + 4;
                }
                hs2 = hs2 + 1;
            }
            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 4) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 64) * 72 + ko;
                uint32 bb2 = (warpC * 64) * 72 + ko;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                CooperativeMatrix<float16,16,16,0> t2;
                CooperativeMatrix<float16,16,16,0> t3;
                t0.load(sa, ab, 0, 72);
                t1.load(sa, ab + 1152, 0, 72);
                t2.load(sa, ab + 2304, 0, 72);
                t3.load(sa, ab + 3456, 0, 72);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                CooperativeMatrix<float16,16,16,1> u2;
                CooperativeMatrix<float16,16,16,1> u3;
                u0.load(sb, bb2, 1, 72);
                u1.load(sb, bb2 + 1152, 1, 72);
                u2.load(sb, bb2 + 2304, 1, 72);
                u3.load(sb, bb2 + 3456, 1, 72);
                a00.mma(t0, u0); a01.mma(t0, u1);
                a02.mma(t0, u2); a03.mma(t0, u3);
                a10.mma(t1, u0); a11.mma(t1, u1);
                a12.mma(t1, u2); a13.mma(t1, u3);
                a20.mma(t2, u0); a21.mma(t2, u1);
                a22.mma(t2, u2); a23.mma(t2, u3);
                a30.mma(t3, u0); a31.mma(t3, u1);
                a32.mma(t3, u2); a33.mma(t3, u3);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 2L;
        }
        uint32 rb = to * 128 + warpR * 64;
        uint32 cb = tt * 256 + warpC * 64;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a02.store(y, (cb + 32) * outDim + rb, 1, outDim);
        a03.store(y, (cb + 48) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a12.store(y, (cb + 32) * outDim + rb + 16, 1, outDim);
        a13.store(y, (cb + 48) * outDim + rb + 16, 1, outDim);
        a20.store(y, cb * outDim + rb + 32, 1, outDim);
        a21.store(y, (cb + 16) * outDim + rb + 32, 1, outDim);
        a22.store(y, (cb + 32) * outDim + rb + 32, 1, outDim);
        a23.store(y, (cb + 48) * outDim + rb + 32, 1, outDim);
        a30.store(y, cb * outDim + rb + 48, 1, outDim);
        a31.store(y, (cb + 16) * outDim + rb + 48, 1, outDim);
        a32.store(y, (cb + 32) * outDim + rb + 48, 1, outDim);
        a33.store(y, (cb + 48) * outDim + rb + 48, 1, outDim);
    }

    /**
     * The B tile SKIPS LDS: the staged activations are already f16 and
     * row-major [token][k], which is exactly the column-major fragment
     * the sb tile existed to produce — so B comes straight out of global
     * memory. Drops the whole B staging half and takes LDS from 54 KB to
     * 18 KB. Each fragment is then read by both row-half warps, so the
     * duplicate global traffic scales with K: measured min-of-7,
     * 8.44 -> 8.84 TMAC/s at K=4096 (gate/up, 47% of prefill GEMM) and
     * 8.11 -> 8.53 at 4096^2, but 7.43 -> 7.35 at K=14336, where the
     * activations are 3.5x larger. Hence the K bound in the wrapper.
     * REFUTED alongside it: the same kernel at BN=512 (V11, 512 threads,
     * 16 warps) — 5.28 TMAC/s, one workgroup per CU and a 16-wave
     * barrier.
     */
    @Kernel
    public static void q4kF16CoopN256GKernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        Shared<float16> sa = shared float16[128 * 72];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 nTokTiles = tokens / 256;
        uint32 tt = wg % nTokTiles;
        uint32 to = wg / nTokTiles;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 2;
        uint32 warpC = sg / 2;
        uint32 aRow = lane & 127;
        uint32 aHalf = lane >> 7;
        int64 rowWords = blocksPerRow * 36L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a20; a20.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a21; a21.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a22; a22.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a23; a23.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a30; a30.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a31; a31.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a32; a32.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a33; a33.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
            int64 kbh = kb + (int64) aHalf;
            int64 blk = kbh >> 3;
            int32 gq = (int32) (kbh & 7L);
            int64 ro = ((int64) (to * 128 + aRow)) * rowWords
                + blk * 36L;
            Vector<int32,4> hw = packed.vload<4>(ro);
            int32 h0 = hw[0];
            float32 d = GgufFile.halfBitsToF32(h0 & 65535);
            float32 dmin = GgufFile.halfBitsToF32((h0 >> 16) & 65535);
            int32 hA = hw[1];
            int32 hB = hw[2];
            int32 hC = hw[3];
            int32 sRaw = 0;
            int32 mRaw = 0;
            if (gq < 4) {
                sRaw = (hA >> (8 * gq)) & 63;
                mRaw = (hB >> (8 * gq)) & 63;
            } else {
                int32 j = gq - 4;
                int32 kk = (hC >> (8 * j)) & 255;
                int32 dd = (hA >> (8 * j)) & 255;
                int32 mm = (hB >> (8 * j)) & 255;
                sRaw = (kk & 15) | ((dd >> 2) & 48);
                mRaw = (kk >> 4) | ((mm >> 2) & 48);
            }
            float32 sc = d * (float32) sRaw;
            float32 mn = dmin * (float32) mRaw;
            int32 rg = gq >> 1;
            int32 nib = (gq & 1) * 4;
            Vector<int32,8> qw = packed.vload<8>(ro + 4L
                + (int64) (rg * 8));
            int64 aBase = (int64) aRow * 72L + (int64) (32 * aHalf);
            int32 e = 0;
            while (e < 8) {
                int32 w = qw[e];
                int32 bi = 0;
                while (bi < 4) {
                    int32 q = (w >> (8 * bi + nib)) & 15;
                    sa[aBase + (int64) (4 * e + bi)] = (float16)
                        (sc * (float32) q - mn);
                    bi = bi + 1;
                }
                e = e + 1;
            }
            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 4) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 64) * 72 + ko;
                uint32 bb2 = (uint32) (((int64) (tt * 256
                    + warpC * 64)) * cols + kb * 32L + (int64) ko);
                uint32 cst = (uint32) cols;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                CooperativeMatrix<float16,16,16,0> t2;
                CooperativeMatrix<float16,16,16,0> t3;
                t0.load(sa, ab, 0, 72);
                t1.load(sa, ab + 1152, 0, 72);
                t2.load(sa, ab + 2304, 0, 72);
                t3.load(sa, ab + 3456, 0, 72);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                CooperativeMatrix<float16,16,16,1> u2;
                CooperativeMatrix<float16,16,16,1> u3;
                u0.load(xh, bb2, 1, cst);
                u1.load(xh, bb2 + 16 * cst, 1, cst);
                u2.load(xh, bb2 + 32 * cst, 1, cst);
                u3.load(xh, bb2 + 48 * cst, 1, cst);
                a00.mma(t0, u0); a01.mma(t0, u1);
                a02.mma(t0, u2); a03.mma(t0, u3);
                a10.mma(t1, u0); a11.mma(t1, u1);
                a12.mma(t1, u2); a13.mma(t1, u3);
                a20.mma(t2, u0); a21.mma(t2, u1);
                a22.mma(t2, u2); a23.mma(t2, u3);
                a30.mma(t3, u0); a31.mma(t3, u1);
                a32.mma(t3, u2); a33.mma(t3, u3);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 2L;
        }
        uint32 rb = to * 128 + warpR * 64;
        uint32 cb = tt * 256 + warpC * 64;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a02.store(y, (cb + 32) * outDim + rb, 1, outDim);
        a03.store(y, (cb + 48) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a12.store(y, (cb + 32) * outDim + rb + 16, 1, outDim);
        a13.store(y, (cb + 48) * outDim + rb + 16, 1, outDim);
        a20.store(y, cb * outDim + rb + 32, 1, outDim);
        a21.store(y, (cb + 16) * outDim + rb + 32, 1, outDim);
        a22.store(y, (cb + 32) * outDim + rb + 32, 1, outDim);
        a23.store(y, (cb + 48) * outDim + rb + 32, 1, outDim);
        a30.store(y, cb * outDim + rb + 48, 1, outDim);
        a31.store(y, (cb + 16) * outDim + rb + 48, 1, outDim);
        a32.store(y, (cb + 32) * outDim + rb + 48, 1, outDim);
        a33.store(y, (cb + 48) * outDim + rb + 48, 1, outDim);
    }




    /**
     * Stage 9a — HALF THE ACCUMULATORS. The shipped kernel spills 74
     * VGPRs to scratch and the k-loop carries 68 scratch_store + 76
     * scratch_load against 64 wmma (RADV_DEBUG=asm, 2026-08-26): the
     * wall is register pressure, not staging. X1 keeps BM=128 but takes
     * BN to 128 with the same 256 threads, so each warp owns 64x32 and
     * holds EIGHT accumulators instead of sixteen — 88 VGPRs of matrix
     * state where the shipped shape needs 160 plus staging.
     */
    @Kernel
    public static void q4kF16CoopX1Kernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        Shared<float16> sa = shared float16[128 * 72];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 nTokTiles = tokens / 128;
        uint32 tt = wg % nTokTiles;
        uint32 to = wg / nTokTiles;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 2;
        uint32 warpC = sg / 2;
        uint32 aRow = lane & 127;
        uint32 aHalf = lane >> 7;
        int64 rowWords = blocksPerRow * 36L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a20; a20.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a21; a21.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a30; a30.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a31; a31.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
            int64 kbh = kb + (int64) aHalf;
            int64 blk = kbh >> 3;
            int32 gq = (int32) (kbh & 7L);
            int64 ro = ((int64) (to * 128 + aRow)) * rowWords
                + blk * 36L;
            Vector<int32,4> hw = packed.vload<4>(ro);
            int32 h0 = hw[0];
            float32 d = GgufFile.halfBitsToF32(h0 & 65535);
            float32 dmin = GgufFile.halfBitsToF32((h0 >> 16) & 65535);
            int32 hA = hw[1];
            int32 hB = hw[2];
            int32 hC = hw[3];
            int32 sRaw = 0;
            int32 mRaw = 0;
            if (gq < 4) {
                sRaw = (hA >> (8 * gq)) & 63;
                mRaw = (hB >> (8 * gq)) & 63;
            } else {
                int32 j = gq - 4;
                int32 kk = (hC >> (8 * j)) & 255;
                int32 dd = (hA >> (8 * j)) & 255;
                int32 mm = (hB >> (8 * j)) & 255;
                sRaw = (kk & 15) | ((dd >> 2) & 48);
                mRaw = (kk >> 4) | ((mm >> 2) & 48);
            }
            float32 sc = d * (float32) sRaw;
            float32 mn = dmin * (float32) mRaw;
            int32 rg = gq >> 1;
            int32 nib = (gq & 1) * 4;
            Vector<int32,8> qw = packed.vload<8>(ro + 4L
                + (int64) (rg * 8));
            int64 aBase = (int64) aRow * 72L + (int64) (32 * aHalf);
            int32 e = 0;
            while (e < 8) {
                int32 w = qw[e];
                int32 bi = 0;
                while (bi < 4) {
                    int32 q = (w >> (8 * bi + nib)) & 15;
                    sa[aBase + (int64) (4 * e + bi)] = (float16)
                        (sc * (float32) q - mn);
                    bi = bi + 1;
                }
                e = e + 1;
            }

            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 4) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 64) * 72 + ko;
                uint32 bb2 = (uint32) (((int64) (tt * 128
                    + warpC * 32)) * cols + kb * 32L + (int64) ko);
                uint32 cst = (uint32) cols;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                CooperativeMatrix<float16,16,16,0> t2;
                CooperativeMatrix<float16,16,16,0> t3;
                t0.load(sa, ab, 0, 72);
                t1.load(sa, ab + 1152, 0, 72);
                t2.load(sa, ab + 2304, 0, 72);
                t3.load(sa, ab + 3456, 0, 72);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                u0.load(xh, bb2, 1, cst);
                u1.load(xh, bb2 + 16 * cst, 1, cst);
                a00.mma(t0, u0);
                a01.mma(t0, u1);
                a10.mma(t1, u0);
                a11.mma(t1, u1);
                a20.mma(t2, u0);
                a21.mma(t2, u1);
                a30.mma(t3, u0);
                a31.mma(t3, u1);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 2L;
        }
        uint32 rb = to * 128 + warpR * 64;
        uint32 cb = tt * 128 + warpC * 32;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a20.store(y, cb * outDim + rb + 32, 1, outDim);
        a21.store(y, (cb + 16) * outDim + rb + 32, 1, outDim);
        a30.store(y, cb * outDim + rb + 48, 1, outDim);
        a31.store(y, (cb + 16) * outDim + rb + 48, 1, outDim);
    }

    /**
     * Stage 9b — X1's transpose: eight accumulators again, but as a
     * 32x64 warp tile (2 A fragments, 4 B fragments) instead of 64x32.
     * A comes from LDS and B from global, so the two are NOT symmetric
     * and which axis to shrink is a measurement, not a preference.
     */
    @Kernel
    public static void q4kF16CoopX3Kernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        Shared<float16> sa = shared float16[128 * 72];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 nTokTiles = tokens / 128;
        uint32 tt = wg % nTokTiles;
        uint32 to = wg / nTokTiles;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 4;
        uint32 warpC = sg / 4;
        uint32 aRow = lane & 127;
        uint32 aHalf = lane >> 7;
        int64 rowWords = blocksPerRow * 36L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
            int64 kbh = kb + (int64) aHalf;
            int64 blk = kbh >> 3;
            int32 gq = (int32) (kbh & 7L);
            int64 ro = ((int64) (to * 128 + aRow)) * rowWords
                + blk * 36L;
            Vector<int32,4> hw = packed.vload<4>(ro);
            int32 h0 = hw[0];
            float32 d = GgufFile.halfBitsToF32(h0 & 65535);
            float32 dmin = GgufFile.halfBitsToF32((h0 >> 16) & 65535);
            int32 hA = hw[1];
            int32 hB = hw[2];
            int32 hC = hw[3];
            int32 sRaw = 0;
            int32 mRaw = 0;
            if (gq < 4) {
                sRaw = (hA >> (8 * gq)) & 63;
                mRaw = (hB >> (8 * gq)) & 63;
            } else {
                int32 j = gq - 4;
                int32 kk = (hC >> (8 * j)) & 255;
                int32 dd = (hA >> (8 * j)) & 255;
                int32 mm = (hB >> (8 * j)) & 255;
                sRaw = (kk & 15) | ((dd >> 2) & 48);
                mRaw = (kk >> 4) | ((mm >> 2) & 48);
            }
            float32 sc = d * (float32) sRaw;
            float32 mn = dmin * (float32) mRaw;
            int32 rg = gq >> 1;
            int32 nib = (gq & 1) * 4;
            Vector<int32,8> qw = packed.vload<8>(ro + 4L
                + (int64) (rg * 8));
            int64 aBase = (int64) aRow * 72L + (int64) (32 * aHalf);
            int32 e = 0;
            while (e < 8) {
                int32 w = qw[e];
                int32 bi = 0;
                while (bi < 4) {
                    int32 q = (w >> (8 * bi + nib)) & 15;
                    sa[aBase + (int64) (4 * e + bi)] = (float16)
                        (sc * (float32) q - mn);
                    bi = bi + 1;
                }
                e = e + 1;
            }

            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 4) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 32) * 72 + ko;
                uint32 bb2 = (uint32) (((int64) (tt * 128
                    + warpC * 64)) * cols + kb * 32L + (int64) ko);
                uint32 cst = (uint32) cols;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                t0.load(sa, ab, 0, 72);
                t1.load(sa, ab + 1152, 0, 72);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                CooperativeMatrix<float16,16,16,1> u2;
                CooperativeMatrix<float16,16,16,1> u3;
                u0.load(xh, bb2, 1, cst);
                u1.load(xh, bb2 + 16 * cst, 1, cst);
                u2.load(xh, bb2 + 32 * cst, 1, cst);
                u3.load(xh, bb2 + 48 * cst, 1, cst);
                a00.mma(t0, u0);
                a01.mma(t0, u1);
                a02.mma(t0, u2);
                a03.mma(t0, u3);
                a10.mma(t1, u0);
                a11.mma(t1, u1);
                a12.mma(t1, u2);
                a13.mma(t1, u3);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 2L;
        }
        uint32 rb = to * 128 + warpR * 32;
        uint32 cb = tt * 128 + warpC * 64;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a02.store(y, (cb + 32) * outDim + rb, 1, outDim);
        a03.store(y, (cb + 48) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a12.store(y, (cb + 32) * outDim + rb + 16, 1, outDim);
        a13.store(y, (cb + 48) * outDim + rb + 16, 1, outDim);
    }

    /**
     * The Q6_K twin of {@link #q4kF16CoopKernel}: identical tile/compute
     * structure, staging swapped for the 212-byte PADDED layout the mmq
     * twin reads (53 dwords: ql 0..31, qh 32..47, 16 int8 scales 48..51,
     * d f16 at 52 — see q6kPadKernel). Each BK=32 slice is two 16-value
     * sub-blocks; d*scale folds at staging and the -32 offset applies
     * per value, so no mins correction exists anywhere.
     */
    @Kernel
    public static void q6kF16CoopKernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        // BK64 (probe V7): see the q4 twin.
        Shared<float16> sa = shared float16[128 * 72];
        Shared<float16> sb = shared float16[128 * 72];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 128;
        uint32 nTokTiles = tokens / 128;   // token-fastest (probe V5)
        uint32 tt = wg % nTokTiles;
        uint32 to = wg / nTokTiles;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 2;
        uint32 warpC = sg / 2;
        int64 rowWords = blocksPerRow * 53L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a20; a20.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a21; a21.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a22; a22.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a23; a23.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a30; a30.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a31; a31.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a32; a32.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a33; a33.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
          int32 halfSel = 0;
          while (halfSel < 2) {
            int64 kbh = kb + (int64) halfSel;
            int64 blk = kbh >> 3;
            int32 g32 = (int32) (kbh & 7L);
            int64 ro = ((int64) (to * 128 + lane)) * rowWords
                + blk * 53L;
            float32 d = GgufFile.halfBitsToF32(packed[ro + 52L] & 65535);
            int64 sBase = (int64) lane * 72L
                + (int64) (32 * halfSel);
            int32 half = 0;
            while (half < 2) {
                int32 sub = 2 * g32 + half;          // 16-value sub-block
                int32 g = sub / 8;                   // 128-half
                int32 rr0 = sub * 16 - g * 128;
                int32 sl = rr0 / 64;                 // ql nibble select
                int32 l64 = rr0 - sl * 64;
                int32 shi = rr0 / 32;                // qh crumb select
                int32 l32 = rr0 - shi * 32;
                int32 sw = packed[ro + 48L + (int64) (sub / 4)];
                int32 scRaw = (sw << (24 - 8 * (sub % 4))) >> 24;
                float32 dsc = d * (float32) scRaw;
                Vector<int32,4> qlw = packed.vload<4>(
                    ro + (int64) (16 * g + l64 / 4));
                Vector<int32,4> qhw = packed.vload<4>(
                    ro + 32L + (int64) (8 * g + l32 / 4));
                int32 e = 0;
                while (e < 4) {
                    int32 lw = qlw[e];
                    int32 hw2 = qhw[e];
                    int32 bi = 0;
                    while (bi < 4) {
                        int32 lo = (lw >> (8 * bi + 4 * sl)) & 15;
                        int32 hi2 = (hw2 >> (8 * bi + 2 * shi)) & 3;
                        int32 q = (lo | (hi2 << 4)) - 32;
                        sa[sBase + (int64) (16 * half + 4 * e + bi)] =
                            (float16) (dsc * (float32) q);
                        bi = bi + 1;
                    }
                    e = e + 1;
                }
                half = half + 1;
            }
            int64 xBase = ((int64) (tt * 128 + lane)) * cols
                + kbh * 32L;
            int32 jj = 0;
            while (jj < 32) {
                sb[sBase + (int64) jj] = xh[xBase + (int64) jj];
                jj = jj + 1;
            }
            halfSel = halfSel + 1;
          }
            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 4) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 64) * 72 + ko;
                uint32 bb2 = (warpC * 64) * 72 + ko;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                CooperativeMatrix<float16,16,16,0> t2;
                CooperativeMatrix<float16,16,16,0> t3;
                t0.load(sa, ab, 0, 72);
                t1.load(sa, ab + 1152, 0, 72);
                t2.load(sa, ab + 2304, 0, 72);
                t3.load(sa, ab + 3456, 0, 72);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                CooperativeMatrix<float16,16,16,1> u2;
                CooperativeMatrix<float16,16,16,1> u3;
                u0.load(sb, bb2, 1, 72);
                u1.load(sb, bb2 + 1152, 1, 72);
                u2.load(sb, bb2 + 2304, 1, 72);
                u3.load(sb, bb2 + 3456, 1, 72);
                a00.mma(t0, u0); a01.mma(t0, u1);
                a02.mma(t0, u2); a03.mma(t0, u3);
                a10.mma(t1, u0); a11.mma(t1, u1);
                a12.mma(t1, u2); a13.mma(t1, u3);
                a20.mma(t2, u0); a21.mma(t2, u1);
                a22.mma(t2, u2); a23.mma(t2, u3);
                a30.mma(t3, u0); a31.mma(t3, u1);
                a32.mma(t3, u2); a33.mma(t3, u3);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 2L;
        }
        uint32 rb = to * 128 + warpR * 64;
        uint32 cb = tt * 128 + warpC * 64;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a02.store(y, (cb + 32) * outDim + rb, 1, outDim);
        a03.store(y, (cb + 48) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a12.store(y, (cb + 32) * outDim + rb + 16, 1, outDim);
        a13.store(y, (cb + 48) * outDim + rb + 16, 1, outDim);
        a20.store(y, cb * outDim + rb + 32, 1, outDim);
        a21.store(y, (cb + 16) * outDim + rb + 32, 1, outDim);
        a22.store(y, (cb + 32) * outDim + rb + 32, 1, outDim);
        a23.store(y, (cb + 48) * outDim + rb + 32, 1, outDim);
        a30.store(y, cb * outDim + rb + 48, 1, outDim);
        a31.store(y, (cb + 16) * outDim + rb + 48, 1, outDim);
        a32.store(y, (cb + 32) * outDim + rb + 48, 1, outDim);
        a33.store(y, (cb + 48) * outDim + rb + 48, 1, outDim);
    }

    /**
     * The token tile DOUBLED to 256 (256 threads, 8 warps of 64x64, BK64).
     * Measured 2026-08-26 by decomposing where V7's time actually went —
     * with the mma, loop, barriers and LDS store count held identical and
     * only what each staging half WRITES varied: mma ceiling 57%, A-side
     * load+dequant 27%, B-side 17%, and the dequant ALU just 7%. So the
     * lever was weight REUSE, not arithmetic: at BN=256 each slab is
     * staged and dequantized once per 256 tokens instead of once per 128,
     * halving the A side (B traffic is unchanged — every row tile still
     * reads every token). A is staged by thread PAIRS (row, k-half), B one
     * token row per thread, so all 256 threads move 96 values: no idle
     * half. Interleaved min-of-7 (a single-shot read could not see it
     * through ~10% run drift): 7.70 -> 8.16 TMAC/s at K=4096, 7.12 ->
     * 7.48 at K=14336. Needs rows % 256 == 0; the 128 kernel stays for
     * shorter batches.
     */
    @Kernel
    public static void q6kF16CoopN256Kernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        // BK64 (probe V7): see the q4 twin.
        Shared<float16> sa = shared float16[128 * 72];
        Shared<float16> sb = shared float16[256 * 72];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 nTokTiles = tokens / 256;   // token-fastest (probe V5)
        uint32 tt = wg % nTokTiles;
        uint32 to = wg / nTokTiles;
        uint32 aRow = lane & 127;
        uint32 aHalf = lane >> 7;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 2;
        uint32 warpC = sg / 2;
        int64 rowWords = blocksPerRow * 53L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a20; a20.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a21; a21.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a22; a22.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a23; a23.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a30; a30.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a31; a31.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a32; a32.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a33; a33.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
            int64 kbh = kb + (int64) aHalf;
            int64 blk = kbh >> 3;
            int32 g32 = (int32) (kbh & 7L);
            int64 ro = ((int64) (to * 128 + aRow)) * rowWords
                + blk * 53L;
            float32 d = GgufFile.halfBitsToF32(packed[ro + 52L] & 65535);
            int64 sBase = (int64) aRow * 72L
                + (int64) (32 * aHalf);
            int32 half = 0;
            while (half < 2) {
                int32 sub = 2 * g32 + half;          // 16-value sub-block
                int32 g = sub / 8;                   // 128-half
                int32 rr0 = sub * 16 - g * 128;
                int32 sl = rr0 / 64;                 // ql nibble select
                int32 l64 = rr0 - sl * 64;
                int32 shi = rr0 / 32;                // qh crumb select
                int32 l32 = rr0 - shi * 32;
                int32 sw = packed[ro + 48L + (int64) (sub / 4)];
                int32 scRaw = (sw << (24 - 8 * (sub % 4))) >> 24;
                float32 dsc = d * (float32) scRaw;
                Vector<int32,4> qlw = packed.vload<4>(
                    ro + (int64) (16 * g + l64 / 4));
                Vector<int32,4> qhw = packed.vload<4>(
                    ro + 32L + (int64) (8 * g + l32 / 4));
                int32 e = 0;
                while (e < 4) {
                    int32 lw = qlw[e];
                    int32 hw2 = qhw[e];
                    int32 bi = 0;
                    while (bi < 4) {
                        int32 lo = (lw >> (8 * bi + 4 * sl)) & 15;
                        int32 hi2 = (hw2 >> (8 * bi + 2 * shi)) & 3;
                        int32 q = (lo | (hi2 << 4)) - 32;
                        sa[sBase + (int64) (16 * half + 4 * e + bi)] =
                            (float16) (dsc * (float32) q);
                        bi = bi + 1;
                    }
                    e = e + 1;
                }
                half = half + 1;
            }
            int32 hs2 = 0;
            while (hs2 < 2) {
                int64 bBase = (int64) lane * 72L + (int64) (32 * hs2);
                int64 xBase = ((int64) (tt * 256 + lane)) * cols
                    + (kb + (int64) hs2) * 32L;
                int32 jj = 0;
                while (jj < 32) {
                    Vector<float16,4> vv = xh.vload<4>(xBase
                        + (int64) jj);
                    sb.vstore(bBase + (int64) jj, vv);
                    jj = jj + 4;
                }
                hs2 = hs2 + 1;
            }
            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 4) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 64) * 72 + ko;
                uint32 bb2 = (warpC * 64) * 72 + ko;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                CooperativeMatrix<float16,16,16,0> t2;
                CooperativeMatrix<float16,16,16,0> t3;
                t0.load(sa, ab, 0, 72);
                t1.load(sa, ab + 1152, 0, 72);
                t2.load(sa, ab + 2304, 0, 72);
                t3.load(sa, ab + 3456, 0, 72);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                CooperativeMatrix<float16,16,16,1> u2;
                CooperativeMatrix<float16,16,16,1> u3;
                u0.load(sb, bb2, 1, 72);
                u1.load(sb, bb2 + 1152, 1, 72);
                u2.load(sb, bb2 + 2304, 1, 72);
                u3.load(sb, bb2 + 3456, 1, 72);
                a00.mma(t0, u0); a01.mma(t0, u1);
                a02.mma(t0, u2); a03.mma(t0, u3);
                a10.mma(t1, u0); a11.mma(t1, u1);
                a12.mma(t1, u2); a13.mma(t1, u3);
                a20.mma(t2, u0); a21.mma(t2, u1);
                a22.mma(t2, u2); a23.mma(t2, u3);
                a30.mma(t3, u0); a31.mma(t3, u1);
                a32.mma(t3, u2); a33.mma(t3, u3);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 2L;
        }
        uint32 rb = to * 128 + warpR * 64;
        uint32 cb = tt * 256 + warpC * 64;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a02.store(y, (cb + 32) * outDim + rb, 1, outDim);
        a03.store(y, (cb + 48) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a12.store(y, (cb + 32) * outDim + rb + 16, 1, outDim);
        a13.store(y, (cb + 48) * outDim + rb + 16, 1, outDim);
        a20.store(y, cb * outDim + rb + 32, 1, outDim);
        a21.store(y, (cb + 16) * outDim + rb + 32, 1, outDim);
        a22.store(y, (cb + 32) * outDim + rb + 32, 1, outDim);
        a23.store(y, (cb + 48) * outDim + rb + 32, 1, outDim);
        a30.store(y, cb * outDim + rb + 48, 1, outDim);
        a31.store(y, (cb + 16) * outDim + rb + 48, 1, outDim);
        a32.store(y, (cb + 32) * outDim + rb + 48, 1, outDim);
        a33.store(y, (cb + 48) * outDim + rb + 48, 1, outDim);
    }

    /**
     * The B tile SKIPS LDS: the staged activations are already f16 and
     * row-major [token][k], which is exactly the column-major fragment
     * the sb tile existed to produce — so B comes straight out of global
     * memory. Drops the whole B staging half and takes LDS from 54 KB to
     * 18 KB. Each fragment is then read by both row-half warps, so the
     * duplicate global traffic scales with K: measured min-of-7,
     * 8.44 -> 8.84 TMAC/s at K=4096 (gate/up, 47% of prefill GEMM) and
     * 8.11 -> 8.53 at 4096^2, but 7.43 -> 7.35 at K=14336, where the
     * activations are 3.5x larger. Hence the K bound in the wrapper.
     * REFUTED alongside it: the same kernel at BN=512 (V11, 512 threads,
     * 16 warps) — 5.28 TMAC/s, one workgroup per CU and a 16-wave
     * barrier.
     */
    @Kernel
    public static void q6kF16CoopN256GKernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        // BK64 (probe V7): see the q4 twin.
        Shared<float16> sa = shared float16[128 * 72];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 256;
        uint32 nTokTiles = tokens / 256;   // token-fastest (probe V5)
        uint32 tt = wg % nTokTiles;
        uint32 to = wg / nTokTiles;
        uint32 aRow = lane & 127;
        uint32 aHalf = lane >> 7;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 2;
        uint32 warpC = sg / 2;
        int64 rowWords = blocksPerRow * 53L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a20; a20.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a21; a21.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a22; a22.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a23; a23.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a30; a30.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a31; a31.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a32; a32.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a33; a33.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
            int64 kbh = kb + (int64) aHalf;
            int64 blk = kbh >> 3;
            int32 g32 = (int32) (kbh & 7L);
            int64 ro = ((int64) (to * 128 + aRow)) * rowWords
                + blk * 53L;
            float32 d = GgufFile.halfBitsToF32(packed[ro + 52L] & 65535);
            int64 sBase = (int64) aRow * 72L
                + (int64) (32 * aHalf);
            int32 half = 0;
            while (half < 2) {
                int32 sub = 2 * g32 + half;          // 16-value sub-block
                int32 g = sub / 8;                   // 128-half
                int32 rr0 = sub * 16 - g * 128;
                int32 sl = rr0 / 64;                 // ql nibble select
                int32 l64 = rr0 - sl * 64;
                int32 shi = rr0 / 32;                // qh crumb select
                int32 l32 = rr0 - shi * 32;
                int32 sw = packed[ro + 48L + (int64) (sub / 4)];
                int32 scRaw = (sw << (24 - 8 * (sub % 4))) >> 24;
                float32 dsc = d * (float32) scRaw;
                Vector<int32,4> qlw = packed.vload<4>(
                    ro + (int64) (16 * g + l64 / 4));
                Vector<int32,4> qhw = packed.vload<4>(
                    ro + 32L + (int64) (8 * g + l32 / 4));
                int32 e = 0;
                while (e < 4) {
                    int32 lw = qlw[e];
                    int32 hw2 = qhw[e];
                    int32 bi = 0;
                    while (bi < 4) {
                        int32 lo = (lw >> (8 * bi + 4 * sl)) & 15;
                        int32 hi2 = (hw2 >> (8 * bi + 2 * shi)) & 3;
                        int32 q = (lo | (hi2 << 4)) - 32;
                        sa[sBase + (int64) (16 * half + 4 * e + bi)] =
                            (float16) (dsc * (float32) q);
                        bi = bi + 1;
                    }
                    e = e + 1;
                }
                half = half + 1;
            }
            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 4) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 64) * 72 + ko;
                uint32 bb2 = (uint32) (((int64) (tt * 256
                    + warpC * 64)) * cols + kb * 32L + (int64) ko);
                uint32 cst = (uint32) cols;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                CooperativeMatrix<float16,16,16,0> t2;
                CooperativeMatrix<float16,16,16,0> t3;
                t0.load(sa, ab, 0, 72);
                t1.load(sa, ab + 1152, 0, 72);
                t2.load(sa, ab + 2304, 0, 72);
                t3.load(sa, ab + 3456, 0, 72);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                CooperativeMatrix<float16,16,16,1> u2;
                CooperativeMatrix<float16,16,16,1> u3;
                u0.load(xh, bb2, 1, cst);
                u1.load(xh, bb2 + 16 * cst, 1, cst);
                u2.load(xh, bb2 + 32 * cst, 1, cst);
                u3.load(xh, bb2 + 48 * cst, 1, cst);
                a00.mma(t0, u0); a01.mma(t0, u1);
                a02.mma(t0, u2); a03.mma(t0, u3);
                a10.mma(t1, u0); a11.mma(t1, u1);
                a12.mma(t1, u2); a13.mma(t1, u3);
                a20.mma(t2, u0); a21.mma(t2, u1);
                a22.mma(t2, u2); a23.mma(t2, u3);
                a30.mma(t3, u0); a31.mma(t3, u1);
                a32.mma(t3, u2); a33.mma(t3, u3);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 2L;
        }
        uint32 rb = to * 128 + warpR * 64;
        uint32 cb = tt * 256 + warpC * 64;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a02.store(y, (cb + 32) * outDim + rb, 1, outDim);
        a03.store(y, (cb + 48) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
        a12.store(y, (cb + 32) * outDim + rb + 16, 1, outDim);
        a13.store(y, (cb + 48) * outDim + rb + 16, 1, outDim);
        a20.store(y, cb * outDim + rb + 32, 1, outDim);
        a21.store(y, (cb + 16) * outDim + rb + 32, 1, outDim);
        a22.store(y, (cb + 32) * outDim + rb + 32, 1, outDim);
        a23.store(y, (cb + 48) * outDim + rb + 32, 1, outDim);
        a30.store(y, cb * outDim + rb + 48, 1, outDim);
        a31.store(y, (cb + 16) * outDim + rb + 48, 1, outDim);
        a32.store(y, (cb + 32) * outDim + rb + 48, 1, outDim);
        a33.store(y, (cb + 48) * outDim + rb + 48, 1, outDim);
    }


    /** `rows` is the PADDED token count; see the Q4 twin's wrapper. */
    public static void q6kF16CoopLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            int64 rows, int64 outDim, int64 cols) {
        int64 nRowTiles = outDim / 128L;
        int64 nTokTiles = rows / 128L;
        KernelStream s = QuantKernel.stream();
        q6kF16CoopKernel.launch(s,
            grid: [(uint32) (nRowTiles * nTokTiles)], block: [128])
            (y, packed, xh, (uint32) rows, (uint32) outDim,
             (uint32) nRowTiles, cols / 256L);
        return;
    }

    /**
     * The BM=64 x BN=64 "m" variant of {@link #q4kF16CoopKernel} —
     * llama.cpp's shape selection: the large tile starves the machine
     * when the launch is narrow (k/v projections at out=1024 put 32
     * workgroups on 20 WGPs), so narrow shapes take 4x the workgroups
     * at the same thread count. Lane-split staging: lanes 0..63
     * dequantize one A row each, lanes 64..127 copy one B token row
     * each. Each subgroup owns a 32x32 quadrant (2x2 fragments).
     */
    @Kernel
    public static void q4kF16CoopM64Kernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        // BK64 (probe V7): see the L twins.
        Shared<float16> sa = shared float16[64 * 72];
        Shared<float16> sb = shared float16[64 * 72];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 128;
        uint32 nTokTiles = tokens / 64;    // token-fastest (probe V5)
        uint32 tt = wg % nTokTiles;
        uint32 to = wg / nTokTiles;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 2;
        uint32 warpC = sg / 2;
        int64 rowWords = blocksPerRow * 36L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
          int32 halfSel = 0;
          while (halfSel < 2) {
            int64 kbh = kb + (int64) halfSel;
            int64 blk = kbh >> 3;
            int32 gq = (int32) (kbh & 7L);
            if (lane < 64) {
                int64 ro = ((int64) (to * 64 + lane)) * rowWords
                    + blk * 36L;
                Vector<int32,4> hw = packed.vload<4>(ro);
                int32 h0 = hw[0];
                float32 d = GgufFile.halfBitsToF32(h0 & 65535);
                float32 dmin = GgufFile.halfBitsToF32((h0 >> 16) & 65535);
                int32 hA = hw[1];
                int32 hB = hw[2];
                int32 hC = hw[3];
                int32 sRaw = 0;
                int32 mRaw = 0;
                if (gq < 4) {
                    sRaw = (hA >> (8 * gq)) & 63;
                    mRaw = (hB >> (8 * gq)) & 63;
                } else {
                    int32 j = gq - 4;
                    int32 kk = (hC >> (8 * j)) & 255;
                    int32 dd = (hA >> (8 * j)) & 255;
                    int32 mm = (hB >> (8 * j)) & 255;
                    sRaw = (kk & 15) | ((dd >> 2) & 48);
                    mRaw = (kk >> 4) | ((mm >> 2) & 48);
                }
                float32 sc = d * (float32) sRaw;
                float32 mn = dmin * (float32) mRaw;
                int32 rg = gq >> 1;
                int32 nib = (gq & 1) * 4;
                Vector<int32,8> qw = packed.vload<8>(ro + 4L
                    + (int64) (rg * 8));
                int64 sBase = (int64) lane * 72L
                    + (int64) (32 * halfSel);
                int32 e = 0;
                while (e < 8) {
                    int32 w = qw[e];
                    int32 bi = 0;
                    while (bi < 4) {
                        int32 by = (w >> (8 * bi)) & 255;
                        int32 q = (by >> nib) & 15;
                        sa[sBase + (int64) (4 * e + bi)] = (float16)
                            (sc * (float32) q - mn);
                        bi = bi + 1;
                    }
                    e = e + 1;
                }
            } else {
                uint32 tl = lane - 64;
                int64 xBase = ((int64) (tt * 64 + tl)) * cols
                    + kbh * 32L;
                int64 sBase = (int64) tl * 72L
                    + (int64) (32 * halfSel);
                int32 jj = 0;
                while (jj < 32) {
                    sb[sBase + (int64) jj] = xh[xBase + (int64) jj];
                    jj = jj + 1;
                }
            }
            halfSel = halfSel + 1;
          }
            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 4) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 32) * 72 + ko;
                uint32 bb2 = (warpC * 32) * 72 + ko;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                t0.load(sa, ab, 0, 72);
                t1.load(sa, ab + 1152, 0, 72);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                u0.load(sb, bb2, 1, 72);
                u1.load(sb, bb2 + 1152, 1, 72);
                a00.mma(t0, u0); a01.mma(t0, u1);
                a10.mma(t1, u0); a11.mma(t1, u1);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 2L;
        }
        uint32 rb = to * 64 + warpR * 32;
        uint32 cb = tt * 64 + warpC * 32;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
    }

    /** The BM=64 x BN=64 variant of {@link #q6kF16CoopKernel} — see
     *  {@link #q4kF16CoopM64Kernel} for the shape rationale. */
    @Kernel
    public static void q6kF16CoopM64Kernel(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            uint32 tokens, uint32 outDim, uint32 nRowTiles,
            int64 blocksPerRow) {
        // BK64 (probe V7): see the L twins.
        Shared<float16> sa = shared float16[64 * 72];
        Shared<float16> sb = shared float16[64 * 72];
        uint32 lane = KernelThread.x();
        uint32 wg = KernelThread.globalIdX() / 128;
        uint32 nTokTiles = tokens / 64;    // token-fastest (probe V5)
        uint32 tt = wg % nTokTiles;
        uint32 to = wg / nTokTiles;
        uint32 sg = lane / 32;
        uint32 warpR = sg % 2;
        uint32 warpC = sg / 2;
        int64 rowWords = blocksPerRow * 53L;
        int64 kBlocks = blocksPerRow * 8L;
        int64 cols = kBlocks * 32L;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        int64 kb = 0;
        while (kb < kBlocks) {
          int32 halfSel = 0;
          while (halfSel < 2) {
            int64 kbh = kb + (int64) halfSel;
            int64 blk = kbh >> 3;
            int32 gq = (int32) (kbh & 7L);
            if (lane < 64) {
                int64 ro = ((int64) (to * 64 + lane)) * rowWords
                    + blk * 53L;
                float32 d = GgufFile.halfBitsToF32(
                    packed[ro + 52L] & 65535);
                int64 sBase = (int64) lane * 72L
                    + (int64) (32 * halfSel);
                int32 half = 0;
                while (half < 2) {
                    int32 sub = 2 * gq + half;
                    int32 g = sub / 8;
                    int32 rr0 = sub * 16 - g * 128;
                    int32 sl = rr0 / 64;
                    int32 l64 = rr0 - sl * 64;
                    int32 shi = rr0 / 32;
                    int32 l32 = rr0 - shi * 32;
                    int32 sw = packed[ro + 48L + (int64) (sub / 4)];
                    int32 scRaw = (sw << (24 - 8 * (sub % 4))) >> 24;
                    float32 dsc = d * (float32) scRaw;
                    Vector<int32,4> qlw = packed.vload<4>(
                        ro + (int64) (16 * g + l64 / 4));
                    Vector<int32,4> qhw = packed.vload<4>(
                        ro + 32L + (int64) (8 * g + l32 / 4));
                    int32 e = 0;
                    while (e < 4) {
                        int32 lw = qlw[e];
                        int32 hw2 = qhw[e];
                        int32 bi = 0;
                        while (bi < 4) {
                            int32 lo = (lw >> (8 * bi + 4 * sl)) & 15;
                            int32 hi2 = (hw2 >> (8 * bi + 2 * shi)) & 3;
                            int32 q = (lo | (hi2 << 4)) - 32;
                            sa[sBase + (int64) (16 * half + 4 * e + bi)]
                                = (float16) (dsc * (float32) q);
                            bi = bi + 1;
                        }
                        e = e + 1;
                    }
                    half = half + 1;
                }
            } else {
                uint32 tl = lane - 64;
                int64 xBase = ((int64) (tt * 64 + tl)) * cols
                    + kbh * 32L;
                int64 sBase = (int64) tl * 72L
                    + (int64) (32 * halfSel);
                int32 jj = 0;
                while (jj < 32) {
                    sb[sBase + (int64) jj] = xh[xBase + (int64) jj];
                    jj = jj + 1;
                }
            }
            halfSel = halfSel + 1;
          }
            Barrier.workgroup();
            int32 ks = 0;
            while (ks < 4) {
                uint32 ko = (uint32) (16 * ks);
                uint32 ab = (warpR * 32) * 72 + ko;
                uint32 bb2 = (warpC * 32) * 72 + ko;
                CooperativeMatrix<float16,16,16,0> t0;
                CooperativeMatrix<float16,16,16,0> t1;
                t0.load(sa, ab, 0, 72);
                t1.load(sa, ab + 1152, 0, 72);
                CooperativeMatrix<float16,16,16,1> u0;
                CooperativeMatrix<float16,16,16,1> u1;
                u0.load(sb, bb2, 1, 72);
                u1.load(sb, bb2 + 1152, 1, 72);
                a00.mma(t0, u0); a01.mma(t0, u1);
                a10.mma(t1, u0); a11.mma(t1, u1);
                ks = ks + 1;
            }
            Barrier.workgroup();
            kb = kb + 2L;
        }
        uint32 rb = to * 64 + warpR * 32;
        uint32 cb = tt * 64 + warpC * 32;
        a00.store(y, cb * outDim + rb, 1, outDim);
        a01.store(y, (cb + 16) * outDim + rb, 1, outDim);
        a10.store(y, cb * outDim + rb + 16, 1, outDim);
        a11.store(y, (cb + 16) * outDim + rb + 16, 1, outDim);
    }

    /** Shape-selected coop launch (llama.cpp's l/m tiling choice): the
     *  128-tile launch must put at least ~2 workgroups on every WGP or
     *  the narrow shapes (k/v at out=1024) starve the machine; below
     *  that, the 64-tile variant runs 4x the workgroups. `rows` padded
     *  to 128 either way (64-tiling divides it too). */
    public static void q4kF16CoopAutoLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            int64 rows, int64 outDim, int64 cols) {
        int64 wgL = (outDim / 128L) * (rows / 128L);
        KernelStream s = QuantKernel.stream();
        // 2026-08-26: the BN=256 pair this replaces held SIXTEEN
        // accumulators per warp and spilled 74 VGPRs -- ACO put 68
        // scratch_store + 76 scratch_load INSIDE the k-loop, against 64
        // wmma. Eight accumulators (X1/X3) cost arithmetic intensity on
        // paper and won 55-70% in fact: 8.55 -> 13.53 TMAC/s at 4096^2,
        // 8.96 -> 14.85 at gate/up, 7.35 -> 12.58 at ffn_down, against
        // llama.cpp-Vulkan's own 9.30 / 10.63 / 8.62 on the same box.
        // X3's 32x64 warp tile wins both K=4096 shapes, X1's 64x32 wins
        // K=14336.
        if (rows % 128L == 0L && outDim % 128L == 0L && wgL >= 1L) {
            if (cols > 8192L) {
                q4kF16CoopX1Kernel.launch(s,
                    grid: [(uint32) wgL], block: [256])
                    (y, packed, xh, (uint32) rows, (uint32) outDim,
                     (uint32) (outDim / 128L), cols / 256L);
                return;
            }
            q4kF16CoopX3Kernel.launch(s,
                grid: [(uint32) wgL], block: [256])
                (y, packed, xh, (uint32) rows, (uint32) outDim,
                 (uint32) (outDim / 128L), cols / 256L);
            return;
        }
        if (wgL < 64L) {
            int64 nRowTiles = outDim / 64L;
            q4kF16CoopM64Kernel.launch(s,
                grid: [(uint32) (nRowTiles * (rows / 64L))], block: [128])
                (y, packed, xh, (uint32) rows, (uint32) outDim,
                 (uint32) nRowTiles, cols / 256L);
            return;
        }
        q4kF16CoopKernel.launch(s,
            grid: [(uint32) (wgL)], block: [128])
            (y, packed, xh, (uint32) rows, (uint32) outDim,
             (uint32) (outDim / 128L), cols / 256L);
        return;
    }

    /** Launch the BN=256 kernel directly (the probe's A/B measures the
     *  SHIPPED kernel, never a copy of it that can drift). */
    public static void q4kF16CoopN256Launch(KernelBuffer<float32> y,
            KernelBuffer<int32> packed, KernelBuffer<float16> xh,
            int64 rows, int64 outDim, int64 cols) {
        KernelStream s = QuantKernel.stream();
        q4kF16CoopN256Kernel.launch(s,
            grid: [(uint32) ((outDim / 128L) * (rows / 256L))],
            block: [256])
            (y, packed, xh, (uint32) rows, (uint32) outDim,
             (uint32) (outDim / 128L), cols / 256L);
        return;
    }

