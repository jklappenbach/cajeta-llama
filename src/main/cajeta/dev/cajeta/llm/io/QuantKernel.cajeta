    /** True when `ty` has a kernel here. The dispatch is on the TYPE, never
     *  on "is packed" — a route written the other way would feed one
     *  format's bytes to another's decoder. */
    public static boolean hasKernel(int32 ty) {
        return ty == Quant.GG_Q4_K || ty == Quant.GG_Q5_K
            || ty == Quant.GG_Q6_K || ty == Quant.GG_Q8_0
            || ty == Quant.GG_Q2_K || ty == Quant.GG_Q3_K
            || ty == Quant.GG_Q4_0 || ty == Quant.GG_Q5_0;
    }

    // ── Q4_0 / Q5_0 f32-activation kernels (2026-08-26) ────────────────
    //
    // The wave (q8_K-integer) twins above cover these formats only when
    // inDim % 256 == 0, because the packed activation layout is a 256-
    // element superblock. Qwen2.5-VL-72B's ffn_down is [8192, 29568] and
    // 29568 % 256 = 128, so HALF that model's Q5_0/Q8_0 traffic can never
    // take the integer route — these f32 kernels are the device path that
    // shape actually runs. One row per work item, like the q8/q5k f32
    // family they sit beside.

    /**
     * `y[yOff + i] = W[i]·x` for one row per work item, W packed Q4_0.
     * Nibble unpack vectorized 16 wide; -8 folds per lane.
     */
    @Kernel
    public static void q40MatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 18L;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 18L;
                float32 dv = QuantKernel.f16AtDev(packed, ro);
                Vector<int8,16> q = packed.vload<16>(ro + 2L);
                Vector<int8,16> lo = (q & 15) - 8;
                Vector<int8,16> hi = ((q >> 4) & 15) - 8;
                int64 xo = xOff + b * 32L;
                Vector<int16,8> l0 = lo.widenLo();
                Vector<int16,8> l1 = lo.widenHi();
                Vector<int16,8> h0 = hi.widenLo();
                Vector<int16,8> h1 = hi.widenHi();
                Vector<float32,4> p = l0.widenLo().toF32() * x.vload<4>(xo);
                p = p + l0.widenHi().toF32() * x.vload<4>(xo + 4L);
                p = p + l1.widenLo().toF32() * x.vload<4>(xo + 8L);
                p = p + l1.widenHi().toF32() * x.vload<4>(xo + 12L);
                p = p + h0.widenLo().toF32() * x.vload<4>(xo + 16L);
                p = p + h0.widenHi().toF32() * x.vload<4>(xo + 20L);
                p = p + h1.widenLo().toF32() * x.vload<4>(xo + 24L);
                p = p + h1.widenHi().toF32() * x.vload<4>(xo + 28L);
                acc = acc + dv * (p[0] + p[1] + p[2] + p[3]);
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    public static void q40MatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        uint32 ur = (uint32) rows;
        uint32 blk = (uint32) QuantKernel.ROWS_PER_BLOCK;
        KernelStream s = QuantKernel.stream();
        q40MatVecKernel.launch(s, grid: [(ur + blk - 1) / blk], block: [blk])
            (y, packed, x, ur, cols / 32L, xOff, yOff);
        return;
    }

    public static void q40MatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        QuantKernel.q40MatVecLaunchNoSync(y, packed, x, rows, cols, xOff,
            yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    /**
     * `y[yOff + i] = W[i]·x` for one row per work item, W packed Q5_0.
     *
     * The low nibbles run the vectorized Q4_0 path with a -16 fold; the
     * 5th bit is element j reading bit j (or j+16) of ONE u32 — a
     * different shift per vector lane, which the vector ops cannot
     * express — so its contribution rides a 32-term scalar fold over the
     * activations, +16*x[j] per set bit, multiplied by the bit rather
     * than branched on (same trick as the wave twin).
     */
    @Kernel
    public static void q50MatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 22L;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 22L;
                float32 dv = QuantKernel.f16AtDev(packed, ro);
                Vector<int8,4> qhb = packed.vload<4>(ro + 2L);
                int32 qh = ((int32) qhb[0] & 255)
                    | (((int32) qhb[1] & 255) << 8)
                    | (((int32) qhb[2] & 255) << 16)
                    | (((int32) qhb[3] & 255) << 24);
                Vector<int8,16> q = packed.vload<16>(ro + 6L);
                Vector<int8,16> lo = (q & 15) - 16;
                Vector<int8,16> hi = ((q >> 4) & 15) - 16;
                int64 xo = xOff + b * 32L;
                Vector<int16,8> l0 = lo.widenLo();
                Vector<int16,8> l1 = lo.widenHi();
                Vector<int16,8> h0 = hi.widenLo();
                Vector<int16,8> h1 = hi.widenHi();
                Vector<float32,4> p = l0.widenLo().toF32() * x.vload<4>(xo);
                p = p + l0.widenHi().toF32() * x.vload<4>(xo + 4L);
                p = p + l1.widenLo().toF32() * x.vload<4>(xo + 8L);
                p = p + l1.widenHi().toF32() * x.vload<4>(xo + 12L);
                p = p + h0.widenLo().toF32() * x.vload<4>(xo + 16L);
                p = p + h0.widenHi().toF32() * x.vload<4>(xo + 20L);
                p = p + h1.widenLo().toF32() * x.vload<4>(xo + 24L);
                p = p + h1.widenHi().toF32() * x.vload<4>(xo + 28L);
                float32 dot = p[0] + p[1] + p[2] + p[3];
                float32 hs = 0.0f;
                int32 j = 0;
                while (j < 16) {
                    hs = hs + (float32) ((qh >> j) & 1)
                        * x[xo + (int64) j];
                    hs = hs + (float32) ((qh >> (j + 16)) & 1)
                        * x[xo + (int64) (j + 16)];
                    j = j + 1;
                }
                acc = acc + dv * (dot + 16.0f * hs);
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    public static void q50MatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        uint32 ur = (uint32) rows;
        uint32 blk = (uint32) QuantKernel.ROWS_PER_BLOCK;
        KernelStream s = QuantKernel.stream();
        q50MatVecKernel.launch(s, grid: [(ur + blk - 1) / blk], block: [blk])
            (y, packed, x, ur, cols / 32L, xOff, yOff);
        return;
    }

    public static void q50MatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        QuantKernel.q50MatVecLaunchNoSync(y, packed, x, rows, cols, xOff,
            yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    /**
     * Q8_0 x F32 activations, WAVE decomposition — the kernel the 72B's
     * ffn_down actually needed. The wave INTEGER route reads q8_K-packed
     * activations whose superblock is 256 elements, so it cannot serve
     * inDim % 256 != 0 (Qwen-72B's ffn_down is 29568, residue 128); the
     * one-item-per-row f32 kernels can, but measured in the ~100-140
     * GiB/s class where the wave kernels measure 130-190 — and ffn_down
     * is ~16 GiB of the 72B's ~45 GiB per decoded token. llama.cpp has
     * no such cliff anywhere: their mat-vec reads float activations, so
     * one design serves every width — measured 204.8 GiB/s on the 72B
     * and ~208 on the 8B, the SAME rate, which is what told us the gap
     * was our router and not a big-model technique of theirs.
     *
     * Geometry is the integer twin's: one wave per output row, one LANE
     * per 32-element block, 32 blocks in flight, subgroup reduce. Only
     * the activation side differs — f32 loads and fma, no quantization,
     * so no width constraint beyond cols % 32 == 0 and no q8_K
     * approximation either.
     */
    @Kernel
    public static void q80F32WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        uint32 lane = KernelThread.x();
        uint32 row = KernelThread.globalIdX() / 32;
        int64 rowBytes = blocksPerRow * 34L;
        float32 acc = 0.0f;
        if (row < rows) {
            int64 i = (int64) row;
            int64 wb = (int64) lane;
            while (wb < blocksPerRow) {
                int64 ro = i * rowBytes + wb * 34L;
                float32 d = QuantKernel.f16AtDev(packed, ro);
                int64 xo = xOff + wb * 32L;
                Vector<int8,16> q0 = packed.vload<16>(ro + 2L);
                Vector<int8,16> q1 = packed.vload<16>(ro + 18L);
                Vector<int16,8> W0 = q0.widenLo();
                Vector<int16,8> W1 = q0.widenHi();
                Vector<int16,8> W2 = q1.widenLo();
                Vector<int16,8> W3 = q1.widenHi();
                Vector<float32,4> p = W0.widenLo().toF32() * x.vload<4>(xo);
                p = p + W0.widenHi().toF32() * x.vload<4>(xo + 4L);
                p = p + W1.widenLo().toF32() * x.vload<4>(xo + 8L);
                p = p + W1.widenHi().toF32() * x.vload<4>(xo + 12L);
                p = p + W2.widenLo().toF32() * x.vload<4>(xo + 16L);
                p = p + W2.widenHi().toF32() * x.vload<4>(xo + 20L);
                p = p + W3.widenLo().toF32() * x.vload<4>(xo + 24L);
                p = p + W3.widenHi().toF32() * x.vload<4>(xo + 28L);
                acc = acc + d * (p[0] + p[1] + p[2] + p[3]);
                wb = wb + 32L;
            }
        }
        float32 tot = Wave.reduceSumF32(acc);
        if (lane == 0 && row < rows) {
            y[yOff + (int64) row] = tot;
        }
    }

    public static void q80F32WaveMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        KernelStream s = QuantKernel.stream();
        q80F32WaveMatVecKernel.launch(s, grid: [(uint32) rows], block: [32])
            (y, packed, x, (uint32) rows, cols / 32L, xOff, yOff);
        return;
    }

    public static void q80F32WaveMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        QuantKernel.q80F32WaveMatVecLaunchNoSync(y, packed, x, rows, cols,
            xOff, yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    /** The Q4_0 member of the f32-wave family — see the Q8_0 twin. */
    @Kernel
    public static void q40F32WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        uint32 lane = KernelThread.x();
        uint32 row = KernelThread.globalIdX() / 32;
        int64 rowBytes = blocksPerRow * 18L;
        float32 acc = 0.0f;
        if (row < rows) {
            int64 i = (int64) row;
            int64 wb = (int64) lane;
            while (wb < blocksPerRow) {
                int64 ro = i * rowBytes + wb * 18L;
                float32 d = QuantKernel.f16AtDev(packed, ro);
                int64 xo = xOff + wb * 32L;
                Vector<int8,16> q = packed.vload<16>(ro + 2L);
                Vector<int8,16> lo = (q & 15) - 8;
                Vector<int8,16> hi = ((q >> 4) & 15) - 8;
                Vector<int16,8> W0 = lo.widenLo();
                Vector<int16,8> W1 = lo.widenHi();
                Vector<int16,8> W2 = hi.widenLo();
                Vector<int16,8> W3 = hi.widenHi();
                Vector<float32,4> p = W0.widenLo().toF32() * x.vload<4>(xo);
                p = p + W0.widenHi().toF32() * x.vload<4>(xo + 4L);
                p = p + W1.widenLo().toF32() * x.vload<4>(xo + 8L);
                p = p + W1.widenHi().toF32() * x.vload<4>(xo + 12L);
                p = p + W2.widenLo().toF32() * x.vload<4>(xo + 16L);
                p = p + W2.widenHi().toF32() * x.vload<4>(xo + 20L);
                p = p + W3.widenLo().toF32() * x.vload<4>(xo + 24L);
                p = p + W3.widenHi().toF32() * x.vload<4>(xo + 28L);
                acc = acc + d * (p[0] + p[1] + p[2] + p[3]);
                wb = wb + 32L;
            }
        }
        float32 tot = Wave.reduceSumF32(acc);
        if (lane == 0 && row < rows) {
            y[yOff + (int64) row] = tot;
        }
    }

    public static void q40F32WaveMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        KernelStream s = QuantKernel.stream();
        q40F32WaveMatVecKernel.launch(s, grid: [(uint32) rows], block: [32])
            (y, packed, x, (uint32) rows, cols / 32L, xOff, yOff);
        return;
    }

    public static void q40F32WaveMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
