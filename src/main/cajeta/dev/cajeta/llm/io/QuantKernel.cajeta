                uint32 rsc1 = ro1 + (uint32) (8 * g);
                Vector<int8,16> qlA1 = packed.vload<16>((int64) rqa1);
                Vector<int8,16> qlB1 = packed.vload<16>((int64) rqa1 + 32L);
