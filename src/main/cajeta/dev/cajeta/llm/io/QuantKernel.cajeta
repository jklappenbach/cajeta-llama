                Vector<uint8,16> q3_0 = (((wB0 >> 4) & 252645135) | ((wH0 >> 2) & 808464432)).asBytes().asUnsigned();
                Vector<int32,4> dv0_0 = q0_0.dotAccum(a_0, z4);
                Vector<int32,4> dv1_0 = q1_0.dotAccum(a_1, z4);
                Vector<int32,4> dv2_0 = q2_0.dotAccum(a_2, z4);
                Vector<int32,4> dv3_0 = q3_0.dotAccum(a_3, z4);
                int32 t0_0 = dv0_0[0] + dv0_0[1] + dv0_0[2] + dv0_0[3] - 32 * as_0;
                int32 t1_0 = dv1_0[0] + dv1_0[1] + dv1_0[2] + dv1_0[3] - 32 * as_1;
