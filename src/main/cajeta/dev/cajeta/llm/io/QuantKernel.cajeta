    /** The Q5_0 member of the f32-wave family — see the Q8_0 twin for
     *  the geometry and the Q5_0 f32 one-item kernel for why the 5th
     *  bit rides a scalar fold over the activations. */
    @Kernel
    public static void q50F32WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        uint32 lane = KernelThread.x();
        uint32 row = KernelThread.globalIdX() / 32;
        int64 rowBytes = blocksPerRow * 22L;
        float32 acc = 0.0f;
        if (row < rows) {
            int64 i = (int64) row;
            int64 wb = (int64) lane;
            while (wb < blocksPerRow) {
                int64 ro = i * rowBytes + wb * 22L;
                float32 d = QuantKernel.f16AtDev(packed, ro);
                int64 xo = xOff + wb * 32L;
                Vector<int8,4> qhb = packed.vload<4>(ro + 2L);
                int32 qh = ((int32) qhb[0] & 255)
                    | (((int32) qhb[1] & 255) << 8)
                    | (((int32) qhb[2] & 255) << 16)
                    | (((int32) qhb[3] & 255) << 24);
                Vector<int8,16> q = packed.vload<16>(ro + 6L);
                Vector<int8,16> lo = (q & 15) - 16;
                Vector<int8,16> hi = ((q >> 4) & 15) - 16;
                Vector<int16,8> W0 = lo.widenLo();
                Vector<int16,8> W1 = lo.widenHi();
                Vector<int16,8> W2 = hi.widenLo();
                Vector<int16,8> W3 = hi.widenHi();
                Vector<float32,4> p = W0.widenLo().toF32() * x.vload<4>(xo);
                p = p + W0.widenHi().toF32() * x.vload<4>(xo + 4L);
                p = p + W1.widenLo().toF32() * x.vload<4>(xo + 8L);
                p = p + W1.widenHi().toF32() * x.vload<4>(xo + 12L);
                p = p + W2.widenLo().toF32() * x.vload<4>(xo + 16L);
                p = p + W2.widenHi().toF32() * x.vload<4>(xo + 20L);
                p = p + W3.widenLo().toF32() * x.vload<4>(xo + 24L);
                p = p + W3.widenHi().toF32() * x.vload<4>(xo + 28L);
                float32 dot = p[0] + p[1] + p[2] + p[3];
                float32 hs = 0.0f;
                int32 j = 0;
                while (j < 16) {
                    hs = hs + (float32) ((qh >> j) & 1)
                        * x[xo + (int64) j];
                    hs = hs + (float32) ((qh >> (j + 16)) & 1)
                        * x[xo + (int64) (j + 16)];
                    j = j + 1;
                }
                acc = acc + d * (dot + 16.0f * hs);
                wb = wb + 32L;
            }
        }
        float32 tot = Wave.reduceSumF32(acc);
        if (lane == 0 && row < rows) {
            y[yOff + (int64) row] = tot;
        }
    }

    public static void q50F32WaveMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        KernelStream s = QuantKernel.stream();
        q50F32WaveMatVecKernel.launch(s, grid: [(uint32) rows], block: [32])
            (y, packed, x, (uint32) rows, cols / 32L, xOff, yOff);
        return;
    }

    public static void q50F32WaveMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        QuantKernel.q50F32WaveMatVecLaunchNoSync(y, packed, x, rows, cols,
            xOff, yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    /** The subset of {@link #hasKernel} with an F32-activation kernel
     *  (the matVecLaunch dispatch). Q2_K/Q3_K have ONLY the wave
     *  integer route (10.12.45.C), so a caller that cannot take the
     *  q8_K approximation has no device path for them. */
    /** The formats with a WAVE kernel over f32 activations — the fast
     *  device mat-vec for widths the q8_K integer route cannot serve. */
    public static boolean hasF32WaveKernel(int32 ty) {
        return ty == Quant.GG_Q8_0 || ty == Quant.GG_Q5_0
            || ty == Quant.GG_Q4_0;
    }

    public static boolean hasF32Kernel(int32 ty) {
        return ty == Quant.GG_Q4_K || ty == Quant.GG_Q5_K
            || ty == Quant.GG_Q6_K || ty == Quant.GG_Q8_0
            || ty == Quant.GG_Q4_0 || ty == Quant.GG_Q5_0;
    }

    /** Launch the kernel for `ty` over device-resident buffers. */
    /**
     * {@link #matVecLaunch} WITHOUT the trailing sync (plan 10.3).
     *
     * A dispatch and a wait for the device to go idle are two things, and
     * every launch here did both. A weight that is issued in row slices
     * therefore stopped the pipeline between slices for no reason: the
     * slices are independent, and the only thing that must observe them all
     * is the download, which is itself ordered on the stream.
     *
     * The caller owes ONE `KernelStream.current().sync()` before it reads
     * the result. That is not optional and it is not implied by anything
     * here — a caller that forgets gets stale output, not a diagnostic.
     */
    public static void matVecLaunchNoSync(int32 ty, KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        if (ty == Quant.GG_Q4_K) {
            QuantKernel.q4kMatVecLaunchNoSync(y, packed, x, rows, cols,
                xOff, yOff);
        } else if (ty == Quant.GG_Q5_K) {
            QuantKernel.q5kMatVecLaunchNoSync(y, packed, x, rows, cols,
                xOff, yOff);
        } else if (ty == Quant.GG_Q6_K) {
            QuantKernel.q6kMatVecLaunchNoSync(y, packed, x, rows, cols,
                xOff, yOff);
        } else if (ty == Quant.GG_Q8_0) {
            QuantKernel.q8MatVecLaunchNoSync(y, packed, x, rows, cols,
                xOff, yOff);
        } else if (ty == Quant.GG_Q4_0) {
            QuantKernel.q40MatVecLaunchNoSync(y, packed, x, rows, cols,
                xOff, yOff);
        } else if (ty == Quant.GG_Q5_0) {
            QuantKernel.q50MatVecLaunchNoSync(y, packed, x, rows, cols,
                xOff, yOff);
        } else if (ty == Quant.GG_MXFP4) {
            QuantKernel.mxfp4MatVecFast3Launch(y, packed, x, rows, cols,
                xOff, yOff);
        } else {
            // 10.12.45: this used to be a bare `else` into the Q8_0
            // kernel. Now that Q2_K/Q3_K BIND packed with no device
            // kernel yet, an ungated caller must get an error, not one
            // format's bytes through another's decoder.
            throw heap LlmException("matVecLaunch: no device mat-vec "
                + "kernel for packed type " + ty);
        }
        return;
    }

    public static void matVecLaunch(int32 ty, KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        if (ty == Quant.GG_Q4_K) {
            QuantKernel.q4kMatVecLaunch(y, packed, x, rows, cols, xOff, yOff);
        } else if (ty == Quant.GG_Q5_K) {
            QuantKernel.q5kMatVecLaunch(y, packed, x, rows, cols, xOff, yOff);
        } else if (ty == Quant.GG_Q6_K) {
            QuantKernel.q6kMatVecLaunch(y, packed, x, rows, cols, xOff, yOff);
        } else if (ty == Quant.GG_Q8_0) {
            QuantKernel.q8MatVecLaunch(y, packed, x, rows, cols, xOff, yOff);
        } else if (ty == Quant.GG_Q4_0) {
            QuantKernel.q40MatVecLaunch(y, packed, x, rows, cols, xOff, yOff);
        } else if (ty == Quant.GG_Q5_0) {
            QuantKernel.q50MatVecLaunch(y, packed, x, rows, cols, xOff, yOff);
        } else if (ty == Quant.GG_MXFP4) {
            QuantKernel.mxfp4MatVecFast3LaunchSync(y, packed, x, rows, cols, xOff, yOff);
        } else {
            // Same guard as the NoSync twin (10.12.45).
            throw heap LlmException("matVecLaunch: no device mat-vec "
                + "kernel for packed type " + ty);
        }
        return;
    }

    /**
     * `Quant.q4kMatVecInto`'s signature over host arrays, via the kernel —
     * uploading, launching and downloading on every call.
     *
     * That upload is the whole cost of a decode step and then some, so
     * this is a TEST and BRING-UP shape, not the routing Unit 4 installs:
     * a real caller uploads the weight ONCE at bind time and keeps the
     * buffer resident, because the weight is the only operand that does
     * not change between tokens.
     */
    public static void matVecIntoDevice(int32 ty, int8[] packed, int64 rows,
            int64 cols, float32[] x, int64 xOff, float32[] y, int64 yOff) {
        KernelBuffer<int8> pb #= heap KernelBuffer<int8>(
            (uint64) packed.count());
        KernelBuffer<float32> xb #= heap KernelBuffer<float32>(
            (uint64) x.count());
        KernelBuffer<float32> yb #= heap KernelBuffer<float32>(
            (uint64) y.count());
        pb.upload(packed);
        xb.upload(x);
        yb.upload(y);
        QuantKernel.matVecLaunch(ty, yb, pb, xb, rows, cols, xOff, yOff);
        yb.download(y);
        return;
    }

    /** Q4_K-only alias kept for the Unit 3 tests that name it. */
    public static void q4kMatVecIntoDevice(int8[] packed, int64 rows,
            int64 cols, float32[] x, int64 xOff, float32[] y, int64 yOff) {
        QuantKernel.matVecIntoDevice(Quant.GG_Q4_K, packed, rows, cols, x,
            xOff, y, yOff);
        return;
    }

    /**
     * `q4kQ8MatVecKernel` over HOST arrays — the shape a test can call.
     *
     * Quantizes `x` itself, so it is the drop-in twin of
     * `Quant.q4kMatVecQ8` and can be held against it for bit-identity. Real
     * callers keep the buffers resident and quantize once per activation
     * (see `Linear.matvecIntoDevice`); this allocates per call and is not a
     * path to run a model through.
     */
    public static void q4kQ8MatVecIntoDevice(int8[] packed, int64 rows,
            int64 cols, float32[] x, int64 xOff, float32[] y, int64 yOff) {
        int8[] xq #= heap int8[cols];
        float32[] xd #= heap float32[cols / 256L];
        int32[] xbs #= heap int32[cols / 16L];
        Quant.q8kQuantize(x, xOff, cols, xq, xd, xbs);
        float32[] yh #= heap float32[rows];
        KernelBuffer<float32> yb #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<int8> pb #= heap KernelBuffer<int8>(
            (uint64) packed.count());
        KernelBuffer<int8> xqb #= heap KernelBuffer<int8>((uint64) cols);
        KernelBuffer<float32> xdb #= heap KernelBuffer<float32>(
            (uint64) (cols / 256L));
        KernelBuffer<int32> xbb #= heap KernelBuffer<int32>(
            (uint64) (cols / 16L));
        pb.upload(packed);
        xqb.upload(xq);
        xdb.upload(xd);
        xbb.upload(xbs);
        QuantKernel.q4kQ8MatVecLaunch(yb, pb, xqb, xdb, xbb, rows, cols, 0L);
        yb.download(yh);
        int64 i = 0;
        while (i < rows) { y[yOff + i] = yh[i]; i = i + 1; }
        return;
    }

    /** {@link #q4kQ8WaveMatVecKernel} over HOST arrays. */
    public static void q4kQ8WaveMatVecIntoDevice(int8[] packed, int64 rows,
            int64 cols, float32[] x, int64 xOff, float32[] y, int64 yOff) {
        int8[] xp #= heap int8[Quant.q8kPackedBytes(cols)];
        Quant.q8kPack(x, xOff, cols, xp);
        float32[] yh #= heap float32[rows];
        KernelBuffer<float32> yb #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<int8> pb #= heap KernelBuffer<int8>(
            (uint64) packed.count());
        KernelBuffer<int8> xpb #= heap KernelBuffer<int8>(
            (uint64) xp.count());
        pb.upload(packed);
        xpb.upload(xp);
        QuantKernel.q4kQ8WaveMatVecLaunch(yb, pb, xpb, rows, cols, 0L);
        yb.download(yh);
        int64 i = 0;
        while (i < rows) { y[yOff + i] = yh[i]; i = i + 1; }
        return;
    }

    /**
     * `q4kQ8PackedMatVecKernel` over HOST arrays — the shape a test can
     * call, and the twin of {@link #q4kQ8MatVecIntoDevice} so the two
     * routes can be compared with everything but the activation layout
     * held fixed.
     */
    public static void q4kQ8PackedMatVecIntoDevice(int8[] packed, int64 rows,
            int64 cols, float32[] x, int64 xOff, float32[] y, int64 yOff) {
        int8[] xp #= heap int8[Quant.q8kPackedBytes(cols)];
        Quant.q8kPack(x, xOff, cols, xp);
        float32[] yh #= heap float32[rows];
        KernelBuffer<float32> yb #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<int8> pb #= heap KernelBuffer<int8>(
            (uint64) packed.count());
        KernelBuffer<int8> xpb #= heap KernelBuffer<int8>(
            (uint64) xp.count());
        pb.upload(packed);
        xpb.upload(xp);
        QuantKernel.q4kQ8PackedMatVecLaunch(yb, pb, xpb, rows, cols, 0L);
        yb.download(yh);
        int64 i = 0;
        while (i < rows) { y[yOff + i] = yh[i]; i = i + 1; }
        return;
    }
}
