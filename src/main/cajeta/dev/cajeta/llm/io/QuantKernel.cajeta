                float32 d0 = GgufFile.halfBitsToF32(((int32) dh0[2] & 255)
                    | (((int32) dh0[3] & 255) << 8)) * xs;
                int32 s0_0 = (int32) scv0[0];
                int32 s1_0 = (int32) scv0[2];
                int32 s2_0 = (int32) scv0[4];
                int32 s3_0 = (int32) scv0[6];
                if (a != 0) {
                    s0_0 = (int32) scv0[1];
                    s1_0 = (int32) scv0[3];
                    s2_0 = (int32) scv0[5];
                    s3_0 = (int32) scv0[7];
                }
                // Unit 60: the nibble/crumb assembly on 32-bit WORDS (four
                // bytes per op). As byte vectors the compiler legalized
                // every op to one v_and/v_or/v_lsh*_b16 PER BYTE — 1300
                // of them per block trip, the kernel's real floor (a
                // cached run of this shape took as long as the DRAM run).
                Vector<int32,4> wA0 = qlA0.asWords();
                Vector<int32,4> wB0 = qlB0.asWords();
                Vector<int32,4> wH0 = qh0.asWords();
                Vector<uint8,16> q0_0 = ((wA0 & 252645135) | ((wH0 << 4) & 808464432)).asBytes().asUnsigned();
