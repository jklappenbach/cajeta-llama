                    s1_3 = (int32) scv3[3];
                    s2_3 = (int32) scv3[5];
                    s3_3 = (int32) scv3[7];
                }
                // Unit 60: the nibble/crumb assembly on 32-bit WORDS (four
                // bytes per op). As byte vectors the compiler legalized
                // every op to one v_and/v_or/v_lsh*_b16 PER BYTE — 1300
                // of them per block trip, the kernel's real floor (a
                // cached run of this shape took as long as the DRAM run).
                Vector<int32,4> wA3 = qlA3.asWords();
                Vector<int32,4> wB3 = qlB3.asWords();
                Vector<int32,4> wH3 = qh3.asWords();
                Vector<uint8,16> q0_3 = ((wA3 & 252645135) | ((wH3 << 4) & 808464432)).asBytes().asUnsigned();
                Vector<uint8,16> q1_3 = ((wB3 & 252645135) | ((wH3 << 2) & 808464432)).asBytes().asUnsigned();
                Vector<uint8,16> q2_3 = (((wA3 >> 4) & 252645135) | (wH3 & 808464432)).asBytes().asUnsigned();
                Vector<uint8,16> q3_3 = (((wB3 >> 4) & 252645135) | ((wH3 >> 2) & 808464432)).asBytes().asUnsigned();
                Vector<int32,4> dv0_3 = q0_3.dotAccum(a_0, z4);
                Vector<int32,4> dv1_3 = q1_3.dotAccum(a_1, z4);
                Vector<int32,4> dv2_3 = q2_3.dotAccum(a_2, z4);
                Vector<int32,4> dv3_3 = q3_3.dotAccum(a_3, z4);
                int32 t0_3 = dv0_3[0] + dv0_3[1] + dv0_3[2] + dv0_3[3] - 32 * as_0;
                int32 t1_3 = dv1_3[0] + dv1_3[1] + dv1_3[2] + dv1_3[3] - 32 * as_1;
                int32 t2_3 = dv2_3[0] + dv2_3[1] + dv2_3[2] + dv2_3[3] - 32 * as_2;
                int32 t3_3 = dv3_3[0] + dv3_3[1] + dv3_3[2] + dv3_3[3] - 32 * as_3;
                acc3 = acc3 + d3 * (float32) (s0_3 * t0_3);
                acc3 = acc3 + d3 * (float32) (s1_3 * t1_3);
                acc3 = acc3 + d3 * (float32) (s2_3 * t2_3);
                acc3 = acc3 + d3 * (float32) (s3_3 * t3_3);
                b = b + 8;
            }
            acc1 = acc1 * w1;
            acc2 = acc2 * w2;
            acc3 = acc3 * w3;
        }
        if (R > 1) {
            float32 t0 = Wave.reduceSumF32(acc0);
            float32 t1 = Wave.reduceSumF32(acc1);
            float32 t2 = Wave.reduceSumF32(acc2);
            float32 t3 = Wave.reduceSumF32(acc3);
            if (lane == 0) {
                int64 o = yOff + (int64) row0;
                if (accum != 0) {
                    if (row0 < rows) { y[o] = y[o] + t0; }
                    if (row0 + 1 < rows) { y[o + 1L] = y[o + 1L] + t1; }
                    if (row0 + 2 < rows) { y[o + 2L] = y[o + 2L] + t2; }
                    if (row0 + 3 < rows) { y[o + 3L] = y[o + 3L] + t3; }
                } else {
                    if (row0 < rows) { y[o] = t0; }
                    if (row0 + 1 < rows) { y[o + 1L] = t1; }
                    if (row0 + 2 < rows) { y[o + 2L] = t2; }
                    if (row0 + 3 < rows) { y[o + 3L] = t3; }
                }
            }
        } else {
            uint32 r = 0;
            while (r < rpw) {
                float32 part = 0.0f;
                if (sub == r) { part = acc0; }
                float32 tot = Wave.reduceSumF32(part);
                if (lane == 0 && wave * rpw + r < rows) {
                    // Unit 48: accumulate form — the decode o-projection
                    // folds its residual add into the store.
                    if (accum != 0) {
                        y[yOff + (int64) (wave * rpw + r)] =
                            y[yOff + (int64) (wave * rpw + r)] + tot;
                    } else {
                        y[yOff + (int64) (wave * rpw + r)] = tot;
                    }
                }
                r = r + 1;
            }
        }
    }

    public static void q6kQ8WaveMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        QuantKernel.requireOffsets32(packed, "q6kQ8WaveMatVec");
        uint32 ur = (uint32) rows;
        int64 rpw = QuantKernel.rowsPerWave(cols / 256L);
        if (rpw == 1L) { rpw = 4L; }   // unit 58: four row slots per wave
        uint32 waves = (uint32) ((rows + rpw - 1L) / rpw);
        KernelStream s = QuantKernel.stream();
        q6kQ8WaveMatVecKernel.launch(s, grid: [waves], block: [32])
            (y, packed, xp, ur, cols / 256L, yOff, 0);
        return;
    }

    /** Unit 48: `y[yOff + row] += W[row] . x` — the accumulate form. */
    public static void q6kQ8WaveMatVecAccumLaunchNoSync(
            KernelBuffer<float32> y, KernelBuffer<int8> packed,
            KernelBuffer<int8> xp, int64 rows, int64 cols, int64 yOff) {
        uint32 ur = (uint32) rows;
        int64 rpw = QuantKernel.rowsPerWave(cols / 256L);
        if (rpw == 1L) { rpw = 4L; }   // unit 58: four row slots per wave
        uint32 waves = (uint32) ((rows + rpw - 1L) / rpw);
        KernelStream s = QuantKernel.stream();
        q6kQ8WaveMatVecKernel.launch(s, grid: [waves], block: [32])
            (y, packed, xp, ur, cols / 256L, yOff, 1);
        return;
    }

    public static void q6kQ8WaveMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        QuantKernel.q6kQ8WaveMatVecLaunchNoSync(y, packed, xp, rows, cols,
            yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    /*
     * ── Unit 40 (spec 15.21.3): expert-indirected mat-vec ──────────────
     *
     * The llama.cpp `mul_mat_vec_id` shape: ONE launch covers every
     * selected expert of a bank. The weight buffer is the bank's whole
     * contiguous slab (the GGUF rank-3 layout, expert-major), `sel` is a
     * DEVICE buffer of the routed expert ids, and the grid is
     * rowsPerExpert x used workgroups flattened 1D (wg / rowsPerExpert
     * = which selection slot, remainder = which output row). The dot
     * loop is byte-for-byte the wave kernel's — only the row's weight
     * offset (through sel), the activation base (through xRowBlocks:
     * 0 = every expert reads the same staged x; width/256 = expert kk
     * reads its own staged row kk) and the output row differ.
     */
    @Kernel
    public static void q4kQ8IdMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            KernelBuffer<int32> sel, uint32 rowsPerExpert,
            int64 blocksPerRow, int64 xRowBlocks, int64 yOff) {
        uint32 lane = KernelThread.x();
        uint32 wave = KernelThread.globalIdX() / 32;
        // Unit 47: short rows pack rowsPerWave rows per wave (see the
        // dense twin); wavesPerExpert waves cover one expert.
        uint32 lpr = 4 * (uint32) blocksPerRow;
        uint32 rpw = 1;
        uint32 rl = lane;
        uint32 sub = 0;
        if (lpr < 32) { rpw = 32 / lpr; sub = lane / lpr; rl = lane - sub * lpr; }
        uint32 wpe = (rowsPerExpert + rpw - 1) / rpw;
        uint32 kk = wave / wpe;
        uint32 rowBase = (wave - kk * wpe) * rpw;
        uint32 row = rowBase + sub;
        uint32 rowBytes = (uint32) blocksPerRow * 144;   // unit 61: uint32 offsets
        uint32 bpr = (uint32) blocksPerRow;
        uint32 xrb = (uint32) xRowBlocks;
        float32 acc = 0.0f;
        if (sub < rpw && row < rowsPerExpert) {
            uint32 rb = ((uint32) sel[(int64) kk] * rowsPerExpert + row) * rowBytes;
            uint32 xbase = kk * xrb;
            int32 g = (int32) (rl % 4);
            int32 sh0 = 16 * (g & 1);
            int32 sh1 = sh0 + 8;
            uint32 b = rl / 4;
            Vector<int32,8> zv = heap Vector<int32,8>(0, 0, 0, 0, 0, 0, 0, 0);
            while (b < bpr) {
                uint32 ro = rb + b * 144;
                uint32 rw = ro + (uint32) (32 * g);

                // The header — { f16 d; f16 dmin; u8 scales[12] } = 16 bytes.
                // Read by all four lanes of the block; it is 16 bytes and it
                // is in cache after the first.
                Vector<int8,16> hv = packed.vload<16>((int64) ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                // Only THIS lane's two sub-blocks are unpacked, where the
                // serial kernel unpacks all eight — and the two forms are
                // NOT interchangeable. Q4_K packs sub-blocks 0-3 and 4-7 in
                // different fields, and a lane owning `g` needs sub-blocks
                // 2g and 2g+1, so g < 2 lands entirely in the first field
                // and g >= 2 entirely in the second. Reading field `g`
                // instead of sub-block `2g` is the shape of the first
                // version of this kernel, which was wrong on every row.
                // Unit 60: scale bytes by word and runtime shift (no runtime
                // lane index — that lowered to a 16-way select chain per byte).
                Vector<int32,4> hvw = hv.asWords();
                int32 hvsA = (hvw[1] >> sh0) & 255;
                int32 hvsB = (hvw[1] >> sh1) & 255;
                int32 hvmC = (hvw[2] >> sh0) & 255;
                int32 hvmD = (hvw[2] >> sh1) & 255;
                int32 sc0 = hvsA & 63;
                int32 sc1 = hvsB & 63;
                int32 mn0 = hvmC & 63;
                int32 mn1 = hvmD & 63;
                if (g >= 2) {
                    int32 k0 = (hvw[3] >> sh0) & 255;
                    int32 k1 = (hvw[3] >> sh1) & 255;
                    sc0 = (k0 & 15) | ((hvsA >> 2) & 48);
                    sc1 = (k1 & 15) | ((hvsB >> 2) & 48);
                    mn0 = (k0 >> 4) | ((hvmC >> 2) & 48);
                    mn1 = (k1 >> 4) | ((hvmD >> 2) & 48);
                }

                Vector<uint8,32> raw = packed.vload<32>(
                    (int64) rw + 16L).asUnsigned();
                Vector<int32,8> raww = raw.asWords();
                Vector<uint8,32> lo = (raww & 252645135).asBytes().asUnsigned();
                Vector<uint8,32> hi = ((raww >> 4) & 252645135).asBytes().asUnsigned();
                uint32 xb = (xbase + b) * 320 + (uint32) (64 * g);
                uint32 xr = (xbase + b) * 320;
                Vector<int8,32> a0 = xp.vload<32>((int64) xb);
                Vector<int8,32> a1 = xp.vload<32>((int64) xb + 32L);
                Vector<int32,8> dl = lo.dotAccum(a0, zv);
                Vector<int32,8> dh = hi.dotAccum(a1, zv);
                int32 sumi = (dl[0] + dl[1] + dl[2] + dl[3]
                    + dl[4] + dl[5] + dl[6] + dl[7]) * sc0
                             + (dh[0] + dh[1] + dh[2] + dh[3]
                                 + dh[4] + dh[5] + dh[6] + dh[7]) * sc1;

                // The dmin term needs the sum of THIS LANE's activations,
                // and the packed block's precomputed sums are per 32-element
                // sub-block — which only helps a lane that owns a whole one.
                // llama.cpp does not read a precomputed sum at all: it takes
                // `dp4a(0x01010101, u)`, so any lane granularity is free.
                // Same trick here, and it drops a 32-byte load per lane per
                // block as well.
                Vector<uint8,32> ones = (lo ^ lo) | 1;
                // Unit 61: the activation sums and the two dot sums are reduced
                // FIRST and scaled as scalars — integer-exact, so bit-identical to
                // scaling the eight lanes, and 2 quarter-rate multiplies where
                // there were 16 (v_mul_lo/v_mad_u64 are 4-cycle on RDNA).
                Vector<int32,8> os0 = ones.dotAccum(a0, zv);
                Vector<int32,8> os1 = ones.dotAccum(a1, zv);
                int32 as0 = os0[0] + os0[1] + os0[2] + os0[3]
                    + os0[4] + os0[5] + os0[6] + os0[7];
                int32 as1 = os1[0] + os1[1] + os1[2] + os1[3]
                    + os1[4] + os1[5] + os1[6] + os1[7];
                int32 dmins = as0 * mn0 + as1 * mn1;

                Vector<int8,4> dv = xp.vload<4>((int64) xr + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dv[0] & 255)
                    | (((int32) dv[1] & 255) << 8)
                    | (((int32) dv[2] & 255) << 16)
                    | (((int32) dv[3] & 255) << 24));

                acc = acc + d * xs * (float32) sumi
                          - dmin * xs * (float32) dmins;
                b = b + 8;
            }
        }
        // The wave reduction, as a shared-memory tree.
        //
        // llama.cpp uses a shuffle butterfly (warp_reduce_sum) here and this
        // was written that way first. Two things came back: the shuffle form
        // was WRONG on every row, and it was exactly as FAST — 89.1 against
        // 88.5 GB/s at 1024 rows, 128.5 against 127.9 at 14336. So the
        // reduction is not what this kernel spends its time on, and the
        // correct-and-simple form is kept until something says otherwise.
        // 2026-08-26: ONE subgroup reduction, not a five-barrier LDS
        // tree. The workgroup IS one wave, so the tree moved through
        // memory what the hardware reduces across lanes — cheap when the
        // k-loop is long, and it is not: at K=4096 a wave runs TWO
        // iterations and then pays the whole tail. Measured on the two
        // formats that carry 95% of this model's decode traffic, cold
        // pool, interleaved min-of-5, GiB/s:
        //   q4_K 14336x4096  180.9 -> 193.8      q4_K 4096x14336 171.6 -> 177.2
        //   q4_K  4096x4096  155.2 -> 157.1      q4_K 1024x4096  129.4 -> 131.4
        //   q6_K  4096x14336 136.5 -> 137.5      q6_K 1024x4096  124.8 -> 127.5
        //   q6_K 128256x4096 158.7 -> 161.0
        // A hand-written shuffle butterfly was tried in 2026-08 and was
        // both wrong and exactly as fast — but at half this kernel's
        // current rate, where the tail was half the share it is now.
        uint32 r = 0;
        while (r < rpw) {
            float32 part = 0.0f;
            if (sub == r) { part = acc; }
            float32 tot = Wave.reduceSumF32(part);
            if (lane == 0 && rowBase + r < rowsPerExpert) {
                y[yOff + (int64) kk * (int64) rowsPerExpert
                  + (int64) (rowBase + r)] = tot;
            }
            r = r + 1;
        }
    }

    @Kernel
    public static void q6kQ8IdMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            KernelBuffer<int32> sel, uint32 rowsPerExpert,
            int64 blocksPerRow, int64 xRowBlocks, int64 yOff) {
        uint32 lane = KernelThread.x();
        uint32 wave = KernelThread.globalIdX() / 32;
        // Unit 47: short rows pack rowsPerWave rows per wave (see the
        // dense twin); wavesPerExpert waves cover one expert.
        uint32 lpr = 4 * (uint32) blocksPerRow;
        uint32 rpw = 1;
        uint32 rl = lane;
        uint32 sub = 0;
        if (lpr < 32) { rpw = 32 / lpr; sub = lane / lpr; rl = lane - sub * lpr; }
        uint32 wpe = (rowsPerExpert + rpw - 1) / rpw;
        uint32 kk = wave / wpe;
        uint32 rowBase = (wave - kk * wpe) * rpw;
        uint32 row = rowBase + sub;
        uint32 rowBytes = (uint32) blocksPerRow * 210;   // unit 61: uint32 offsets
        uint32 bpr = (uint32) blocksPerRow;
        uint32 xrb = (uint32) xRowBlocks;
        float32 acc = 0.0f;
        if (sub < rpw && row < rowsPerExpert) {
            uint32 rb = ((uint32) sel[(int64) kk] * rowsPerExpert + row) * rowBytes;
            uint32 xbase = kk * xrb;
            int32 m = (int32) (rl % 4);
            int32 g = m / 2;               // which 128-element half
            int32 a = m - g * 2;           // which 16-lane slice of it
            uint32 b = rl / 4;  // 8 blocks in flight
            Vector<int32,4> z4 = heap Vector<int32,4>(0, 0, 0, 0);
            while (b < bpr) {
                uint32 ro = rb + b * 210;
                uint32 rqa = ro + (uint32) (64 * g + 16 * a);
                uint32 rqh = ro + (uint32) (32 * g + 16 * a);
                uint32 rs0 = ro + (uint32) (8 * g + a);
                float32 d = QuantKernel.f16AtDev(packed, (int64) ro + 208L);
                uint32 xb = (xbase + b) * 320;
                uint32 xa0 = xb + (uint32) (16 * (8 * g + a));
                Vector<int8,4> dvs = xp.vload<4>((int64) xb + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dvs[0] & 255)
                    | (((int32) dvs[1] & 255) << 8)
                    | (((int32) dvs[2] & 255) << 16)
                    | (((int32) dvs[3] & 255) << 24));
                Vector<int8,16> qlA = packed.vload<16>(
                    (int64) rqa);
                Vector<int8,16> qlB = packed.vload<16>(
                    (int64) rqa + 32L);
                Vector<int8,16> qh16 = packed.vload<16>(
                    (int64) rqh + 128L);
                Vector<uint8,16> qu_0 = ((qlA.asWords() & 252645135) | ((qh16.asWords() << 4) & 808464432)).asBytes().asUnsigned();
                Vector<int8,16> a_0 = xp.vload<16>((int64) xa0);
                Vector<uint8,16> on_0 = (qu_0 ^ qu_0) | 1;
                Vector<int32,4> dv_0 = qu_0.dotAccum(a_0, z4);
                Vector<int32,4> sv_0 = on_0.dotAccum(a_0, z4);
                int32 dot_0 = dv_0[0] + dv_0[1] + dv_0[2] + dv_0[3];
                int32 as_0 = sv_0[0] + sv_0[1] + sv_0[2] + sv_0[3];
                int32 sc_0 = (int32) packed[(int64) rs0 + 192L];
                acc = acc + d * xs
                    * (float32) (sc_0 * (dot_0 - 32 * as_0));
                Vector<uint8,16> qu_1 = ((qlB.asWords() & 252645135) | ((qh16.asWords() << 2) & 808464432)).asBytes().asUnsigned();
                Vector<int8,16> a_1 = xp.vload<16>((int64) xa0 + 32L);
                Vector<uint8,16> on_1 = (qu_1 ^ qu_1) | 1;
                Vector<int32,4> dv_1 = qu_1.dotAccum(a_1, z4);
                Vector<int32,4> sv_1 = on_1.dotAccum(a_1, z4);
                int32 dot_1 = dv_1[0] + dv_1[1] + dv_1[2] + dv_1[3];
                int32 as_1 = sv_1[0] + sv_1[1] + sv_1[2] + sv_1[3];
                int32 sc_1 = (int32) packed[(int64) rs0 + 194L];
                acc = acc + d * xs
                    * (float32) (sc_1 * (dot_1 - 32 * as_1));
                Vector<uint8,16> qu_2 = (((qlA.asWords() >> 4) & 252645135) | (qh16.asWords() & 808464432)).asBytes().asUnsigned();
                Vector<int8,16> a_2 = xp.vload<16>((int64) xa0 + 64L);
                Vector<uint8,16> on_2 = (qu_2 ^ qu_2) | 1;
                Vector<int32,4> dv_2 = qu_2.dotAccum(a_2, z4);
                Vector<int32,4> sv_2 = on_2.dotAccum(a_2, z4);
                int32 dot_2 = dv_2[0] + dv_2[1] + dv_2[2] + dv_2[3];
                int32 as_2 = sv_2[0] + sv_2[1] + sv_2[2] + sv_2[3];
                int32 sc_2 = (int32) packed[(int64) rs0 + 196L];
                acc = acc + d * xs
                    * (float32) (sc_2 * (dot_2 - 32 * as_2));
                Vector<uint8,16> qu_3 = (((qlB.asWords() >> 4) & 252645135) | ((qh16.asWords() >> 2) & 808464432)).asBytes().asUnsigned();
                Vector<int8,16> a_3 = xp.vload<16>((int64) xa0 + 96L);
                Vector<uint8,16> on_3 = (qu_3 ^ qu_3) | 1;
                Vector<int32,4> dv_3 = qu_3.dotAccum(a_3, z4);
                Vector<int32,4> sv_3 = on_3.dotAccum(a_3, z4);
                int32 dot_3 = dv_3[0] + dv_3[1] + dv_3[2] + dv_3[3];
                int32 as_3 = sv_3[0] + sv_3[1] + sv_3[2] + sv_3[3];
                int32 sc_3 = (int32) packed[(int64) rs0 + 198L];
                acc = acc + d * xs
                    * (float32) (sc_3 * (dot_3 - 32 * as_3));
                b = b + 8;
            }
        }
        uint32 r = 0;
        while (r < rpw) {
            float32 part = 0.0f;
            if (sub == r) { part = acc; }
            float32 tot = Wave.reduceSumF32(part);
            if (lane == 0 && rowBase + r < rowsPerExpert) {
                y[yOff + (int64) kk * (int64) rowsPerExpert
                  + (int64) (rowBase + r)] = tot;
            }
            r = r + 1;
        }
    }


    /**
     * Unit 48: gate AND up in one indirected launch, the GLU in its
     * epilogue. A wave owns output row `row` of expert `sel[kk]` in
     * BOTH banks — the same lane mapping as {@link #q4kQ8IdMatVecKernel}
     * (four lanes per block, short rows packed per wave), the
     * activation side loaded once and used against both weight rows.
     * Two accumulators, two segmented reductions, and lane 0 writes
     * `act(gate) * up` straight into the GLU'd middle: one launch and
     * one pass over the activations where the chain had gate, up and
     * a GLU kernel. The per-row math is the id kernel's, so each
     * bank's dot product is bit-identical to a separate launch.
     */
    @Kernel
    public static void q4kQ8IdGateUpGluKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packedG, KernelBuffer<int8> packedU,
            KernelBuffer<int8> xp, KernelBuffer<int32> sel,
            uint32 rowsPerExpert, int64 blocksPerRow, int64 xRowBlocks,
            int32 act) {
        uint32 lane = KernelThread.x();
        uint32 wave = KernelThread.globalIdX() / 32;
        uint32 lpr = 4 * (uint32) blocksPerRow;
        uint32 rpw = 1;
        uint32 rl = lane;
        uint32 sub = 0;
        if (lpr < 32) { rpw = 32 / lpr; sub = lane / lpr; rl = lane - sub * lpr; }
        uint32 wpe = (rowsPerExpert + rpw - 1) / rpw;
        uint32 kk = wave / wpe;
        uint32 rowBase = (wave - kk * wpe) * rpw;
        uint32 row = rowBase + sub;
        uint32 rowBytes = (uint32) blocksPerRow * 144;   // unit 61: uint32 offsets
        uint32 bpr = (uint32) blocksPerRow;
        uint32 xrb = (uint32) xRowBlocks;
        float32 accG = 0.0f;
        float32 accU = 0.0f;
        if (sub < rpw && row < rowsPerExpert) {
            uint32 rb = ((uint32) sel[(int64) kk] * rowsPerExpert + row) * rowBytes;
            uint32 xbase = kk * xrb;
            int32 g = (int32) (rl % 4);
            int32 sh0 = 16 * (g & 1);
            int32 sh1 = sh0 + 8;
            uint32 b = rl / 4;
            Vector<int32,8> zv = heap Vector<int32,8>(0, 0, 0, 0, 0, 0, 0, 0);
            while (b < bpr) {
                uint32 ro = rb + b * 144;
                uint32 rw = ro + (uint32) (32 * g);
                // Activation side, once.
                uint32 xb = (xbase + b) * 320 + (uint32) (64 * g);
                uint32 xr = (xbase + b) * 320;
                Vector<int8,32> a0 = xp.vload<32>((int64) xb);
                Vector<int8,32> a1 = xp.vload<32>((int64) xb + 32L);
                Vector<int8,4> dv = xp.vload<4>((int64) xr + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dv[0] & 255)
                    | (((int32) dv[1] & 255) << 8)
                    | (((int32) dv[2] & 255) << 16)
                    | (((int32) dv[3] & 255) << 24));
                Vector<uint8,32> ones = (a0.asUnsigned() ^ a0.asUnsigned()) | 1;
                // Unit 61: the activation sums and the two dot sums are reduced
                // FIRST and scaled as scalars — integer-exact, so bit-identical to
                // scaling the eight lanes, and 2 quarter-rate multiplies where
                // there were 16 (v_mul_lo/v_mad_u64 are 4-cycle on RDNA).
                Vector<int32,8> os0 = ones.dotAccum(a0, zv);
                Vector<int32,8> os1 = ones.dotAccum(a1, zv);
                int32 as0 = os0[0] + os0[1] + os0[2] + os0[3]
                    + os0[4] + os0[5] + os0[6] + os0[7];
                int32 as1 = os1[0] + os1[1] + os1[2] + os1[3]
                    + os1[4] + os1[5] + os1[6] + os1[7];

                // ── gate ──
                Vector<int8,16> hv = packedG.vload<16>((int64) ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                // Unit 60: scale bytes by word and runtime shift (no runtime
                // lane index — that lowered to a 16-way select chain per byte).
                Vector<int32,4> hvw = hv.asWords();
                int32 hvsA = (hvw[1] >> sh0) & 255;
                int32 hvsB = (hvw[1] >> sh1) & 255;
                int32 hvmC = (hvw[2] >> sh0) & 255;
                int32 hvmD = (hvw[2] >> sh1) & 255;
                int32 sc0 = hvsA & 63;
                int32 sc1 = hvsB & 63;
                int32 mn0 = hvmC & 63;
                int32 mn1 = hvmD & 63;
                if (g >= 2) {
                    int32 k0 = (hvw[3] >> sh0) & 255;
                    int32 k1 = (hvw[3] >> sh1) & 255;
                    sc0 = (k0 & 15) | ((hvsA >> 2) & 48);
                    sc1 = (k1 & 15) | ((hvsB >> 2) & 48);
                    mn0 = (k0 >> 4) | ((hvmC >> 2) & 48);
                    mn1 = (k1 >> 4) | ((hvmD >> 2) & 48);
                }
                Vector<uint8,32> raw = packedG.vload<32>(
                    (int64) rw + 16L).asUnsigned();
                Vector<int32,8> raww = raw.asWords();
                Vector<uint8,32> lo = (raww & 252645135).asBytes().asUnsigned();
                Vector<uint8,32> hi = ((raww >> 4) & 252645135).asBytes().asUnsigned();
                Vector<int32,8> dl = lo.dotAccum(a0, zv);
                Vector<int32,8> dh = hi.dotAccum(a1, zv);
                int32 sumi = (dl[0] + dl[1] + dl[2] + dl[3]
                    + dl[4] + dl[5] + dl[6] + dl[7]) * sc0
                             + (dh[0] + dh[1] + dh[2] + dh[3]
                                 + dh[4] + dh[5] + dh[6] + dh[7]) * sc1;
                int32 dmins = as0 * mn0 + as1 * mn1;
                accG = accG + d * xs * (float32) sumi
                            - dmin * xs * (float32) dmins;

                // ── up ──
                Vector<int8,16> hvU = packedU.vload<16>((int64) ro);
                float32 dU = GgufFile.halfBitsToF32(((int32) hvU[0] & 255)
                    | (((int32) hvU[1] & 255) << 8));
                float32 dminU = GgufFile.halfBitsToF32(((int32) hvU[2] & 255)
                    | (((int32) hvU[3] & 255) << 8));
                // Unit 60: scale bytes by word and runtime shift (no runtime
                // lane index — that lowered to a 16-way select chain per byte).
                Vector<int32,4> hvUw = hvU.asWords();
                int32 hvUsA = (hvUw[1] >> sh0) & 255;
                int32 hvUsB = (hvUw[1] >> sh1) & 255;
                int32 hvUmC = (hvUw[2] >> sh0) & 255;
                int32 hvUmD = (hvUw[2] >> sh1) & 255;
                int32 sc0U = hvUsA & 63;
                int32 sc1U = hvUsB & 63;
                int32 mn0U = hvUmC & 63;
                int32 mn1U = hvUmD & 63;
                if (g >= 2) {
                    int32 k0 = (hvUw[3] >> sh0) & 255;
                    int32 k1 = (hvUw[3] >> sh1) & 255;
                    sc0U = (k0 & 15) | ((hvUsA >> 2) & 48);
                    sc1U = (k1 & 15) | ((hvUsB >> 2) & 48);
                    mn0U = (k0 >> 4) | ((hvUmC >> 2) & 48);
                    mn1U = (k1 >> 4) | ((hvUmD >> 2) & 48);
                }
                Vector<uint8,32> rawU = packedU.vload<32>(
                    (int64) rw + 16L).asUnsigned();
                Vector<int32,8> rawUw = rawU.asWords();
                Vector<uint8,32> loU = (rawUw & 252645135).asBytes().asUnsigned();
                Vector<uint8,32> hiU = ((rawUw >> 4) & 252645135).asBytes().asUnsigned();
                Vector<int32,8> dlU = loU.dotAccum(a0, zv);
                Vector<int32,8> dhU = hiU.dotAccum(a1, zv);
                int32 sumiU = (dlU[0] + dlU[1] + dlU[2] + dlU[3]
                    + dlU[4] + dlU[5] + dlU[6] + dlU[7]) * sc0U
                             + (dhU[0] + dhU[1] + dhU[2] + dhU[3]
                                 + dhU[4] + dhU[5] + dhU[6] + dhU[7]) * sc1U;
                int32 dminsU = as0 * mn0U + as1 * mn1U;
                accU = accU + dU * xs * (float32) sumiU
                            - dminU * xs * (float32) dminsU;
                b = b + 8;
            }
        }
        uint32 r = 0;
        while (r < rpw) {
            float32 partG = 0.0f;
            float32 partU = 0.0f;
            if (sub == r) { partG = accG; partU = accU; }
            float32 totG = Wave.reduceSumF32(partG);
            float32 totU2 = Wave.reduceSumF32(partU);
            if (lane == 0 && rowBase + r < rowsPerExpert) {
                float32 x = totG;
                float32 a = 0.0f;
                if (act == 1) {
                    float32 t = 0.7978845608f * (x + 0.044715f * x * x * x);
                    float32 th = 1.0f - 2.0f / (Math.exp(2.0f * t) + 1.0f);
                    a = 0.5f * x * (1.0f + th);
                } else {
                    a = x / (1.0f + Math.exp(0.0f - x));
                }
                y[(int64) kk * (int64) rowsPerExpert
                  + (int64) (rowBase + r)] = a * totU2;
            }
            r = r + 1;
        }
    }

    public static void idGateUpGluLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> slabG, KernelBuffer<int8> slabU,
            KernelBuffer<int8> xp, KernelBuffer<int32> sel, int32 used,
            int64 rowsPerExpert, int64 cols, int32 act) {
        QuantKernel.requireOffsets32(slabG, "idGateUpGlu");
        QuantKernel.requireOffsets32(slabU, "idGateUpGlu");
        int64 rpw = QuantKernel.rowsPerWave(cols / 256L);
        int64 wpe = (rowsPerExpert + rpw - 1L) / rpw;
        uint32 wgs = (uint32) (wpe * (int64) used);
        KernelStream s = QuantKernel.stream();
        q4kQ8IdGateUpGluKernel.launch(s, grid: [wgs], block: [32])
            (y, slabG, slabU, xp, sel, (uint32) rowsPerExpert, cols / 256L,
             0L, act);
        return;
    }

    /** {@link #q4kQ8IdMatVecKernel} / the Q6_K twin, dispatched by ggml
     *  type. False = no id-kernel for this type (caller falls back). */

    /**
     * Unit 51: the down projection for ALL used experts of one output
     * row in one wave, the combine in the epilogue: lane slot
     * (lane / 4) walks the (expert, block) pairs kb = slot, slot+8, ...
     * over used * blocksPerRow of them — so a 3-block row fills the
     * wave (24 pairs, three full iterations) where one row per wave
     * left 20 lanes idle — and accumulates w_k * (its share of expert
     * k's dot). One reduction, and lane 0 adds the row's expert sum
     * onto the residual. The per-block math is the id kernel's; the
     * association differs (the weight rides each partial), so the
     * acceptance is generation identity, not bit-identity.
     */
    @Kernel
    public static void q4kQ8IdDownCombineKernel(KernelBuffer<float32> hs,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            KernelBuffer<int32> sel, KernelBuffer<float32> wSel,
            uint32 rowsPerExpert, int64 blocksPerRow, int64 xRowBlocks,
            uint32 used, KernelBuffer<float32> nOut, KernelBuffer<int8> pk,
            KernelBuffer<float32> nw, uint32 dim, float32 eps, int32 form,
            KernelBuffer<int32> counter, uint32 normTail) {
        Shared<float32> part = shared float32[8];
        Shared<int32> psum = shared int32[256];
        Shared<int32> tk = shared int32[1];
        uint32 lane = KernelThread.x() % 32;
        uint32 row = KernelThread.globalIdX() / 32;
        uint32 rowBytes = (uint32) blocksPerRow * 144;   // unit 61: uint32 offsets
        uint32 bpr = (uint32) blocksPerRow;
        uint32 xrb = (uint32) xRowBlocks;
        float32 acc = 0.0f;
        if (row < rowsPerExpert) {
            int32 g = (int32) (lane % 4);
            int32 sh0 = 16 * (g & 1);
            int32 sh1 = sh0 + 8;
            Vector<int32,8> zv = heap Vector<int32,8>(0, 0, 0, 0, 0, 0, 0, 0);
            uint32 total = used * bpr;
            uint32 kb = lane / 4;
            while (kb < total) {
                uint32 k = kb / bpr;
                uint32 b = kb - k * bpr;
                uint32 rb = ((uint32) sel[(int64) k] * rowsPerExpert + row) * rowBytes;
                uint32 xbase = k * xrb;
                float32 wk = wSel[(int64) k];
                uint32 ro = rb + b * 144;
                uint32 rw = ro + (uint32) (32 * g);

                // The header — { f16 d; f16 dmin; u8 scales[12] } = 16 bytes.
                // Read by all four lanes of the block; it is 16 bytes and it
                // is in cache after the first.
                Vector<int8,16> hv = packed.vload<16>((int64) ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                // Only THIS lane's two sub-blocks are unpacked, where the
                // serial kernel unpacks all eight — and the two forms are
                // NOT interchangeable. Q4_K packs sub-blocks 0-3 and 4-7 in
                // different fields, and a lane owning `g` needs sub-blocks
                // 2g and 2g+1, so g < 2 lands entirely in the first field
                // and g >= 2 entirely in the second. Reading field `g`
                // instead of sub-block `2g` is the shape of the first
                // version of this kernel, which was wrong on every row.
                // Unit 60: scale bytes by word and runtime shift (no runtime
                // lane index — that lowered to a 16-way select chain per byte).
                Vector<int32,4> hvw = hv.asWords();
                int32 hvsA = (hvw[1] >> sh0) & 255;
                int32 hvsB = (hvw[1] >> sh1) & 255;
                int32 hvmC = (hvw[2] >> sh0) & 255;
                int32 hvmD = (hvw[2] >> sh1) & 255;
                int32 sc0 = hvsA & 63;
                int32 sc1 = hvsB & 63;
                int32 mn0 = hvmC & 63;
                int32 mn1 = hvmD & 63;
                if (g >= 2) {
                    int32 k0 = (hvw[3] >> sh0) & 255;
                    int32 k1 = (hvw[3] >> sh1) & 255;
                    sc0 = (k0 & 15) | ((hvsA >> 2) & 48);
                    sc1 = (k1 & 15) | ((hvsB >> 2) & 48);
                    mn0 = (k0 >> 4) | ((hvmC >> 2) & 48);
                    mn1 = (k1 >> 4) | ((hvmD >> 2) & 48);
                }

                Vector<uint8,32> raw = packed.vload<32>(
                    (int64) rw + 16L).asUnsigned();
                Vector<int32,8> raww = raw.asWords();
                Vector<uint8,32> lo = (raww & 252645135).asBytes().asUnsigned();
                Vector<uint8,32> hi = ((raww >> 4) & 252645135).asBytes().asUnsigned();
                uint32 xb = (xbase + b) * 320 + (uint32) (64 * g);
                uint32 xr = (xbase + b) * 320;
                Vector<int8,32> a0 = xp.vload<32>((int64) xb);
                Vector<int8,32> a1 = xp.vload<32>((int64) xb + 32L);
                Vector<int32,8> dl = lo.dotAccum(a0, zv);
                Vector<int32,8> dh = hi.dotAccum(a1, zv);
                int32 sumi = (dl[0] + dl[1] + dl[2] + dl[3]
                    + dl[4] + dl[5] + dl[6] + dl[7]) * sc0
                             + (dh[0] + dh[1] + dh[2] + dh[3]
                                 + dh[4] + dh[5] + dh[6] + dh[7]) * sc1;

                // The dmin term needs the sum of THIS LANE's activations,
                // and the packed block's precomputed sums are per 32-element
                // sub-block — which only helps a lane that owns a whole one.
                // llama.cpp does not read a precomputed sum at all: it takes
                // `dp4a(0x01010101, u)`, so any lane granularity is free.
                // Same trick here, and it drops a 32-byte load per lane per
                // block as well.
                Vector<uint8,32> ones = (lo ^ lo) | 1;
                // Unit 61: the activation sums and the two dot sums are reduced
                // FIRST and scaled as scalars — integer-exact, so bit-identical to
                // scaling the eight lanes, and 2 quarter-rate multiplies where
                // there were 16 (v_mul_lo/v_mad_u64 are 4-cycle on RDNA).
                Vector<int32,8> os0 = ones.dotAccum(a0, zv);
                Vector<int32,8> os1 = ones.dotAccum(a1, zv);
                int32 as0 = os0[0] + os0[1] + os0[2] + os0[3]
                    + os0[4] + os0[5] + os0[6] + os0[7];
                int32 as1 = os1[0] + os1[1] + os1[2] + os1[3]
                    + os1[4] + os1[5] + os1[6] + os1[7];
                int32 dmins = as0 * mn0 + as1 * mn1;

                Vector<int8,4> dv = xp.vload<4>((int64) xr + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dv[0] & 255)
                    | (((int32) dv[1] & 255) << 8)
                    | (((int32) dv[2] & 255) << 16)
                    | (((int32) dv[3] & 255) << 24));

                acc = acc + wk * (d * xs * (float32) sumi
                          - dmin * xs * (float32) dmins);
                kb = kb + 8;
            }
        }
        float32 tot = Wave.reduceSumF32(acc);
        if (lane == 0 && row < rowsPerExpert) {
            hs[(int64) row] = hs[(int64) row] + tot;
        }
        // ── Unit 59b: the NEXT layer's input norm + pack in this
        // launch's tail. Every wave has added its row; the last block
        // to arrive (ticket) norms the whole residual row and packs it
        // for the next layer's q|k|v, so the norm launch and its CP
        // gap are gone. The block is 256 threads (eight row waves) so
        // the tail is rmsnormPackRowF32's body verbatim.
        if (normTail == 0) { return; }
        uint32 tid = KernelThread.x();
        if (lane == 0) { Barrier.deviceMemory(MemoryOrder.Release); }
        Barrier.workgroup();
        if (tid == 0) {
            int32 old = counter.atomicAdd(0L, 1, MemoryOrder.AcqRel);
            tk[0] = old;
        }
        Barrier.workgroup();
        uint32 nblk = (rowsPerExpert + 7) / 8;
        if ((uint32) tk[0] != nblk - 1) { return; }
        Barrier.deviceMemory(MemoryOrder.Acquire);
        if (tid == 0) { counter[0L] = 0; }
        uint32 wid = tid / 32;
        uint32 wl = tid % 32;
        float32 ss = 0.0f;
        uint32 i = tid;
        while (i < dim) {
            float32 v = hs[(int64) i];
            ss = ss + v * v;
            i = i + 256;
        }
        float32 wsum = Wave.reduceSumF32(ss);
        if (wl == 0) { part[wid] = wsum; }
        Barrier.workgroup();
        float32 tsq = part[0] + part[1] + part[2] + part[3]
            + part[4] + part[5] + part[6] + part[7];
        float32 scale = 1.0f / Math.sqrt(tsq / (float32) dim + eps);
        uint32 blocks = dim / 256;
        float32 v0 = 0.0f; float32 v1 = 0.0f; float32 v2 = 0.0f; float32 v3 = 0.0f;
        float32 v4 = 0.0f; float32 v5 = 0.0f; float32 v6 = 0.0f; float32 v7 = 0.0f;
        uint32 e0 = wid * 256 + wl * 8;
        if (wid < blocks) {
            float32 w0 = nw[e0]; float32 w1 = nw[e0 + 1]; float32 w2 = nw[e0 + 2];
            float32 w3 = nw[e0 + 3]; float32 w4 = nw[e0 + 4]; float32 w5 = nw[e0 + 5];
            float32 w6 = nw[e0 + 6]; float32 w7 = nw[e0 + 7];
            if (form == 1) {
                w0 = 1.0f + w0; w1 = 1.0f + w1; w2 = 1.0f + w2; w3 = 1.0f + w3;
                w4 = 1.0f + w4; w5 = 1.0f + w5; w6 = 1.0f + w6; w7 = 1.0f + w7;
            }
            v0 = hs[(int64) e0] * scale * w0;
            v1 = hs[(int64) (e0 + 1)] * scale * w1;
            v2 = hs[(int64) (e0 + 2)] * scale * w2;
            v3 = hs[(int64) (e0 + 3)] * scale * w3;
            v4 = hs[(int64) (e0 + 4)] * scale * w4;
            v5 = hs[(int64) (e0 + 5)] * scale * w5;
            v6 = hs[(int64) (e0 + 6)] * scale * w6;
            v7 = hs[(int64) (e0 + 7)] * scale * w7;
            nOut[e0] = v0; nOut[e0 + 1] = v1; nOut[e0 + 2] = v2; nOut[e0 + 3] = v3;
            nOut[e0 + 4] = v4; nOut[e0 + 5] = v5; nOut[e0 + 6] = v6; nOut[e0 + 7] = v7;
        }
        float32 amax = 0.0f;
        float32 av = v0; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v1; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v2; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v3; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v4; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v5; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v6; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v7; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        float32 bmax = Wave.reduceMaxF32(amax);
        float32 inv = 0.0f;
        if (bmax > 0.0f) { inv = 127.0f / bmax; }
        int64 ob = (int64) wid * 320L;
        int32 sm = 0;
        if (wid < blocks) {
            int32 q0 = (int32) Math.round(v0 * inv);
            int32 q1 = (int32) Math.round(v1 * inv);
            int32 q2 = (int32) Math.round(v2 * inv);
            int32 q3 = (int32) Math.round(v3 * inv);
            int32 q4 = (int32) Math.round(v4 * inv);
            int32 q5 = (int32) Math.round(v5 * inv);
            int32 q6 = (int32) Math.round(v6 * inv);
            int32 q7 = (int32) Math.round(v7 * inv);
            int64 qo = ob + (int64) (wl * 8);
            pk[qo] = (int8) q0; pk[qo + 1L] = (int8) q1;
            pk[qo + 2L] = (int8) q2; pk[qo + 3L] = (int8) q3;
            pk[qo + 4L] = (int8) q4; pk[qo + 5L] = (int8) q5;
            pk[qo + 6L] = (int8) q6; pk[qo + 7L] = (int8) q7;
            sm = q0 + q1 + q2 + q3 + q4 + q5 + q6 + q7;
        }
        psum[tid] = sm;
        Barrier.workgroup();
        if (wid < blocks && wl < 8) {
            uint32 base = wid * 32 + wl * 4;
            int32 tsum = psum[base] + psum[base + 1]
                       + psum[base + 2] + psum[base + 3];
            int64 so = ob + 256L + (int64) (wl * 4);
            int32 b0 = tsum & 255;
            int32 b1 = (tsum >> 8) & 255;
            int32 b2 = (tsum >> 16) & 255;
            int32 b3 = (tsum >> 24) & 255;
            if (b0 > 127) { b0 = b0 - 256; }
            if (b1 > 127) { b1 = b1 - 256; }
            if (b2 > 127) { b2 = b2 - 256; }
            if (b3 > 127) { b3 = b3 - 256; }
            pk[so] = (int8) b0;
            pk[so + 1L] = (int8) b1;
            pk[so + 2L] = (int8) b2;
            pk[so + 3L] = (int8) b3;
        }
        if (wid < blocks && wl == 0) {
            float32 dsc = bmax / 127.0f;
            int32 db = Cajeta.f32ToBits(dsc);
            int32 e1 = db & 255;
            int32 e2 = (db >> 8) & 255;
            int32 e3 = (db >> 16) & 255;
            int32 e4 = (db >> 24) & 255;
            if (e1 > 127) { e1 = e1 - 256; }
            if (e2 > 127) { e2 = e2 - 256; }
            if (e3 > 127) { e3 = e3 - 256; }
            if (e4 > 127) { e4 = e4 - 256; }
            pk[ob + 288L] = (int8) e1;
            pk[ob + 289L] = (int8) e2;
            pk[ob + 290L] = (int8) e3;
            pk[ob + 291L] = (int8) e4;
        }
    }

    /**
     * Unit 51: the down projection for ALL used experts of one output
     * row in one wave, the combine in the epilogue: lane slot
     * (lane / 4) walks the (expert, block) pairs kb = slot, slot+8, ...
     * over used * blocksPerRow of them — so a 3-block row fills the
     * wave (24 pairs, three full iterations) where one row per wave
     * left 20 lanes idle — and accumulates w_k * (its share of expert
     * k's dot). One reduction, and lane 0 adds the row's expert sum
     * onto the residual. The per-block math is the id kernel's; the
     * association differs (the weight rides each partial), so the
     * acceptance is generation identity, not bit-identity.
     */
    @Kernel
    public static void q6kQ8IdDownCombineKernel(KernelBuffer<float32> hs,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            KernelBuffer<int32> sel, KernelBuffer<float32> wSel,
            uint32 rowsPerExpert, int64 blocksPerRow, int64 xRowBlocks,
            uint32 used, KernelBuffer<float32> nOut, KernelBuffer<int8> pk,
            KernelBuffer<float32> nw, uint32 dim, float32 eps, int32 form,
            KernelBuffer<int32> counter, uint32 normTail) {
        Shared<float32> part = shared float32[8];
        Shared<int32> psum = shared int32[256];
        Shared<int32> tk = shared int32[1];
        uint32 lane = KernelThread.x() % 32;
        uint32 row = KernelThread.globalIdX() / 32;
        uint32 rowBytes = (uint32) blocksPerRow * 210;   // unit 61: uint32 offsets
        uint32 bpr = (uint32) blocksPerRow;
        uint32 xrb = (uint32) xRowBlocks;
        float32 acc = 0.0f;
        if (row < rowsPerExpert) {
            int32 m = (int32) (lane % 4);
            int32 g = m / 2;               // which 128-element half
            int32 a = m - g * 2;           // which 16-lane slice of it
            Vector<int32,4> z4 = heap Vector<int32,4>(0, 0, 0, 0);
            uint32 total = used * bpr;
            uint32 kb = lane / 4;
            while (kb < total) {
                uint32 k = kb / bpr;
                uint32 b = kb - k * bpr;
                uint32 rb = ((uint32) sel[(int64) k] * rowsPerExpert + row) * rowBytes;
                uint32 xbase = k * xrb;
                float32 wk = wSel[(int64) k];
                uint32 ro = rb + b * 210;
                uint32 rqa = ro + (uint32) (64 * g + 16 * a);
                uint32 rqh = ro + (uint32) (32 * g + 16 * a);
                uint32 rs0 = ro + (uint32) (8 * g + a);
                float32 d = QuantKernel.f16AtDev(packed, (int64) ro + 208L);
                uint32 xb = (xbase + b) * 320;
                uint32 xa0 = xb + (uint32) (16 * (8 * g + a));
                Vector<int8,4> dvs = xp.vload<4>((int64) xb + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dvs[0] & 255)
                    | (((int32) dvs[1] & 255) << 8)
                    | (((int32) dvs[2] & 255) << 16)
                    | (((int32) dvs[3] & 255) << 24));
                Vector<int8,16> qlA = packed.vload<16>(
                    (int64) rqa);
                Vector<int8,16> qlB = packed.vload<16>(
                    (int64) rqa + 32L);
                Vector<int8,16> qh16 = packed.vload<16>(
                    (int64) rqh + 128L);
                Vector<uint8,16> qu_0 = ((qlA.asWords() & 252645135) | ((qh16.asWords() << 4) & 808464432)).asBytes().asUnsigned();
                Vector<int8,16> a_0 = xp.vload<16>((int64) xa0);
                Vector<uint8,16> on_0 = (qu_0 ^ qu_0) | 1;
                Vector<int32,4> dv_0 = qu_0.dotAccum(a_0, z4);
                Vector<int32,4> sv_0 = on_0.dotAccum(a_0, z4);
                int32 dot_0 = dv_0[0] + dv_0[1] + dv_0[2] + dv_0[3];
                int32 as_0 = sv_0[0] + sv_0[1] + sv_0[2] + sv_0[3];
                int32 sc_0 = (int32) packed[(int64) rs0 + 192L];
                acc = acc + wk * d * xs
                    * (float32) (sc_0 * (dot_0 - 32 * as_0));
                Vector<uint8,16> qu_1 = ((qlB.asWords() & 252645135) | ((qh16.asWords() << 2) & 808464432)).asBytes().asUnsigned();
                Vector<int8,16> a_1 = xp.vload<16>((int64) xa0 + 32L);
                Vector<uint8,16> on_1 = (qu_1 ^ qu_1) | 1;
                Vector<int32,4> dv_1 = qu_1.dotAccum(a_1, z4);
                Vector<int32,4> sv_1 = on_1.dotAccum(a_1, z4);
                int32 dot_1 = dv_1[0] + dv_1[1] + dv_1[2] + dv_1[3];
                int32 as_1 = sv_1[0] + sv_1[1] + sv_1[2] + sv_1[3];
                int32 sc_1 = (int32) packed[(int64) rs0 + 194L];
                acc = acc + wk * d * xs
                    * (float32) (sc_1 * (dot_1 - 32 * as_1));
                Vector<uint8,16> qu_2 = (((qlA.asWords() >> 4) & 252645135) | (qh16.asWords() & 808464432)).asBytes().asUnsigned();
                Vector<int8,16> a_2 = xp.vload<16>((int64) xa0 + 64L);
                Vector<uint8,16> on_2 = (qu_2 ^ qu_2) | 1;
                Vector<int32,4> dv_2 = qu_2.dotAccum(a_2, z4);
                Vector<int32,4> sv_2 = on_2.dotAccum(a_2, z4);
                int32 dot_2 = dv_2[0] + dv_2[1] + dv_2[2] + dv_2[3];
                int32 as_2 = sv_2[0] + sv_2[1] + sv_2[2] + sv_2[3];
                int32 sc_2 = (int32) packed[(int64) rs0 + 196L];
                acc = acc + wk * d * xs
                    * (float32) (sc_2 * (dot_2 - 32 * as_2));
                Vector<uint8,16> qu_3 = (((qlB.asWords() >> 4) & 252645135) | ((qh16.asWords() >> 2) & 808464432)).asBytes().asUnsigned();
                Vector<int8,16> a_3 = xp.vload<16>((int64) xa0 + 96L);
                Vector<uint8,16> on_3 = (qu_3 ^ qu_3) | 1;
                Vector<int32,4> dv_3 = qu_3.dotAccum(a_3, z4);
                Vector<int32,4> sv_3 = on_3.dotAccum(a_3, z4);
                int32 dot_3 = dv_3[0] + dv_3[1] + dv_3[2] + dv_3[3];
                int32 as_3 = sv_3[0] + sv_3[1] + sv_3[2] + sv_3[3];
                int32 sc_3 = (int32) packed[(int64) rs0 + 198L];
                acc = acc + wk * d * xs
                    * (float32) (sc_3 * (dot_3 - 32 * as_3));
                kb = kb + 8;
            }
        }
        float32 tot = Wave.reduceSumF32(acc);
        if (lane == 0 && row < rowsPerExpert) {
            hs[(int64) row] = hs[(int64) row] + tot;
        }
        // ── Unit 59b: the NEXT layer's input norm + pack in this
        // launch's tail. Every wave has added its row; the last block
        // to arrive (ticket) norms the whole residual row and packs it
        // for the next layer's q|k|v, so the norm launch and its CP
        // gap are gone. The block is 256 threads (eight row waves) so
        // the tail is rmsnormPackRowF32's body verbatim.
        if (normTail == 0) { return; }
        uint32 tid = KernelThread.x();
        if (lane == 0) { Barrier.deviceMemory(MemoryOrder.Release); }
        Barrier.workgroup();
        if (tid == 0) {
            int32 old = counter.atomicAdd(0L, 1, MemoryOrder.AcqRel);
            tk[0] = old;
        }
        Barrier.workgroup();
        uint32 nblk = (rowsPerExpert + 7) / 8;
        if ((uint32) tk[0] != nblk - 1) { return; }
        Barrier.deviceMemory(MemoryOrder.Acquire);
        if (tid == 0) { counter[0L] = 0; }
        uint32 wid = tid / 32;
        uint32 wl = tid % 32;
        float32 ss = 0.0f;
        uint32 i = tid;
        while (i < dim) {
            float32 v = hs[(int64) i];
            ss = ss + v * v;
            i = i + 256;
        }
        float32 wsum = Wave.reduceSumF32(ss);
        if (wl == 0) { part[wid] = wsum; }
        Barrier.workgroup();
        float32 tsq = part[0] + part[1] + part[2] + part[3]
            + part[4] + part[5] + part[6] + part[7];
        float32 scale = 1.0f / Math.sqrt(tsq / (float32) dim + eps);
        uint32 blocks = dim / 256;
        float32 v0 = 0.0f; float32 v1 = 0.0f; float32 v2 = 0.0f; float32 v3 = 0.0f;
        float32 v4 = 0.0f; float32 v5 = 0.0f; float32 v6 = 0.0f; float32 v7 = 0.0f;
        uint32 e0 = wid * 256 + wl * 8;
        if (wid < blocks) {
            float32 w0 = nw[e0]; float32 w1 = nw[e0 + 1]; float32 w2 = nw[e0 + 2];
            float32 w3 = nw[e0 + 3]; float32 w4 = nw[e0 + 4]; float32 w5 = nw[e0 + 5];
            float32 w6 = nw[e0 + 6]; float32 w7 = nw[e0 + 7];
            if (form == 1) {
                w0 = 1.0f + w0; w1 = 1.0f + w1; w2 = 1.0f + w2; w3 = 1.0f + w3;
                w4 = 1.0f + w4; w5 = 1.0f + w5; w6 = 1.0f + w6; w7 = 1.0f + w7;
            }
            v0 = hs[(int64) e0] * scale * w0;
            v1 = hs[(int64) (e0 + 1)] * scale * w1;
            v2 = hs[(int64) (e0 + 2)] * scale * w2;
            v3 = hs[(int64) (e0 + 3)] * scale * w3;
            v4 = hs[(int64) (e0 + 4)] * scale * w4;
            v5 = hs[(int64) (e0 + 5)] * scale * w5;
            v6 = hs[(int64) (e0 + 6)] * scale * w6;
            v7 = hs[(int64) (e0 + 7)] * scale * w7;
            nOut[e0] = v0; nOut[e0 + 1] = v1; nOut[e0 + 2] = v2; nOut[e0 + 3] = v3;
            nOut[e0 + 4] = v4; nOut[e0 + 5] = v5; nOut[e0 + 6] = v6; nOut[e0 + 7] = v7;
        }
        float32 amax = 0.0f;
        float32 av = v0; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v1; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v2; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v3; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v4; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v5; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v6; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v7; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        float32 bmax = Wave.reduceMaxF32(amax);
        float32 inv = 0.0f;
        if (bmax > 0.0f) { inv = 127.0f / bmax; }
        int64 ob = (int64) wid * 320L;
        int32 sm = 0;
        if (wid < blocks) {
            int32 q0 = (int32) Math.round(v0 * inv);
            int32 q1 = (int32) Math.round(v1 * inv);
            int32 q2 = (int32) Math.round(v2 * inv);
            int32 q3 = (int32) Math.round(v3 * inv);
            int32 q4 = (int32) Math.round(v4 * inv);
            int32 q5 = (int32) Math.round(v5 * inv);
            int32 q6 = (int32) Math.round(v6 * inv);
            int32 q7 = (int32) Math.round(v7 * inv);
            int64 qo = ob + (int64) (wl * 8);
            pk[qo] = (int8) q0; pk[qo + 1L] = (int8) q1;
            pk[qo + 2L] = (int8) q2; pk[qo + 3L] = (int8) q3;
            pk[qo + 4L] = (int8) q4; pk[qo + 5L] = (int8) q5;
            pk[qo + 6L] = (int8) q6; pk[qo + 7L] = (int8) q7;
            sm = q0 + q1 + q2 + q3 + q4 + q5 + q6 + q7;
        }
        psum[tid] = sm;
        Barrier.workgroup();
        if (wid < blocks && wl < 8) {
            uint32 base = wid * 32 + wl * 4;
            int32 tsum = psum[base] + psum[base + 1]
                       + psum[base + 2] + psum[base + 3];
            int64 so = ob + 256L + (int64) (wl * 4);
            int32 b0 = tsum & 255;
            int32 b1 = (tsum >> 8) & 255;
            int32 b2 = (tsum >> 16) & 255;
            int32 b3 = (tsum >> 24) & 255;
            if (b0 > 127) { b0 = b0 - 256; }
            if (b1 > 127) { b1 = b1 - 256; }
            if (b2 > 127) { b2 = b2 - 256; }
            if (b3 > 127) { b3 = b3 - 256; }
            pk[so] = (int8) b0;
            pk[so + 1L] = (int8) b1;
            pk[so + 2L] = (int8) b2;
            pk[so + 3L] = (int8) b3;
        }
        if (wid < blocks && wl == 0) {
            float32 dsc = bmax / 127.0f;
            int32 db = Cajeta.f32ToBits(dsc);
            int32 e1 = db & 255;
            int32 e2 = (db >> 8) & 255;
            int32 e3 = (db >> 16) & 255;
            int32 e4 = (db >> 24) & 255;
            if (e1 > 127) { e1 = e1 - 256; }
            if (e2 > 127) { e2 = e2 - 256; }
            if (e3 > 127) { e3 = e3 - 256; }
            if (e4 > 127) { e4 = e4 - 256; }
            pk[ob + 288L] = (int8) e1;
            pk[ob + 289L] = (int8) e2;
            pk[ob + 290L] = (int8) e3;
            pk[ob + 291L] = (int8) e4;
        }
    }

    /** Unit 51: `hs += sum_k wSel[k] * W_sel[k] x_k` — the down id
     *  mat-vec with the combine fused. False = format not served. */
    public static boolean idDownCombineLaunchNoSync(int32 ggmlType,
            KernelBuffer<float32> hs, KernelBuffer<int8> slab,
            KernelBuffer<int8> xp, KernelBuffer<int32> sel,
            KernelBuffer<float32> wSel, int32 used, int64 rowsPerExpert,
            int64 cols, int64 xRowBlocks) {
        return QuantKernel.idDownCombineTailLaunchNoSync(ggmlType, hs, slab,
            xp, sel, wSel, used, rowsPerExpert, cols, xRowBlocks,
            null, null, null, 0L, 0.0f, 0, null);
    }

    /** Unit 59b: as {@link #idDownCombineLaunchNoSync}, with the next
     *  layer's input norm + Q8_K pack of the residual `hs` in the
     *  launch's tail when `nOut` is given (dim <= 2048, a multiple of
     *  256; `counter` a zeroed int32[4] the tail resets). Blocks of
     *  eight row waves either way. */
    public static boolean idDownCombineTailLaunchNoSync(int32 ggmlType,
            KernelBuffer<float32> hs, KernelBuffer<int8> slab,
            KernelBuffer<int8> xp, KernelBuffer<int32> sel,
            KernelBuffer<float32> wSel, int32 used, int64 rowsPerExpert,
            int64 cols, int64 xRowBlocks, KernelBuffer<float32> nOut,
            KernelBuffer<int8> pk, KernelBuffer<float32> nw, int64 dim,
            float32 eps, int32 form, KernelBuffer<int32> counter) {
        QuantKernel.requireOffsets32(slab, "idDownCombine");
        uint32 wgs = (uint32) ((rowsPerExpert + 7L) / 8L);
        uint32 tailOn = 0;
        KernelBuffer<float32> o = nOut;
        KernelBuffer<int8> p = pk;
        KernelBuffer<float32> w = nw;
        KernelBuffer<int32> c = counter;
        if (nOut != null) {
            tailOn = 1;
        } else {
            // The kernel takes every buffer; hand it live ones it will
            // not touch (normTail = 0 returns before the tail).
            o = hs; p = xp; w = wSel; c = sel;
        }
        KernelStream s = QuantKernel.stream();
        if (ggmlType == 12) {
            q4kQ8IdDownCombineKernel.launch(s, grid: [wgs], block: [256])
                (hs, slab, xp, sel, wSel, (uint32) rowsPerExpert,
                 cols / 256L, xRowBlocks, (uint32) used,
                 o, p, w, (uint32) dim, eps, form, c, tailOn);
            return true;
        }
        if (ggmlType == 14) {
            q6kQ8IdDownCombineKernel.launch(s, grid: [wgs], block: [256])
                (hs, slab, xp, sel, wSel, (uint32) rowsPerExpert,
                 cols / 256L, xRowBlocks, (uint32) used,
                 o, p, w, (uint32) dim, eps, form, c, tailOn);
            return true;
        }
        return false;
    }

    public static boolean idMatVecLaunchNoSync(int32 ggmlType,
            KernelBuffer<float32> y, KernelBuffer<int8> slab,
            KernelBuffer<int8> xp, KernelBuffer<int32> sel, int32 used,
            int64 rowsPerExpert, int64 cols, int64 xRowBlocks) {
        QuantKernel.requireOffsets32(slab, "idMatVec");
        int64 rpw = QuantKernel.rowsPerWave(cols / 256L);
        int64 wpe = (rowsPerExpert + rpw - 1L) / rpw;
        uint32 wgs = (uint32) (wpe * (int64) used);
        KernelStream s = QuantKernel.stream();
        if (ggmlType == 12) {
            q4kQ8IdMatVecKernel.launch(s, grid: [wgs], block: [32])
                (y, slab, xp, sel, (uint32) rowsPerExpert, cols / 256L,
                 xRowBlocks, 0L);
            return true;
        }
        if (ggmlType == 14) {
            q6kQ8IdMatVecKernel.launch(s, grid: [wgs], block: [32])
                (y, slab, xp, sel, (uint32) rowsPerExpert, cols / 256L,
                 xRowBlocks, 0L);
            return true;
        }
        return false;
    }

    /**
     * Unit 30: the routing histogram (spec 15.20). One thread per
     * (row, k) selection: `hist[base + sel[i]] += 1`, so the per-slot
     * histogram of which experts fired accumulates ON the device and
     * is read back once per request — an observed decode pays one
     * launch per MoE layer, never a download per token.
     */
    @Kernel
    public static void routeHistKernel(KernelBuffer<int32> hist,
            KernelBuffer<int32> sel, uint32 n, uint32 base) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            int32 e = sel[(int64) i];
            hist.atomicAdd((int64) (base + (uint32) e), 1, MemoryOrder.Relaxed);
        }
    }

    public static void routeHistLaunchNoSync(KernelBuffer<int32> hist,
            KernelBuffer<int32> sel, int64 n, int64 base) {
        uint32 blocks = (uint32) ((n + 63L) / 64L);
        KernelStream s = QuantKernel.stream();
        routeHistKernel.launch(s, grid: [blocks], block: [64])
            (hist, sel, (uint32) n, (uint32) base);
        return;
    }

    /**
     * The router mat-vec on the device (unit 40): logits[e] = W[e] . x
     * over a row-major [E, H] copy (the uploader TRANSPOSES the import
     * layout once). One WAVE per expert row, lanes striding the
     * columns — consecutive lanes read consecutive floats, and E
     * workgroups hide the latency a thread-per-expert serial loop
     * exposed (the first version of this kernel was exactly that, and
     * it was latency-bound on four waves).
     */
    @Kernel
    public static void routerF32MatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<float32> w, KernelBuffer<float32> x,
            uint32 experts, uint32 cols) {
        // 256 lanes per expert row with an LDS tree (the rmsnormRows
        // idiom): one wave per row was latency-bound at E waves total
        // and measured 27 us for 1 MB — 37 GB/s; 8x the waves hides it.
        Shared<float32> part = shared float32[256];
        uint32 lane = KernelThread.x();
        uint32 e = KernelThread.globalIdX() / 256;
        float32 acc = 0.0f;
        if (e < experts) {
            uint32 j = lane;
            while (j < cols) {
                acc = acc + w[(int64) e * (int64) cols + (int64) j]
                    * x[(int64) j];
                j = j + 256;
            }
        }
        part[lane] = acc;
        Barrier.workgroup();
        uint32 sred = 128;
        while (sred > 0) {
            if (lane < sred) {
                part[lane] = part[lane] + part[lane + sred];
            }
            Barrier.workgroup();
            sred = sred / 2;
        }
        if (lane == 0 && e < experts) {
            y[(int64) e] = part[0];
        }
    }

    /**
     * Unit 50: the router mat-vec AND the top-k in ONE launch. Block e
     * computes logit e exactly as routerF32MatVecKernel does, publishes
     * it with a device-scope release fence and takes a ticket on
     * `counter[0]`; the block whose ticket is the last acquires, runs
     * the moeTopKKernel selection in its first wave over the complete
     * logits, and resets the counter for the next launch (the stream
     * orders it). The top-k was a launch whose whole cost was the
     * dependency on the previous one; here it rides the router's.
     */
    @Kernel
    public static void routerTopKKernel(KernelBuffer<int32> sel,
            KernelBuffer<float32> w, KernelBuffer<float32> logits,
            KernelBuffer<float32> wRouter, KernelBuffer<float32> x,
            KernelBuffer<int32> counter, uint32 experts, uint32 cols,
            uint32 used, uint32 normTopk, float32 wScale) {
        Shared<float32> part = shared float32[256];
        Shared<int32> lastFlag = shared int32[1];
        uint32 lane = KernelThread.x();
        uint32 e = KernelThread.globalIdX() / 256;
        float32 acc = 0.0f;
        if (e < experts) {
            uint32 j = lane;
            while (j < cols) {
                acc = acc + wRouter[(int64) e * (int64) cols + (int64) j]
                    * x[(int64) j];
                j = j + 256;
            }
        }
        part[lane] = acc;
        Barrier.workgroup();
        uint32 sred = 128;
        while (sred > 0) {
            if (lane < sred) {
                part[lane] = part[lane] + part[lane + sred];
            }
            Barrier.workgroup();
            sred = sred / 2;
        }
        if (lane == 0) {
            if (e < experts) { logits[(int64) e] = part[0]; }
            Barrier.deviceMemory(MemoryOrder.Release);
            int32 old = counter.atomicAdd(0L, 1, MemoryOrder.AcqRel);
            int32 fl = 0;
            if ((uint32) old == experts - 1) { fl = 1; }
            lastFlag[0] = fl;
        }
        Barrier.workgroup();
        if (lastFlag[0] == 0) { return; }
        // The last block: the first wave selects.
        if (lane >= 32) { return; }
        Barrier.deviceMemory(MemoryOrder.Acquire);
        float32 lm = 0.0f - 340282346638528859811704183484516925440.0f;
        uint32 ee = lane;
        while (ee < experts) {
            float32 v = logits[(int64) ee];
            if (v > lm) { lm = v; }
            ee = ee + 32;
        }
        float32 mx = Wave.reduceMaxF32(lm);
        float32 ls = 0.0f;
        ee = lane;
        while (ee < experts) {
            ls = ls + Math.exp(logits[(int64) ee] - mx);
            ee = ee + 32;
        }
        float32 sum = Wave.reduceSumF32(ls);
        float32 vLast = 340282346638528859811704183484516925440.0f;
        uint32 iLast = experts;
        uint32 k = 0;
        while (k < used) {
            float32 bv = 0.0f - 1.0f;
            ee = lane;
            while (ee < experts) {
                float32 p = Math.exp(logits[(int64) ee] - mx);
                boolean ok = p < vLast
                    || (p == vLast && ee > iLast);
                if (ok && p > bv) { bv = p; }
                ee = ee + 32;
            }
            float32 vk = Wave.reduceMaxF32(bv);
            uint32 bi = experts;
            ee = lane;
            while (ee < experts) {
                float32 p = Math.exp(logits[(int64) ee] - mx);
                boolean ok = p < vLast
                    || (p == vLast && ee > iLast);
                if (ok && p == vk && ee < bi) { bi = ee; }
                ee = ee + 32;
            }
            uint32 ik = Wave.reduceMin(bi);
            if (lane == 0) {
                sel[(int64) k] = (int32) ik;
                w[(int64) k] = vk / sum;
            }
            vLast = vk;
            iLast = ik;
            k = k + 1;
        }
        if (lane == 0) {
            if (normTopk != 0) {
                float32 ws = 0.0f;
                k = 0;
                while (k < used) { ws = ws + w[(int64) k]; k = k + 1; }
                if (ws < 0.00006103515625f) { ws = 0.00006103515625f; }
                k = 0;
                while (k < used) {
                    w[(int64) k] = w[(int64) k] / ws;
                    k = k + 1;
                }
            }
            if (wScale != 0.0f && wScale != 1.0f) {
                k = 0;
                while (k < used) {
                    w[(int64) k] = w[(int64) k] * wScale;
                    k = k + 1;
                }
            }
            counter[0L] = 0;
        }
    }

    /**
     * Unit 53: the router + top-k as WAVES — one wave per expert row
     * (lanes stride the 2048 columns four floats at a time, one wave
     * reduction, no LDS, no barrier), the last wave to finish selects
     * with all 128 logits held in four registers per lane: the
     * softmax max and sum by wave reduction, then the same
     * threshold-chained rounds as moeTopKKernel on registers. Where
     * the block form paid an 8-level LDS tree per expert and
     * recomputed exp across the rounds, this pays neither.
     */
    @Kernel
    public static void routerTopKWaveKernel(KernelBuffer<int32> sel,
            KernelBuffer<float32> w, KernelBuffer<float32> logits,
            KernelBuffer<float32> wRouter, KernelBuffer<float32> x,
            KernelBuffer<int32> counter, uint32 experts, uint32 cols,
            uint32 used, uint32 normTopk, float32 wScale) {
        // Unit 59: a BLOCK of four waves per expert, each lane with
        // its four 16-byte loads of the row issued together. The
        // one-wave form looped 16 times over a 2048-wide row with a
        // vmcnt(0) per trip (ISA): 128 waves x 16 serialized DRAM
        // round trips = 14.4 us for 1 MB. The tail (top-k) is wave 0
        // of the last block to arrive.
        Shared<float32> part = shared float32[4];
        Shared<int32> tk = shared int32[1];
        uint32 tid = KernelThread.x();
        uint32 lane = tid % 32;
        uint32 wv4 = tid / 32;
        uint32 e = KernelThread.globalIdX() / 128;
        float32 acc = 0.0f;
        if (e < experts) {
            int64 rb = (int64) e * (int64) cols;
            uint32 j = tid * 4;
            while (j < cols) {
                uint32 j1 = j + 512;
                uint32 j2 = j + 1024;
                uint32 j3 = j + 1536;
                Vector<float32,4> w0 = wRouter.vload<4>(rb + (int64) j);
                Vector<float32,4> x0 = x.vload<4>((int64) j);
                Vector<float32,4> w1 = w0;
                Vector<float32,4> x1 = x0 * 0.0f;
                Vector<float32,4> w2 = w0;
                Vector<float32,4> x2 = x1;
                Vector<float32,4> w3 = w0;
                Vector<float32,4> x3 = x1;
                if (j1 < cols) { w1 = wRouter.vload<4>(rb + (int64) j1); x1 = x.vload<4>((int64) j1); }
                if (j2 < cols) { w2 = wRouter.vload<4>(rb + (int64) j2); x2 = x.vload<4>((int64) j2); }
                if (j3 < cols) { w3 = wRouter.vload<4>(rb + (int64) j3); x3 = x.vload<4>((int64) j3); }
                Vector<float32,4> pv = w0 * x0 + w1 * x1 + w2 * x2 + w3 * x3;
                acc = acc + pv[0] + pv[1] + pv[2] + pv[3];
                j = j + 2048;
            }
        }
        float32 tot = Wave.reduceSumF32(acc);
        if (lane == 0) { part[wv4] = tot; }
        Barrier.workgroup();
        if (tid == 0) {
            float32 t4 = part[0] + part[1] + part[2] + part[3];
            if (e < experts) { logits[(int64) e] = t4; }
            Barrier.deviceMemory(MemoryOrder.Release);
            int32 old = counter.atomicAdd(0L, 1, MemoryOrder.AcqRel);
            tk[0] = old;
        }
        Barrier.workgroup();
        uint32 last = (uint32) tk[0];
        if (last != experts - 1) { return; }
        if (wv4 != 0) { return; }
        Barrier.deviceMemory(MemoryOrder.Acquire);
        // Up to 128 experts in four registers per lane: lane holds
        // experts lane, lane+32, lane+64, lane+96.
        float32 neg = 0.0f - 340282346638528859811704183484516925440.0f;
        float32 l0 = neg; float32 l1 = neg; float32 l2 = neg; float32 l3 = neg;
        if (lane < experts) { l0 = logits[(int64) lane]; }
        if (lane + 32 < experts) { l1 = logits[(int64) (lane + 32)]; }
        if (lane + 64 < experts) { l2 = logits[(int64) (lane + 64)]; }
        if (lane + 96 < experts) { l3 = logits[(int64) (lane + 96)]; }
        float32 lm = l0;
        if (l1 > lm) { lm = l1; }
        if (l2 > lm) { lm = l2; }
        if (l3 > lm) { lm = l3; }
        float32 mx = Wave.reduceMaxF32(lm);
        float32 p0 = 0.0f; float32 p1 = 0.0f; float32 p2 = 0.0f; float32 p3 = 0.0f;
        if (lane < experts) { p0 = Math.exp(l0 - mx); }
        if (lane + 32 < experts) { p1 = Math.exp(l1 - mx); }
        if (lane + 64 < experts) { p2 = Math.exp(l2 - mx); }
        if (lane + 96 < experts) { p3 = Math.exp(l3 - mx); }
        float32 sum = Wave.reduceSumF32(p0 + p1 + p2 + p3);
        float32 vLast = 340282346638528859811704183484516925440.0f;
        uint32 iLast = experts;
        uint32 k = 0;
        while (k < used) {
            float32 bv = 0.0f - 1.0f;
            boolean ok0 = lane < experts && (p0 < vLast || (p0 == vLast && lane > iLast));
            boolean ok1 = lane + 32 < experts && (p1 < vLast || (p1 == vLast && lane + 32 > iLast));
            boolean ok2 = lane + 64 < experts && (p2 < vLast || (p2 == vLast && lane + 64 > iLast));
            boolean ok3 = lane + 96 < experts && (p3 < vLast || (p3 == vLast && lane + 96 > iLast));
            if (ok0 && p0 > bv) { bv = p0; }
            if (ok1 && p1 > bv) { bv = p1; }
            if (ok2 && p2 > bv) { bv = p2; }
            if (ok3 && p3 > bv) { bv = p3; }
            float32 vk = Wave.reduceMaxF32(bv);
            uint32 bi = experts;
            if (ok3 && p3 == vk) { bi = lane + 96; }
            if (ok2 && p2 == vk) { bi = lane + 64; }
            if (ok1 && p1 == vk) { bi = lane + 32; }
            if (ok0 && p0 == vk) { bi = lane; }
            uint32 ik = Wave.reduceMin(bi);
            if (lane == 0) {
                sel[(int64) k] = (int32) ik;
                w[(int64) k] = vk / sum;
            }
            vLast = vk;
            iLast = ik;
            k = k + 1;
        }
        if (lane == 0) {
            if (normTopk != 0) {
                float32 ws = 0.0f;
                k = 0;
                while (k < used) { ws = ws + w[(int64) k]; k = k + 1; }
                if (ws < 0.00006103515625f) { ws = 0.00006103515625f; }
                k = 0;
                while (k < used) {
                    w[(int64) k] = w[(int64) k] / ws;
                    k = k + 1;
                }
            }
            if (wScale != 0.0f && wScale != 1.0f) {
                k = 0;
                while (k < used) {
                    w[(int64) k] = w[(int64) k] * wScale;
                    k = k + 1;
                }
            }
            counter[0L] = 0;
        }
    }

    /**
     * Unit 59: the post-attention RMSNorm, its Q8_K pack AND the router
     * + top-k in ONE launch. A block per expert: every block norms the
     * row redundantly (8 KB from L2 — the sum of squares is a wave
     * reduction and an 8-way LDS sum, the thread's eight normed values
     * stay in registers exactly as rmsnormPackRowF32 computes them),
     * block 0 alone stores the f32 row and the pack, every block dots
     * its expert's router row against its registers, and the last
     * block to arrive selects (routerTopKWaveKernel's tail). Two
     * launches and their gap become one launch whose extra work is a
     * few microseconds of L2 reads spread over 128 blocks.
     */
    @Kernel
    public static void rmsnormRouterTopKKernel(KernelBuffer<float32> out,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            KernelBuffer<float32> nw, uint32 dim, float32 eps, int32 form,
            KernelBuffer<int32> sel, KernelBuffer<float32> w,
            KernelBuffer<float32> logits, KernelBuffer<float32> wRouter,
            KernelBuffer<int32> counter, uint32 experts, uint32 used,
            uint32 normTopk, float32 wScale) {
        Shared<float32> part = shared float32[8];
        Shared<float32> rpart = shared float32[8];
        Shared<int32> psum = shared int32[256];
        Shared<int32> tk = shared int32[1];
        uint32 tid = KernelThread.x();
        uint32 lane = tid % 32;
        uint32 wid = tid / 32;
        uint32 wl = lane;
        uint32 e = KernelThread.globalIdX() / 256;
        // ── the norm, as rmsnormPackRowF32 ──
        float32 ss = 0.0f;
        uint32 i = tid;
        while (i < dim) {
            float32 v = x[i];
            ss = ss + v * v;
            i = i + 256;
        }
        float32 ws = Wave.reduceSumF32(ss);
        if (wl == 0) { part[wid] = ws; }
        Barrier.workgroup();
        float32 tot = part[0] + part[1] + part[2] + part[3]
            + part[4] + part[5] + part[6] + part[7];
        float32 scale = 1.0f / Math.sqrt(tot / (float32) dim + eps);
        uint32 blocks = dim / 256;
        float32 v0 = 0.0f; float32 v1 = 0.0f; float32 v2 = 0.0f; float32 v3 = 0.0f;
        float32 v4 = 0.0f; float32 v5 = 0.0f; float32 v6 = 0.0f; float32 v7 = 0.0f;
        uint32 e0 = wid * 256 + wl * 8;
        if (wid < blocks) {
            float32 w0 = nw[e0]; float32 w1 = nw[e0 + 1]; float32 w2 = nw[e0 + 2];
            float32 w3 = nw[e0 + 3]; float32 w4 = nw[e0 + 4]; float32 w5 = nw[e0 + 5];
            float32 w6 = nw[e0 + 6]; float32 w7 = nw[e0 + 7];
            if (form == 1) {
                w0 = 1.0f + w0; w1 = 1.0f + w1; w2 = 1.0f + w2; w3 = 1.0f + w3;
                w4 = 1.0f + w4; w5 = 1.0f + w5; w6 = 1.0f + w6; w7 = 1.0f + w7;
            }
            v0 = x[e0] * scale * w0;
            v1 = x[e0 + 1] * scale * w1;
            v2 = x[e0 + 2] * scale * w2;
            v3 = x[e0 + 3] * scale * w3;
            v4 = x[e0 + 4] * scale * w4;
            v5 = x[e0 + 5] * scale * w5;
            v6 = x[e0 + 6] * scale * w6;
            v7 = x[e0 + 7] * scale * w7;
            if (e == 0) {
                out[e0] = v0; out[e0 + 1] = v1; out[e0 + 2] = v2; out[e0 + 3] = v3;
                out[e0 + 4] = v4; out[e0 + 5] = v5; out[e0 + 6] = v6; out[e0 + 7] = v7;
            }
        }
        // ── this expert's router dot against the registers ──
        float32 rd = 0.0f;
        if (wid < blocks && e < experts) {
            int64 rb = (int64) e * (int64) dim + (int64) e0;
            Vector<float32,4> ra = wRouter.vload<4>(rb);
            Vector<float32,4> rb4 = wRouter.vload<4>(rb + 4L);
            rd = ra[0] * v0 + ra[1] * v1 + ra[2] * v2 + ra[3] * v3
               + rb4[0] * v4 + rb4[1] * v5 + rb4[2] * v6 + rb4[3] * v7;
        }
        float32 rws = Wave.reduceSumF32(rd);
        if (wl == 0) { rpart[wid] = rws; }
        // ── the pack (block 0 stores; every block runs the same code) ──
        float32 amax = 0.0f;
        float32 av = v0; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v1; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v2; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v3; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v4; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v5; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v6; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        av = v7; if (av < 0.0f) { av = 0.0f - av; } if (av > amax) { amax = av; }
        float32 bmax = Wave.reduceMaxF32(amax);
        float32 inv = 0.0f;
        if (bmax > 0.0f) { inv = 127.0f / bmax; }
        int64 ob = (int64) wid * 320L;
        int32 sm = 0;
        if (wid < blocks) {
            int32 q0 = (int32) Math.round(v0 * inv);
            int32 q1 = (int32) Math.round(v1 * inv);
            int32 q2 = (int32) Math.round(v2 * inv);
            int32 q3 = (int32) Math.round(v3 * inv);
            int32 q4 = (int32) Math.round(v4 * inv);
            int32 q5 = (int32) Math.round(v5 * inv);
            int32 q6 = (int32) Math.round(v6 * inv);
            int32 q7 = (int32) Math.round(v7 * inv);
            if (e == 0) {
                int64 qo = ob + (int64) (wl * 8);
                packed[qo] = (int8) q0; packed[qo + 1L] = (int8) q1;
                packed[qo + 2L] = (int8) q2; packed[qo + 3L] = (int8) q3;
                packed[qo + 4L] = (int8) q4; packed[qo + 5L] = (int8) q5;
                packed[qo + 6L] = (int8) q6; packed[qo + 7L] = (int8) q7;
            }
            sm = q0 + q1 + q2 + q3 + q4 + q5 + q6 + q7;
        }
        psum[tid] = sm;
        Barrier.workgroup();
        if (e == 0 && wid < blocks && wl < 8) {
            uint32 base = wid * 32 + wl * 4;
            int32 tsum = psum[base] + psum[base + 1]
                       + psum[base + 2] + psum[base + 3];
            int64 so = ob + 256L + (int64) (wl * 4);
            int32 b0 = tsum & 255;
            int32 b1 = (tsum >> 8) & 255;
            int32 b2 = (tsum >> 16) & 255;
            int32 b3 = (tsum >> 24) & 255;
            if (b0 > 127) { b0 = b0 - 256; }
            if (b1 > 127) { b1 = b1 - 256; }
            if (b2 > 127) { b2 = b2 - 256; }
            if (b3 > 127) { b3 = b3 - 256; }
            packed[so] = (int8) b0;
            packed[so + 1L] = (int8) b1;
            packed[so + 2L] = (int8) b2;
            packed[so + 3L] = (int8) b3;
        }
        if (e == 0 && wid < blocks && wl == 0) {
            float32 dsc = bmax / 127.0f;
            int32 db = Cajeta.f32ToBits(dsc);
            int32 e1 = db & 255;
            int32 e2 = (db >> 8) & 255;
            int32 e3 = (db >> 16) & 255;
            int32 e4 = (db >> 24) & 255;
            if (e1 > 127) { e1 = e1 - 256; }
            if (e2 > 127) { e2 = e2 - 256; }
            if (e3 > 127) { e3 = e3 - 256; }
            if (e4 > 127) { e4 = e4 - 256; }
            packed[ob + 288L] = (int8) e1;
            packed[ob + 289L] = (int8) e2;
            packed[ob + 290L] = (int8) e3;
            packed[ob + 291L] = (int8) e4;
        }
        // ── the ticket ──
        if (tid == 0) {
            float32 t8 = rpart[0] + rpart[1] + rpart[2] + rpart[3]
                + rpart[4] + rpart[5] + rpart[6] + rpart[7];
            if (e < experts) { logits[(int64) e] = t8; }
            Barrier.deviceMemory(MemoryOrder.Release);
            int32 old = counter.atomicAdd(0L, 1, MemoryOrder.AcqRel);
            tk[0] = old;
        }
        Barrier.workgroup();
        uint32 last = (uint32) tk[0];
        if (last != experts - 1) { return; }
        if (wid != 0) { return; }
        Barrier.deviceMemory(MemoryOrder.Acquire);
        // Up to 128 experts in four registers per lane: lane holds
        // experts lane, lane+32, lane+64, lane+96.
        float32 neg = 0.0f - 340282346638528859811704183484516925440.0f;
        float32 l0 = neg; float32 l1 = neg; float32 l2 = neg; float32 l3 = neg;
        if (lane < experts) { l0 = logits[(int64) lane]; }
        if (lane + 32 < experts) { l1 = logits[(int64) (lane + 32)]; }
        if (lane + 64 < experts) { l2 = logits[(int64) (lane + 64)]; }
        if (lane + 96 < experts) { l3 = logits[(int64) (lane + 96)]; }
        float32 lm = l0;
        if (l1 > lm) { lm = l1; }
        if (l2 > lm) { lm = l2; }
        if (l3 > lm) { lm = l3; }
        float32 mx = Wave.reduceMaxF32(lm);
        float32 p0 = 0.0f; float32 p1 = 0.0f; float32 p2 = 0.0f; float32 p3 = 0.0f;
        if (lane < experts) { p0 = Math.exp(l0 - mx); }
        if (lane + 32 < experts) { p1 = Math.exp(l1 - mx); }
        if (lane + 64 < experts) { p2 = Math.exp(l2 - mx); }
        if (lane + 96 < experts) { p3 = Math.exp(l3 - mx); }
        float32 sum = Wave.reduceSumF32(p0 + p1 + p2 + p3);
        float32 vLast = 340282346638528859811704183484516925440.0f;
        uint32 iLast = experts;
        uint32 k = 0;
        while (k < used) {
            float32 bv = 0.0f - 1.0f;
            boolean ok0 = lane < experts && (p0 < vLast || (p0 == vLast && lane > iLast));
            boolean ok1 = lane + 32 < experts && (p1 < vLast || (p1 == vLast && lane + 32 > iLast));
            boolean ok2 = lane + 64 < experts && (p2 < vLast || (p2 == vLast && lane + 64 > iLast));
            boolean ok3 = lane + 96 < experts && (p3 < vLast || (p3 == vLast && lane + 96 > iLast));
            if (ok0 && p0 > bv) { bv = p0; }
            if (ok1 && p1 > bv) { bv = p1; }
            if (ok2 && p2 > bv) { bv = p2; }
            if (ok3 && p3 > bv) { bv = p3; }
            float32 vk = Wave.reduceMaxF32(bv);
            uint32 bi = experts;
            if (ok3 && p3 == vk) { bi = lane + 96; }
            if (ok2 && p2 == vk) { bi = lane + 64; }
            if (ok1 && p1 == vk) { bi = lane + 32; }
            if (ok0 && p0 == vk) { bi = lane; }
            uint32 ik = Wave.reduceMin(bi);
            if (lane == 0) {
                sel[(int64) k] = (int32) ik;
                w[(int64) k] = vk / sum;
            }
            vLast = vk;
            iLast = ik;
            k = k + 1;
        }
        if (lane == 0) {
            if (normTopk != 0) {
                float32 ws = 0.0f;
                k = 0;
                while (k < used) { ws = ws + w[(int64) k]; k = k + 1; }
                if (ws < 0.00006103515625f) { ws = 0.00006103515625f; }
                k = 0;
                while (k < used) {
                    w[(int64) k] = w[(int64) k] / ws;
                    k = k + 1;
                }
            }
            if (wScale != 0.0f && wScale != 1.0f) {
                k = 0;
                while (k < used) {
                    w[(int64) k] = w[(int64) k] * wScale;
                    k = k + 1;
                }
            }
            counter[0L] = 0;
        }
    }

    public static void rmsnormRouterTopKLaunchNoSync(KernelBuffer<float32> out,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            KernelBuffer<float32> nw, int64 dim, float32 eps, int32 form,
            KernelBuffer<int32> sel, KernelBuffer<float32> w,
            KernelBuffer<float32> logits, KernelBuffer<float32> wRouter,
            KernelBuffer<int32> counter, int64 experts, int64 used,
            boolean normTopk, float32 wScale) {
        KernelStream s = QuantKernel.stream();
        uint32 nt = 0;
        if (normTopk) { nt = 1; }
        rmsnormRouterTopKKernel.launch(s, grid: [(uint32) experts], block: [256])
            (out, packed, x, nw, (uint32) dim, eps, form, sel, w, logits,
             wRouter, counter, (uint32) experts, (uint32) used, nt, wScale);
        return;
    }

    public static void routerTopKWaveLaunchNoSync(KernelBuffer<int32> sel,
            KernelBuffer<float32> w, KernelBuffer<float32> logits,
            KernelBuffer<float32> wRouter, KernelBuffer<float32> x,
            KernelBuffer<int32> counter, int64 experts, int64 cols,
            int64 used, boolean normTopk, float32 wScale) {
        KernelStream s = QuantKernel.stream();
        uint32 nt = 0;
        if (normTopk) { nt = 1; }
        routerTopKWaveKernel.launch(s, grid: [(uint32) experts], block: [128])
            (sel, w, logits, wRouter, x, counter, (uint32) experts,
             (uint32) cols, (uint32) used, nt, wScale);
        return;
    }

    public static void routerTopKLaunchNoSync(KernelBuffer<int32> sel,
            KernelBuffer<float32> w, KernelBuffer<float32> logits,
            KernelBuffer<float32> wRouter, KernelBuffer<float32> x,
            KernelBuffer<int32> counter, int64 experts, int64 cols,
            int64 used, boolean normTopk, float32 wScale) {
        KernelStream s = QuantKernel.stream();
        uint32 nt = 0;
        if (normTopk) { nt = 1; }
        routerTopKKernel.launch(s, grid: [(uint32) experts], block: [256])
            (sel, w, logits, wRouter, x, counter, (uint32) experts,
             (uint32) cols, (uint32) used, nt, wScale);
        return;
    }

    /** Unit 41: gather picked rows into group order —
     *  dst[i, :] = src[idx[i], :] over `total = picks * cols`
     *  elements. One thread per element; the div/mod is cheap against
     *  the bytes moved. */
    @Kernel
    public static void gatherRowsF32Kernel(KernelBuffer<float32> dst,
            KernelBuffer<float32> src, KernelBuffer<int32> idx,
            uint32 total, uint32 cols) {
        uint32 t = KernelThread.globalIdX();
        if (t < total) {
            uint32 i = t / cols;
            uint32 j = t - i * cols;
            dst[(int64) t] = src[(int64) idx[(int64) i] * (int64) cols
                + (int64) j];
        }
    }

    public static void gatherRowsF32LaunchNoSync(KernelBuffer<float32> dst,
            KernelBuffer<float32> src, KernelBuffer<int32> idx,
            int64 picks, int64 cols) {
        uint32 total = (uint32) (picks * cols);
        KernelStream s = QuantKernel.stream();
        gatherRowsF32Kernel.launch(s, grid: [(total + 255) / 256],
            block: [256])(dst, src, idx, total, (uint32) cols);
        return;
    }

    /** Unit 41: the weighted scatter-combine, deterministically — one
     *  workgroup per OUTPUT row walks its own picks, so no atomics and
     *  no ordering dependence: out[r, j] = sum_k gw[slot] *
     *  be[slot, j] with slot = rowSlot[r*used + k]. */
    @Kernel
    public static void moeScatterCombineKernel(KernelBuffer<float32> out,
            KernelBuffer<float32> be, KernelBuffer<int32> rowSlot,
            KernelBuffer<float32> gw, uint32 rows, uint32 used,
            uint32 cols) {
        uint32 lane = KernelThread.x();
        uint32 r = KernelThread.globalIdX() / 256;
        if (r < rows) {
            uint32 j = lane;
            while (j < cols) {
                float32 acc = 0.0f;
                uint32 k = 0;
                while (k < used) {
                    int32 slot = rowSlot[(int64) r * (int64) used
                        + (int64) k];
                    acc = acc + gw[(int64) slot]
                        * be[(int64) slot * (int64) cols + (int64) j];
                    k = k + 1;
                }
                out[(int64) r * (int64) cols + (int64) j] = acc;
                j = j + 256;
            }
        }
    }

    public static void moeScatterCombineLaunchNoSync(
            KernelBuffer<float32> out, KernelBuffer<float32> be,
            KernelBuffer<int32> rowSlot, KernelBuffer<float32> gw,
            int64 rows, int64 used, int64 cols) {
        uint32 ur = (uint32) rows;
        KernelStream s = QuantKernel.stream();
        moeScatterCombineKernel.launch(s, grid: [ur],
            block: [256])(out, be, rowSlot, gw, ur, (uint32) used,
            (uint32) cols);
        return;
    }

    /**
     * Batched router (unit 41): logits[r, e] = W[e] . x[r] over the
     * row-major [E, H] router copy, one workgroup per token row with a
     * thread per expert. The serial j loop is latency-hidden by the
     * row count (the decode kernel's four-wave version of this shape
     * was latency-BOUND; at 512 rows there are thousands of waves).
     * Replaces 512 x 48 host scalar mat-vecs that were ~70% of the
     * whole steady prefill.
     */
    @Kernel
    public static void routerBatchF32Kernel(KernelBuffer<float32> y,
            KernelBuffer<float32> w, KernelBuffer<float32> x,
            uint32 rows, uint32 experts, uint32 cols) {
        uint32 e = KernelThread.x();
        uint32 r = KernelThread.globalIdX() / 256;
        if (r < rows && e < experts) {
            float32 acc = 0.0f;
            int64 wb = (int64) e * (int64) cols;
            int64 xb = (int64) r * (int64) cols;
            uint32 j = 0;
            while (j < cols) {
                acc = acc + w[wb + (int64) j] * x[xb + (int64) j];
                j = j + 1;
            }
            y[(int64) r * (int64) experts + (int64) e] = acc;
        }
    }

    public static void routerBatchF32LaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<float32> w, KernelBuffer<float32> x,
            int64 rows, int64 experts, int64 cols) {
        uint32 ur = (uint32) rows;
        KernelStream s = QuantKernel.stream();
        routerBatchF32Kernel.launch(s, grid: [ur], block: [256])
            (y, w, x, ur, (uint32) experts, (uint32) cols);
        return;
    }

    public static void routerF32MatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<float32> w, KernelBuffer<float32> x,
            int64 experts, int64 cols) {
        uint32 ue = (uint32) experts;
        KernelStream s = QuantKernel.stream();
        routerF32MatVecKernel.launch(s, grid: [ue], block: [256])
            (y, w, x, ue, (uint32) cols);
        return;
    }

    /**
     * Softmax + top-k + renorm on the device (unit 40), mirroring
     * MoeFfn.routeInto EXACTLY: softmax over all experts (the weights
     * are probabilities, so the full softmax is load-bearing),
     * selection where ties keep the LOWER index, the f16-min divisor
     * clamp on the renorm, then the optional scale.
     *
     * One wave, lanes striding the experts. Selection is
     * THRESHOLD-CHAINED rather than mark-and-rescan: pass k takes the
     * max over entries strictly below the previous pick — or equal to
     * it at a HIGHER index — which reproduces the serial rule
     * (duplicates leave in ascending index order) without rewriting
     * probs, so no cross-lane memory visibility is ever needed. The
     * unnormalized exp is recomputed per pass from the cached logits;
     * E is at most a few hundred and the reduces are the cost.
     */
    @Kernel
    public static void moeTopKKernel(KernelBuffer<int32> sel,
            KernelBuffer<float32> w, KernelBuffer<float32> logits,
            uint32 experts, uint32 used, uint32 normTopk,
            float32 wScale) {
        uint32 lane = KernelThread.x();
        // Wave max of the logits.
        float32 lm = 0.0f - 340282346638528859811704183484516925440.0f;
        uint32 e = lane;
        while (e < experts) {
            float32 v = logits[(int64) e];
            if (v > lm) { lm = v; }
            e = e + 32;
        }
        float32 mx = Wave.reduceMaxF32(lm);
        // Wave sum of exp(l - mx).
        float32 ls = 0.0f;
        e = lane;
        while (e < experts) {
            ls = ls + Math.exp(logits[(int64) e] - mx);
            e = e + 32;
        }
        float32 sum = Wave.reduceSumF32(ls);
        // k threshold-chained argmax passes (all wave-uniform state).
        float32 vLast = 340282346638528859811704183484516925440.0f;
        uint32 iLast = experts;
        uint32 k = 0;
        while (k < used) {
            float32 bv = 0.0f - 1.0f;
            e = lane;
            while (e < experts) {
                float32 p = Math.exp(logits[(int64) e] - mx);
                boolean ok = p < vLast
                    || (p == vLast && e > iLast);
                if (ok && p > bv) { bv = p; }
                e = e + 32;
            }
            float32 vk = Wave.reduceMaxF32(bv);
            // Lowest index attaining vk under the same eligibility.
            uint32 bi = experts;
            e = lane;
            while (e < experts) {
                float32 p = Math.exp(logits[(int64) e] - mx);
                boolean ok = p < vLast
                    || (p == vLast && e > iLast);
                if (ok && p == vk && e < bi) { bi = e; }
                e = e + 32;
            }
            uint32 ik = Wave.reduceMin(bi);
            if (lane == 0) {
                sel[(int64) k] = (int32) ik;
                w[(int64) k] = vk / sum;
            }
            vLast = vk;
            iLast = ik;
            k = k + 1;
        }
        if (lane == 0) {
            if (normTopk != 0) {
                float32 ws = 0.0f;
                k = 0;
                while (k < used) { ws = ws + w[(int64) k]; k = k + 1; }
                if (ws < 0.00006103515625f) { ws = 0.00006103515625f; }
                k = 0;
                while (k < used) {
                    w[(int64) k] = w[(int64) k] / ws;
                    k = k + 1;
                }
            }
            if (wScale != 0.0f && wScale != 1.0f) {
                k = 0;
                while (k < used) {
                    w[(int64) k] = w[(int64) k] * wScale;
                    k = k + 1;
                }
            }
        }
    }

    public static void moeTopKLaunchNoSync(KernelBuffer<int32> sel,
            KernelBuffer<float32> w, KernelBuffer<float32> logits,
            KernelBuffer<float32> probs, int64 experts, int64 used,
            boolean normTopk, float32 wScale) {
        KernelStream s = QuantKernel.stream();
        uint32 nt = 0;
        if (normTopk) { nt = 1; }
        moeTopKKernel.launch(s, grid: [1], block: [32])
            (sel, w, logits, (uint32) experts, (uint32) used,
             nt, wScale);
        return;
    }

    /**
     * Unit 45: {@link #moeTopKKernel} over EVERY row of a batch — one
     * wave per row, the same threshold-chained selection (the host
     * routeFromLogits tie rule, lower index first), writing
     * `selAll[row*used + k]` / `wAll[...]`. The body is the per-row
     * kernel's with a row base on the three buffers.
     */
    @Kernel
    public static void moeTopKBatchKernel(KernelBuffer<int32> selAll,
            KernelBuffer<float32> wAll, KernelBuffer<float32> logits,
            uint32 rows, uint32 experts, uint32 used, uint32 normTopk,
            float32 wScale) {
        uint32 lane = KernelThread.x();
        uint32 row = KernelThread.globalIdX() / 32;
        if (row >= rows) { return; }
        int64 lb = (int64) row * (int64) experts;
        int64 sb = (int64) row * (int64) used;
        float32 lm = 0.0f - 340282346638528859811704183484516925440.0f;
        uint32 e = lane;
        while (e < experts) {
            float32 v = logits[lb + (int64) e];
            if (v > lm) { lm = v; }
            e = e + 32;
        }
        float32 mx = Wave.reduceMaxF32(lm);
        float32 ls = 0.0f;
        e = lane;
        while (e < experts) {
            ls = ls + Math.exp(logits[lb + (int64) e] - mx);
            e = e + 32;
        }
        float32 sum = Wave.reduceSumF32(ls);
        float32 vLast = 340282346638528859811704183484516925440.0f;
        uint32 iLast = experts;
        uint32 k = 0;
        while (k < used) {
            float32 bv = 0.0f - 1.0f;
            e = lane;
            while (e < experts) {
                float32 p = Math.exp(logits[lb + (int64) e] - mx);
                boolean ok = p < vLast
                    || (p == vLast && e > iLast);
                if (ok && p > bv) { bv = p; }
                e = e + 32;
            }
            float32 vk = Wave.reduceMaxF32(bv);
            uint32 bi = experts;
            e = lane;
            while (e < experts) {
                float32 p = Math.exp(logits[lb + (int64) e] - mx);
                boolean ok = p < vLast
                    || (p == vLast && e > iLast);
                if (ok && p == vk && e < bi) { bi = e; }
                e = e + 32;
            }
            uint32 ik = Wave.reduceMin(bi);
            if (lane == 0) {
                selAll[sb + (int64) k] = (int32) ik;
                wAll[sb + (int64) k] = vk / sum;
            }
            vLast = vk;
            iLast = ik;
            k = k + 1;
        }
        if (lane == 0) {
            if (normTopk != 0) {
                float32 ws = 0.0f;
                k = 0;
                while (k < used) { ws = ws + wAll[sb + (int64) k]; k = k + 1; }
                if (ws < 0.00006103515625f) { ws = 0.00006103515625f; }
                k = 0;
                while (k < used) {
                    wAll[sb + (int64) k] = wAll[sb + (int64) k] / ws;
                    k = k + 1;
                }
            }
            if (wScale != 0.0f && wScale != 1.0f) {
                k = 0;
                while (k < used) {
                    wAll[sb + (int64) k] = wAll[sb + (int64) k] * wScale;
                    k = k + 1;
                }
            }
        }
    }

    public static void moeTopKBatchLaunchNoSync(KernelBuffer<int32> selAll,
            KernelBuffer<float32> wAll, KernelBuffer<float32> logits,
            int64 rows, int64 experts, int64 used, boolean normTopk,
            float32 wScale) {
        KernelStream s = QuantKernel.stream();
        uint32 nt = 0;
        if (normTopk) { nt = 1; }
        moeTopKBatchKernel.launch(s, grid: [(uint32) rows], block: [32])
            (selAll, wAll, logits, (uint32) rows, (uint32) experts,
             (uint32) used, nt, wScale);
        return;
    }

    /**
     * Unit 45: the counting sort that groups a batch's picks by
     * expert, ON THE DEVICE, in ONE workgroup — the host groupPicks
     * reproduced exactly, including its order: picks land in their
     * group in pick order, so the result is deterministic. Thread e
     * owns expert e: it counts its picks, thread 0 prefix-sums the
     * group offsets and the 64-row chunk offsets, then thread e walks
     * the picks again to place its own, and writes its chunk map
     * entries. `meta[0]` receives the chunk count for the id-GEMMs.
     * np <= 4096 picks stage in LDS; larger batches take a second
     * pass over global.
     */
    @Kernel
    public static void moeGroupKernel(KernelBuffer<int32> gRow,
            KernelBuffer<float32> gW, KernelBuffer<int32> rowSlot,
            KernelBuffer<int32> mapE, KernelBuffer<int32> mapT0,
            KernelBuffer<int32> mapM1, KernelBuffer<int32> meta,
            KernelBuffer<int32> selAll, KernelBuffer<float32> wAll,
            uint32 np, uint32 experts, uint32 used) {
        Shared<int32> selL = shared int32[4096];
        Shared<int32> cnt = shared int32[256];
        Shared<int32> off = shared int32[257];
        Shared<int32> coff = shared int32[257];
        uint32 t = KernelThread.x();
        uint32 staged = np;
        if (staged > 4096) { staged = 4096; }
        uint32 i = t;
        while (i < staged) {
            selL[i] = selAll[(int64) i];
            i = i + 256;
        }
        Barrier.workgroup();
        if (t < experts) {
            int32 c = 0;
            i = 0;
            while (i < staged) {
                if ((uint32) selL[i] == t) { c = c + 1; }
                i = i + 1;
            }
            i = staged;
            while (i < np) {
                if ((uint32) selAll[(int64) i] == t) { c = c + 1; }
                i = i + 1;
            }
            cnt[t] = c;
        }
        Barrier.workgroup();
        if (t == 0) {
            int32 o = 0;
            int32 co = 0;
            uint32 e = 0;
            while (e < experts) {
                off[e] = o;
                coff[e] = co;
                o = o + cnt[e];
                co = co + (cnt[e] + 63) / 64;
                e = e + 1;
            }
            off[experts] = o;
            coff[experts] = co;
            meta[0L] = co;
        }
        Barrier.workgroup();
        if (t < experts) {
            int32 slot = off[t];
            i = 0;
            while (i < staged) {
                if ((uint32) selL[i] == t) {
                    gRow[(int64) slot] = (int32) (i / used);
                    gW[(int64) slot] = wAll[(int64) i];
                    rowSlot[(int64) i] = slot;
                    slot = slot + 1;
                }
                i = i + 1;
            }
            i = staged;
            while (i < np) {
                if ((uint32) selAll[(int64) i] == t) {
                    gRow[(int64) slot] = (int32) (i / used);
                    gW[(int64) slot] = wAll[(int64) i];
                    rowSlot[(int64) i] = slot;
                    slot = slot + 1;
                }
                i = i + 1;
            }
            int32 c = cnt[t];
            int32 tw = 0;
            while (tw * 64 < c) {
                int64 mi = (int64) (coff[t] + tw);
                mapE[mi] = (int32) t;
                mapT0[mi] = off[t] + tw * 64;
                mapM1[mi] = off[t] + c;
                tw = tw + 1;
            }
        }
    }

    public static void moeGroupLaunchNoSync(KernelBuffer<int32> gRow,
            KernelBuffer<float32> gW, KernelBuffer<int32> rowSlot,
            KernelBuffer<int32> mapE, KernelBuffer<int32> mapT0,
            KernelBuffer<int32> mapM1, KernelBuffer<int32> meta,
            KernelBuffer<int32> selAll, KernelBuffer<float32> wAll,
            int64 np, int64 experts, int64 used) {
        KernelStream s = QuantKernel.stream();
        moeGroupKernel.launch(s, grid: [1], block: [256])
            (gRow, gW, rowSlot, mapE, mapT0, mapM1, meta, selAll, wAll,
             (uint32) np, (uint32) experts, (uint32) used);
        return;
    }


    /** As {@link #moeCombineKernel} but ACCUMULATING into `out` —
     *  the residual add fused into the combine, one launch fewer per
     *  decode layer (unit 41e). */
    @Kernel
    public static void moeCombineAddKernel(KernelBuffer<float32> out,
            KernelBuffer<float32> rows, KernelBuffer<float32> w,
            uint32 used, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            float32 acc = 0.0f;
            uint32 k = 0;
            while (k < used) {
                acc = acc + w[(int64) k]
                    * rows[(int64) k * (int64) n + (int64) i];
                k = k + 1;
            }
            out[(int64) i] = out[(int64) i] + acc;
        }
    }

    public static void moeCombineAddLaunchNoSync(
            KernelBuffer<float32> out, KernelBuffer<float32> rows,
            KernelBuffer<float32> w, int64 used, int64 n) {
        uint32 un = (uint32) n;
        KernelStream s = QuantKernel.stream();
        moeCombineAddKernel.launch(s, grid: [(un + 255) / 256],
            block: [256])(out, rows, w, (uint32) used, un);
        return;
    }

    /** out[i] = sum_k w[k] * rows[k*n + i] — the weighted expert
     *  combine over the down id-kernel's [used x n] output (unit 40's
     *  epilogue; deterministic, no atomics). */
    @Kernel
    public static void moeCombineKernel(KernelBuffer<float32> out,
            KernelBuffer<float32> rows, KernelBuffer<float32> w,
            uint32 used, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            float32 acc = 0.0f;
            uint32 k = 0;
            while (k < used) {
                acc = acc + w[(int64) k]
                    * rows[(int64) k * (int64) n + (int64) i];
                k = k + 1;
            }
            out[(int64) i] = acc;
        }
    }

    public static void moeCombineLaunchNoSync(KernelBuffer<float32> out,
            KernelBuffer<float32> rows, KernelBuffer<float32> w,
            int64 used, int64 n) {
        uint32 un = (uint32) n;
        KernelStream s = QuantKernel.stream();
        moeCombineKernel.launch(s, grid: [(un + 255) / 256], block: [256])
            (out, rows, w, (uint32) used, un);
        return;
    }

    /**
     * WAVE-COOPERATIVE Q2_K x q8_K (10.12.45.C). The Q6 wave kernel's
     * decomposition on Q2_K's shape: one workgroup of 32 per output
     * row, one 16-element sub-block per lane, two blocks in flight.
     * llama.cpp's mmvq twin (vec_dot_q2_K_q8_1_impl_mmvq) closes the
     * min term by dotting the SPLATTED min against the activations —
     * here that is the same all-ones dot the Q6 kernel already takes
     * for its bias, scaled by the per-sub-block min. On RDNA2+ their
     * launch geometry is nwarps 1 x rows_per_block 1 (mmvq.cu:86) —
     * exactly this wave-per-row shape.
     *
     * Bounds: quants cap at 3, activations at 127, so a 16-element dot
     * caps at 6096; a 4-bit scale takes it to ~91k, the min term to
     * ~30k — both orders inside int32 (signed overflow TRAPS).
     */
    @Kernel
    public static void q2kQ8WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, int64 blocksPerRow, int64 yOff) {
        uint32 lane = KernelThread.x();
        uint32 row = KernelThread.globalIdX() / 32;
        int64 rowBytes = blocksPerRow * 84L;
        float32 acc = 0.0f;
        if (row < rows) {
            int64 i = (int64) row;
            // V2 (2026-08-25, the unpack-cost pass): one lane per
            // 16-byte qs GROUP rather than per sub-block. The first
            // shape had four lanes re-loading the SAME 16 qs bytes at
            // four different shifts; llama.cpp's mmvq twin extracts
            // all four 2-bit planes from one register instead
            // (`(v >> 2i) & 0x03030303`), and this is that move at
            // vector width. A group's four planes are sub-blocks
            // 8*(g/2) + (g%2) + 2k for k = 0..3 at shift 2k, so one
            // load feeds four dots; the per-plane scale multiplies
            // stay in int32 VECTOR lanes and the horizontal reduce
            // happens once per group, not once per sub-block; d, dmin
            // and xs are decoded by 4 lanes per block instead of 16.
            // Eight blocks in flight per wave.
            int32 g = (int32) (lane % 4);
            int64 b = (int64) (lane / 4);
            int32 sb0 = 8 * (g / 2) + (g % 2);
            int32 qOff = 16 + 16 * g;
            Vector<int32,4> z4 = heap Vector<int32,4>(0, 0, 0, 0);
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 84L;
                float32 d = QuantKernel.f16AtDev(packed, ro + 80L);
                float32 dmin = QuantKernel.f16AtDev(packed, ro + 82L);
                int64 xb = b * 320L;
                Vector<int8,16> qv = packed.vload<16>(ro + (int64) qOff);
                Vector<uint8,16> q0 = (qv & 3).asUnsigned();
                Vector<uint8,16> q1 = ((qv >> 2) & 3).asUnsigned();
                Vector<uint8,16> q2 = ((qv >> 4) & 3).asUnsigned();
                Vector<uint8,16> q3 = ((qv >> 6) & 3).asUnsigned();
                int64 ab = xb + (int64) (sb0 * 16);
                Vector<int8,16> a0 = xp.vload<16>(ab);
                Vector<int8,16> a1 = xp.vload<16>(ab + 32L);
                Vector<int8,16> a2 = xp.vload<16>(ab + 64L);
                Vector<int8,16> a3 = xp.vload<16>(ab + 96L);
                int32 s0 = (int32) packed[ro + (int64) sb0] & 255;
                int32 s1 = (int32) packed[ro + (int64) (sb0 + 2)] & 255;
                int32 s2 = (int32) packed[ro + (int64) (sb0 + 4)] & 255;
                int32 s3 = (int32) packed[ro + (int64) (sb0 + 6)] & 255;
                Vector<uint8,16> ones = (q0 ^ q0) | 1;

                Vector<int32,4> td = q0.dotAccum(a0, z4) * (s0 & 15)
                    + q1.dotAccum(a1, z4) * (s1 & 15)
                    + q2.dotAccum(a2, z4) * (s2 & 15)
                    + q3.dotAccum(a3, z4) * (s3 & 15);
                Vector<int32,4> tm = ones.dotAccum(a0, z4) * (s0 >> 4)
                    + ones.dotAccum(a1, z4) * (s1 >> 4)
                    + ones.dotAccum(a2, z4) * (s2 >> 4)
                    + ones.dotAccum(a3, z4) * (s3 >> 4);
                int32 dot = td[0] + td[1] + td[2] + td[3];
                int32 msum = tm[0] + tm[1] + tm[2] + tm[3];

                Vector<int8,4> dvs = xp.vload<4>(xb + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dvs[0] & 255)
                    | (((int32) dvs[1] & 255) << 8)
                    | (((int32) dvs[2] & 255) << 16)
                    | (((int32) dvs[3] & 255) << 24));

                acc = acc + xs * (d * (float32) dot
                    - dmin * (float32) msum);
                b = b + 8L;
            }
        }
        // 2026-08-26: ONE subgroup reduction, not a five-barrier LDS
        // tree. The workgroup IS one wave, so the tree moved through
        // memory what the hardware reduces across lanes — cheap when the
        // k-loop is long, and it is not: at K=4096 a wave runs TWO
        // iterations and then pays the whole tail. Measured on the two
        // formats that carry 95% of this model's decode traffic, cold
        // pool, interleaved min-of-5, GiB/s:
        //   q4_K 14336x4096  180.9 -> 193.8      q4_K 4096x14336 171.6 -> 177.2
        //   q4_K  4096x4096  155.2 -> 157.1      q4_K 1024x4096  129.4 -> 131.4
        //   q6_K  4096x14336 136.5 -> 137.5      q6_K 1024x4096  124.8 -> 127.5
        //   q6_K 128256x4096 158.7 -> 161.0
        // A hand-written shuffle butterfly was tried in 2026-08 and was
        // both wrong and exactly as fast — but at half this kernel's
        // current rate, where the tail was half the share it is now.
        float32 tot = Wave.reduceSumF32(acc);
        if (lane == 0 && row < rows) {
            y[yOff + (int64) row] = tot;
        }
    }

    public static void q2kQ8WaveMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        uint32 ur = (uint32) rows;
        KernelStream s = QuantKernel.stream();
        q2kQ8WaveMatVecKernel.launch(s, grid: [ur], block: [32])
            (y, packed, xp, ur, cols / 256L, yOff);
        return;
    }

    public static void q2kQ8WaveMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        QuantKernel.q2kQ8WaveMatVecLaunchNoSync(y, packed, xp, rows, cols,
            yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    /** {@link #q2kQ8WaveMatVecKernel} over HOST arrays. */
    public static void q2kQ8WaveMatVecIntoDevice(int8[] packed, int64 rows,
            int64 cols, float32[] x, int64 xOff, float32[] y, int64 yOff) {
        int8[] xp #= heap int8[Quant.q8kPackedBytes(cols)];
        Quant.q8kPack(x, xOff, cols, xp);
        float32[] yh #= heap float32[rows];
        KernelBuffer<float32> yb #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<int8> pb #= heap KernelBuffer<int8>(
            (uint64) packed.count());
        KernelBuffer<int8> xpb #= heap KernelBuffer<int8>((uint64) xp.count());
        pb.upload(packed);
        xpb.upload(xp);
        QuantKernel.q2kQ8WaveMatVecLaunch(yb, pb, xpb, rows, cols, 0L);
        yb.download(yh);
        int64 i = 0;
        while (i < rows) { y[yOff + i] = yh[i]; i = i + 1; }
        return;
    }

    /**
     * WAVE-COOPERATIVE Q3_K x q8_K (10.12.45.C). Same decomposition;
     * Q3's quant is `2-bit | hbit<<2` minus 4, so the raw 0..7 value
     * goes into the unsigned-x-signed dotAccum fast tier and the bias
     * leaves as `-4 * asum` — the Q6 kernel's bias trick with bias 4.
     * The 16 six-bit scales decode per LANE (each lane needs only its
     * own sub-block's), exactly as the host floor decodes them.
     *
     * Bounds: raw quants cap at 7 -> 16-element dot caps at 14224; a
     * signed 6-bit scale takes it to ~455k — well inside int32.
     */
    @Kernel
    public static void q3kQ8WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, int64 blocksPerRow, int64 yOff) {
        uint32 lane = KernelThread.x();
        uint32 row = KernelThread.globalIdX() / 32;
        int64 rowBytes = blocksPerRow * 110L;
        float32 acc = 0.0f;
        if (row < rows) {
            int64 i = (int64) row;
            // V2 (2026-08-25, the unpack-cost pass — see the Q2 kernel
            // for the full argument): one lane per 16-byte qs group,
            // all four 2-bit planes extracted from one register, and
            // ONE hmask load serves the whole group — plane k of group
            // g is sub-block 8*(g/2) + (g%2) + 2k, whose high bit is
            // bit 4*(g/2) + k of the same 16 hmask bytes. Scale
            // multiplies stay in int32 vector lanes; one horizontal
            // reduce per group; d and xs decoded by 4 lanes per block
            // instead of 16. Eight blocks in flight.
            int32 g = (int32) (lane % 4);
            int64 b = (int64) (lane / 4);
            int32 sb0 = 8 * (g / 2) + (g % 2);
            int32 qOff = 32 + 16 * g;
            int32 hOff = 16 * (g % 2);
            int32 hb0 = 4 * (g / 2);
            Vector<int32,4> z4 = heap Vector<int32,4>(0, 0, 0, 0);
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 110L;
                float32 d = QuantKernel.f16AtDev(packed, ro + 108L);
                int64 xb = b * 320L;
                Vector<int8,16> qv = packed.vload<16>(ro + (int64) qOff);
                Vector<int8,16> hv = packed.vload<16>(ro + (int64) hOff);
                Vector<uint8,16> q0 = ((qv & 3)
                    | (((hv >> hb0) & 1) << 2)).asUnsigned();
                Vector<uint8,16> q1 = (((qv >> 2) & 3)
                    | (((hv >> (hb0 + 1)) & 1) << 2)).asUnsigned();
                Vector<uint8,16> q2 = (((qv >> 4) & 3)
                    | (((hv >> (hb0 + 2)) & 1) << 2)).asUnsigned();
                Vector<uint8,16> q3 = (((qv >> 6) & 3)
                    | (((hv >> (hb0 + 3)) & 1) << 2)).asUnsigned();
                int64 ab = xb + (int64) (sb0 * 16);
                Vector<int8,16> a0 = xp.vload<16>(ab);
                Vector<int8,16> a1 = xp.vload<16>(ab + 32L);
                Vector<int8,16> a2 = xp.vload<16>(ab + 64L);
                Vector<int8,16> a3 = xp.vload<16>(ab + 96L);
                Vector<uint8,16> ones = (q0 ^ q0) | 1;

                // The four six-bit signed scales, decoded INLINE as the
                // host floor decodes all sixteen (a static helper's
                // KernelBuffer indexing does not resolve outside a
                // kernel body). No ternary: expression-form conditionals
                // do not lower in kernel bodies. sb0 is 0/1/8/9, so the
                // low-nibble/high-nibble split (sb < 8 vs >= 8) is
                // UNIFORM across a group's four sub-blocks sb0+2k.
                int32 lb0 = (int32) packed[ro + (int64) (96 + (sb0 % 8))]
                    & 255;
                int32 lb1 = (int32) packed[ro + (int64) (96 + ((sb0 + 2) % 8))]
                    & 255;
                int32 lb2 = (int32) packed[ro + (int64) (96 + ((sb0 + 4) % 8))]
                    & 255;
                int32 lb3 = (int32) packed[ro + (int64) (96 + ((sb0 + 6) % 8))]
                    & 255;
                int32 lo0 = lb0 & 15;
                int32 lo1 = lb1 & 15;
                int32 lo2 = lb2 & 15;
                int32 lo3 = lb3 & 15;
                if (sb0 >= 8) {
                    lo0 = lb0 >> 4;
                    lo1 = lb1 >> 4;
                    lo2 = lb2 >> 4;
                    lo3 = lb3 >> 4;
                }
                int32 h0 = ((int32) packed[ro + (int64) (104 + (sb0 & 3))]
                    & 255) >> (2 * (sb0 / 4));
                int32 h1 = ((int32) packed[ro + (int64) (104 + ((sb0 + 2) & 3))]
                    & 255) >> (2 * ((sb0 + 2) / 4));
                int32 h2 = ((int32) packed[ro + (int64) (104 + ((sb0 + 4) & 3))]
                    & 255) >> (2 * ((sb0 + 4) / 4));
                int32 h3 = ((int32) packed[ro + (int64) (104 + ((sb0 + 6) & 3))]
                    & 255) >> (2 * ((sb0 + 6) / 4));
                int32 sc0 = (lo0 | ((h0 & 3) << 4)) - 32;
                int32 sc1 = (lo1 | ((h1 & 3) << 4)) - 32;
                int32 sc2 = (lo2 | ((h2 & 3) << 4)) - 32;
                int32 sc3 = (lo3 | ((h3 & 3) << 4)) - 32;

                Vector<int32,4> td = q0.dotAccum(a0, z4) * sc0
                    + q1.dotAccum(a1, z4) * sc1
                    + q2.dotAccum(a2, z4) * sc2
                    + q3.dotAccum(a3, z4) * sc3;
                Vector<int32,4> ta = ones.dotAccum(a0, z4) * sc0
                    + ones.dotAccum(a1, z4) * sc1
                    + ones.dotAccum(a2, z4) * sc2
                    + ones.dotAccum(a3, z4) * sc3;
                int32 dot = td[0] + td[1] + td[2] + td[3];
                int32 asum = ta[0] + ta[1] + ta[2] + ta[3];

                Vector<int8,4> dvs = xp.vload<4>(xb + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dvs[0] & 255)
                    | (((int32) dvs[1] & 255) << 8)
                    | (((int32) dvs[2] & 255) << 16)
                    | (((int32) dvs[3] & 255) << 24));

                acc = acc + d * xs * (float32) (dot - 4 * asum);
                b = b + 8L;
            }
        }
        // 2026-08-26: ONE subgroup reduction, not a five-barrier LDS
        // tree. The workgroup IS one wave, so the tree moved through
        // memory what the hardware reduces across lanes — cheap when the
        // k-loop is long, and it is not: at K=4096 a wave runs TWO
        // iterations and then pays the whole tail. Measured on the two
        // formats that carry 95% of this model's decode traffic, cold
        // pool, interleaved min-of-5, GiB/s:
        //   q4_K 14336x4096  180.9 -> 193.8      q4_K 4096x14336 171.6 -> 177.2
        //   q4_K  4096x4096  155.2 -> 157.1      q4_K 1024x4096  129.4 -> 131.4
        //   q6_K  4096x14336 136.5 -> 137.5      q6_K 1024x4096  124.8 -> 127.5
        //   q6_K 128256x4096 158.7 -> 161.0
        // A hand-written shuffle butterfly was tried in 2026-08 and was
        // both wrong and exactly as fast — but at half this kernel's
        // current rate, where the tail was half the share it is now.
        float32 tot = Wave.reduceSumF32(acc);
        if (lane == 0 && row < rows) {
            y[yOff + (int64) row] = tot;
        }
    }

    public static void q3kQ8WaveMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        uint32 ur = (uint32) rows;
        KernelStream s = QuantKernel.stream();
        q3kQ8WaveMatVecKernel.launch(s, grid: [ur], block: [32])
            (y, packed, xp, ur, cols / 256L, yOff);
        return;
    }

    public static void q3kQ8WaveMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        QuantKernel.q3kQ8WaveMatVecLaunchNoSync(y, packed, xp, rows, cols,
            yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    /** {@link #q3kQ8WaveMatVecKernel} over HOST arrays. */
    public static void q3kQ8WaveMatVecIntoDevice(int8[] packed, int64 rows,
            int64 cols, float32[] x, int64 xOff, float32[] y, int64 yOff) {
        int8[] xp #= heap int8[Quant.q8kPackedBytes(cols)];
        Quant.q8kPack(x, xOff, cols, xp);
        float32[] yh #= heap float32[rows];
        KernelBuffer<float32> yb #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<int8> pb #= heap KernelBuffer<int8>(
            (uint64) packed.count());
        KernelBuffer<int8> xpb #= heap KernelBuffer<int8>((uint64) xp.count());
        pb.upload(packed);
        xpb.upload(xp);
        QuantKernel.q3kQ8WaveMatVecLaunch(yb, pb, xpb, rows, cols, 0L);
        yb.download(yh);
        int64 i = 0;
        while (i < rows) { y[yOff + i] = yh[i]; i = i + 1; }
        return;
    }

    /**
     * WAVE-COOPERATIVE Q5_K x q8_K (10.12.39). The Q4_K kernel plus the
     * fifth bit: same 16-byte header, same lane split (four lanes per
     * block, lane `g` owns sub-blocks 2g and 2g+1), same dmin ones-dot.
     * The high bits for the whole super-block live in qh[32] at +16 —
     * element `e`'s bit is `qh[e % 32] >> (e / 32)`, and a lane's two
     * sub-blocks are simply bits 2g and 2g+1 of all 32 bytes, so the
     * fifth bit costs ONE 32-byte load and two vector shifts. Quants are
     * 0..31, still inside the unsigned-x-signed dotAccum tier.
     *
     * Bounds: 31 x 127 x 32 = ~126k per block dot; x a 6-bit scale =
     * ~7.9M — well inside int32.
     */
    @Kernel
    public static void q5kQ8WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, int64 blocksPerRow, int64 yOff) {
        uint32 lane = KernelThread.x();
        uint32 row = KernelThread.globalIdX() / 32;
        int64 rowBytes = blocksPerRow * 176L;
        float32 acc = 0.0f;
        if (row < rows) {
            int64 i = (int64) row;
            int32 g = (int32) (lane % 4);
            int64 b = (int64) (lane / 4);
            Vector<int32,8> zv = heap Vector<int32,8>(0, 0, 0, 0, 0, 0, 0, 0);
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 176L;

                // The Q4_K header, byte for byte (see q4kQ8WaveMatVecKernel
                // for why only THIS lane's two sub-blocks are decoded).
                Vector<int8,16> hv = packed.vload<16>(ro);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                int32 sc0 = 0;
                int32 sc1 = 0;
                int32 mn0 = 0;
                int32 mn1 = 0;
                if (g < 2) {
                    int32 j = 2 * g;
                    sc0 = (int32) hv[4 + j] & 63;
                    sc1 = (int32) hv[5 + j] & 63;
                    mn0 = (int32) hv[8 + j] & 63;
                    mn1 = (int32) hv[9 + j] & 63;
                } else {
                    int32 j = 2 * g - 4;
                    int32 k0 = (int32) hv[12 + j] & 255;
                    int32 k1 = (int32) hv[13 + j] & 255;
                    int32 d0 = (int32) hv[4 + j] & 255;
                    int32 d1 = (int32) hv[5 + j] & 255;
                    int32 m0 = (int32) hv[8 + j] & 255;
                    int32 m1 = (int32) hv[9 + j] & 255;
                    sc0 = (k0 & 15) | ((d0 >> 2) & 48);
                    sc1 = (k1 & 15) | ((d1 >> 2) & 48);
                    mn0 = (k0 >> 4) | ((m0 >> 2) & 48);
                    mn1 = (k1 >> 4) | ((m1 >> 2) & 48);
                }

                Vector<uint8,32> qh = packed.vload<32>(ro + 16L)
                    .asUnsigned();
                Vector<uint8,32> raw = packed.vload<32>(
                    ro + 48L + (int64) (32 * g)).asUnsigned();
                Vector<uint8,32> lo = (raw & 15)
                    | (((qh >> (2 * g)) & 1) << 4);
                Vector<uint8,32> hi = ((raw >> 4) & 15)
                    | (((qh >> (2 * g + 1)) & 1) << 4);
                int64 xb = b * 320L + (int64) (64 * g);
                Vector<int8,32> a0 = xp.vload<32>(xb);
                Vector<int8,32> a1 = xp.vload<32>(xb + 32L);
                Vector<int32,8> dl = lo.dotAccum(a0, zv);
                Vector<int32,8> dh = hi.dotAccum(a1, zv);
                int32 sumi = (dl[0] + dl[1] + dl[2] + dl[3]
                    + dl[4] + dl[5] + dl[6] + dl[7]) * sc0
                             + (dh[0] + dh[1] + dh[2] + dh[3]
                                 + dh[4] + dh[5] + dh[6] + dh[7]) * sc1;

                Vector<uint8,32> ones = (lo ^ lo) | 1;

                // Unit 61: the activation sums and the two dot sums are reduced

                // FIRST and scaled as scalars — integer-exact, so bit-identical to

                // scaling the eight lanes, and 2 quarter-rate multiplies where

                // there were 16 (v_mul_lo/v_mad_u64 are 4-cycle on RDNA).

                Vector<int32,8> os0 = ones.dotAccum(a0, zv);

                Vector<int32,8> os1 = ones.dotAccum(a1, zv);

                int32 as0 = os0[0] + os0[1] + os0[2] + os0[3]
                    + os0[4] + os0[5] + os0[6] + os0[7];

                int32 as1 = os1[0] + os1[1] + os1[2] + os1[3]
                    + os1[4] + os1[5] + os1[6] + os1[7];
                int32 dmins = as0 * mn0 + as1 * mn1;

                Vector<int8,4> dv = xp.vload<4>(b * 320L + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dv[0] & 255)
                    | (((int32) dv[1] & 255) << 8)
                    | (((int32) dv[2] & 255) << 16)
                    | (((int32) dv[3] & 255) << 24));

                acc = acc + d * xs * (float32) sumi
                          - dmin * xs * (float32) dmins;
                b = b + 8L;
            }
        }
        // 2026-08-26: ONE subgroup reduction, not a five-barrier LDS
        // tree. The workgroup IS one wave, so the tree moved through
        // memory what the hardware reduces across lanes — cheap when the
        // k-loop is long, and it is not: at K=4096 a wave runs TWO
        // iterations and then pays the whole tail. Measured on the two
        // formats that carry 95% of this model's decode traffic, cold
        // pool, interleaved min-of-5, GiB/s:
        //   q4_K 14336x4096  180.9 -> 193.8      q4_K 4096x14336 171.6 -> 177.2
        //   q4_K  4096x4096  155.2 -> 157.1      q4_K 1024x4096  129.4 -> 131.4
        //   q6_K  4096x14336 136.5 -> 137.5      q6_K 1024x4096  124.8 -> 127.5
        //   q6_K 128256x4096 158.7 -> 161.0
        // A hand-written shuffle butterfly was tried in 2026-08 and was
        // both wrong and exactly as fast — but at half this kernel's
        // current rate, where the tail was half the share it is now.
        float32 tot = Wave.reduceSumF32(acc);
        if (lane == 0 && row < rows) {
            y[yOff + (int64) row] = tot;
        }
    }

    public static void q5kQ8WaveMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        uint32 ur = (uint32) rows;
        KernelStream s = QuantKernel.stream();
        q5kQ8WaveMatVecKernel.launch(s, grid: [ur], block: [32])
            (y, packed, xp, ur, cols / 256L, yOff);
        return;
    }

    public static void q5kQ8WaveMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        QuantKernel.q5kQ8WaveMatVecLaunchNoSync(y, packed, xp, rows, cols,
            yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    /** {@link #q5kQ8WaveMatVecKernel} over HOST arrays. */
    public static void q5kQ8WaveMatVecIntoDevice(int8[] packed, int64 rows,
            int64 cols, float32[] x, int64 xOff, float32[] y, int64 yOff) {
        int8[] xp #= heap int8[Quant.q8kPackedBytes(cols)];
        Quant.q8kPack(x, xOff, cols, xp);
        float32[] yh #= heap float32[rows];
        KernelBuffer<float32> yb #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<int8> pb #= heap KernelBuffer<int8>(
            (uint64) packed.count());
        KernelBuffer<int8> xpb #= heap KernelBuffer<int8>((uint64) xp.count());
        pb.upload(packed);
        xpb.upload(xp);
        QuantKernel.q5kQ8WaveMatVecLaunch(yb, pb, xpb, rows, cols, 0L);
        yb.download(yh);
        int64 i = 0;
        while (i < rows) { y[yOff + i] = yh[i]; i = i + 1; }
        return;
    }

    /**
     * WAVE-COOPERATIVE Q4_0 x q8_K. One LANE per 32-element weight block,
     * like the Q8_0 twin — Q4_0's block is 18 bytes so the row stride is
     * not dword-aligned, which costs nothing here because the wave
     * mat-vecs address bytes, not words (only the coop GEMM needs a
     * repack).
     *
     * The -8 bias rides the activation sum rather than the weights, so
     * the quants stay unsigned 0..15 and feed the same mixed u8 x i8
     * dotAccum every other kernel in this family uses:
     *   sum (q - 8)*a  ==  sum q*a  -  8 * sum a
     */
    @Kernel
    public static void q40Q8WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, int64 blocksPerRow, int64 yOff) {
        uint32 lane = KernelThread.x();
        uint32 row = KernelThread.globalIdX() / 32;
        int64 rowBytes = blocksPerRow * 18L;
        float32 acc = 0.0f;
        if (row < rows) {
            int64 i = (int64) row;
            Vector<int32,4> z4 = heap Vector<int32,4>(0, 0, 0, 0);
            int64 wb = (int64) lane;
            while (wb < blocksPerRow) {
            int64 ro = i * rowBytes + wb * 18L;
            Vector<int8,4> dh = packed.vload<4>(ro);
            float32 d = GgufFile.halfBitsToF32(((int32) dh[0] & 255)
                | (((int32) dh[1] & 255) << 8));
            Vector<int8,16> qs = packed.vload<16>(ro + 2L);
            Vector<uint8,16> lo = (qs & 15).asUnsigned();
            Vector<uint8,16> hi = ((qs >> 4) & 15).asUnsigned();
            int64 ab = wb / 8L;
            int64 xb = ab * 320L + (wb % 8L) * 32L;
            Vector<int8,16> a0 = xp.vload<16>(xb);
            Vector<int8,16> a1 = xp.vload<16>(xb + 16L);
            Vector<uint8,16> ones = (lo ^ lo) | 1;
            Vector<int32,4> t0 = lo.dotAccum(a0, z4);
            Vector<int32,4> t1 = hi.dotAccum(a1, z4);
            Vector<int32,4> s0 = ones.dotAccum(a0, z4);
            Vector<int32,4> s1 = ones.dotAccum(a1, z4);
            int32 dot = t0[0] + t0[1] + t0[2] + t0[3]
                      + t1[0] + t1[1] + t1[2] + t1[3];
            int32 asum = s0[0] + s0[1] + s0[2] + s0[3]
                       + s1[0] + s1[1] + s1[2] + s1[3];
            Vector<int8,4> dv = xp.vload<4>(ab * 320L + 288L);
            float32 xs = Cajeta.bitsToF32(((int32) dv[0] & 255)
                | (((int32) dv[1] & 255) << 8)
                | (((int32) dv[2] & 255) << 16)
                | (((int32) dv[3] & 255) << 24));
            acc = acc + d * xs * (float32) (dot - 8 * asum);
            wb = wb + 32L;
            }
        }
        float32 tot = Wave.reduceSumF32(acc);
        if (lane == 0 && row < rows) {
            y[yOff + (int64) row] = tot;
        }
    }

    public static void q40Q8WaveMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        KernelStream s = QuantKernel.stream();
        q40Q8WaveMatVecKernel.launch(s, grid: [(uint32) rows], block: [32])
            (y, packed, xp, (uint32) rows, cols / 32L, yOff);
        return;
    }

    public static void q40Q8WaveMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        QuantKernel.q40Q8WaveMatVecLaunchNoSync(y, packed, xp, rows, cols, yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    /**
     * WAVE-COOPERATIVE Q5_0 x q8_K. One LANE per 32-element block, 22
     * bytes each: { f16 d; u32 qh; u8 qs[16] }.
     *
     * The 5th bit does NOT vectorize the way Q5_K's does. In Q5_K a
     * sub-block's 32 elements all read the SAME bit position of 32
     * different bytes, so one shift over a byte vector serves them all.
     * In Q5_0 element j reads bit j of a single u32 — a different shift
     * per lane of the vector, which the vector ops cannot express.
     *
     * So the high bit rides the ACTIVATION sum instead of the weight
     * vector. With hb the 5th bit and lo the nibble:
     *   sum (lo + 16*hb - 16) * a  ==  sum lo*a  +  16*sum hb*a  -  16*sum a
     * The first and third terms stay vector dotAccums; only the middle
     * one is an unrolled 32-term scalar fold over the activation bytes
     * already in registers, with a multiply by the bit rather than a
     * branch. Correctness first — if Q5_0 decode ever shows up hot, the
     * lever is a bit-spread that builds hb as a vector.
     */
    @Kernel
    public static void q50Q8WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, int64 blocksPerRow, int64 yOff) {
        uint32 lane = KernelThread.x();
        uint32 row = KernelThread.globalIdX() / 32;
        int64 rowBytes = blocksPerRow * 22L;
        float32 acc = 0.0f;
        if (row < rows) {
            int64 i = (int64) row;
            Vector<int32,4> z4 = heap Vector<int32,4>(0, 0, 0, 0);
            int64 wb = (int64) lane;
            while (wb < blocksPerRow) {
            int64 ro = i * rowBytes + wb * 22L;
            Vector<int8,4> dh = packed.vload<4>(ro);
            float32 d = GgufFile.halfBitsToF32(((int32) dh[0] & 255)
                | (((int32) dh[1] & 255) << 8));
            Vector<int8,4> qhb = packed.vload<4>(ro + 2L);
            int32 qh = ((int32) qhb[0] & 255)
                | (((int32) qhb[1] & 255) << 8)
                | (((int32) qhb[2] & 255) << 16)
                | (((int32) qhb[3] & 255) << 24);
            Vector<int8,16> qs = packed.vload<16>(ro + 6L);
            Vector<uint8,16> lo = (qs & 15).asUnsigned();
            Vector<uint8,16> hi = ((qs >> 4) & 15).asUnsigned();
            int64 ab = wb / 8L;
            int64 xb = ab * 320L + (wb % 8L) * 32L;
            Vector<int8,16> a0 = xp.vload<16>(xb);
            Vector<int8,16> a1 = xp.vload<16>(xb + 16L);
            Vector<uint8,16> ones = (lo ^ lo) | 1;
            Vector<int32,4> t0 = lo.dotAccum(a0, z4);
            Vector<int32,4> t1 = hi.dotAccum(a1, z4);
            Vector<int32,4> s0 = ones.dotAccum(a0, z4);
            Vector<int32,4> s1 = ones.dotAccum(a1, z4);
            int32 dot = t0[0] + t0[1] + t0[2] + t0[3]
                      + t1[0] + t1[1] + t1[2] + t1[3];
            int32 asum = s0[0] + s0[1] + s0[2] + s0[3]
                       + s1[0] + s1[1] + s1[2] + s1[3];
            int32 hs = 0;
            hs = hs + (((qh >> 0) & 1) * (int32) a0[0]);
            hs = hs + (((qh >> 1) & 1) * (int32) a0[1]);
            hs = hs + (((qh >> 2) & 1) * (int32) a0[2]);
            hs = hs + (((qh >> 3) & 1) * (int32) a0[3]);
            hs = hs + (((qh >> 4) & 1) * (int32) a0[4]);
            hs = hs + (((qh >> 5) & 1) * (int32) a0[5]);
            hs = hs + (((qh >> 6) & 1) * (int32) a0[6]);
            hs = hs + (((qh >> 7) & 1) * (int32) a0[7]);
            hs = hs + (((qh >> 8) & 1) * (int32) a0[8]);
            hs = hs + (((qh >> 9) & 1) * (int32) a0[9]);
            hs = hs + (((qh >> 10) & 1) * (int32) a0[10]);
            hs = hs + (((qh >> 11) & 1) * (int32) a0[11]);
            hs = hs + (((qh >> 12) & 1) * (int32) a0[12]);
            hs = hs + (((qh >> 13) & 1) * (int32) a0[13]);
            hs = hs + (((qh >> 14) & 1) * (int32) a0[14]);
            hs = hs + (((qh >> 15) & 1) * (int32) a0[15]);
            hs = hs + (((qh >> 16) & 1) * (int32) a1[0]);
            hs = hs + (((qh >> 17) & 1) * (int32) a1[1]);
            hs = hs + (((qh >> 18) & 1) * (int32) a1[2]);
            hs = hs + (((qh >> 19) & 1) * (int32) a1[3]);
            hs = hs + (((qh >> 20) & 1) * (int32) a1[4]);
            hs = hs + (((qh >> 21) & 1) * (int32) a1[5]);
            hs = hs + (((qh >> 22) & 1) * (int32) a1[6]);
            hs = hs + (((qh >> 23) & 1) * (int32) a1[7]);
            hs = hs + (((qh >> 24) & 1) * (int32) a1[8]);
            hs = hs + (((qh >> 25) & 1) * (int32) a1[9]);
            hs = hs + (((qh >> 26) & 1) * (int32) a1[10]);
            hs = hs + (((qh >> 27) & 1) * (int32) a1[11]);
            hs = hs + (((qh >> 28) & 1) * (int32) a1[12]);
            hs = hs + (((qh >> 29) & 1) * (int32) a1[13]);
            hs = hs + (((qh >> 30) & 1) * (int32) a1[14]);
            hs = hs + (((qh >> 31) & 1) * (int32) a1[15]);
            Vector<int8,4> dv = xp.vload<4>(ab * 320L + 288L);
            float32 xs = Cajeta.bitsToF32(((int32) dv[0] & 255)
                | (((int32) dv[1] & 255) << 8)
                | (((int32) dv[2] & 255) << 16)
                | (((int32) dv[3] & 255) << 24));
            acc = acc + d * xs
                * (float32) (dot + 16 * hs - 16 * asum);
            wb = wb + 32L;
            }
        }
        float32 tot = Wave.reduceSumF32(acc);
        if (lane == 0 && row < rows) {
            y[yOff + (int64) row] = tot;
        }
    }

    public static void q50Q8WaveMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        KernelStream s = QuantKernel.stream();
        q50Q8WaveMatVecKernel.launch(s, grid: [(uint32) rows], block: [32])
            (y, packed, xp, (uint32) rows, cols / 32L, yOff);
        return;
    }

    public static void q50Q8WaveMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        QuantKernel.q50Q8WaveMatVecLaunchNoSync(y, packed, xp, rows, cols, yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    /**
     * WAVE-COOPERATIVE Q8_0 x q8_K (10.12.39). The simplest member of the
     * family: the weights are already int8, so there is nothing to unpack
     * — one LANE per 32-element weight block, a signed x signed dotAccum,
     * and the scale is the block's f16 `d` times the covering activation
     * block's f32 `d`. Thirty-two weight blocks in flight per wave span
     * exactly four activation blocks; a 4096-wide row is 4 lane
     * iterations, 14336 is 14.
     */
    @Kernel
    public static void q80Q8WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            uint32 rows, int64 blocksPerRow, int64 yOff) {
        uint32 lane = KernelThread.x();
        uint32 row = KernelThread.globalIdX() / 32;
        int64 rowBytes = blocksPerRow * 34L;
        float32 acc = 0.0f;
        if (row < rows) {
            int64 i = (int64) row;
            Vector<int32,8> zv = heap Vector<int32,8>(0, 0, 0, 0, 0, 0, 0, 0);
            int64 wb = (int64) lane;
            while (wb < blocksPerRow) {
                int64 ro = i * rowBytes + wb * 34L;
                // The f16 scale is bytes 0..1; vload<4> because 2-byte
                // vector loads are not a shape the loader has, and the
                // two spilled bytes are this block's first quants.
                Vector<int8,4> dh = packed.vload<4>(ro);
                float32 d = GgufFile.halfBitsToF32(((int32) dh[0] & 255)
                    | (((int32) dh[1] & 255) << 8));
                Vector<int8,32> w = packed.vload<32>(ro + 2L);
                int64 ab = wb / 8L;
                Vector<int8,32> a = xp.vload<32>(ab * 320L
                    + (wb % 8L) * 32L);
                Vector<int32,8> tot = w.dotAccum(a, zv);
                int32 sumi = tot[0] + tot[1] + tot[2] + tot[3]
                           + tot[4] + tot[5] + tot[6] + tot[7];
                Vector<int8,4> dv = xp.vload<4>(ab * 320L + 288L);
                float32 xs = Cajeta.bitsToF32(((int32) dv[0] & 255)
                    | (((int32) dv[1] & 255) << 8)
                    | (((int32) dv[2] & 255) << 16)
                    | (((int32) dv[3] & 255) << 24));
                acc = acc + d * xs * (float32) sumi;
                wb = wb + 32L;
            }
        }
        // 2026-08-26: ONE subgroup reduction, not a five-barrier LDS
        // tree. The workgroup IS one wave, so the tree moved through
        // memory what the hardware reduces across lanes — cheap when the
        // k-loop is long, and it is not: at K=4096 a wave runs TWO
        // iterations and then pays the whole tail. Measured on the two
        // formats that carry 95% of this model's decode traffic, cold
        // pool, interleaved min-of-5, GiB/s:
        //   q4_K 14336x4096  180.9 -> 193.8      q4_K 4096x14336 171.6 -> 177.2
        //   q4_K  4096x4096  155.2 -> 157.1      q4_K 1024x4096  129.4 -> 131.4
        //   q6_K  4096x14336 136.5 -> 137.5      q6_K 1024x4096  124.8 -> 127.5
        //   q6_K 128256x4096 158.7 -> 161.0
        // A hand-written shuffle butterfly was tried in 2026-08 and was
        // both wrong and exactly as fast — but at half this kernel's
        // current rate, where the tail was half the share it is now.
        float32 tot = Wave.reduceSumF32(acc);
        if (lane == 0 && row < rows) {
            y[yOff + (int64) row] = tot;
        }
    }

    public static void q80Q8WaveMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        uint32 ur = (uint32) rows;
        KernelStream s = QuantKernel.stream();
        // Q8_0 blocks are 32-wide, not 256 — the one launch in this
        // family whose blocksPerRow is cols / 32.
        q80Q8WaveMatVecKernel.launch(s, grid: [ur], block: [32])
            (y, packed, xp, ur, cols / 32L, yOff);
        return;
    }

    public static void q80Q8WaveMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 yOff) {
        QuantKernel.q80Q8WaveMatVecLaunchNoSync(y, packed, xp, rows, cols,
            yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    /** {@link #q80Q8WaveMatVecKernel} over HOST arrays. */
    public static void q80Q8WaveMatVecIntoDevice(int8[] packed, int64 rows,
            int64 cols, float32[] x, int64 xOff, float32[] y, int64 yOff) {
        int8[] xp #= heap int8[Quant.q8kPackedBytes(cols)];
        Quant.q8kPack(x, xOff, cols, xp);
        float32[] yh #= heap float32[rows];
        KernelBuffer<float32> yb #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<int8> pb #= heap KernelBuffer<int8>(
            (uint64) packed.count());
        KernelBuffer<int8> xpb #= heap KernelBuffer<int8>((uint64) xp.count());
        pb.upload(packed);
        xpb.upload(xp);
        QuantKernel.q80Q8WaveMatVecLaunch(yb, pb, xpb, rows, cols, 0L);
        yb.download(yh);
        int64 i = 0;
        while (i < rows) { y[yOff + i] = yh[i]; i = i + 1; }
        return;
    }

    /** {@link #q6kQ8WaveMatVecKernel} over HOST arrays. */
    public static void q6kQ8WaveMatVecIntoDevice(int8[] packed, int64 rows,
            int64 cols, float32[] x, int64 xOff, float32[] y, int64 yOff) {
        int8[] xp #= heap int8[Quant.q8kPackedBytes(cols)];
        Quant.q8kPack(x, xOff, cols, xp);
        float32[] yh #= heap float32[rows];
        KernelBuffer<float32> yb #= heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<int8> pb #= heap KernelBuffer<int8>(
            (uint64) packed.count());
        KernelBuffer<int8> xpb #= heap KernelBuffer<int8>((uint64) xp.count());
        pb.upload(packed);
        xpb.upload(xp);
        QuantKernel.q6kQ8WaveMatVecLaunch(yb, pb, xpb, rows, cols, 0L);
        yb.download(yh);
        int64 i = 0;
        while (i < rows) { y[yOff + i] = yh[i]; i = i + 1; }
        return;
    }


    /**
     * Quantize activations into `Quant.q8kPack` form ON THE DEVICE — the
     * kernel that makes device residency possible (plan 10.2), and
     * llama.cpp's `quantize_row_q8_1_cuda` in this engine's block layout.
     *
     * One work item per 256-element block. That is a tiny grid — 16 blocks
     * for a 4096-wide activation — and deliberately so: it runs once per
     * DISTINCT activation, not once per projection, and it exists to
     * remove a host round trip rather than to be fast in itself.
     *
     * It must agree with the host packer BIT FOR BIT, because the two are
     * interchangeable by design and a test that only checked "close" would
     * let the device path drift into a second, slightly different
     * quantization that nothing compares against.
     */
    @Kernel
    public static void q8kPackKernel(KernelBuffer<int8> out,
            KernelBuffer<float32> x, uint32 blocks) {
        Shared<int32> psum = shared int32[32];
        uint32 lane = KernelThread.x();
        uint32 blk = KernelThread.globalIdX() / 32;
        if (blk < blocks) {
            int64 b = (int64) blk;
            int64 xb = b * 256L;
            int64 ob = b * 320L;
            // Eight elements a lane, thirty-two lanes to a block. The first
            // version gave a whole block to ONE work item, which put 256
            // dependent global loads on a single lane and made the device
            // packer slower than the host packer it exists to replace.
            int64 e0 = xb + (int64) (lane * 8);

            float32 amax = 0.0f;
            int32 t = 0;
            while (t < 8) {
                float32 v = x[e0 + (int64) t];
                float32 av = v;
                // An `if`, not a ternary: a conditional EXPRESSION in a
                // kernel body silently skips the whole kernel (10.9).
                if (v < 0.0f) { av = 0.0f - v; }
                if (av > amax) { amax = av; }
                t = t + 1;
            }
            // Unit 54: the block IS the wave — one reduction, no tree.
            float32 bmax = Wave.reduceMaxF32(amax);
            // An all-zero block quantizes to all-zero with a zero scale; the
            // reciprocal has to be guarded or it is inf * 0.
            float32 inv = 0.0f;
            if (bmax > 0.0f) { inv = 127.0f / bmax; }

            int32 s = 0;
            int32 k = 0;
            while (k < 8) {
                float32 fv = x[e0 + (int64) k] * inv;
                int32 qi = (int32) Math.round(fv);
                out[ob + (int64) (lane * 8) + (int64) k] = (int8) qi;
                s = s + qi;
                k = k + 1;
            }
            psum[lane] = s;
            Barrier.workgroup();

            // A 32-element SUB-BLOCK is four lanes. The sums are integers,
            // so regrouping them across lanes is exact and the block stays
            // byte-identical to the host packer.
            if (lane < 8) {
                uint32 base = lane * 4;
                int32 tot = psum[base] + psum[base + 1]
                          + psum[base + 2] + psum[base + 3];
                int64 so = ob + 256L + (int64) (lane * 4);
                int32 b0 = tot & 255;
                int32 b1 = (tot >> 8) & 255;
                int32 b2 = (tot >> 16) & 255;
                int32 b3 = (tot >> 24) & 255;
                if (b0 > 127) { b0 = b0 - 256; }
                if (b1 > 127) { b1 = b1 - 256; }
                if (b2 > 127) { b2 = b2 - 256; }
                if (b3 > 127) { b3 = b3 - 256; }
                out[so] = (int8) b0;
                out[so + 1L] = (int8) b1;
                out[so + 2L] = (int8) b2;
                out[so + 3L] = (int8) b3;
            }
            if (lane == 0) {
                // The scale is bmax/127, so never negative — which is what
                // lets the kernels rebuild it with a masked shift.
                float32 dsc = bmax / 127.0f;
                int32 db = Cajeta.f32ToBits(dsc);
                int32 e1 = db & 255;
                int32 e2 = (db >> 8) & 255;
                int32 e3 = (db >> 16) & 255;
                int32 e4 = (db >> 24) & 255;
                if (e1 > 127) { e1 = e1 - 256; }
                if (e2 > 127) { e2 = e2 - 256; }
                if (e3 > 127) { e3 = e3 - 256; }
                if (e4 > 127) { e4 = e4 - 256; }
                out[ob + 288L] = (int8) e1;
                out[ob + 289L] = (int8) e2;
                out[ob + 290L] = (int8) e3;
                out[ob + 291L] = (int8) e4;
            }
        }
    }

    /**
     * 10.12.45.B — device-to-device f32 copy. Exists for the formats
     * whose mat-vec reads F32 activations (Q5_K, Q8_0 today): a
     * device-resident forward hands them `xDev`, and the staging
     * buffer their kernels read (`Linear.stX`) is a different device
     * allocation. llama.cpp never needs this — its decode quantizes
     * activations ON DEVICE (`quantize_q8_1`) for every format and
     * dots integers; that is where our units C/D land, and this copy
     * is the minimal correct seam until they do.
     */
    @Kernel
    public static void f32CopyKernel(KernelBuffer<float32> dst,
            KernelBuffer<float32> src, uint32 n) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < n) {
            dst[(int64) gi] = src[(int64) gi];
        }
    }

    public static void f32CopyLaunchNoSync(KernelBuffer<float32> dst,
            KernelBuffer<float32> src, int64 n) {
        KernelStream s = QuantKernel.stream();
        f32CopyKernel.launch(s, grid: [((uint32) n + 255) / 256],
            block: [256])(dst, src, (uint32) n);
        return;
    }

    /** {@link #q8kPackKernel} over `n` activations already on the device. */
    public static void q8kPackLaunchNoSync(KernelBuffer<int8> out,
            KernelBuffer<float32> x, int64 n) {
        uint32 nb = (uint32) (n / 256L);
        KernelStream s = QuantKernel.stream();
        // One workgroup of 32 lanes per block — the geometry the kernel
        // assumes, not a tunable.
        q8kPackKernel.launch(s, grid: [nb], block: [32])(out, x, nb);
        return;
    }

    public static void q8kPackLaunch(KernelBuffer<int8> out,
            KernelBuffer<float32> x, int64 n) {
        QuantKernel.q8kPackLaunchNoSync(out, x, n);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    /** {@link #q8kPackKernel} over HOST arrays — the shape a test can call
     *  to compare against {@link Quant#q8kPack}. */
    public static void q8kPackIntoDevice(float32[] x, int64 n, int8[] out) {
        KernelBuffer<float32> xb #= heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<int8> ob #= heap KernelBuffer<int8>(
            (uint64) Quant.q8kPackedBytes(n));
        xb.upload(x);
        QuantKernel.q8kPackLaunch(ob, xb, n);
        ob.download(out);
        return;
    }

    /**
     * `q4kMatVecKernel` over an INTERLEAVED weight (Quant.interleaveRows16).
     *
     * Byte for byte the same body — same loads, same widths, same order of
     * products and sums. The single difference is where a 16-byte chunk
     * lives: `chunkAt` maps a row-relative offset through the interleave so
     * the 64 lanes of a block read one contiguous run instead of 64 runs
     * 2304 bytes apart.
     *
     * Because the arithmetic is untouched, this is required to be
     * BIT-IDENTICAL to `q4kMatVecKernel` on the same weight, and that is
     * the test rather than a tolerance. A layout change that also changed
     * the numbers would mean the mapping is wrong, not that the numbers
     * moved.
     */
    @Kernel
    public static void q4kMatVecKernelIL(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff,
            int64 grp) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 144L;
            // `grp` arrives as a PARAMETER rather than reading
            // ROWS_PER_BLOCK here: a kernel cannot read a static field
            // ("unsupported construct — field access"), and a duplicated
            // literal would be a second place for the interleave stride to
            // disagree with the launch block size it must equal.
            int64 gidx = i / grp;
            // Base of THIS lane's 16-byte chunk zero. Adding `(off/16)*16*grp`
            // walks to chunk `off/16` without leaving the lane's column.
            int64 rowBase = gidx * grp * rowBytes + (i - gidx * grp) * 16L;
            int64 stride = 16L * grp;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                // CHUNK INDICES IN CLOSED FORM — no division anywhere.
                //
                // The obvious spelling is `(byteOffset / 16) * stride`, and
                // it is a trap: `byteOffset` is int64, so that is a SIGNED
                // divide, which LLVM cannot reduce to a shift without
                // proving non-negativity and instead emits the
                // round-toward-zero correction on every load. In a kernel
                // measured at 63% of its own read roofline — i.e. ALU-bound
                // — 272 of those per row is not a rounding error, and the
                // first interleaved measurement was really measuring them.
                //
                // A block is 144 bytes = 9 chunks, so chunk indices are
                // exact small integers: header at 9b, and sub-block `sb`'s
                // two halves at 9b+1+2*(sb/2) and 9b+2+2*(sb/2).
                int64 cb = b * 9L;

                Vector<int8,16> hv = packed.vload<16>(rowBase + cb * stride);
                float32 d = GgufFile.halfBitsToF32(((int32) hv[0] & 255)
                    | (((int32) hv[1] & 255) << 8));
                float32 dmin = GgufFile.halfBitsToF32(((int32) hv[2] & 255)
                    | (((int32) hv[3] & 255) << 8));
                int32 d0 = (int32) hv[4] & 255;
                int32 d1 = (int32) hv[5] & 255;
                int32 d2 = (int32) hv[6] & 255;
                int32 d3 = (int32) hv[7] & 255;
                int32 m0 = (int32) hv[8] & 255;
                int32 m1 = (int32) hv[9] & 255;
                int32 m2 = (int32) hv[10] & 255;
                int32 m3 = (int32) hv[11] & 255;
                int32 k0 = (int32) hv[12] & 255;
                int32 k1 = (int32) hv[13] & 255;
                int32 k2 = (int32) hv[14] & 255;
                int32 k3 = (int32) hv[15] & 255;

                int64 xb = xOff + b * 256L;
                Vector<float32,8> tv = x.vload<8>(xb) * 0.0f;
                Vector<float32,8> uv = tv;
                tv[0] = d * (float32) (d0 & 63);
                tv[1] = d * (float32) (d1 & 63);
                tv[2] = d * (float32) (d2 & 63);
                tv[3] = d * (float32) (d3 & 63);
                tv[4] = d * (float32) ((k0 & 15) | ((d0 >> 2) & 48));
                tv[5] = d * (float32) ((k1 & 15) | ((d1 >> 2) & 48));
                tv[6] = d * (float32) ((k2 & 15) | ((d2 >> 2) & 48));
                tv[7] = d * (float32) ((k3 & 15) | ((d3 >> 2) & 48));
                uv[0] = dmin * (float32) (m0 & 63);
                uv[1] = dmin * (float32) (m1 & 63);
                uv[2] = dmin * (float32) (m2 & 63);
                uv[3] = dmin * (float32) (m3 & 63);
                uv[4] = dmin * (float32) ((k0 >> 4) | ((m0 >> 2) & 48));
                uv[5] = dmin * (float32) ((k1 >> 4) | ((m1 >> 2) & 48));
                uv[6] = dmin * (float32) ((k2 >> 4) | ((m2 >> 2) & 48));
                uv[7] = dmin * (float32) ((k3 >> 4) | ((m3 >> 2) & 48));

                int32 sb = 0;
                while (sb < 8) {
                    int64 ck = cb + 1L + 2L * (int64) (sb / 2);
                    Vector<int8,16> c0 = packed.vload<16>(
                        rowBase + ck * stride);
                    Vector<int8,16> c1 = packed.vload<16>(
                        rowBase + (ck + 1L) * stride);
                    Vector<int8,16> q0 = c0 & 15;
                    Vector<int8,16> q1 = c1 & 15;
                    if ((sb - (sb / 2) * 2) == 1) {
                        q0 = (c0 >> 4) & 15;
                        q1 = (c1 >> 4) & 15;
                    }
                    int64 xo = xb + (int64) (sb * 32);
                    Vector<int16,8> a0 = q0.widenLo();
                    Vector<int16,8> a1 = q0.widenHi();
                    Vector<int16,8> a2 = q1.widenLo();
                    Vector<int16,8> a3 = q1.widenHi();
                    Vector<float32,4> x0 = x.vload<4>(xo);
                    Vector<float32,4> x1 = x.vload<4>(xo + 4L);
                    Vector<float32,4> x2 = x.vload<4>(xo + 8L);
                    Vector<float32,4> x3 = x.vload<4>(xo + 12L);
                    Vector<float32,4> x4 = x.vload<4>(xo + 16L);
                    Vector<float32,4> x5 = x.vload<4>(xo + 20L);
                    Vector<float32,4> x6 = x.vload<4>(xo + 24L);
                    Vector<float32,4> x7 = x.vload<4>(xo + 28L);
                    Vector<float32,4> p = a0.widenLo().toF32() * x0;
                    p = p + a0.widenHi().toF32() * x1;
                    p = p + a1.widenLo().toF32() * x2;
                    p = p + a1.widenHi().toF32() * x3;
                    p = p + a2.widenLo().toF32() * x4;
                    p = p + a2.widenHi().toF32() * x5;
                    p = p + a3.widenLo().toF32() * x6;
                    p = p + a3.widenHi().toF32() * x7;
                    Vector<float32,4> sv = x0 + x1 + x2 + x3;
                    sv = sv + x4 + x5 + x6 + x7;
                    float32 qx = p[0] + p[1] + p[2] + p[3];
                    float32 sx = sv[0] + sv[1] + sv[2] + sv[3];
                    acc = acc + tv[sb] * qx - uv[sb] * sx;
                    sb = sb + 1;
                }
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    /** {@link #q4kMatVecLaunch} over an interleaved weight. */
    public static void q4kILMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        uint32 ur = (uint32) rows;
        uint32 blk = (uint32) QuantKernel.ROWS_PER_BLOCK;
        KernelStream s = QuantKernel.stream();
        q4kMatVecKernelIL.launch(s, grid: [(ur + blk - 1) / blk], block: [blk])
            (y, packed, x, ur, cols / 256L, xOff, yOff,
             (int64) QuantKernel.ROWS_PER_BLOCK);
        s.sync();
        return;
    }

    /**
     * ROOFLINE: read a row and do almost nothing with it.
     *
     * The mat-vecs peak around 109 GB/s on this part while llama.cpp does a
     * whole token at roughly 180, so either our kernel is leaving bandwidth
     * on the table or 109 IS what this access pattern can get. One arm
     * distinguishes them: same grid, same rows, same 16-byte loads, same
     * one-row-per-work-item decomposition — and one XOR per load instead of
     * the decode. XOR because it cannot overflow (cajeta traps on signed
     * overflow) and cannot be folded away: the accumulator depends on every
     * load, so no load can be removed.
     *
     * If this reads ~109 too, the DECOMPOSITION is the ceiling and no
     * amount of tuning the arithmetic will move it. If it reads much more,
     * the ceiling is inside the mat-vec body.
     */
    @Kernel
    public static void rowReadKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, uint32 rows, int64 rowBytes) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 base = (int64) gi * rowBytes;
            Vector<int8,16> acc = packed.vload<16>(base)
                ^ packed.vload<16>(base);
            int64 o = 0;
            while (o < rowBytes) {
                acc = acc ^ packed.vload<16>(base + o);
                o = o + 16L;
            }
            y[(int64) gi] = (float32) acc[0];
        }
    }

    /** {@link #rowReadKernel} at the mat-vecs' grid. */
    public static void rowReadLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, int64 rows, int64 rowBytes) {
        uint32 ur = (uint32) rows;
        uint32 blk = (uint32) QuantKernel.ROWS_PER_BLOCK;
        KernelStream s = QuantKernel.stream();
        rowReadKernel.launch(s, grid: [(ur + blk - 1) / blk], block: [blk])
            (y, packed, ur, rowBytes);
        s.sync();
        return;
    }

    /** {@link #q4kMatVecLaunch} for Q6_K — 210-byte blocks, same grid. */
    public static void q6kMatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        uint32 ur = (uint32) rows;
        uint32 blk = (uint32) QuantKernel.ROWS_PER_BLOCK;
        KernelStream s = QuantKernel.stream();
        q6kMatVecKernel.launch(s, grid: [(ur + blk - 1) / blk], block: [blk])
            (y, packed, x, ur, cols / 256L, xOff, yOff);
        return;
    }

    public static void q6kMatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        QuantKernel.q6kMatVecLaunchNoSync(y, packed, x, rows, cols, xOff, yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    // ── MXFP4 (Unit 32, unit 4) ──────────────────────────────────────────
    //
    // The device twin of Quant.mxfp4MatVecIntoScalar. One work item per
    // output row; each 17-byte block decodes as on the host — an E8M0
    // half-scale, then 32 E2M1 nibbles in 0..31 order (element k reads byte
    // k&15's low nibble for k<16, high nibble for k>=16). Same element and
    // accumulation order as the CPU scalar reference, so BackendParityTest
    // holds within the standard tolerance. The Q8-activation fast path and
    // any SIMD widening are Unit 7 (performance); this is the correct floor.

    /** E2M1 code -> signed value, matching Quant.mxfp4Code / kvalues_mxfp4. */
    @Device
    static int32 mxfp4CodeDev(int32 nib) {
        int32 m = nib & 7;
        int32 mag = 0;
        if (m == 1) { mag = 1; }
        else if (m == 2) { mag = 2; }
        else if (m == 3) { mag = 3; }
        else if (m == 4) { mag = 4; }
        else if (m == 5) { mag = 6; }
        else if (m == 6) { mag = 8; }
        else if (m == 7) { mag = 12; }
        if ((nib & 8) != 0) { return -mag; }
        return mag;
    }

    /** E8M0 exponent byte -> half-scale 2^(e-128), matching Quant.mxfp4Scale. */
    @Device
    static float32 mxfp4ScaleDev(int32 e) {
        int64 bits;
        if (e < 2) {
            bits = 0x00200000L << (int64) e;
        } else {
            bits = (int64) (e - 1) << 23;
        }
        return Cajeta.bitsToF32(bits);
    }

    @Kernel
    public static void mxfp4MatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 17L;
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 17L;
                float32 d = QuantKernel.mxfp4ScaleDev(
                    (int32) packed[ro] & 255);
                int64 xb = xOff + b * 32L;
                int32 k = 0;
                while (k < 32) {
                    int32 byteV =
                        (int32) packed[ro + 1L + (int64) (k & 15)] & 255;
                    int32 nib;
                    if (k < 16) { nib = byteV & 15; }
                    else { nib = (byteV >> 4) & 15; }
                    acc = acc + (float32) QuantKernel.mxfp4CodeDev(nib) * d
                        * x[xb + (int64) k];
                    k = k + 1;
                }
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    /** Launch {@link #mxfp4MatVecKernel} over device-resident buffers. */
    public static void mxfp4MatVecLaunchNoSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        uint32 ur = (uint32) rows;
        uint32 blk = (uint32) QuantKernel.ROWS_PER_BLOCK;
        KernelStream s = QuantKernel.stream();
        mxfp4MatVecKernel.launch(s, grid: [(ur + blk - 1) / blk], block: [blk])
            (y, packed, x, ur, cols / 32L, xOff, yOff);
        return;
    }

    public static void mxfp4MatVecLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        QuantKernel.mxfp4MatVecLaunchNoSync(y, packed, x, rows, cols,
            xOff, yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }


    // ── MXFP4 GPU mat-vec, performance (Unit 32, unit 7) ─────────────────
    //
    // Measured on gfx1151 (RDNA3.5, HIP/ROCr), shape 4096x14336 (31.2 MB of
    // weights, MALL-resident), profiler device time avg/200; llama.cpp's own
    // mxfp4 MUL_MAT on the SAME device/shape is 58.4 us (test-backend-ops).
    //
    // The non-linear E2M1 table {0,1,2,3,4,6,8,12} decodes through a single
    // Vector.lut4 — a 16-entry int8 table lookup that lowers to v_perm_b32 on
    // amdgpu (the byte-permute LUT, ~12 perms for 32 elements) instead of the
    // ~100 us per-element arithmetic remap that was the whole gap to
    // llama.cpp. The signed kvalues (sign folded into indices 8..15) are the
    // table, so lut4 yields the decoded value directly — no widen-domain
    // arithmetic, no select chain. Portable: on backends without a byte
    // permute the lut4 lowers to a spill-and-gather (correct, slower).

    /** The signed MXFP4 kvalues as a 16-entry int8 LUT (index = nibble). */
    @Device
    static Vector<int8,16> mxfp4Kv() {
        return stack Vector<int8,16>(0, 1, 2, 3, 4, 6, 8, 12,
                                     0, -1, -2, -3, -4, -6, -8, -12);
    }

    /**
     * SIMD MXFP4 mat-vec, one work item per row (PORTABLE — correct on the
     * CPU backend and every wave width). Nibbles decode through
     * {@link #mxfp4Kv} + Vector.lut4, then widen to f32 and FMA. Production
     * GPU path; matches the scalar reference within the backend tolerance.
     */
    @Kernel
    public static void mxfp4MatVecKernelFast3(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < rows) {
            int64 i = (int64) gi;
            int64 rowBytes = blocksPerRow * 17L;
            Vector<int8,16> kv = QuantKernel.mxfp4Kv();
            float32 acc = 0.0f;
            int64 b = 0;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 17L;
                float32 d = QuantKernel.mxfp4ScaleDev(
                    (int32) packed[ro] & 255);
                int64 xb = xOff + b * 32L;
                Vector<int8,16> v = packed.vload<16>(ro + 1L);
                Vector<int8,16> dl = (v & 15).lut4(kv);
                Vector<int8,16> dh = ((v >> 4) & 15).lut4(kv);
                Vector<int16,8> l0 = dl.widenLo();
                Vector<int16,8> l1 = dl.widenHi();
                Vector<int16,8> h0 = dh.widenLo();
                Vector<int16,8> h1 = dh.widenHi();
                Vector<float32,4> accv = x.vload<4>(xb) * 0.0f;
                accv = accv + x.vload<4>(xb)       * (l0.widenLo().toF32() * d);
                accv = accv + x.vload<4>(xb + 4L)  * (l0.widenHi().toF32() * d);
                accv = accv + x.vload<4>(xb + 8L)  * (l1.widenLo().toF32() * d);
                accv = accv + x.vload<4>(xb + 12L) * (l1.widenHi().toF32() * d);
                accv = accv + x.vload<4>(xb + 16L) * (h0.widenLo().toF32() * d);
                accv = accv + x.vload<4>(xb + 20L) * (h0.widenHi().toF32() * d);
                accv = accv + x.vload<4>(xb + 24L) * (h1.widenLo().toF32() * d);
                accv = accv + x.vload<4>(xb + 28L) * (h1.widenHi().toF32() * d);
                acc = acc + accv[0] + accv[1] + accv[2] + accv[3];
                b = b + 1;
            }
            y[yOff + i] = acc;
        }
    }

    /** Launch {@link #mxfp4MatVecKernelFast3} (portable production path). */
    public static void mxfp4MatVecFast3Launch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        uint32 ur = (uint32) rows;
        uint32 blk = (uint32) QuantKernel.ROWS_PER_BLOCK;
        KernelStream s = QuantKernel.stream();
        mxfp4MatVecKernelFast3.launch(s,
            grid: [(ur + blk - 1) / blk], block: [blk])
            (y, packed, x, ur, cols / 32L, xOff, yOff);
        return;
    }

    public static void mxfp4MatVecFast3LaunchSync(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        QuantKernel.mxfp4MatVecFast3Launch(y, packed, x, rows, cols,
            xOff, yOff);
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    /**
     * Wave-cooperative MXFP4 mat-vec (Unit 32, unit 7). One WAVE (32 lanes)
     * per output row; lane L strides the row's blocks L, L+32, ... so the
     * wave reads 32 CONSECUTIVE blocks per step (coalesced, MALL floor).
     * Decode is {@link #mxfp4Kv} + Vector.lut4 (v_perm_b32); partials sum
     * with Wave.reduceSumF32.
     *
     * AMDGPU/NVIDIA (wave width 32) ONLY — hard-assumes 32 and is WRONG on
     * the CPU backend. Not wired into {@link #matVecLaunch}: the launch
     * cannot size rows*width because the device cannot report wave width
     * (Unit 12 gap). Kept as the fastest kernel for backend-aware dispatch.
     */
    @Kernel
    public static void mxfp4MatVecKernelCoop(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        uint32 gid = KernelThread.globalIdX();
        uint32 row = gid / 32;
        uint32 lane = gid & 31;
        if (row < rows) {
            int64 i = (int64) row;
            int64 rowBytes = blocksPerRow * 17L;
            Vector<int8,16> kv = QuantKernel.mxfp4Kv();
            float32 acc = 0.0f;
            int64 b = (int64) lane;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 17L;
                float32 d = QuantKernel.mxfp4ScaleDev(
                    (int32) packed[ro] & 255);
                int64 xb = xOff + b * 32L;
                Vector<int8,16> v = packed.vload<16>(ro + 1L);
                Vector<int8,16> dl = (v & 15).lut4(kv);
                Vector<int8,16> dh = ((v >> 4) & 15).lut4(kv);
                Vector<int16,8> l0 = dl.widenLo();
                Vector<int16,8> l1 = dl.widenHi();
                Vector<int16,8> h0 = dh.widenLo();
                Vector<int16,8> h1 = dh.widenHi();
                Vector<float32,4> accv = x.vload<4>(xb) * 0.0f;
                accv = accv + x.vload<4>(xb)       * (l0.widenLo().toF32() * d);
                accv = accv + x.vload<4>(xb + 4L)  * (l0.widenHi().toF32() * d);
                accv = accv + x.vload<4>(xb + 8L)  * (l1.widenLo().toF32() * d);
                accv = accv + x.vload<4>(xb + 12L) * (l1.widenHi().toF32() * d);
                accv = accv + x.vload<4>(xb + 16L) * (h0.widenLo().toF32() * d);
                accv = accv + x.vload<4>(xb + 20L) * (h0.widenHi().toF32() * d);
                accv = accv + x.vload<4>(xb + 24L) * (h1.widenLo().toF32() * d);
                accv = accv + x.vload<4>(xb + 28L) * (h1.widenHi().toF32() * d);
                acc = acc + accv[0] + accv[1] + accv[2] + accv[3];
                b = b + 32L;
            }
            float32 total = Wave.reduceSumF32(acc);
            if (lane == 0) { y[yOff + i] = total; }
        }
    }

    /** Launch {@link #mxfp4MatVecKernelCoop} (wave32/amdgpu only). */
    public static void mxfp4MatVecCoopLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        uint32 threads = (uint32) (rows * 32L);
        uint32 blk = (uint32) 256;
        KernelStream s = QuantKernel.stream();
        mxfp4MatVecKernelCoop.launch(s,
            grid: [(threads + blk - 1) / blk], block: [blk])
            (y, packed, x, (uint32) rows, cols / 32L, xOff, yOff);
        s.sync();
        return;
    }
    // ── MXFP4 Q8 fast path (Unit 32, unit 7 — parity close) ──────────────
    //
    // llama.cpp's vec_dot_mxfp4_q8_1 removes the f32-domain decode entirely:
    // it decodes the nibbles to int8 with the byte-permute LUT and dots them
    // against Q8-quantized ACTIVATIONS in the integer domain (dp4a), scaling
    // the integer sum by d_w*d_x ONCE per 32-block. The lut4 output IS the
    // signed int8 weight, so pairing it with dotSum (chained v_dot4/sdot4)
    // drops the widen->toF32->f32-FMA the f32 coop kernel spent ~15 us on
    // (the 77 vs 58 us residual). Activations quantize once per mat-vec (a
    // tiny one-shot grid), at MXFP4's 32-element block granularity so every
    // weight block has an exact partner scale.

    /**
     * Quantize activations to per-32 Q8_0 — one wave (32 lanes) per 32-block:
     * amax over the wave, scale d = amax/127, quant = round(x/d). Writes int8
     * quants to `xq` (0-based element index over the activation region that
     * begins at `xOff`) and the block scale to `xd` (0-based block index).
     * Runs once per distinct activation — a tiny grid, not a hot kernel.
     */
    @Kernel
    public static void mxfp4QuantActKernel(KernelBuffer<int8> xq,
            KernelBuffer<float32> xd, KernelBuffer<float32> x,
            uint32 blocks, int64 xOff) {
        uint32 lane = KernelThread.globalIdX() & 31;
        uint32 blk = KernelThread.globalIdX() / 32;
        if (blk < blocks) {
            int64 b = (int64) blk;
            float32 v = x[xOff + b * 32L + (int64) lane];
            float32 av = v;
            if (v < 0.0f) { av = 0.0f - v; }
            float32 bmax = Wave.reduceMaxF32(av);
            float32 inv = 0.0f;
            if (bmax > 0.0f) { inv = 127.0f / bmax; }
            int32 qi = (int32) Math.round(v * inv);
            xq[b * 32L + (int64) lane] = (int8) qi;
            if (lane == 0) { xd[b] = bmax / 127.0f; }
        }
    }

    /** Launch {@link #mxfp4QuantActKernel} over `cols` activations at `xOff`. */
    public static void mxfp4QuantActLaunch(KernelBuffer<int8> xq,
            KernelBuffer<float32> xd, KernelBuffer<float32> x,
            int64 cols, int64 xOff) {
        uint32 nb = (uint32) (cols / 32L);
        uint32 threads = nb * 32;
        uint32 blk = (uint32) 256;
        KernelStream s = QuantKernel.stream();
        mxfp4QuantActKernel.launch(s,
            grid: [(threads + blk - 1) / blk], block: [blk])
            (xq, xd, x, nb, xOff);
        return;
    }

    /**
     * Wave-cooperative MXFP4 mat-vec over Q8-quantized activations (the
     * llama.cpp mxfp4xq8 dot). Identical wave/row/block striding to
     * {@link #mxfp4MatVecKernelCoop}, but the block dot is INTEGER: lut4
     * decodes the nibbles to signed int8 and dotSum (sdot4/v_dot4) dots them
     * against the block's Q8 activation bytes, scaled by d_w*d_x once. No
     * widen/convert/f32-FMA in the loop. `xq`/`xd` are 0-based over the
     * activation region (produced by {@link #mxfp4QuantActKernel}).
     *
     * AMDGPU/NVIDIA (wave width 32) ONLY — same Unit 12 launch-sizing gap as
     * the f32 coop kernel; backend-aware dispatch, not the portable path.
     */
    @Kernel
    public static void mxfp4MatVecKernelCoopQ8(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xq,
            KernelBuffer<float32> xd,
            uint32 rows, int64 blocksPerRow, int64 yOff) {
        uint32 gid = KernelThread.globalIdX();
        uint32 row = gid / 32;
        uint32 lane = gid & 31;
        if (row < rows) {
            int64 i = (int64) row;
            int64 rowBytes = blocksPerRow * 17L;
            Vector<int8,16> kv = QuantKernel.mxfp4Kv();
            float32 acc = 0.0f;
            int64 b = (int64) lane;
            while (b < blocksPerRow) {
                int64 ro = i * rowBytes + b * 17L;
                float32 dw = QuantKernel.mxfp4ScaleDev(
                    (int32) packed[ro] & 255);
                float32 dx = xd[b];
                Vector<int8,16> v = packed.vload<16>(ro + 1L);
                Vector<int8,16> dl = (v & 15).lut4(kv);
                Vector<int8,16> dh = ((v >> 4) & 15).lut4(kv);
                int64 xb = b * 32L;
                Vector<int8,16> aLo = xq.vload<16>(xb);
                Vector<int8,16> aHi = xq.vload<16>(xb + 16L);
                int32 s = 0;
                s = dl.dotSum(aLo, s);
                s = dh.dotSum(aHi, s);
                acc = acc + (float32) s * dw * dx;
                b = b + 32L;
            }
            float32 total = Wave.reduceSumF32(acc);
            if (lane == 0) { y[yOff + i] = total; }
        }
    }

    /**
     * Launch the MXFP4 Q8 coop path: quantize activations once, then the
     * integer coop mat-vec. `xq`/`xd` are caller-owned scratch sized to
     * `cols` bytes and `cols/32` floats.
     */
    public static void mxfp4MatVecCoopQ8Launch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            KernelBuffer<int8> xq, KernelBuffer<float32> xd,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        QuantKernel.mxfp4QuantActLaunch(xq, xd, x, cols, xOff);
        uint32 threads = (uint32) (rows * 32L);
        uint32 blk = (uint32) 256;
        KernelStream s = QuantKernel.stream();
        mxfp4MatVecKernelCoopQ8.launch(s,
            grid: [(threads + blk - 1) / blk], block: [blk])
            (y, packed, xq, xd, (uint32) rows, cols / 32L, yOff);
        s.sync();
        return;
    }

    /**
     * {@link #mxfp4MatVecCoopQ8Launch} over HOST arrays — allocates the
     * weight/activation buffers and the Q8 scratch, uploads, launches,
     * downloads. The shape a test (or a non-resident caller) invokes.
     * AMDGPU/NVIDIA (wave32) only, like the kernel it wraps.
     */
    public static void mxfp4MatVecCoopQ8IntoDevice(int8[] packed, int64 rows,
            int64 cols, float32[] x, int64 xOff, float32[] y, int64 yOff) {
        KernelBuffer<int8> pb #= heap KernelBuffer<int8>(
            (uint64) packed.count());
        KernelBuffer<float32> xb #= heap KernelBuffer<float32>(
            (uint64) x.count());
        KernelBuffer<float32> yb #= heap KernelBuffer<float32>(
            (uint64) y.count());
        KernelBuffer<int8> xq #= heap KernelBuffer<int8>((uint64) cols);
        KernelBuffer<float32> xd #= heap KernelBuffer<float32>(
            (uint64) (cols / 32L));
        pb.upload(packed);
        xb.upload(x);
        yb.upload(y);
        QuantKernel.mxfp4MatVecCoopQ8Launch(yb, pb, xb, xq, xd,
            rows, cols, xOff, yOff);
        yb.download(y);
        return;
    }

    /**
     * The Q8 coop MXFP4 mat-vec RE-EXPRESSED on the cajeta.xpu cooperative-tile
     * surface (xpu-cooperative-tile spec §8.1, Phase A Unit 4 — witness A).
     * Byte-for-byte the same algorithm as {@link #mxfp4MatVecKernelCoopQ8}, but
     * it names NO wave-width literal, NO dotSum, and NO Wave.reduce:
     *   - the row is globalId / Group.width() (32 folds per target, no `& 31`);
     *   - Group.stripe(blocks) is the lane-strided block loop (the `b += 32`);
     *   - Group.mac(s, dl, aLo) is the dp4a dot (the compiler picks v_dot4);
     *   - Group.reduce(GroupOp.Add, acc) is the wave reduce;
     *   - Group.laneId() == 0 commits the row.
     * Same launch geometry as the hand kernel (block 256 = 8 waves), so it is
     * per-wave-identical; the surface ops fold to the same ISA. wave32 backends.
     */
    @Kernel
    public static void mxfp4MatVecKernelCoopQ8Surface(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<int8> xq,
            KernelBuffer<float32> xd,
            uint32 rows, int64 blocksPerRow, int64 yOff) {
        uint32 row = KernelThread.globalIdX() / (uint32) Group.width();
        if (row < rows) {
            int64 i = (int64) row;
            int64 rowBytes = blocksPerRow * 17L;
            Vector<int8,16> kv = QuantKernel.mxfp4Kv();
            float32 acc = 0.0f;
            for (int32 bb : Group.stripe((int32) blocksPerRow)) {
                int64 b = (int64) bb;
                int64 ro = i * rowBytes + b * 17L;
                float32 dw = QuantKernel.mxfp4ScaleDev(
                    (int32) packed[ro] & 255);
                float32 dx = xd[b];
                Vector<int8,16> v = packed.vload<16>(ro + 1L);
                Vector<int8,16> dl = (v & 15).lut4(kv);
                Vector<int8,16> dh = ((v >> 4) & 15).lut4(kv);
                int64 xb = b * 32L;
                Vector<int8,16> aLo = xq.vload<16>(xb);
                Vector<int8,16> aHi = xq.vload<16>(xb + 16L);
                int32 s = 0;
                s = Group.mac(s, dl, aLo);
                s = Group.mac(s, dh, aHi);
                acc = acc + (float32) s * dw * dx;
            }
            float32 total = Group.reduce(GroupOp.Add, acc);
            if (Group.laneId() == 0) { y[yOff + i] = total; }
        }
    }

    /** {@link #mxfp4MatVecCoopQ8Launch} for the surface kernel — identical
     *  geometry, so a like-for-like comparison against the hand kernel. */
    public static void mxfp4MatVecCoopQ8SurfaceLaunch(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            KernelBuffer<int8> xq, KernelBuffer<float32> xd,
            int64 rows, int64 cols, int64 xOff, int64 yOff) {
        QuantKernel.mxfp4QuantActLaunch(xq, xd, x, cols, xOff);
        uint32 threads = (uint32) (rows * 32L);
        uint32 blk = (uint32) 256;
        KernelStream s = QuantKernel.stream();
        mxfp4MatVecKernelCoopQ8Surface.launch(s,
            grid: [(threads + blk - 1) / blk], block: [blk])
            (y, packed, xq, xd, (uint32) rows, cols / 32L, yOff);
        s.sync();
        return;
    }

    /** {@link #mxfp4MatVecCoopQ8IntoDevice} for the surface kernel. */
    public static void mxfp4MatVecCoopQ8SurfaceIntoDevice(int8[] packed,
            int64 rows, int64 cols, float32[] x, int64 xOff, float32[] y,
            int64 yOff) {
        KernelBuffer<int8> pb #= heap KernelBuffer<int8>(
            (uint64) packed.count());
        KernelBuffer<float32> xb #= heap KernelBuffer<float32>(
            (uint64) x.count());
        KernelBuffer<float32> yb #= heap KernelBuffer<float32>(
            (uint64) y.count());
        KernelBuffer<int8> xq #= heap KernelBuffer<int8>((uint64) cols);
        KernelBuffer<float32> xd #= heap KernelBuffer<float32>(
            (uint64) (cols / 32L));
        pb.upload(packed);
        xb.upload(x);
        yb.upload(y);
        QuantKernel.mxfp4MatVecCoopQ8SurfaceLaunch(yb, pb, xb, xq, xd,
            rows, cols, xOff, yOff);
        yb.download(y);
        return;
    }

