package dev.cajeta.llm.model;

import cajeta.lang.Math;
import cajeta.lang.String;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.llm.LlmException;
import dev.cajeta.llm.io.Checkpoint;

/**
 * The GQA attention projections and per-layer attention configuration for
 * one decoder layer (spec §5 preamble: window, RoPE base/scaling and
 * kv-head count are LAYER state; the model config supplies defaults that
 * layers inherit). Parameter field names are the torch key segments, so
 * the reflective walk yields HF keys verbatim — including Gemma's
 * `qNorm`/`kNorm` when QK-norm is declared (spec 5.10).
 */
public final class Attention extends InfModule {
    Linear qProj;
    Linear kProj;
    Linear vProj;
    Linear oProj;
    RMSNorm qNorm;   // null unless the config declares QK-norm
    RMSNorm kNorm;
    int32 nHeads;
    int32 nKvHeads;
    int32 headDim;
    /** Attention window in tokens; 0 = infinite (spec 5.9). */
    int32 window;
    /** Query scale — declared, or the default `1/sqrt(head_dim)` (5.13). */
    float32 scale;
    /** Per-dim RoPE inverse frequencies with the layer's theta base and
     *  declared scaling baked in (5.2, 5.3). A plain array, deliberately
     *  not a Tensor: InfModule's walk must not see it as a parameter. */
    float32[] ropeInv;
    /** Its device twin (10.12.7.c), uploaded on first use the way
     *  {@link RMSNorm#deviceWeight} is. */
    KernelBuffer<float32> ropeInvDev;

    KernelBuffer<float32> deviceRopeInv() {
        if (this.ropeInvDev == null) {
            this.ropeInvDev #= heap KernelBuffer<float32>(
                (uint64) this.ropeInv.count());
            this.ropeInvDev.upload(this.ropeInv);
        }
        return this.ropeInvDev;
    }

    Attention(ModelConfig cfg, int32 layerIdx) {
        int32 hidden = cfg.hiddenSize;
        int32 qd = cfg.qDim();
        int32 kvd = cfg.kvDim();
        this.qProj = heap Linear(hidden, qd);
        this.kProj = heap Linear(hidden, kvd);
        this.vProj = heap Linear(hidden, kvd);
        this.oProj = heap Linear(qd, hidden);
        if (cfg.qkNorm) {
            this.qNorm = heap RMSNorm(cfg.headDim, cfg.rmsNormEps);
            this.kNorm = heap RMSNorm(cfg.headDim, cfg.rmsNormEps);
        } else {
            this.qNorm = null;
            this.kNorm = null;
        }
        this.nHeads = cfg.numHeads;
        this.nKvHeads = cfg.numKvHeads;
        this.headDim = cfg.headDim;
        this.window = cfg.windowForLayer(layerIdx);
        if (cfg.queryScale != 0.0f) {
            this.scale = cfg.queryScale;
        } else {
            this.scale = 1.0f / Math.sqrt((float32) cfg.headDim);
        }
        this.ropeInv #= Prim.invFreq(cfg.headDim, cfg.ropeTheta,
            cfg.ropeScalingType, cfg.ropeScalingFactor, cfg.ropeLowFreq,
            cfg.ropeHighFreq, cfg.ropeOrigMaxPos);
        // Precomputed per-dimension factors (GGUF `rope_freqs.weight`)
        // apply on top, exactly as llama.cpp's freq_factors do:
        // theta_d /= factor_d. A model that ships them carries NO
        // rope.scaling.* keys, so this is the only signal there is.
        if (cfg.ropeFreqs != null) {
            int32 half = cfg.headDim / 2;
            if ((int32) cfg.ropeFreqs.count() != half) {
                throw heap LlmException("rope_freqs has "
                    + (int32) cfg.ropeFreqs.count() + " entries; expected "
                    + half + " (headDim/2)");
            }
            int32 rd = 0;
            while (rd < half) {
                float32 fv = cfg.ropeFreqs[rd];
                if (fv != 0.0f) {
                    this.ropeInv[rd] = this.ropeInv[rd] / fv;
                }
                rd = rd + 1;
            }
        }
    }

    void bind(Checkpoint ckpt, String prefix, boolean toDevice) {
        this.qProj.bind(ckpt, prefix + "q_proj.weight", toDevice);
        this.kProj.bind(ckpt, prefix + "k_proj.weight", toDevice);
        this.vProj.bind(ckpt, prefix + "v_proj.weight", toDevice);
        this.oProj.bind(ckpt, prefix + "o_proj.weight", toDevice);
        // Qwen2 biases q/k/v (and never o); Llama biases nothing. Absent
        // is not an error — bindBias returns on a missing tensor.
        this.qProj.bindBias(ckpt, prefix + "q_proj.bias", toDevice);
        this.kProj.bindBias(ckpt, prefix + "k_proj.bias", toDevice);
        this.vProj.bindBias(ckpt, prefix + "v_proj.bias", toDevice);
        if (this.qNorm != null) {
            this.qNorm.bind(ckpt, prefix + "q_norm.weight", toDevice);
            this.kNorm.bind(ckpt, prefix + "k_norm.weight", toDevice);
        }
    }
}
