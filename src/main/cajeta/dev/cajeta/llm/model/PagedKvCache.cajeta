package dev.cajeta.llm.model;

import cajeta.lang.Cajeta;
import cajeta.lang.Math;
import cajeta.math.Tensor;
import dev.cajeta.llm.LlmException;

/**
 * The paged KV cache (plan Unit 8; spec 6.1–6.18, 13.13).
 *
 * Unwindowed layers draw fixed-size blocks — `blockTokens` positions of
 * K AND V (spec 6.3) — from ONE pool shared by every sequence, indexed
 * by per-sequence per-layer block tables. Windowed layers keep a
 * per-sequence ring of `min(maxSeq, window)` entries instead: they never
 * exhaust, they evict by wrapping (6.8), and RoPE'd rows arrive here
 * already rotated by ABSOLUTE position — the ring slot is a storage
 * detail (6.10).
 *
 * Blocks are shared by refcount: forking a prefix bumps counts (6.14),
 * a write into a shared block copies it first (6.15 — the silent
 * defining bug of block sharing), and a block returns to the free list
 * only when its last reference releases. Pool exhaustion SURFACES
 * (append returns false) rather than failing the call — admission and
 * preemption are the scheduler's decisions (6.4, Unit 9); exceeding an
 * unwindowed layer's configured maximum context is the caller's error
 * and throws.
 *
 * Everything is preallocated at construction: appends, copy-on-write,
 * forks and releases perform ZERO heap allocations, so the decode path's
 * 6.1.6 invariant extends through the cache.
 */
public final class PagedKvCache {
    Tensor<float32> pool;    // [numBlocks · 2 · blockTokens · kvDim] flat
    int32[] freeList;
    int32 freeCount;
    int32[] refCount;        // per block
    int32 numBlocks;
    int32 blockTokens;
    int32 kvDim;
    int32 layers;
    int32 maxSeqs;
    int32 maxSeqCap;         // configured max context (unwindowed layers)
    int32[] layerWindow;     // per layer; 0 = unwindowed
    int32 blocksPerSeq;      // table stride: ceil(maxSeqCap / blockTokens)
    int32[] tables;          // [maxSeqs · layers · blocksPerSeq]
    int32[] lenSL;           // appended length per (seq, layer)
    Tensor<float32>[] ringK; // [maxSeqs · layers], null when unwindowed
    Tensor<float32>[] ringV;

    public PagedKvCache(ModelConfig cfg, int32 maxSeqCap, int32 maxSeqs,
            int32 numBlocks) {
        this.blockTokens = cfg.blockTokens;
        this.kvDim = cfg.kvDim();
        this.layers = cfg.numLayers;
        this.maxSeqs = maxSeqs;
        this.maxSeqCap = maxSeqCap;
        this.numBlocks = numBlocks;
        int64[] ps = heap int64[1];
        ps[0] = (int64) numBlocks * 2 * (int64) this.blockTokens
            * (int64) this.kvDim;
        this.pool #= Tensor.zeros<float32>(ps);
        this.freeList = heap int32[numBlocks];
        int32 b = 0;
        while (b < numBlocks) {
            this.freeList[b] = numBlocks - 1 - b;
            b = b + 1;
        }
        this.freeCount = numBlocks;
        this.refCount = heap int32[numBlocks];
        this.blocksPerSeq = (maxSeqCap + this.blockTokens - 1)
            / this.blockTokens;
        this.tables = heap int32[maxSeqs * cfg.numLayers * this.blocksPerSeq];
        this.lenSL = heap int32[maxSeqs * cfg.numLayers];
        this.layerWindow = heap int32[cfg.numLayers];
        this.ringK = heap Tensor<float32>[maxSeqs * cfg.numLayers];
        this.ringV = heap Tensor<float32>[maxSeqs * cfg.numLayers];
        int32 l = 0;
        while (l < cfg.numLayers) {
            int32 w = cfg.windowForLayer(l);
            this.layerWindow[l] = w;
            if (w > 0) {
                int32 rows = Math.min<int32>(maxSeqCap, w);
                int64[] rs = heap int64[1];
                rs[0] = (int64) rows * (int64) this.kvDim;
                int32 s = 0;
                while (s < maxSeqs) {
                    this.ringK[s * cfg.numLayers + l] #=
                        Tensor.zeros<float32>(rs);
                    this.ringV[s * cfg.numLayers + l] #=
                        Tensor.zeros<float32>(rs);
                    s = s + 1;
                }
            }
            l = l + 1;
        }
    }

    // ── observability (spec 6.25 precursor; 8.3.2) ──────────────────────

    public int32 freeBlocks() {
        return this.freeCount;
    }

    public int32 usedBlocks() {
        return this.numBlocks - this.freeCount;
    }

    /** Ring rows allocated for a windowed layer (0 for unwindowed). */
    public int32 ringRows(int32 layer) {
        if (this.layerWindow[layer] == 0) {
            return 0;
        }
        return Math.min<int32>(this.maxSeqCap, this.layerWindow[layer]);
    }

    public int32 lengthOf(int32 seq, int32 layer) {
        return this.lenSL[seq * this.layers + layer];
    }

    /** Unwindowed layers — each holds full-context blocks. */
    public int32 fullLayers() {
        int32 n = 0;
        int32 l = 0;
        while (l < this.layers) {
            if (this.layerWindow[l] == 0) {
                n = n + 1;
            }
            l = l + 1;
        }
        return n;
    }

    /** Pool blocks `n` more tokens on `seq` would draw — the scheduler's
     *  admission/headroom arithmetic (spec 6.19). */
    public int32 blocksNeededFor(int32 seq, int32 n) {
        int32 total = 0;
        int32 l = 0;
        while (l < this.layers) {
            if (this.layerWindow[l] == 0) {
                int32 len = this.lenSL[seq * this.layers + l];
                int32 now = (len + this.blockTokens - 1) / this.blockTokens;
                int32 then = (len + n + this.blockTokens - 1)
                    / this.blockTokens;
                total = total + (then - now);
            }
            l = l + 1;
        }
        return total;
    }

    // ── append (6.1, 6.2, 6.8, 6.15) ────────────────────────────────────

    /**
     * Append the (already-RoPE'd) K/V row for absolute position `p` of
     * `seq` at `layer`. Returns false when a pool block is needed and
     * none is free — the scheduler's signal (6.4) — leaving the cache
     * unchanged. Windowed layers never fail: they overwrite `p − w` by
     * construction. A write landing in a SHARED block copies it first
     * (6.15).
     */
    public boolean appendRow(int32 seq, int32 layer, Tensor<float32> k,
            int64 kOff, Tensor<float32> v, int64 vOff, int32 p) {
        // Measurement instrument (Prim.skipMask bit 16).
        if ((Prim.skipMask & 16) != 0) { return true; }
        int32 sl = seq * this.layers + layer;
        if (p != this.lenSL[sl]) {
            // Name the SLOT and layer, not just the numbers: this fires
            // when a scheduler hands a slot to a second sequence without
            // the cache having been released, and "position 0 is not the
            // next position (128)" alone cannot distinguish that from a
            // position-arithmetic slip in one sequence.
            throw heap LlmException("kv append: seq " + seq + " layer "
                + layer + " (slot " + sl + "): position " + p
                + " is not the next position (" + this.lenSL[sl]
                + "); a slot reused without release, or a chunk offset "
                + "that did not advance");
        }
        int32 w = this.layerWindow[layer];
        if (w > 0) {
            int32 rows = Math.min<int32>(this.maxSeqCap, w);
            Tensor<float32> rk = this.ringK[sl];
            Tensor<float32> rv = this.ringV[sl];
            int64 base = (int64) (p % rows) * (int64) this.kvDim;
            // Raw buffers — 2 x kvDim accessor calls per layer per token.
            float32[] rkb = rk.hostBuffer();
            int64 rkbase = rk.hostBase() + base;
            float32[] rvb = rv.hostBuffer();
            int64 rvbase = rv.hostBase() + base;
            float32[] kb0 = k.hostBuffer();
            int64 ko0 = k.hostBase() + kOff;
            float32[] vb0 = v.hostBuffer();
            int64 vo0 = v.hostBase() + vOff;
            int64 j = 0;
            while (j < (int64) this.kvDim) {
                rkb[rkbase + j] = kb0[ko0 + j];
                rvb[rvbase + j] = vb0[vo0 + j];
                j = j + 1;
            }
            this.lenSL[sl] = p + 1;
            return true;
        }
        if (p >= this.maxSeqCap) {
            // Explicit context-limit error, distinct from exhaustion (6.4).
            throw heap LlmException("kv append: position " + p
                + " exceeds the configured maximum context "
                + this.maxSeqCap);
        }
        int32 ti = p / this.blockTokens;
        int32 tBase = sl * this.blocksPerSeq;
        int32 blk = 0;
        if (p % this.blockTokens == 0) {
            // Block boundary: take from the pool (6.2's only draw point).
            if (this.freeCount == 0) {
                return false;
            }
            this.freeCount = this.freeCount - 1;
            blk = this.freeList[this.freeCount];
            this.refCount[blk] = 1;
            this.tables[tBase + ti] = blk;
        } else {
            blk = this.tables[tBase + ti];
            if (this.refCount[blk] > 1) {
                // Copy-on-write (6.15): never mutate shared history.
                if (this.freeCount == 0) {
                    return false;
                }
                this.freeCount = this.freeCount - 1;
                int32 fresh = this.freeList[this.freeCount];
                this.refCount[fresh] = 1;
                int64 srcB = (int64) blk * 2 * (int64) this.blockTokens
                    * (int64) this.kvDim;
                int64 dstB = (int64) fresh * 2 * (int64) this.blockTokens
                    * (int64) this.kvDim;
                int64 n = 2 * (int64) this.blockTokens * (int64) this.kvDim;
                float32[] pb0 = this.pool.hostBuffer();
                int64 pbase0 = this.pool.hostBase();
                int64 j = 0;
                while (j < n) {
                    pb0[pbase0 + dstB + j] = pb0[pbase0 + srcB + j];
                    j = j + 1;
                }
                this.refCount[blk] = this.refCount[blk] - 1;
                this.tables[tBase + ti] = fresh;
                blk = fresh;
            }
        }
        int32 slot = p % this.blockTokens;
        int64 kBase = ((int64) blk * 2 * (int64) this.blockTokens
            + (int64) slot) * (int64) this.kvDim;
        int64 vBase = ((int64) blk * 2 * (int64) this.blockTokens
            + (int64) this.blockTokens + (int64) slot) * (int64) this.kvDim;
        float32[] pb = this.pool.hostBuffer();
        int64 pbase = this.pool.hostBase();
        float32[] kb1 = k.hostBuffer();
        int64 ko1 = k.hostBase() + kOff;
        float32[] vb1 = v.hostBuffer();
        int64 vo1 = v.hostBase() + vOff;
        int64 j = 0;
        while (j < (int64) this.kvDim) {
            pb[pbase + kBase + j] = kb1[ko1 + j];
            pb[pbase + vBase + j] = vb1[vo1 + j];
            j = j + 1;
        }
        this.lenSL[sl] = p + 1;
        return true;
    }

    /**
     * Copy positions `[from, to)` of `(seq, layer)` into CONTIGUOUS host
     * planes — `kOut[i·kvDim..]` for position `from + i`, and the same for
     * V (plan 10.11.2).
     *
     * The device K/V planes are flat `[cap x kvDim]`, with no block table
     * and no ring, so seeding them from the paged cache means walking the
     * indirection once here rather than teaching a kernel about it. Reads
     * go through raw buffers and one `rowBase` per position, not `kAt`
     * per element: at 512 positions of an 8B model that is 1M accessor
     * calls a layer, and the accessor is what `attendRow` measured as the
     * cost, not the arithmetic.
     */
    public void copyRowsTo(int32 seq, int32 layer, int32 from, int32 to,
            float32[] kOut, float32[] vOut) {
        int32 sl = seq * this.layers + layer;
        Tensor<float32> srcK = this.srcOf(sl, false);
        Tensor<float32> srcV = this.srcOf(sl, true);
        float32[] kb = srcK.hostBuffer();
        int64 kbase = srcK.hostBase();
        float32[] vb = srcV.hostBuffer();
        int64 vbase = srcV.hostBase();
        int32 t = from;
        while (t < to) {
            int64 dst = (int64) (t - from) * (int64) this.kvDim;
            int64 kr = kbase + this.rowBase(sl, t, false);
            int64 vr = vbase + this.rowBase(sl, t, true);
            int64 j = 0;
            while (j < (int64) this.kvDim) {
                kOut[dst + j] = kb[kr + j];
                vOut[dst + j] = vb[vr + j];
                j = j + 1;
            }
            t = t + 1;
        }
        return;
    }

    /**
     * {@link #appendRow} from RAW host arrays — the shape a writeback from
     * device-resident K/V can call. Same bookkeeping, same failure mode.
     */
    public boolean appendRowRaw(int32 seq, int32 layer, float32[] kb,
            int64 kOff, float32[] vb, int64 vOff, int32 p) {
        int32 sl = seq * this.layers + layer;
        if (p != this.lenSL[sl]) {
            // Name the SLOT and layer, not just the numbers: this fires
            // when a scheduler hands a slot to a second sequence without
            // the cache having been released, and "position 0 is not the
            // next position (128)" alone cannot distinguish that from a
            // position-arithmetic slip in one sequence.
            throw heap LlmException("kv append: seq " + seq + " layer "
                + layer + " (slot " + sl + "): position " + p
                + " is not the next position (" + this.lenSL[sl]
                + "); a slot reused without release, or a chunk offset "
                + "that did not advance");
        }
        int32 w = this.layerWindow[layer];
        if (w > 0) {
            int32 rows = Math.min<int32>(this.maxSeqCap, w);
            Tensor<float32> rk = this.ringK[sl];
            Tensor<float32> rv = this.ringV[sl];
            int64 base = (int64) (p % rows) * (int64) this.kvDim;
            float32[] rkb = rk.hostBuffer();
            int64 rkbase = rk.hostBase() + base;
            float32[] rvb = rv.hostBuffer();
            int64 rvbase = rv.hostBase() + base;
            int64 j = 0;
            while (j < (int64) this.kvDim) {
                rkb[rkbase + j] = kb[kOff + j];
                rvb[rvbase + j] = vb[vOff + j];
                j = j + 1;
            }
            this.lenSL[sl] = p + 1;
            return true;
        }
        if (p >= this.maxSeqCap) {
            throw heap LlmException("kv append: position " + p
                + " exceeds the configured maximum context "
                + this.maxSeqCap);
        }
        int32 ti = p / this.blockTokens;
        int32 tBase = sl * this.blocksPerSeq;
        int32 blk = 0;
        if (p % this.blockTokens == 0) {
            if (this.freeCount == 0) { return false; }
            this.freeCount = this.freeCount - 1;
            blk = this.freeList[this.freeCount];
            this.refCount[blk] = 1;
            this.tables[tBase + ti] = blk;
        } else {
            blk = this.tables[tBase + ti];
            if (this.refCount[blk] > 1) {
                if (this.freeCount == 0) { return false; }
                this.freeCount = this.freeCount - 1;
                int32 fresh = this.freeList[this.freeCount];
                this.refCount[fresh] = 1;
                int64 srcB = (int64) blk * 2 * (int64) this.blockTokens
                    * (int64) this.kvDim;
                int64 dstB = (int64) fresh * 2 * (int64) this.blockTokens
                    * (int64) this.kvDim;
                int64 n = 2 * (int64) this.blockTokens * (int64) this.kvDim;
                float32[] pb0 = this.pool.hostBuffer();
                int64 pbase0 = this.pool.hostBase();
                int64 j = 0;
                while (j < n) {
                    pb0[pbase0 + dstB + j] = pb0[pbase0 + srcB + j];
                    j = j + 1;
                }
                this.refCount[blk] = this.refCount[blk] - 1;
                this.tables[tBase + ti] = fresh;
                blk = fresh;
            }
        }
        int32 slot = p % this.blockTokens;
        int64 kBase = ((int64) blk * 2 * (int64) this.blockTokens
            + (int64) slot) * (int64) this.kvDim;
        int64 vBase = ((int64) blk * 2 * (int64) this.blockTokens
            + (int64) this.blockTokens + (int64) slot) * (int64) this.kvDim;
        float32[] pb = this.pool.hostBuffer();
        int64 pbase = this.pool.hostBase();
        int64 j2 = 0;
        while (j2 < (int64) this.kvDim) {
            pb[pbase + kBase + j2] = kb[kOff + j2];
            pb[pbase + vBase + j2] = vb[vOff + j2];
            j2 = j2 + 1;
        }
        this.lenSL[sl] = p + 1;
        return true;
    }

    // ── element reads (test surface; in-place attention reads below) ────

    /** K element at absolute position `t`; windowed layers serve only the
     *  live range `[len − w, len)`. */
    public float32 kAt(int32 seq, int32 layer, int32 t, int32 d) {
        return this.elemAt(seq, layer, t, d, false);
    }

    public float32 vAt(int32 seq, int32 layer, int32 t, int32 d) {
        return this.elemAt(seq, layer, t, d, true);
    }

    float32 elemAt(int32 seq, int32 layer, int32 t, int32 d, boolean isV) {
        int32 sl = seq * this.layers + layer;
        int32 len = this.lenSL[sl];
        if (t < 0 || t >= len) {
            throw heap LlmException("kv read: position " + t
                + " is outside the appended range [0, " + len + ")");
        }
        int32 w = this.layerWindow[layer];
        if (w > 0) {
            int32 rows = Math.min<int32>(this.maxSeqCap, w);
            if (t < len - rows) {
                throw heap LlmException("kv read: position " + t
                    + " is outside the live window [" + (len - rows)
                    + ", " + len + ")");
            }
            Tensor<float32> r = this.ringV[sl];
            if (!isV) {
                r = this.ringK[sl];
            }
            return r.flatGet((int64) (t % rows) * (int64) this.kvDim
                + (int64) d);
        }
        int32 blk = this.tables[sl * this.blocksPerSeq + t / this.blockTokens];
        int64 half = 0;
        if (isV) {
            half = (int64) this.blockTokens;
        }
        return this.pool.flatGet(((int64) blk * 2 * (int64) this.blockTokens
            + half + (int64) (t % this.blockTokens)) * (int64) this.kvDim
            + (int64) d);
    }

    // ── in-place attention reads (6.13 precursor; 8.2.5) ────────────────

    /**
     * GQA attention for one query row at absolute position `p` of `seq`,
     * reading K/V IN PLACE through the block table (or ring). The layer's
     * window clamps the range in prefill and decode alike; `scores` is
     * the caller's preallocated scratch. Zero allocations.
     */
    public void attendRow(int32 seq, int32 layer, Tensor<float32> q,
            int64 qOff, float32 scale, Tensor<float32> scores,
            Tensor<float32> outv, int64 outOff,
            int32 nHeads, int32 nKv, int32 headDim) {
        // Measurement instrument (Prim.skipMask bit 32).
        if ((Prim.skipMask & 32) != 0) { return; }
        int32 sl = seq * this.layers + layer;
        int32 p = this.lenSL[sl] - 1;
        int32 w = this.layerWindow[layer];
        int32 from = 0;
        if (w > 0 && p + 1 > w) {
            from = p + 1 - w;
        }
        int32 group = nHeads / nKv;
        int32 count = p + 1 - from;
        // `srcOf` depends only on (sl, isV) — hoisted out of every loop.
        // It was called once per (h, t) for K and once per (h, t, d) for V.
        Tensor<float32> srcK = this.srcOf(sl, false);
        Tensor<float32> srcV = this.srcOf(sl, true);
        // RAW BUFFERS, not `flatGet`/`flatSet`. This loop performs ~3.1M
        // multiply-accumulates per token (12 positions x 32 heads x 128 dims
        // x 32 layers, K and V), which is ~6M accessor calls — and the
        // accessor, not the arithmetic, was the cost: it measured 105
        // ms/token, more than all 224 projections together. `MatvecProbe`
        // already carries a "raw arrays, no Tensor/Storage accessors" arm
        // for exactly this reason, and `Linear.matvecInto` already reads
        // `hostBuffer()`/`hostBase()`.
        //
        // Hoisting `srcOf`/`rowBase` out of the inner body was tried FIRST
        // and changed nothing (272.5 vs 263.8 ms) — LLVM was already
        // sinking them. The accessors were what remained.
        float32[] kb = srcK.hostBuffer();
        int64 kbase = srcK.hostBase();
        float32[] vb = srcV.hostBuffer();
        int64 vbase = srcV.hostBase();
        float32[] qb = q.hostBuffer();
        int64 qbase0 = q.hostBase();
        float32[] sb = scores.hostBuffer();
        int64 sbase = scores.hostBase();
        float32[] ob = outv.hostBuffer();
        int64 obase0 = outv.hostBase();
        int32 h = 0;
        while (h < nHeads) {
            int32 kvh = h / group;
            int64 qBase = qOff + (int64) (h * headDim);
            int64 kvHead = (int64) (kvh * headDim);
            int64 t = 0;
            while (t < (int64) count) {
                int32 tp = from + (int32) t;
                float32 s = 0.0f;
                int64 kRow = kbase + this.rowBase(sl, tp, false) + kvHead;
                int64 qr = qbase0 + qBase;
                int64 d = 0;
                while (d < (int64) headDim) {
                    s = s + qb[qr + d] * kb[kRow + d];
                    d = d + 1;
                }
                sb[sbase + t] = s * scale;
                t = t + 1;
            }
            float32 mx = sb[sbase];
            t = 1;
            while (t < (int64) count) {
                float32 sv = sb[sbase + t];
                if (sv > mx) {
                    mx = sv;
                }
                t = t + 1;
            }
            float32 sum = 0.0f;
            t = 0;
            while (t < (int64) count) {
                float32 e = Math.exp(sb[sbase + t] - mx);
                sb[sbase + t] = e;
                sum = sum + e;
                t = t + 1;
            }
            float32 rs = 1.0f / sum;
            // POSITION-OUTER, not dim-outer. The dim-outer form called
            // `srcOf` and `rowBase` from the INNERMOST body, where both are
            // invariant in `d` — 128 x count of them per head, ~1.57M
            // `rowBase` calls per token, each a modulo plus two array reads
            // plus a branch. It measured 105 ms/token, more than all 224
            // projections put together, for twelve positions of context.
            //
            // Bit-identity is preserved and that is why this shape was
            // chosen over a wider rewrite: each output element still
            // accumulates `t = 0..count-1` ASCENDING starting from 0.0f and
            // is scaled by `rs` at the end, exactly as before. Only the
            // traversal order of independent elements changed.
            int64 obase = obase0 + outOff + (int64) (h * headDim);
            int64 d = 0;
            while (d < (int64) headDim) {
                ob[obase + d] = 0.0f;
                d = d + 1;
            }
            t = 0;
            while (t < (int64) count) {
                int32 tp = from + (int32) t;
                int64 vRow = vbase + this.rowBase(sl, tp, true) + kvHead;
                float32 sc = sb[sbase + t];
                d = 0;
                while (d < (int64) headDim) {
                    ob[obase + d] = ob[obase + d] + sc * vb[vRow + d];
                    d = d + 1;
                }
                t = t + 1;
            }
            d = 0;
            while (d < (int64) headDim) {
                ob[obase + d] = ob[obase + d] * rs;
                d = d + 1;
            }
            h = h + 1;
        }
        return;
    }

    /** The tensor holding (seq, layer)'s K or V rows. */
    Tensor<float32> srcOf(int32 sl, boolean isV) {
        int32 layer = sl % this.layers;
        if (this.layerWindow[layer] > 0) {
            if (isV) {
                return this.ringV[sl];
            }
            return this.ringK[sl];
        }
        return this.pool;
    }

    /** Flat base of position `tp`'s K or V row within {@link #srcOf}. */
    int64 rowBase(int32 sl, int32 tp, boolean isV) {
        int32 layer = sl % this.layers;
        int32 w = this.layerWindow[layer];
        if (w > 0) {
            int32 rows = Math.min<int32>(this.maxSeqCap, w);
            return (int64) (tp % rows) * (int64) this.kvDim;
        }
        int32 blk = this.tables[sl * this.blocksPerSeq
            + tp / this.blockTokens];
        int64 half = 0;
        if (isV) {
            half = (int64) this.blockTokens;
        }
        return ((int64) blk * 2 * (int64) this.blockTokens + half
            + (int64) (tp % this.blockTokens)) * (int64) this.kvDim;
    }

    // ── sharing (6.14, 6.15) and lifecycle (6.24 precursor) ─────────────

    /**
     * Make `dst` share `src`'s first `prefixTokens` positions on every
     * layer: pool blocks covering the prefix are SHARED (refcounts bump —
     * a partial tail block shares too, protected by copy-on-write);
     * windowed rings copy their live range (bounded by w). `dst` must be
     * empty.
     */
    public void forkPrefix(int32 srcSeq, int32 dstSeq, int32 prefixTokens) {
        int32 l = 0;
        while (l < this.layers) {
            int32 ssl = srcSeq * this.layers + l;
            int32 dsl = dstSeq * this.layers + l;
            if (this.lenSL[dsl] != 0) {
                throw heap LlmException("kv fork: destination sequence "
                    + dstSeq + " is not empty");
            }
            if (prefixTokens > this.lenSL[ssl]) {
                throw heap LlmException("kv fork: prefix " + prefixTokens
                    + " exceeds source length " + this.lenSL[ssl]);
            }
            int32 w = this.layerWindow[l];
            if (w > 0) {
                int32 rows = Math.min<int32>(this.maxSeqCap, w);
                Tensor<float32> sk = this.ringK[ssl];
                Tensor<float32> sv = this.ringV[ssl];
                Tensor<float32> dk = this.ringK[dsl];
                Tensor<float32> dv = this.ringV[dsl];
                int64 n = (int64) rows * (int64) this.kvDim;
                int64 j = 0;
                while (j < n) {
                    dk.flatSet(j, sk.flatGet(j));
                    dv.flatSet(j, sv.flatGet(j));
                    j = j + 1;
                }
            } else {
                int32 nb = (prefixTokens + this.blockTokens - 1)
                    / this.blockTokens;
                int32 bi = 0;
                while (bi < nb) {
                    int32 blk = this.tables[ssl * this.blocksPerSeq + bi];
                    this.tables[dsl * this.blocksPerSeq + bi] = blk;
                    this.refCount[blk] = this.refCount[blk] + 1;
                    bi = bi + 1;
                }
            }
            this.lenSL[dsl] = prefixTokens;
            l = l + 1;
        }
        return;
    }

    // ── block store seams (Unit 11; spec 6.16, 6.17) ────────────────────

    /** Bytes one block payload occupies: 2·blockTokens·kvDim f32. */
    public int32 blockPayloadBytes() {
        return 2 * this.blockTokens * this.kvDim * 4;
    }

    public int32 blockTokensN() {
        return this.blockTokens;
    }

    /**
     * Serialize FULL block `bi` of (seq, unwindowed layer) into `dst` as
     * little-endian f32 bits — the eviction write (6.16).
     */
    public void exportBlock(int32 seq, int32 layer, int32 bi, int8[] dst) {
        if (this.layerWindow[layer] != 0) {
            throw heap LlmException("kv export: layer " + layer
                + " is windowed; rings are not stored");
        }
        int32 sl = seq * this.layers + layer;
        int32 blk = this.tables[sl * this.blocksPerSeq + bi];
        int64 base = (int64) blk * 2 * (int64) this.blockTokens
            * (int64) this.kvDim;
        int64 n = 2 * (int64) this.blockTokens * (int64) this.kvDim;
        int64 j = 0;
        while (j < n) {
            int32 bits = Cajeta.f32ToBits(this.pool.flatGet(base + j));
            int32 at = (int32) (j * 4);
            dst[at] = (int8) (bits & 255);
            dst[at + 1] = (int8) ((bits >>> 8) & 255);
            dst[at + 2] = (int8) ((bits >>> 16) & 255);
            dst[at + 3] = (int8) ((bits >>> 24) & 255);
            j = j + 1;
        }
        return;
    }

    /**
     * Adopt a stored block as block `bi` of (seq, layer): takes a pool
     * block (false when none is free), installs it in the table, and
     * advances the sequence's length to `(bi+1)·blockTokens`. Imports
     * must be sequential from block 0 on an empty tail (6.17, 6.18).
     */
    public boolean importBlock(int32 seq, int32 layer, int32 bi, int8[] src) {
        if (this.layerWindow[layer] != 0) {
            throw heap LlmException("kv import: layer " + layer
                + " is windowed");
        }
        int32 sl = seq * this.layers + layer;
        if (this.lenSL[sl] != bi * this.blockTokens) {
            throw heap LlmException("kv import: block " + bi
                + " is not the next block (length " + this.lenSL[sl] + ")");
        }
        if (this.freeCount == 0) {
            return false;
        }
        this.freeCount = this.freeCount - 1;
        int32 blk = this.freeList[this.freeCount];
        this.refCount[blk] = 1;
        this.tables[sl * this.blocksPerSeq + bi] = blk;
        int64 base = (int64) blk * 2 * (int64) this.blockTokens
            * (int64) this.kvDim;
        int64 n = 2 * (int64) this.blockTokens * (int64) this.kvDim;
        int64 j = 0;
        while (j < n) {
            int32 at = (int32) (j * 4);
            int32 bits = ((int32) src[at] & 255)
                | (((int32) src[at + 1] & 255) << 8)
                | (((int32) src[at + 2] & 255) << 16)
                | (((int32) src[at + 3] & 255) << 24);
            this.pool.flatSet(base + j, Cajeta.bitsToF32(bits));
            j = j + 1;
        }
        this.lenSL[sl] = (bi + 1) * this.blockTokens;
        return true;
    }

    /** Release every block `seq` references; a block frees only when its
     *  LAST reference goes (6.14). The sequence resets to empty without
     *  reallocating anything (8.1.6). */
    public void release(int32 seq) {
        int32 l = 0;
        while (l < this.layers) {
            int32 sl = seq * this.layers + l;
            if (this.layerWindow[l] == 0) {
                int32 len = this.lenSL[sl];
                int32 nb = (len + this.blockTokens - 1) / this.blockTokens;
                int32 bi = 0;
                while (bi < nb) {
                    int32 blk = this.tables[sl * this.blocksPerSeq + bi];
                    this.refCount[blk] = this.refCount[blk] - 1;
                    if (this.refCount[blk] == 0) {
                        this.freeList[this.freeCount] = blk;
                        this.freeCount = this.freeCount + 1;
                    }
                    bi = bi + 1;
                }
            }
            this.lenSL[sl] = 0;
            l = l + 1;
        }
        return;
    }
}
