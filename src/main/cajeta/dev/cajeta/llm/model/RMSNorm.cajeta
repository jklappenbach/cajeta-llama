package dev.cajeta.llm.model;

import cajeta.lang.String;
import cajeta.math.Tensor;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.llm.LlmException;
import dev.cajeta.llm.io.Checkpoint;

/**
 * RMSNorm weights, `[dim]`. Llama form: `y = x/rms(x) · w`. (The Gemma
 * zero-centered `(1 + w)` form and the QK-norm placement are Unit 7's
 * concern — this class only owns the parameter and its binding.)
 */
public final class RMSNorm extends InfModule {
    Tensor<float32> weight;
    int32 dim;
    float32 eps;
    // A device copy of the scale, built on first device-resident use
    // (plan 10.2). Uploaded ONCE per norm for the life of the model: the
    // weight never changes, so it does not belong in the per-token
    // transfer budget the way the activation does.
    KernelBuffer<float32> wDev;

    /** The scale on the device, uploaded on first use. */
    KernelBuffer<float32> deviceWeight() {
        if (this.wDev == null) {
            int64 n = (int64) this.dim;
            float32[] h #= heap float32[n];
            int64 i = 0;
            while (i < n) { h[i] = this.weight.flatGet(i); i = i + 1; }
            this.wDev #= heap KernelBuffer<float32>((uint64) n);
            this.wDev.upload(h);
        }
        return this.wDev;
    }

    RMSNorm(int32 dim, float32 eps) {
        this.weight = null;
        this.dim = dim;
        this.eps = eps;
    }

    void bind(Checkpoint ckpt, String name, boolean toDevice) {
        Tensor<float32> t #= ckpt.loadF32(name);
        if (t.ndim() != 1 || t.shapeAt(0) != (int64) this.dim) {
            throw heap LlmException("weight binding: '" + name
                + "' does not match norm shape [" + this.dim + "]");
        }
        if (toDevice) {
            t.gpu();
        }
        this.weight #= t;
    }
}
