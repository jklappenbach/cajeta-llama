package dev.cajeta.llm.model;

import cajeta.math.Tensor;

/**
 * The MoE forward's per-layer scratch, allocated once at bind so the
 * decode path stays zero-allocation (the 6.1.6 invariant). Deliberately
 * NOT an InfModule — the reflective parameter walk must not see scratch
 * as parameters (the ActivationPool rule), and MoeFfn holding this as a
 * plain class reference is exactly how the walk skips it.
 */
final class MoeScratch {
    Tensor<float32> logits;   // router logits, [experts]
    float32[] probs;          // gating probabilities, [experts]
    int32[] sel;              // selected expert ids, [used]
    float32[] w;              // combining weights, [used]
    Tensor<float32> g;        // expert gate activation, [width]
    Tensor<float32> u;        // expert up activation, [width]
    Tensor<float32> eOut;     // one expert's output, [hidden]
    Tensor<float32> shG;      // shared-expert gate, [sharedW] (or null)
    Tensor<float32> shU;      // shared-expert up, [sharedW] (or null)
    Tensor<float32> shOut;    // shared-expert output, [hidden] (or null)

    // ── Unit 28 batch scratch — grown on demand by ensureBatch; null
    // until the first grouped forward, so decode pays nothing. ──
    int32 bRows;              // current row capacity (0 = unallocated)
    int32[] selAll;           // per-row selections, [bRows*used]
    float32[] wAll;           // per-row weights, [bRows*used]
    int32[] gCnt;             // per-expert entry count, [experts]
    int32[] gOff;             // group offsets, [experts+1]
    int32[] gCur;             // fill cursors, [experts]
    int32[] gRow;             // token row per group entry, [bRows*used]
    float32[] gW;             // weight per group entry, [bRows*used]
    Tensor<float32> bx;       // gathered rows, [bRows x hidden]
    Tensor<float32> bg;       // group gate activations, [bRows x width]
    Tensor<float32> bu;       // group up activations, [bRows x width]
    Tensor<float32> be;       // group expert outputs, [bRows x hidden]
    float32[] dq;             // one expert's dequant, [width*hidden]

    MoeScratch(int32 experts, int32 used, int32 width, int32 hidden,
            int32 sharedW) {
        int64[] s = heap int64[1];
        s[0] = (int64) experts;
        this.logits #= Tensor.zeros<float32>(s);
        this.probs = heap float32[experts];
        this.sel = heap int32[used];
        this.w = heap float32[used];
        s[0] = (int64) width;
        this.g #= Tensor.zeros<float32>(s);
        this.u #= Tensor.zeros<float32>(s);
        s[0] = (int64) hidden;
        this.eOut #= Tensor.zeros<float32>(s);
        this.bRows = 0;
        this.selAll = null;
        this.wAll = null;
        this.gCnt = null;
        this.gOff = null;
        this.gCur = null;
        this.gRow = null;
        this.gW = null;
        this.bx = null;
        this.bg = null;
        this.bu = null;
        this.be = null;
        this.dq = null;
        this.shG = null;
        this.shU = null;
        this.shOut = null;
        if (sharedW > 0) {
            s[0] = (int64) sharedW;
            this.shG #= Tensor.zeros<float32>(s);
            this.shU #= Tensor.zeros<float32>(s);
            s[0] = (int64) hidden;
            this.shOut #= Tensor.zeros<float32>(s);
        }
    }

    /** Grow the batch scratch to `rows` (15.12's grouped prefill).
     *  Grow-only, allocation-free once the high-water mark is met. */
    void ensureBatch(int32 rows, int32 used, int32 experts,
            int32 width, int32 hidden) {
        if (this.bRows >= rows) {
            return;
        }
        this.bRows = rows;
        this.selAll = heap int32[rows * used];
        this.wAll = heap float32[rows * used];
        if (this.gCnt == null) {
            this.gCnt = heap int32[experts];
            this.gOff = heap int32[experts + 1];
            this.gCur = heap int32[experts];
        }
        this.gRow = heap int32[rows * used];
        this.gW = heap float32[rows * used];
        int64[] s = heap int64[1];
        s[0] = (int64) rows * (int64) hidden;
        this.bx #= Tensor.zeros<float32>(s);
        this.be #= Tensor.zeros<float32>(s);
        s[0] = (int64) rows * (int64) width;
        this.bg #= Tensor.zeros<float32>(s);
        this.bu #= Tensor.zeros<float32>(s);
        if (this.dq == null) {
            this.dq = heap float32[width * hidden];
        }
        return;
    }
}
