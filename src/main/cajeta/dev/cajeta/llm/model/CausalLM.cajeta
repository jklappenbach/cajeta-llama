package dev.cajeta.llm.model;

import dev.cajeta.llm.Diag;


import cajeta.collection.ArrayList;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.math.Tensor;
import dev.cajeta.llm.LlmException;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.io.GgufFile;
import dev.cajeta.llm.io.Quant;

/**
 * The tape-free inference model (plan Unit 6; spec §4). Construction
 * builds the decoder stack from a HF `config.json`; binding loads HF
 * safetensors by torch `state_dict` name with no rename table; the
 * forward path is decode-first:
 *
 * - {@link #decodeStep} runs one token through pooled activations and
 *   the in-place KV cache — ZERO heap allocations per step (6.1.6), so
 *   the global live-set mutex never enters the hot path.
 * - {@link #prefill} runs the prompt through ONE arena block sized to the
 *   actual sequence length, carved into borrowed slices (spec 4.9/4.10);
 *   nothing survives the call, so peak activation memory is O(one layer)
 *   regardless of depth (6.1.1).
 *
 * Under `tie_word_embeddings` the `lmHead` field stays null and logits
 * are produced against the embedding matrix (spec 4.7).
 *
 * v1 computes on the HOST at f32; a model loaded `toDevice` is fully
 * device-resident after binding (6.1.4), and Unit 7's kernels take the
 * forward path to the device behind the same HostOps seams.
 */
public final class CausalLM extends InfModule {
    // Walked fields first: these two produce the state_dict key space.
    DecoderModel model;
    Linear lmHead;          // null when tie_word_embeddings (spec 4.7)

    // Non-parameter state (skipped by the reflective walk).
    ModelConfig cfg;
    ActivationPool pool;
    PagedKvCache cache;
    int32 maxSeq;
    int32 maxSeqsN;
    int32 pos;

    /**
     * `maxSeqs` sequences share the cache pool; `numBlocks` 0 auto-sizes
     * so every sequence can hold a full context (the scheduler passes a
     * deliberately scarcer pool to exercise admission and preemption).
     */
    public CausalLM(#ModelConfig cfg, int32 maxSeq, int32 maxSeqs,
            int32 numBlocks) {
        this.cfg #= cfg;
        this.model = heap DecoderModel(this.cfg);
        if (this.cfg.tieWordEmbeddings) {
            this.lmHead = null;
        } else {
            this.lmHead = heap Linear(this.cfg.hiddenSize,
                this.cfg.vocabSize);
        }
        this.pool = heap ActivationPool(this.cfg, maxSeq);
        // Pool capacity: every unwindowed layer can hold a full-context
        // sequence (windowed layers keep rings and draw no blocks).
        int32 blocksPerSeq = (maxSeq + this.cfg.blockTokens - 1)
            / this.cfg.blockTokens;
        int32 fullLayers = 0;
        int32 li = 0;
        while (li < this.cfg.numLayers) {
            if (this.cfg.windowForLayer(li) == 0) {
                fullLayers = fullLayers + 1;
            }
            li = li + 1;
        }
        int32 nb = numBlocks;
        if (nb == 0) {
            nb = fullLayers * blocksPerSeq * maxSeqs;
        }
        if (nb == 0) {
            nb = 1;
        }
        this.cache = heap PagedKvCache(this.cfg, maxSeq, maxSeqs, nb);
        this.maxSeq = maxSeq;
        this.maxSeqsN = maxSeqs;
        this.pos = 0;
    }

    public int32 maxSequences() {
        return this.maxSeqsN;
    }

    /** Unit 30: arm the routing histogram for this step (spec 15.20) —
     *  the slot the routes belong to, and whether anyone listens. A
     *  dense model has nothing to arm. */
    void armRoutes(int32 seq) {
        if (this.cfg.expertCount <= 0) { return; }
        MoeFfn.armRouteObservation(seq, this.cfg.numLayers,
            this.cfg.expertCount, this.maxSeqsN, Diag.on());
        return;
    }

    /** Unit 30: zero a slot's routing histogram — at admission, so a
     *  new occupant starts from nothing. */
    public void clearRoutes(int32 seq) {
        if (this.cfg.expertCount <= 0) { return; }
        MoeFfn.clearRouteHistogram(seq);
        return;
    }

    /**
     * Unit 30: emit the request's routing records (spec 15.20) and
     * clear its slot. One `route`/`layer` record per MoE layer —
     * v0 layer, v1 tokens routed, v2 distinct experts fired, v3 the
     * experts covering 90% of the layer's hits (its concentration: k90
     * = `used` means every token picked the same set), v4 the top
     * expert, v5 its hits — then one `route`/`request` summary: v0
     * tokens, v1 layers, v2 experts, v3 distinct (layer, expert) pairs,
     * v4 mean k90, v5 total hits. Reads the device histogram back once.
     */
    public void emitRouteRecords(int32 seq, int32 session) {
        if (this.cfg.expertCount <= 0 || !Diag.on()) { return; }
        int64[] h #= MoeFfn.routeHistogram(seq);
        if (h == null) { return; }
        int32 layers = this.cfg.numLayers;
        int32 experts = this.cfg.expertCount;
        int64 used = 1L;
        MoeFfn m0 = this.moeAt(0);
        if (m0 != null) { used = (int64) m0.used(); }
        int64 totalHits = 0L;
        int64 distinctPairs = 0L;
        int64 k90Sum = 0L;
        int64 tokens = 0L;
        int64[] sorted #= heap int64[experts];
        int32 l = 0;
        while (l < layers) {
            int64 base = (int64) l * (int64) experts;
            int64 hits = 0L;
            int64 distinct = 0L;
            int64 top = 0L;
            int64 topHits = 0L;
            int32 e = 0;
            while (e < experts) {
                int64 c = h[base + (int64) e];
                sorted[e] = c;
                hits = hits + c;
                if (c > 0L) { distinct = distinct + 1L; }
                if (c > topHits) { topHits = c; top = (int64) e; }
                e = e + 1;
            }
            // k90: the fewest experts whose hits reach 90% of the
            // layer's — a selection sort over the (small) expert count.
            int64 k90 = 0L;
            if (hits > 0L) {
                int64 need = (hits * 9L + 9L) / 10L;
                int64 got = 0L;
                int32 taken = 0;
                while (got < need && taken < experts) {
                    int32 bi = 0;
                    int32 j = 1;
                    while (j < experts) {
                        if (sorted[j] > sorted[bi]) { bi = j; }
                        j = j + 1;
                    }
                    got = got + sorted[bi];
                    sorted[bi] = 0L - 1L;
                    taken = taken + 1;
                }
                k90 = (int64) taken;
            }
            int64 lt = hits / used;
            Diag.emit("route", session, "layer", (int64) l, lt, distinct,
                k90, top, topHits);
            totalHits = totalHits + hits;
            distinctPairs = distinctPairs + distinct;
            k90Sum = k90Sum + k90;
            if (lt > tokens) { tokens = lt; }
            l = l + 1;
        }
        int64 meanK90 = layers > 0 ? k90Sum / (int64) layers : 0L;
        Diag.emit("route", session, "request", tokens, (int64) layers,
            (int64) experts, distinctPairs, meanK90, totalHits);
        MoeFfn.clearRouteHistogram(seq);
        return;
    }

    /**
     * Build the prefill-weight state OFF the prefill clock (the
     * profiling audit): under `prefillWeights = "int8"` the per-tensor
     * widen kernels measured 179 ms INSIDE the first prefill —
     * one-time work misattributed to prompt latency. Call after bind;
     * a no-op under the packed policy.
     */
    public void prewarmPrefillWeights() {
        if (!Linear.deqPrefillOn()) { return; }
        int32 l = 0;
        while (l < this.model.numLayers) {
            DecoderLayer d = this.model.layerArr[l];
            if (Linear.fuseEnabled()) {
                // 10.12.32: the fused buffers replace the per-tensor
                // deq for the fused tensors — building both would
                // double their footprint for nothing. Layers whose
                // attn_v is Q6_K cannot fuse q|k|v (half of Q4_K_M):
                // their trio prewarms per-tensor, or the widens land
                // inside the first timed prefill.
                if (d.selfAttn.vProj.packedTy == Quant.GG_Q4_K) {
                    d.selfAttn.qProj.ensureFused3(d.selfAttn.kProj,
                        d.selfAttn.vProj);
                } else {
                    d.selfAttn.qProj.prewarmDeq();
                    d.selfAttn.kProj.prewarmDeq();
                    d.selfAttn.vProj.prewarmDeq();
                }
                if (d.mlp != null) {
                    d.mlp.gateProj.ensureFused2(d.mlp.upProj);
                }
            } else {
                d.selfAttn.qProj.prewarmDeq();
                d.selfAttn.kProj.prewarmDeq();
                d.selfAttn.vProj.prewarmDeq();
                if (d.mlp != null) {
                    d.mlp.gateProj.prewarmDeq();
                    d.mlp.upProj.prewarmDeq();
                }
            }
            d.selfAttn.oProj.prewarmDeq();
            if (d.mlp != null) {
                d.mlp.downProj.prewarmDeq();
            }
            // 10.12.35: the yBatch buffers were allocated lazily by the
            // FIRST prefill — rocprofv3 put ~40 ms of hipMalloc inside
            // its pack->GEMM gaps. Allocate them off the clock, at the
            // full-context bound they would reach anyway.
            d.selfAttn.qProj.ensureBatchOut(this.maxSeq);
            d.selfAttn.kProj.ensureBatchOut(this.maxSeq);
            d.selfAttn.vProj.ensureBatchOut(this.maxSeq);
            d.selfAttn.oProj.ensureBatchOut(this.maxSeq);
            if (d.mlp != null) {
                d.mlp.gateProj.ensureBatchOut(this.maxSeq);
                d.mlp.upProj.ensureBatchOut(this.maxSeq);
                d.mlp.downProj.ensureBatchOut(this.maxSeq);
            }
            l = l + 1;
        }
        Linear.ensureBatchStage(this.maxSeq,
            this.cfg.intermediateSize);
        if (this.lmHead != null) {
            // The output projection's ~430 MB device upload happened
            // lazily INSIDE the first prefill's logits tail.
            this.lmHead.ensureDevice();
        }
        KernelStream ps = QuantKernel.stream();
        ps.sync();
        return;
    }

    public int32 layerCount() {
        return this.cfg.numLayers;
    }

    /** The cache — observable occupancy for tests and the scheduler. */
    /**
     * Reset sequence `seq` to empty WITHOUT freeing anything — the
     * warmup seam (first-touch attribution, 2026-08-25: every fresh
     * device buffer pays GPU page-commit inside the first prefill,
     * measured as the whole 2x gap between the engine's GEMMs and the
     * probe's). A warmup prefill + resetSeq leaves every buffer
     * allocated AND touched, so the next prefill runs at steady state.
     */
    public void resetSeq(int32 seq) {
        this.cache.release(seq);
        DeviceKv rd = this.dkvRaw(seq);
        if (rd != null) { rd.reset(); }
        this.pos = 0;
        return;
    }

    /** The vocabulary width, for a caller inspecting logits. */
    public int32 vocabSize() { return this.cfg.vocabSize; }

    /** Logit `i` of the last step — the measurement surface for the
     *  top-2 gap at a divergence. */
    public float32 logitAt(int32 i) {
        return this.pool.logits.flatGet((int64) i);
    }

    public PagedKvCache kvCache() {
        return this.cache;
    }

    /** Parse config, build the stack, bind the checkpoint. */
    public static #CausalLM load(String configPath, String ckptPath,
            int32 maxSeq, boolean toDevice) {
        CausalLM m = heap CausalLM(
            ModelConfig.parse(configPath), maxSeq, 1, 0);
        Checkpoint ckpt = Checkpoint.open(ckptPath);
        m.bind(ckpt, toDevice);
        ckpt.close();
        return #m;
    }

    /** Bind every parameter from `ckpt` by its torch state_dict key. */
    public void bind(Checkpoint ckpt, boolean toDevice) {
        this.model.bind(ckpt, toDevice);
        if (this.lmHead != null) {
            this.lmHead.bind(ckpt, "lm_head.weight", toDevice);
        }
    }

    public int32 position() {
        return this.pos;
    }

    /** Layer `i`'s MoE FFN, or null for a dense model. */
    public MoeFfn moeAt(int32 i) {
        return this.model.layerArr[i].moe;
    }

    public int32 vocabSize() {
        return this.cfg.vocabSize;
    }

    /** The logits of the most recent step — a borrow of pooled storage. */
    public Tensor<float32> logits() {
        return this.pool.logits;
    }

    /**
     * Run the prompt `tokens[0, n)` from the current position of the
     * DEFAULT sequence — sequence 0's convenience wrapper over
     * {@link #stepSeq}.
     */
    public int32 prefill(int32[] tokens, int32 n) {
        int32 r = this.stepSeq(0, tokens, 0, n);
        this.pos = this.seqLength(0);
        return r;
    }

    /**
     * THE step function (spec 13.14): consume `n` tokens
     * `tokens[off, off+n)` of sequence `seq` from its current cache
     * length — a prefill chunk at n=chunk, a decode at n=1, one forward
     * path. Returns the argmax over the LAST consumed position's logits
     * (meaningful when that position is the sequence's newest token;
     * interior chunks' argmax is discarded by the caller). n=1 runs in
     * pooled buffers (zero allocations); larger chunks carve one arena
     * block sized to the actual chunk (spec 4.9).
     */
    public int32 stepSeq(int32 seq, int32[] tokens, int32 off, int32 n) {
        if (n <= 0) {
            throw heap LlmException("step: token count must be positive");
        }
        this.armRoutes(seq);
        int32 seqPos = this.seqLength(seq);
        if (seqPos + n > this.maxSeq) {
            throw heap LlmException("step: " + n
                + " tokens at position " + seqPos
                + " exceeds maxSeq " + this.maxSeq);
        }
        if (n == 1) {
            return this.stepOne(seq, tokens[off]);
        }
        int64 rows = (int64) n;
        int64 h = (int64) this.cfg.hiddenSize;
        int64 qd = (int64) this.cfg.qDim();
        int64 kvd = (int64) this.cfg.kvDim();
        int64 inter = (int64) this.cfg.intermediateSize;

        // One block sized to the ACTUAL sequence length (spec 4.9).
        int64 total = rows * (h * 4 + qd * 2 + kvd * 2 + inter * 2);
        PrefillArena arena = heap PrefillArena(total);
        Tensor<float32> hs = arena.take(rows, h);
        Tensor<float32> xn = arena.take(rows, h);
        Tensor<float32> proj = arena.take(rows, h);
        Tensor<float32> mlpOut = arena.take(rows, h);
        Tensor<float32> q = arena.take(rows, qd);
        Tensor<float32> ao = arena.take(rows, qd);
        Tensor<float32> k = arena.take(rows, kvd);
        Tensor<float32> v = arena.take(rows, kvd);
        Tensor<float32> gate = arena.take(rows, inter);
        Tensor<float32> up = arena.take(rows, inter);

        Tensor<float32> emb = this.model.embedTokens.weight;
        int32 r = 0;
        while (r < n) {
            this.model.embedTokens.rowIntoTensor(tokens[off + r], hs,
                (int64) r * h, this.cfg.hiddenSize);
            r = r + 1;
        }
        int32 seqPos2 = this.seqLength(seq);
        this.forwardRows(seq, hs, xn, q, k, v, ao, proj, gate, up, mlpOut,
            n, seqPos2);
        return HostOps.argmaxRow(this.pool.logits, this.cfg.vocabSize);
    }

    /**
     * One decode step for `token` at the current position of sequence 0,
     * entirely in pooled buffers: zero heap allocations (6.1.6). Returns
     * the argmax of the resulting logits.
     */
    public int32 decodeStep(int32 token) {
        int32 r = this.stepOne(0, token);
        this.pos = this.seqLength(0);
        return r;
    }

    /** The N=1 specialization of {@link #stepSeq}: pooled buffers, zero
     *  heap allocations, same `forwardRows`. */
    int32 stepOne(int32 seq, int32 token) {
        int32 seqPos = this.seqLength(seq);
        if (seqPos >= this.maxSeq) {
            throw heap LlmException("decode: context is full (maxSeq "
                + this.maxSeq + ")");
        }
        ActivationPool p = this.pool;
        int64 te0 = Clock.nanoTime();
        this.model.embedTokens.rowIntoTensor(token, p.x, 0,
            this.cfg.hiddenSize);
        CausalLM.dtPreNs = CausalLM.dtPreNs
            + (Clock.nanoTime() - te0);
        this.forwardRows(seq, p.x, p.xn, p.q, p.k, p.v, p.attnOut,
            p.attnProj, p.gate, p.up, p.mlpOut, 1, seqPos);
        int64 ta0 = Clock.nanoTime();
        int32 am = HostOps.argmaxRow(p.logits, this.cfg.vocabSize);
        CausalLM.dtArgmaxNs = CausalLM.dtArgmaxNs
            + (Clock.nanoTime() - ta0);
        return am;
    }

    /**
     * The shared step function over `rows` consecutive positions starting
     * at absolute `startPos`: the layer stack (norm → GQA attention with
     * causal-by-construction cache reads → norm → SwiGLU, residuals in
     * place on `hs`), then the final norm and the output projection of
     * the LAST row into `pool.logits`. Buffers are caller-owned; row `r`
     * of a buffer is its flat range `[r·dim, (r+1)·dim)`.
     */
    void forwardRows(int32 seq, Tensor<float32> hs, Tensor<float32> xn,
            Tensor<float32> q, Tensor<float32> k, Tensor<float32> v,
            Tensor<float32> ao, Tensor<float32> proj,
            Tensor<float32> gate, Tensor<float32> up,
            Tensor<float32> mlpOut, int32 rows, int32 startPos) {
        int32 h = this.cfg.hiddenSize;
        int32 qd = this.cfg.qDim();
        int32 kvd = this.cfg.kvDim();
        int32 inter = this.cfg.intermediateSize;
        int32 nH = this.cfg.numHeads;
        int32 nKv = this.cfg.numKvHeads;
        int32 hd = this.cfg.headDim;
        Tensor<float32> scores = this.pool.scores;

        // FULL LAYER RESIDENCY (plan 10.2), when the layout allows it.
        // Gated on the Llama shape — no QK-norm, no four-norm — because the
        // extra norms in the other layouts have no device path yet, and a
        // half-resident layer that silently used a stale `hs` would be the
        // worst of both. rows==1 because only decode has a residual chain
        // short enough for one buffer.
        boolean resident = rows == 1 && this.deviceResidentReady();
        if (rows == 1 && !this.decSaid) {
            // The decode twin of `prefill-mode` (unit 38): which path
            // this engine's decode actually takes, said once, by the
            // engine — a timing inference is not a mechanism check.
            this.decSaid = true;
            Diag.emit("decode-mode", 0 - 1,
                resident ? "resident" : "host", 0L, 0L, 0L, 0L, 0L, 0L);
        }
        if (!resident) {
            // The host path reads K/V bytes, so the device planes owe the
            // cache whatever they hold beyond it (10.11.2). Prefill, a
            // non-Llama layout and a disabled route all land here.
            int64 tsk0 = Clock.nanoTime();
            this.syncKvToHost(seq);
            CausalLM.hdSyncKvNs = CausalLM.hdSyncKvNs
                + (Clock.nanoTime() - tsk0);
        }
        if (resident) {
            int64 tp0 = Clock.nanoTime();
            this.ensureResidentBuffers(h);
            this.ensureDeviceKv(seq);
            float32[] hb = hs.hostBuffer();
            int64 hbase = hs.hostBase();
            int64 ci = 0;
            while (ci < (int64) h) {
                this.hsHost[ci] = hb[hbase + ci];
                ci = ci + 1;
            }
            this.hsDev.upload(this.hsHost);
            CausalLM.dtPreNs = CausalLM.dtPreNs
                + (Clock.nanoTime() - tp0);
        }

        // BATCHED PREFILL (plan 10.12.1). The projections run over ALL
        // rows at once so a 32-token tile shares one pass over the
        // weights; the per-row path below reads all 4.58 GB of an 8B
        // checkpoint once PER PROMPT TOKEN, which is 2.4 TB for a
        // 512-token prompt and is why prefill(512) took 34 s.
        boolean batched = rows > 1 && this.batchReady(rows);
        // ONE `dkv` PER ENGINE, so it can serve at most one sequence
        // (15.2.8). `DeviceKv` carries a single `int32 seq` and a single set
        // of planes; a second sequence entering prefill reuses the first
        // one's slots at its own positions, which the paged cache catches as
        // "position 0 is not the next position (128)". Above one sequence the
        // whole engine takes the host attention path, which owns per-sequence
        // state properly — 34x slower at prefill, and correct.
        //
        // BOTH creation sites must agree. Guarding only this one leaves
        // `ensureDeviceKv` to build the very object this refuses, and the
        // crash returns unchanged (attempt 1, 2026-08-29).
        if (batched && CausalLM.devAttnOn
                && DeviceKv.supports(this.cfg)) {
            // The prefill attend needs the device planes; the same ones
            // decode then inherits, already holding the prompt, so the
            // 10.11 seed becomes free.
            //
            // 23.2.2: the `maxSeqsN <= 1` guard 15.2.8 put here is gone.
            // It bought correctness by forcing every extra sequence onto
            // the host attend, at 45x on prefill; per-slot planes are
            // what buys that back.
            this.ensureDkvSlot(seq);
        }
        if (rows > 1 && !this.batchSaid) {
            // SAY whether it engaged. The first version of this only knew
            // Q4_K, and Q4_K_M is a MIXTURE — attn_v and some ffn_down are
            // Q6_K — so `batchReady` was false and the whole prefill ran
            // per row. It read as "batching bought 4%" when it never ran.
            this.batchSaid = true;
            // v1 = how many projections refused (0 when batched), so a
            // bench log says WHY beside WHETHER; each refusal was named
            // by its own `batch-refused` record just before this one.
            Diag.emit("prefill-mode", 0 - 1,
                batched ? "batched" : "per-row", (int64) rows,
                (int64) this.batchRefusals, 0L, 0L, 0L, 0L);
        }
        if (batched) {
            this.forwardRowsBatched(seq, hs, xn, q, k, v, ao, proj, gate,
                up, mlpOut, rows, startPos, h, qd, kvd, inter, nH, nKv, hd,
                scores);
            return;
        }

        int64 trl0 = Clock.nanoTime();
        int32 l = 0;
        while (l < this.model.numLayers) {
            DecoderLayer d = this.model.layerArr[l];
            Attention a = d.selfAttn;
            if (resident) {
                this.residentLayer(seq, l, d, a, xn, mlpOut, q, k, v, ao,
                    scores, h, qd, kvd, inter, nH, nKv, hd, startPos);
                l = l + 1;
                continue;
            }
            int32 r = 0;
            while (r < rows) {
                int64 rh = (int64) r * (int64) h;
                int64 rq = (int64) r * (int64) qd;
                int64 rkv = (int64) r * (int64) kvd;
                int64 ri = (int64) r * (int64) inter;
                int32 p = startPos + r;

                // Attention sublayer.
                int64 tph0 = Clock.nanoTime();
                Prim.rmsnormRowHost(hs, rh, d.inputLayernorm.weight,
                    d.inputLayernorm.eps, xn, rh, h, d.normForm);
                // A NEW activation is current: `xn` was just rewritten at
                // `rh`. q, k and v then all read that same window, and the
                // shared stage quantizes and uploads it once instead of three
                // times. Declared here rather than inferred, because `xn` is
                // reused at the same offset every layer — identity and offset
                // cannot tell layer N's activation from layer N+1's.
                Linear.beginSharedActivation();
                a.qProj.matvecInto(xn, rh, q, rq);
                a.kProj.matvecInto(xn, rh, k, rkv);
                a.vProj.matvecInto(xn, rh, v, rkv);
                Linear.endSharedActivation();
                if (a.qNorm != null) {
                    // QK-norm BEFORE RoPE (spec 5.10), per head.
                    int32 hh = 0;
                    while (hh < nH) {
                        Prim.rmsnormRowHost(q, rq + (int64) (hh * hd),
                            a.qNorm.weight, a.qNorm.eps,
                            q, rq + (int64) (hh * hd), hd, d.normForm);
                        hh = hh + 1;
                    }
                    hh = 0;
                    while (hh < nKv) {
                        Prim.rmsnormRowHost(k, rkv + (int64) (hh * hd),
                            a.kNorm.weight, a.kNorm.eps,
                            k, rkv + (int64) (hh * hd), hd, d.normForm);
                        hh = hh + 1;
                    }
                }
                // RoPE at the ABSOLUTE position, per-layer frequencies —
                // never the ring slot (spec 6.10).
                Prim.ropeRowHost(q, rq, nH, hd, p, a.ropeInv);
                Prim.ropeRowHost(k, rkv, nKv, hd, p, a.ropeInv);
                if (!this.cache.appendRow(seq, l, k, rkv, v, rkv, p)) {
                    // The scheduler's admission/headroom arithmetic must
                    // prevent this; hitting it here is an invariant
                    // violation, not a schedulable event (6.4, 13.15).
                    throw heap LlmException("kv pool exhausted at layer "
                        + l + " position " + p);
                }
                int64 tat0 = Clock.nanoTime();
                CausalLM.hdProjNs = CausalLM.hdProjNs + (tat0 - tph0);
                // Causal by construction; the layer's window clamps in
                // prefill AND decode inside the cache read (spec 5.9).
                this.cache.attendRow(seq, l, q, rq, a.scale, scores, ao, rq,
                    nH, nKv, hd);
                int64 top0 = Clock.nanoTime();
                CausalLM.hdAttendNs = CausalLM.hdAttendNs + (top0 - tat0);
                a.oProj.matvecInto(ao, rq, proj, rh);
                if (d.fourNorm) {
                    // Gemma layout: post-norm on the sublayer OUTPUT.
                    Prim.rmsnormRowHost(proj, rh,
                        d.postAttentionLayernorm.weight,
                        d.postAttentionLayernorm.eps, proj, rh, h,
                        d.normForm);
                }
                HostOps.addRow(hs, rh, proj, rh, h);
                int64 tmlp0 = Clock.nanoTime();
                CausalLM.hdOProjNs = CausalLM.hdOProjNs + (tmlp0 - top0);

                // MLP sublayer. Two-norm layout uses
                // post_attention_layernorm as the pre-MLP norm.
                RMSNorm pre = d.postAttentionLayernorm;
                if (d.fourNorm) {
                    pre = d.preFeedforwardLayernorm;
                }
                Prim.rmsnormRowHost(hs, rh, pre.weight, pre.eps,
                    xn, rh, h, d.normForm);
                if (d.moe != null) {
                    // MoE FFN: deferred to a GROUPED dispatch after the
                    // row loop (15.12, unit 28). Safe because rows
                    // couple only through the KV cache, which is
                    // attention-phase state — hs/xn/mlpOut windows are
                    // per-row disjoint. fourNorm and the residual for
                    // these rows run in the deferred block too.
                    r = r + 1;
                    continue;
                } else {
                    Linear.beginSharedActivation();
                    if (d.mlp.gateProj.isDeviceRouted()
                            && d.mlp.upProj.isDeviceRouted()
                            && d.mlp.downProj.isDeviceRouted()) {
                        // THE MLP MIDDLE NEVER LEAVES THE DEVICE (plan 10.2).
                        // gate and up are produced there, the SwiGLU runs there,
                        // and down quantizes the result there — where the host
                        // path downloads gate and up, folds them, and uploads
                        // the fold again, three crossings a layer for a value
                        // no one on this side ever looks at.
                        d.mlp.gateProj.matvecKeepOnDevice(xn, rh);
                        d.mlp.upProj.matvecKeepOnDevice(xn, rh);
                        Linear.endSharedActivation();
                        Prim.gluDevice(d.mlp.gateProj.out(), d.mlp.upProj.out(),
                            (int64) inter, d.activation);
                        d.mlp.downProj.matvecFromDevice(d.mlp.gateProj.out(),
                            (int64) inter, mlpOut, rh);
                    } else {
                        d.mlp.gateProj.matvecInto(xn, rh, gate, ri);
                        d.mlp.upProj.matvecInto(xn, rh, up, ri);
                        Linear.endSharedActivation();
                        Prim.gluRowHost(gate, ri, up, ri, gate, ri, inter,
                            d.activation);
                        d.mlp.downProj.matvecInto(gate, ri, mlpOut, rh);
                    }
                }
                if (d.fourNorm) {
                    Prim.rmsnormRowHost(mlpOut, rh,
                        d.postFeedforwardLayernorm.weight,
                        d.postFeedforwardLayernorm.eps, mlpOut, rh, h,
                        d.normForm);
                }
                HostOps.addRow(hs, rh, mlpOut, rh, h);
                CausalLM.hdMlpNs = CausalLM.hdMlpNs
                    + (Clock.nanoTime() - tmlp0);
                r = r + 1;
            }
            if (d.moe != null) {
                // The deferred MoE FFN for every row of this layer:
                // per-token at decode (the zero-allocation path, and
                // 15.16's per-token instrument), grouped by expert for
                // a multi-row chunk (15.12 — each selected expert's
                // bytes read once per batch).
                if (rows == 1) {
                    int64 tmoe0 = Clock.nanoTime();
                    d.moe.forwardRow(xn, 0L, mlpOut, 0L, d.activation);
                    CausalLM.hdMoeNs = CausalLM.hdMoeNs
                        + (Clock.nanoTime() - tmoe0);
                } else {
                    d.moe.forwardBatch(xn, mlpOut, rows, d.activation);
                }
                int32 mr = 0;
                while (mr < rows) {
                    int64 mrh = (int64) mr * (int64) h;
                    if (d.fourNorm) {
                        Prim.rmsnormRowHost(mlpOut, mrh,
                            d.postFeedforwardLayernorm.weight,
                            d.postFeedforwardLayernorm.eps, mlpOut, mrh,
                            h, d.normForm);
                    }
                    HostOps.addRow(hs, mrh, mlpOut, mrh, h);
                    mr = mr + 1;
                }
            }
            l = l + 1;
        }
        if (resident) {
            CausalLM.rlLoopNs = CausalLM.rlLoopNs
                + (Clock.nanoTime() - trl0);
        }

        if (resident && CausalLM.fuseTail && this.lmHead != null
                && this.lmHead.isDeviceRouted()) {
            DeviceKv nd = this.dkvOf(seq);
            if (nd != null) {
                // One position was appended to every layer's device
                // planes. The paged cache is NOT advanced — see
                // `seqLength`.
                nd.notePosition(startPos);
            }
            // FUSED TAIL (lm-head parity, 2026-08-25): the final norm
            // and the output projection RIDE THE CHAIN'S STREAM, so the
            // token's one wait covers them too — the way llama.cpp keeps
            // lm_head inside the same graph submission. The unfused path
            // below paid a second launch+sync round trip here (3.14 ms
            // measured against the ~2.0 ms the lm_head's 0.43 GB of
            // Q6_K weights cost to stream), and its residual download
            // existed only to feed a HOST final norm — the next token's
            // pre phase uploads a fresh embedding, it never reads hs.
            // Timer semantics shift with the fuse: norm = the tail's
            // launch cost, sync = chain AND tail GPU time, lmHead = the
            // logits copy-out, hsDown = 0 by construction.
            int64 tf0 = Clock.nanoTime();
            Prim.rmsnormDevice(this.xnDev, this.hsDev,
                this.model.norm.deviceWeight(), (int64) h,
                this.model.norm.eps, this.cfg.normForm);
            Linear.stageDeviceActivation(this.xnDev, (int64) h);
            this.lmHead.matvecStagedKeep();
            int64 tf1 = Clock.nanoTime();
            KernelStream fs = QuantKernel.stream();
            fs.sync();
            int64 tf2 = Clock.nanoTime();
            this.lmHead.fetchInto(this.pool.logits, 0L);
            CausalLM.dtNormNs = CausalLM.dtNormNs
                + (tf1 - tf0);
            CausalLM.dtSyncNs = CausalLM.dtSyncNs
                + (tf2 - tf1);
            CausalLM.dtLmHeadNs = CausalLM.dtLmHeadNs
                + (Clock.nanoTime() - tf2);
            CausalLM.dtTok = CausalLM.dtTok + 1L;
            return;
        }
        if (resident) {
            DeviceKv nd = this.dkvOf(seq);
            if (nd != null) {
                // One position was appended to every layer's device
                // planes. The paged cache is NOT advanced — see
                // `seqLength`.
                nd.notePosition(startPos);
            }
            // Back to the host once, for the final norm and lm_head.
            // 10.12.37: the layer chain above is now launch-only, so
            // THIS is the token's one wait. (The fused tail above is the
            // default; this branch serves tied-embedding models, formats
            // without a device route, and the bench's `nofuse` arm.)
            int64 ts0 = Clock.nanoTime();
            KernelStream ds = QuantKernel.stream();
            ds.sync();
            int64 ts1 = Clock.nanoTime();
            CausalLM.dtSyncNs = CausalLM.dtSyncNs
                + (ts1 - ts0);
            this.hsDev.download(this.hsHost);
            float32[] hb2 = hs.hostBuffer();
            int64 hb2base = hs.hostBase();
            int64 co = 0;
            while (co < (int64) h) {
                hb2[hb2base + co] = this.hsHost[co];
                co = co + 1;
            }
            CausalLM.dtHsDownNs = CausalLM.dtHsDownNs
                + (Clock.nanoTime() - ts1);
            CausalLM.dtTok = CausalLM.dtTok + 1L;
        }

        // Final norm of the last row, then the output projection.
        int64 tn0 = Clock.nanoTime();
        int64 lastH = (int64) (rows - 1) * (int64) h;
        Prim.rmsnormRowHost(hs, lastH, this.model.norm.weight,
            this.model.norm.eps, xn, lastH, h, this.cfg.normForm);
        int64 tn1 = Clock.nanoTime();
        if (this.lmHead != null) {
            this.lmHead.matvecInto(xn, lastH, this.pool.logits, 0);
        } else {
            // Tied output projection: logits against the embedding matrix.
            HostOps.rowsDotRow(this.model.embedTokens.weight, xn, lastH,
                this.pool.logits, this.cfg.vocabSize, h);
        }
        if (resident) {
            CausalLM.dtNormNs = CausalLM.dtNormNs
                + (tn1 - tn0);
            CausalLM.dtLmHeadNs = CausalLM.dtLmHeadNs
                + (Clock.nanoTime() - tn1);
        }
    }

    // Device-resident decode state (plan 10.2). One hidden-wide buffer for
    // the residual stream and one for the norm output, allocated once.
    KernelBuffer<float32> hsDev;
    KernelBuffer<float32> xnDev;
    KernelBuffer<float32> moeDev;   // unit 38: MoE crossing up-leg
    float32[] hsHost;

    // Prefill-resident hidden state (10.12.7.b): `[rows x h]` device
    // twins of hs/xn for the batched path, plus the scratch host array
    // the one-per-prefill upload/download bounces through — an arena
    // slice's `hostBase` is nonzero and `KernelBuffer.upload` starts at
    // index 0, the exact trap that broke `prefillAttend` (spec 9).
    KernelBuffer<float32> pfHsDev;
    KernelBuffer<float32> pfXnDev;
    float32[] pfHsHost;
    int64 pfHsCap;
    // 10.12.7.c: per-row positions for the batched device rope, and the
    // scratch the roped k/v come down through for the paged cache's
    // host append (the cache stays authoritative).
    KernelBuffer<int32> pfPosDev;
    int32[] pfPosHost;
    int32 pfPosCap;
    /** Unit 59b: the next layer's input norm + pack already ran in
     *  the previous layer's down-combine tail. */
    boolean preNormedNext;
    float32[] pfKScr;
    float32[] pfVScr;
    int64 pfKvCap;

    void ensurePrefillRes(int64 n) {
        if (this.pfHsCap >= n) { return; }
        this.pfHsDev #= heap KernelBuffer<float32>((uint64) n);
        this.pfXnDev #= heap KernelBuffer<float32>((uint64) n);
        this.pfHsHost #= heap float32[n];
        this.pfHsCap = n;
        return;
    }

    void ensurePrefillPos(int32 rows, int32 startPos) {
        if (this.pfPosCap < rows) {
            this.pfPosDev #= heap KernelBuffer<int32>((uint64) rows);
            this.pfPosHost #= heap int32[(int64) rows];
            this.pfPosCap = rows;
        }
        int32 i = 0;
        while (i < rows) {
            this.pfPosHost[(int64) i] = startPos + i;
            i = i + 1;
        }
        this.pfPosDev.upload(this.pfPosHost, (int64) rows);
        return;
    }

    // Unit 29: the MoE expert sum's ride back up to the resident hs.
    KernelBuffer<float32> pfMoeDev;
    int64 pfMoeCap;

    void ensurePrefillMoe(int64 n) {
        if (this.pfMoeCap >= n) { return; }
        this.pfMoeDev #= heap KernelBuffer<float32>((uint64) n);
        this.pfMoeCap = n;
        return;
    }

    KernelBuffer<float32> pfLastDev;
    int64 pfLastCap;

    void ensurePrefillLast(int64 n) {
        if (this.pfLastDev != null && this.pfLastCap >= n) { return; }
        this.pfLastDev #= heap KernelBuffer<float32>((uint64) n);
        this.pfLastCap = n;
        return;
    }

    void ensurePrefillKv(int64 n) {
        if (this.pfKvCap >= n) { return; }
        this.pfKScr #= heap float32[n];
        this.pfVScr #= heap float32[n];
        this.pfKvCap = n;
        return;
    }

    // Device attention (plan 10.11): RoPE, the KV planes and the attend.
    /**
     * Device-resident K/V, ONE PER SLOT (23.2.1).
     *
     * `DeviceKv` is a single sequence's planes by construction — its own
     * doc says so — so multi-sequence is N of them, not one object
     * parameterized by slot. That choice is what keeps `from = 0` in
     * every attend kernel: each slot owns its planes outright, so no
     * kernel learns about slots at all. Allocation is lazy, so an idle
     * slot costs nothing.
     *
     * Indexed by `seq`, which IS the slot — `Scheduler` calls
     * `stepSeq(r.slot, ...)` and `PagedKvCache` keys on the same value.
     * A null entry means that slot is not device-resident.
     */
    DeviceKv[] dkvs;

    /**
     * This slot's planes, or null when the device attend must not run.
     *
     * The `devAttnOn` check lives HERE, in the one accessor, rather than
     * at each use. 15.2.8's first attempt guarded one of two sites and
     * the other kept building the object it refused; a switch that every
     * reader consults through the same door cannot half-apply.
     */
    DeviceKv dkvOf(int32 seq) {
        if (!CausalLM.devAttnOn) { return null; }
        return this.dkvRaw(seq);
    }

    /** The slot's planes IGNORING the routing switch — for writeback,
     *  which must still drain planes that already own rows when the
     *  switch is flipped off underneath them. */
    DeviceKv dkvRaw(int32 seq) {
        if (this.dkvs == null || seq < 0 || seq >= this.maxSeqsN) {
            return null;
        }
        return this.dkvs[(int64) seq];
    }

    /** This slot's planes, allocated on first use. */
    DeviceKv ensureDkvSlot(int32 seq) {
        if (seq < 0 || seq >= this.maxSeqsN) { return null; }
        if (this.dkvs == null) {
            this.dkvs #= heap DeviceKv[(int64) this.maxSeqsN];
        }
        if (this.dkvs[(int64) seq] == null) {
            DeviceKv d #= heap DeviceKv(this.cfg, this.maxSeq);
            d.bindRope(this.model);
            this.dkvs[(int64) seq] #= d;
        }
        return this.dkvs[(int64) seq];
    }

    /**
     * How many slots hold device planes.
     *
     * Both device-KV probes read this (23.1.2, 23.1.3), and they need a
     * MECHANISM rather than a stopwatch: a wall-clock cannot tell "ran
     * on the host" from "ran on the device slowly", and a lazy allocator
     * that quietly allocates all N still passes an isolation test.
     */
    public int32 deviceKvSlotsActive() {
        if (this.dkvs == null) { return 0; }
        int32 n = 0;
        int32 i = 0;
        while (i < this.maxSeqsN) {
            if (this.dkvs[(int64) i] != null) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    /** Bytes the device planes would occupy with every slot resident —
     *  `maxSeqs x 2 planes x layers x cap x kvDim x 4` (23.2.3). Reported
     *  at load; there is no VRAM query on the `Device` surface to turn
     *  this into a pre-flight rejection. */
    public int64 deviceKvCeilingBytes() {
        return (int64) this.maxSeqsN * 2L * (int64) this.cfg.numLayers
            * (int64) this.maxSeq * (int64) this.cfg.kvDim() * 4L;
    }

    static boolean devAttnOn = true;
    public static void setDevAttn(boolean on) {
        CausalLM.devAttnOn = on;
    }

    // Unit-40 defect hunt: per-layer NaN sniffer on the batched
    // resident hs (bench-only; syncs every layer).
    static boolean nanSniff;
    public static void setNanSniff(boolean on) { CausalLM.nanSniff = on; }
    void sniffRow(String where, int32 li, int32 h) {
        if (!CausalLM.nanSniff) { return; }
        KernelStream ns = QuantKernel.stream();
        ns.sync();
        this.hsDev.download(this.hsHost, (int64) h);
        int64 bad = 0L;
        int64 i = 0;
        while (i < (int64) h) {
            float32 v = this.hsHost[i];
            if (v != v) { bad = bad + 1L; }
            i = i + 1;
        }
        if (bad > 0L) {
            System.stdout.println("[NAN-DEC " + where + " layer " + li
                + " count " + bad + "]");
        }
        return;
    }

    void sniff(String where, int32 l, int64 nHs) {
        if (!CausalLM.nanSniff) { return; }
        KernelStream ns = QuantKernel.stream();
        ns.sync();
        this.pfHsDev.download(this.pfHsHost, nHs);
        int64 bad = 0L;
        int64 firstI = 0L - 1L;
        int64 i = 0;
        while (i < nHs) {
            float32 v = this.pfHsHost[i];
            if (v != v) {
                bad = bad + 1L;
                if (firstI < 0L) { firstI = i; }
            }
            i = i + 1;
        }
        if (bad > 0L) {
            System.stdout.println("[NAN " + where + " layer " + l
                + " count " + bad + " first " + firstI + "]");
        }
        return;
    }
    static boolean forceReseed = false;

    // 10.12.38: the prefill cache-authority pass is LAZY by default —
    // the planes adopt with the host cache behind and `writeback` pays
    // the catch-up only when a host path actually reads K/V. The
    // profiler measured the eager pass at ~36 ms (4 ms downloads +
    // ~32 ms per-row host appends) that resident decode never reads.
    // `eagerauth` reverts; `reseed` forces eager regardless, since its
    // whole point is to seed decode FROM the host cache.
    static boolean eagerAuthOn = false;

    public static void setEagerAuth(boolean on) {
        CausalLM.eagerAuthOn = on;
    }

    // Prefill phase timers (10.12.22): the batch phases in Linear cover
    // the projections; these cover the rest of `forwardRowsBatched`, so
    // the whole prefill is accounted rather than "launch plus a
    // mystery". Host prims = the rmsnorm/GLU/add row loops.
    static int64 pfPrimNs;
    static int64 pfRopeNs;
    static int64 pfAttendNs;
    static int64 pfGemmNs;
    static int64 pfStageNs;
    static int64 pfGQkvNs;
    static int64 pfGONs;
    static int64 pfGMlpNs;
    static int64 pfGDownNs;
    // Attribution arm (bench "pfsync"): every pfMark drains the stream
    // first, so the buckets hold GPU time by phase instead of enqueue
    // time. Off (the default), pfMark is a plain timestamp and the
    // launch-only loop is untouched — the instrument must not perturb
    // its control.
    static boolean pfSyncOn;
    public static void setPfSync(boolean on) { CausalLM.pfSyncOn = on; }
    static int64 pfMark() {
        if (CausalLM.pfSyncOn) { QuantKernel.stream().sync(); }
        return Clock.nanoTime();
    }
    static int64 pfHeadNs;
    static int64 pfTailHsNs;
    static int64 pfLogitsNs;
    public static int64 prefillHeadNs() { return CausalLM.pfHeadNs; }
    public static int64 prefillTailHsNs() { return CausalLM.pfTailHsNs; }
    public static int64 prefillLogitsNs() { return CausalLM.pfLogitsNs; }

    public static int64 prefillPrimNs()   { return CausalLM.pfPrimNs; }
    public static int64 prefillGemmNs()   { return CausalLM.pfGemmNs; }
    public static int64 prefillGQkvNs()   { return CausalLM.pfGQkvNs; }
    public static int64 prefillGONs()     { return CausalLM.pfGONs; }
    public static int64 prefillGMlpNs()   { return CausalLM.pfGMlpNs; }
    public static int64 prefillGDownNs()  { return CausalLM.pfGDownNs; }
    public static int64 prefillStageNs()  { return CausalLM.pfStageNs; }
    public static int64 prefillRopeNs()   { return CausalLM.pfRopeNs; }
    public static int64 prefillAttendNs() { return CausalLM.pfAttendNs; }
    public static void resetPrefillTimers() {
        CausalLM.pfPrimNs = 0L;
        CausalLM.pfRopeNs = 0L;
        CausalLM.pfAttendNs = 0L;
        CausalLM.pfGemmNs = 0L;
        CausalLM.pfStageNs = 0L;
        CausalLM.pfGQkvNs = 0L;
        CausalLM.pfGONs = 0L;
        CausalLM.pfGMlpNs = 0L;
        CausalLM.pfGDownNs = 0L;
        return;
    }

    // DECODE-TAIL attribution (2026-08-25): the per-token HOST work of a
    // resident decode, phase by phase, because the kernel trace can only
    // show the GPU idle it leaves behind — a ~3 ms gap between lm_head
    // finishing and the next token's upload — not what the host was doing
    // in it. Pre = embed row + hs fill + upload; sync = the token's one
    // wait; hsDown = residual download + copy-out; norm = the host final
    // rmsnorm; lmHead = matvecInto (its own launch/download/copyOut
    // internals are Linear's dev timers); argmax = the 128k host scan.
    // The fused decode tail: final norm + lm_head launched on the
    // chain's stream before its one sync (llama.cpp keeps them in the
    // same graph submission). Off = the two-round-trip host tail, kept
    // for tied embeddings, un-routed formats, and the bench's A/B arm.
    static boolean fuseTail = true;
    public static void setFuseTail(boolean on) {
        CausalLM.fuseTail = on;
    }

    // ── Host-path decode phase split (parity attribution): where a
    // per-row token goes when the resident path is refused (MoE /
    // QK-norm shapes). Wall time per section; the bench resets before
    // its decode loop and divides by tokens. ──
    static int64 hdSyncKvNs;  // syncKvToHost at forwardRows entry
    static int64 hdProjNs;    // pre-norm + q/k/v proj + qk-norm + rope + append
    static int64 hdAttendNs;  // cache.attendRow (host attention over KV)
    static int64 hdOProjNs;   // oProj + residual add
    static int64 hdMlpNs;     // dense MLP sublayer (nil on all-MoE models)
    static int64 hdMoeNs;     // moe.forwardRow
    public static int64 hostDecSyncKvNs() { return CausalLM.hdSyncKvNs; }
    public static int64 hostDecProjNs()   { return CausalLM.hdProjNs; }
    public static int64 hostDecAttendNs() { return CausalLM.hdAttendNs; }
    public static int64 hostDecOProjNs()  { return CausalLM.hdOProjNs; }
    public static int64 hostDecMlpNs()    { return CausalLM.hdMlpNs; }
    public static int64 hostDecMoeNs()    { return CausalLM.hdMoeNs; }
    public static void resetHostDecTimers() {
        CausalLM.hdSyncKvNs = 0L;
        CausalLM.hdProjNs = 0L;
        CausalLM.hdAttendNs = 0L;
        CausalLM.hdOProjNs = 0L;
        CausalLM.hdMlpNs = 0L;
        CausalLM.hdMoeNs = 0L;
        return;
    }

    // Triage arm: sync the stream before each resident sublayer
    // stamp, so rlAttnNs/rlMoeNs become GPU-INCLUSIVE attribution.
    // Perturbs pipelining (~0.1 ms/token of extra syncs) — bench only.
    static boolean phaseSyncOn;

    public static void setPhaseSync(boolean on) {
        CausalLM.phaseSyncOn = on;
    }

    // Attention-chain sub-spans (GPU-inclusive under phaseSync).
    static int64 raNormNs;   // pre-norm + stage
    static int64 raProjNs;   // q/k/v projections
    static int64 raRopeNs;   // qk-norm + rope + append
    static int64 raAttnNs;   // the attend
    static int64 raOutNs;    // oProj + residual add
    public static int64 raNorm() { return CausalLM.raNormNs; }
    public static int64 raProj() { return CausalLM.raProjNs; }
    public static int64 raRope() { return CausalLM.raRopeNs; }
    public static int64 raAttn() { return CausalLM.raAttnNs; }
    public static int64 raOut()  { return CausalLM.raOutNs; }
    static void aSync() {
        if (!CausalLM.phaseSyncOn) { return; }
        KernelStream s = QuantKernel.stream();
        s.sync();
        return;
    }

    // Resident-loop host attribution (unit 40 triage).
    static int64 rlAttnNs;   // residentLayer attention sublayer, host span
    static int64 rlMoeNs;    // residentLayer MoE sublayer, host span
    static int64 rlLoopNs;   // the whole layer loop, host span
    public static int64 residentAttnNs() { return CausalLM.rlAttnNs; }
    public static int64 residentMoeNs()  { return CausalLM.rlMoeNs; }
    public static int64 residentLoopNs() { return CausalLM.rlLoopNs; }
    public static void resetResidentTimers() {
        CausalLM.rlAttnNs = 0L;
        CausalLM.rlMoeNs = 0L;
        CausalLM.rlLoopNs = 0L;
        CausalLM.raNormNs = 0L;
        CausalLM.raProjNs = 0L;
        CausalLM.raRopeNs = 0L;
        CausalLM.raAttnNs = 0L;
        CausalLM.raOutNs = 0L;
        return;
    }

    static int64 dtPreNs;
    static int64 dtSyncNs;
    static int64 dtHsDownNs;
    static int64 dtNormNs;
    static int64 dtLmHeadNs;
    static int64 dtArgmaxNs;
    static int64 dtTok;
    public static int64 decodePreNs()    { return CausalLM.dtPreNs; }
    public static int64 decodeSyncNs()   { return CausalLM.dtSyncNs; }
    public static int64 decodeHsDownNs() { return CausalLM.dtHsDownNs; }
    public static int64 decodeNormNs()   { return CausalLM.dtNormNs; }
    public static int64 decodeLmHeadNs() { return CausalLM.dtLmHeadNs; }
    public static int64 decodeArgmaxNs() { return CausalLM.dtArgmaxNs; }
    public static int64 decodeTokens()   { return CausalLM.dtTok; }
    public static void resetDecodeTimers() {
        CausalLM.dtPreNs = 0L;
        CausalLM.dtSyncNs = 0L;
        CausalLM.dtHsDownNs = 0L;
        CausalLM.dtNormNs = 0L;
        CausalLM.dtLmHeadNs = 0L;
        CausalLM.dtArgmaxNs = 0L;
        CausalLM.dtTok = 0L;
        return;
    }

    public static void setForceReseed(boolean on) {
        CausalLM.forceReseed = on;
    }

    /** Arm for 10.11 — the attention tail on the device. On by default:
     *  the host tail is 3 ms of a 32 ms token at 12 positions of context
     *  but 97 ms of a 125 ms token at 512, and it is the only part of a
     *  decode token that grows with context. */
    public static void setDeviceAttention(boolean on) {
        CausalLM.devAttnOn = on;
    }

    public static boolean deviceAttentionEnabled() {
        return CausalLM.devAttnOn;
    }

    /**
     * The sequence's length in POSITIONS, device-held rows included.
     *
     * While the device owns rows the paged cache is deliberately behind —
     * its length and its bytes stay consistent with each other, and
     * `DeviceKv.writeback` catches it up in one pass (10.11.2). Every
     * position decision has to ask here rather than the cache, or a
     * device-resident generation would emit the same position forever.
     */
    int32 seqLength(int32 seq) {
        DeviceKv d = this.dkvOf(seq);
        if (d != null && d.owns() && d.seq == seq) {
            return d.length();
        }
        return this.cache.lengthOf(seq, 0);
    }

    /** Bring the paged cache back up to date, so a host-path token — or
     *  anything that reads K/V — sees real bytes. */
    void syncKvToHost(int32 seq) {
        // dkvRaw, not dkvOf: planes that already own rows must still be
        // drained if the routing switch went off underneath them, or the
        // host cache keeps a length it has no bytes for.
        DeviceKv d = this.dkvRaw(seq);
        if (d != null && d.owns()) {
            d.writeback(this.cache, seq);
        }
        return;
    }

    /**
     * Can this stack take the device routes at all — every projection
     * device-launchable AND a KV layout `DeviceKv` implements?
     *
     * Public so a FIXTURE can assert it (24.1.1). A fixture that
     * silently fails to route makes every test built on it vacuously
     * green, which is the failure Unit 24 exists to end; asserting the
     * precondition is what separates "the device path agreed" from "the
     * device path never ran".
     */
    public boolean deviceRoutable() {
        return DeviceKv.supports(this.cfg) && this.residentRouted();
    }

    /**
     * Is the BATCHED device route available for `rows` rows?
     *
     * Public so a test can gate on the CAPABILITY the prefill path
     * itself checks (`batched = rows > 1 && batchReady(rows)`) rather
     * than on a proxy. Two weaker proxies were tried and both are true
     * on the cpu backend, where the batch route does not exist:
     * `deviceRoutable()` (every projection IS device-launchable there)
     * and `Linear.devicePackOn()`. A gate that is true where the path
     * does not run turns a correct backend into a red suite.
     */
    public boolean batchRoutedFor(int32 rows) {
        return this.batchReady(rows);
    }

    /** Is every projection in the stack on a device route, and is the
     *  layout the plain Llama one the resident path implements? */
    boolean deviceResidentReady() {
        if (!Linear.residentEnabled()) { return false; }
        int32 l = 0;
        while (l < this.model.numLayers) {
            DecoderLayer d = this.model.layerArr[l];
            Attention a = d.selfAttn;
            // Unit 38 (spec 15.21.1): qNorm no longer disqualifies —
            // the per-head norms run on the device between projection
            // and rope (unit 29's kernel, nH/nKv rows of hd) — and an
            // MoE layer's FFN takes the host crossing (correct with
            // slots or windowed), so only the four attention
            // projections must route. Before this, the 30B decoded on
            // the host attention path: 110 ms of a 211 ms token.
            if (d.fourNorm) { return false; }
            if (!a.qProj.isDeviceRouted() || !a.kProj.isDeviceRouted()
                    || !a.vProj.isDeviceRouted()
                    || !a.oProj.isDeviceRouted()) {
                return false;
            }
            if (d.moe == null) {
                if (!d.mlp.gateProj.isDeviceRouted()
                        || !d.mlp.upProj.isDeviceRouted()
                        || !d.mlp.downProj.isDeviceRouted()) {
                    return false;
                }
            }
            l = l + 1;
        }
        return true;
    }

    /** Every projection in the stack has a batched GEMM kernel for
     *  THIS row count (10.12.45.D: Q5_K/Q8_0 batch only at the Mw8
     *  shape, so the answer depends on rows). */
    boolean batchReady(int32 rows) {
        // Every layer is scanned, not just to the first refusal: the
        // `batch-refused` diagnostic (prefill-routes plan 1.2.1) names
        // EVERY distinct (projection, format, reason), because a mixture
        // like Q4_K_M refuses on the odd Q6_K/Q5_K tensor, not the first
        // one. The count of refusing projections rides on `prefill-mode`.
        int32 refusals = 0;
        int32 l = 0;
        while (l < this.model.numLayers) {
            DecoderLayer d = this.model.layerArr[l];
            Attention a = d.selfAttn;
            // Unit 29: qNorm no longer disqualifies — the batched path
            // applies the per-head norms between projection and rope
            // (llama.cpp's build_qwen3 order, read rather than assumed).
            if (d.fourNorm) {
                refusals = refusals + this.refuse(l, "layer", 0 - 1,
                    "fourNorm layer: the batched path has no 4-norm order",
                    rows);
            }
            refusals = refusals + this.refuseIf(l, "attn_q", a.qProj, rows);
            refusals = refusals + this.refuseIf(l, "attn_k", a.kProj, rows);
            refusals = refusals + this.refuseIf(l, "attn_v", a.vProj, rows);
            refusals = refusals + this.refuseIf(l, "attn_output", a.oProj, rows);
            if (d.moe != null) {
                // Unit 29: an MoE FFN places no static claim here — the
                // grouped dispatch (unit 28) chooses device or host PER
                // EXPERT GROUP inside forwardBatch, so only the dense
                // attention stack must batch.
                l = l + 1;
                continue;
            }
            refusals = refusals + this.refuseIf(l, "ffn_gate", d.mlp.gateProj, rows);
            refusals = refusals + this.refuseIf(l, "ffn_up", d.mlp.upProj, rows);
            refusals = refusals + this.refuseIf(l, "ffn_down", d.mlp.downProj, rows);
            l = l + 1;
        }
        this.batchRefusals = refusals;
        return refusals == 0;
    }

    /** 1 when `lin` refuses the batched route at `rows` (said once per
     *  distinct projection/format/reason), else 0. */
    int32 refuseIf(int32 layer, String proj, Linear lin, int32 rows) {
        String why = lin.batchRefusal((int64) rows);
        if (why == null) { return 0; }
        return this.refuse(layer, proj, lin.packedType(), why, rows);
    }

    /** Emits `batch-refused` once per distinct (projection, format,
     *  reason) for the life of this model: name = "<proj> <format>:
     *  <reason>", v0 = layer, v1 = rows, v2 = ggml type. Returns 1. */
    int32 refuse(int32 layer, String proj, int32 ty, String why, int32 rows) {
        if (!Diag.on()) { return 1; }
        String tn #= GgufFile.typeName(ty);
        String key = proj + " " + tn + ": " + why;
        if (this.refusedKeys == null) {
            this.refusedKeys = heap ArrayList<String>();
        }
        int32 i = 0;
        while (i < this.refusedKeys.count()) {
            if (this.refusedKeys.get(i).equals(key)) { return 1; }
            i = i + 1;
        }
        Diag.emit("batch-refused", 0 - 1, key, (int64) layer, (int64) rows,
            (int64) ty, 0L, 0L, 0L);
        this.refusedKeys.add(#key);
        return 1;
    }

    /**
     * Every projection can launch on the DEVICE-RESIDENT decode path
     * (10.12.45): a device mat-vec kernel exists for its format. Q2_K
     * and Q3_K bind packed but have no kernel yet, and letting them
     * onto the resident path would hit matVecLaunch's no-kernel throw
     * mid-token; they take the host decode until their unit C lands.
     */
    boolean residentRouted() {
        int32 l = 0;
        while (l < this.model.numLayers) {
            DecoderLayer d = this.model.layerArr[l];
            Attention a = d.selfAttn;
            // Unit 38: an MoE layer's FFN never runs through `d.mlp`,
            // so only its attention projections gate the device
            // planes; refusing MoE here starved `ensureDeviceKv` and
            // forced the host attend under an otherwise-resident
            // stack.
            if (!a.qProj.deviceLaunchable()
                    || !a.kProj.deviceLaunchable()
                    || !a.vProj.deviceLaunchable()
                    || !a.oProj.deviceLaunchable()) {
                return false;
            }
            if (d.moe == null) {
                if (!d.mlp.gateProj.deviceLaunchable()
                        || !d.mlp.upProj.deviceLaunchable()
                        || !d.mlp.downProj.deviceLaunchable()) {
                    return false;
                }
            }
            l = l + 1;
        }
        return true;
    }

    /** The tag of this model's most recent batch stage, drawn from
     *  Linear.nextStageTag() — PROCESS-WIDE monotonic, so the stage can
     *  never hit a stale window: `xn` is rewritten at the SAME address
     *  every layer (identity plus offset cannot tell layer N from layer
     *  N+1), and the cache is shared by every model in the process
     *  (a per-instance sequence let same-shaped models alias each
     *  other's entries — 25.3). */
    int64 stageTag;
    boolean batchSaid;
    boolean decSaid;
    /** Refusing projections in the last `batchReady` scan (rides on the
     *  `prefill-mode` record as v1). */
    int32 batchRefusals;
    /** Distinct "<proj> <format>: <reason>" keys already said by
     *  `batch-refused`, for the life of the model. */
    ArrayList<String> refusedKeys;

    /**
     * The layer stack with the PROJECTIONS BATCHED over all rows.
     *
     * Same arithmetic as the per-row path and the same order within a
     * row; what changes is that the row loop moved INSIDE each
     * projection, so the weights are streamed once per 32-row tile
     * instead of once per row. Attention stays per row for now — it is
     * O(n^2) and the next unit — but it is no longer competing with 2.4
     * TB of redundant weight traffic.
     */
    void forwardRowsBatched(int32 seq, Tensor<float32> hs,
            Tensor<float32> xn, Tensor<float32> q, Tensor<float32> k,
            Tensor<float32> v, Tensor<float32> ao, Tensor<float32> proj,
            Tensor<float32> gate, Tensor<float32> up,
            Tensor<float32> mlpOut, int32 rows, int32 startPos,
            int32 h, int32 qd, int32 kvd, int32 inter,
            int32 nH, int32 nKv, int32 hd, Tensor<float32> scores) {
        // RESIDENT HIDDEN STATE (10.12.7.b): hs lives on the device for
        // the whole layer stack — norms, residual adds and the MLP chain
        // never read it on the host. It crosses the bus exactly twice: up
        // here, down after the last layer. q/k/v still come down each
        // layer because rope/append/attend keep their host seam (.c).
        boolean res = Linear.devicePackOn();
        int64 nHs = (int64) rows * (int64) h;
        if (res) {
            int64 th0 = Clock.nanoTime();
            this.ensurePrefillRes(nHs);
            float32[] hb = hs.hostBuffer();
            int64 hb0 = hs.hostBase();
            int64 c = 0;
            while (c < nHs) {
                this.pfHsHost[c] = hb[hb0 + c];
                c = c + 1;
            }
            this.pfHsDev.upload(this.pfHsHost, nHs);
            CausalLM.pfHeadNs = CausalLM.pfHeadNs
                + (Clock.nanoTime() - th0);
        }
        // Layer-invariant (10.12.24's extraneous-call audit): the
        // per-row positions were re-filled and re-uploaded once PER
        // LAYER — 32 identical 2 KB uploads per prefill.
        DeviceKv dkv = this.dkvOf(seq);
        boolean resAttn = res && dkv != null;
        if (resAttn) {
            this.ensurePrefillPos(rows, startPos);
            // 10.12.38 lazy authority: a mid-sequence chunk appends host
            // cache rows at exactly `startPos`, so any debt a lazy first
            // chunk left must be paid before the layer loop's inline
            // appends. A no-op when nothing is owed.
            if (startPos != 0) { this.syncKvToHost(seq); }
        }
        int32 l = 0;
        while (l < this.model.numLayers) {
            DecoderLayer d = this.model.layerArr[l];
            Attention a = d.selfAttn;

            // ── attention sublayer ──────────────────────────────────────
            if (res) {
                int64 tm0 = CausalLM.pfMark();
                Prim.rmsnormBatchDevice(this.pfXnDev, this.pfHsDev,
                    d.inputLayernorm.deviceWeight(), (int64) rows,
                    (int64) h, d.inputLayernorm.eps, d.normForm);
                int64 tm1 = CausalLM.pfMark();
                CausalLM.pfPrimNs = CausalLM.pfPrimNs + (tm1 - tm0);
                this.stageTag = Linear.nextStageTag();
                Linear.stageBatchFromDevice(this.pfXnDev, rows, h,
                    this.stageTag);
                CausalLM.pfStageNs = CausalLM.pfStageNs
                    + (CausalLM.pfMark() - tm1);
            } else {
                int64 tp0 = Clock.nanoTime();
                int32 r0 = 0;
                while (r0 < rows) {
                    Prim.rmsnormRowHost(hs, (int64) r0 * (int64) h,
                        d.inputLayernorm.weight, d.inputLayernorm.eps,
                        xn, (int64) r0 * (int64) h, h, d.normForm);
                    r0 = r0 + 1;
                }
                CausalLM.pfPrimNs = CausalLM.pfPrimNs
                    + (Clock.nanoTime() - tp0);
                this.stageTag = Linear.nextStageTag();
                Linear.stageBatch(xn, 0L, rows, h, this.stageTag);
            }
            int32 r = 0;
            // 10.12.7.c: with the device attend available, q/k/v never
            // exist on the host at all — roped on the device, appended
            // to the planes there, attended there, and the o input
            // packed straight from the attend's output. The paged cache
            // stays authoritative through ONE k/v download per layer
            // into appendRowRaw, replacing per-row host rope + append.
            if (resAttn) {
                // 10.12.32: one fused q|k|v launch when the route
                // applies; the scatter leaves rope/append untouched.
                int64 tg0 = CausalLM.pfMark();
                if (!a.qProj.fusedQkvBatchKeep(a.kProj, a.vProj,
                        rows)) {
                    a.qProj.matmulBatchKeep(rows);
                    a.kProj.matmulBatchKeep(rows);
                    a.vProj.matmulBatchKeep(rows);
                }
                int64 tr0 = CausalLM.pfMark();
                CausalLM.pfGemmNs = CausalLM.pfGemmNs + (tr0 - tg0);
                CausalLM.pfGQkvNs = CausalLM.pfGQkvNs + (tr0 - tg0);
                if (a.qNorm != null) {
                    // QK-norm BEFORE RoPE (spec 5.10), per head: the
                    // [rows x nH x hd] tensor is rows*nH contiguous
                    // hd-rows sharing one [hd] weight — exactly
                    // rmsnormRowsF32's shape, and in place is safe
                    // because each workgroup reads and writes only its
                    // own row.
                    Prim.rmsnormBatchDevice(a.qProj.yBatch,
                        a.qProj.yBatch, a.qNorm.deviceWeight(),
                        (int64) rows * (int64) nH, (int64) hd,
                        a.qNorm.eps, d.normForm);
                    Prim.rmsnormBatchDevice(a.kProj.yBatch,
                        a.kProj.yBatch, a.kNorm.deviceWeight(),
                        (int64) rows * (int64) nKv, (int64) hd,
                        a.kNorm.eps, d.normForm);
                    int64 tqn = CausalLM.pfMark();
                    CausalLM.pfPrimNs = CausalLM.pfPrimNs + (tqn - tr0);
                    tr0 = tqn;
                }
                Prim.ropeBatchDevice(a.qProj.yBatch, a.deviceRopeInv(),
                    this.pfPosDev, (int64) rows, nH, hd);
                Prim.ropeBatchDevice(a.kProj.yBatch, a.deviceRopeInv(),
                    this.pfPosDev, (int64) rows, nKv, hd);
                int64 ta0 = CausalLM.pfMark();
                CausalLM.pfRopeNs = CausalLM.pfRopeNs
                    + (ta0 - tr0);
                KernelBuffer<float32> aoDev = dkv
                    .prefillAttendResident(l, a.qProj.yBatch,
                        a.kProj.yBatch, a.vProj.yBatch, rows, startPos,
                        a.scale);
                // Cache authority (10.12.30): at startPos == 0 the k/v
                // download + paged append are DEFERRED to one pass
                // after the layer loop, reading the persistent planes
                // — the loop stays launch-only and the GPU never waits
                // for the host between layers. Mid-sequence prefill
                // keeps the in-loop path (the planes hold absolute
                // positions; a prefix download cannot reach them).
                if (startPos != 0) {
                    KernelStream as = QuantKernel.stream();
                    as.sync();
                    int64 kvn = (int64) rows * (int64) kvd;
                    this.ensurePrefillKv(kvn);
                    a.kProj.yBatch.download(this.pfKScr, kvn);
                    a.vProj.yBatch.download(this.pfVScr, kvn);
                    r = 0;
                    while (r < rows) {
                        if (!this.cache.appendRowRaw(seq, l, this.pfKScr,
                                (int64) r * (int64) kvd, this.pfVScr,
                                (int64) r * (int64) kvd, startPos + r)) {
                            throw heap LlmException("kv pool exhausted"
                                + " at layer " + l + " position "
                                + (startPos + r));
                        }
                        r = r + 1;
                    }
                }
                int64 taEnd = CausalLM.pfMark();
                CausalLM.pfAttendNs = CausalLM.pfAttendNs
                    + (taEnd - ta0);
                this.stageTag = Linear.nextStageTag();
                Linear.stageBatchFromDevice(aoDev, rows, qd,
                    this.stageTag);
                CausalLM.pfStageNs = CausalLM.pfStageNs
                    + (CausalLM.pfMark() - taEnd);
            } else {
            a.qProj.matmulInto(rows, q, 0L);
            a.kProj.matmulInto(rows, k, 0L);
            a.vProj.matmulInto(rows, v, 0L);
            if (a.qNorm != null) {
                // QK-norm BEFORE RoPE (spec 5.10), per head per row —
                // the host twin of the resident arm's device norms.
                r = 0;
                while (r < rows) {
                    int64 rqn = (int64) r * (int64) qd;
                    int64 rkn = (int64) r * (int64) kvd;
                    int32 hh = 0;
                    while (hh < nH) {
                        Prim.rmsnormRowHost(q, rqn + (int64) (hh * hd),
                            a.qNorm.weight, a.qNorm.eps,
                            q, rqn + (int64) (hh * hd), hd, d.normForm);
                        hh = hh + 1;
                    }
                    hh = 0;
                    while (hh < nKv) {
                        Prim.rmsnormRowHost(k, rkn + (int64) (hh * hd),
                            a.kNorm.weight, a.kNorm.eps,
                            k, rkn + (int64) (hh * hd), hd, d.normForm);
                        hh = hh + 1;
                    }
                    r = r + 1;
                }
            }

            // RoPE and the cache append stay on the host: they are O(n)
            // and they are what keeps the paged cache authoritative for
            // everything outside this pass. The ATTEND is O(n^2) and is
            // 16.5 s of a 23.6 s prefill at 512 tokens, so it goes to the
            // device for every row at once (10.12.2).
            if (dkv != null) {
                // Device attend: RoPE and the append for every row first,
                // then ONE attend for all of them. Safe here only because
                // the kernel takes `startPos` and derives each row's
                // causal range from it.
                int64 tr0 = Clock.nanoTime();
                r = 0;
                while (r < rows) {
                    int64 rkv = (int64) r * (int64) kvd;
                    int32 p = startPos + r;
                    Prim.ropeRowHost(q, (int64) r * (int64) qd, nH, hd, p,
                        a.ropeInv);
                    Prim.ropeRowHost(k, rkv, nKv, hd, p, a.ropeInv);
                    if (!this.cache.appendRow(seq, l, k, rkv, v, rkv, p)) {
                        throw heap LlmException("kv pool exhausted at "
                            + "layer " + l + " position " + p);
                    }
                    r = r + 1;
                }
                int64 ta0 = Clock.nanoTime();
                CausalLM.pfRopeNs = CausalLM.pfRopeNs
                    + (ta0 - tr0);
                dkv.prefillAttend(l, q, k, v, ao, rows, startPos,
                    a.scale);
                CausalLM.pfAttendNs = CausalLM.pfAttendNs
                    + (Clock.nanoTime() - ta0);
            } else {
                // INTERLEAVED, and it must be. `attendRow` takes the query
                // position from `lenSL - 1`, so appending every row before
                // attending makes every row attend as the LAST one — a
                // causality break that still decodes, just wrongly. It
                // decoded 1882 1889 1882 1889 rather than 198 14196.
                r = 0;
                while (r < rows) {
                    int64 rq = (int64) r * (int64) qd;
                    int64 rkv = (int64) r * (int64) kvd;
                    int32 p = startPos + r;
                    Prim.ropeRowHost(q, rq, nH, hd, p, a.ropeInv);
                    Prim.ropeRowHost(k, rkv, nKv, hd, p, a.ropeInv);
                    if (!this.cache.appendRow(seq, l, k, rkv, v, rkv, p)) {
                        throw heap LlmException("kv pool exhausted at "
                            + "layer " + l + " position " + p);
                    }
                    this.cache.attendRow(seq, l, q, rq, a.scale, scores,
                        ao, rq, nH, nKv, hd);
                    r = r + 1;
                }
            }

            this.stageTag = Linear.nextStageTag();
            Linear.stageBatch(ao, 0L, rows, qd, this.stageTag);
            }
            if (res) {
                // o_proj's output joins the resident hs; the second
                // norm reads it there.
                int64 tg1 = CausalLM.pfMark();
                a.oProj.matmulBatchKeep(rows);
                int64 tn2 = CausalLM.pfMark();
                CausalLM.pfGemmNs = CausalLM.pfGemmNs + (tn2 - tg1);
                CausalLM.pfGONs = CausalLM.pfGONs + (tn2 - tg1);
                Prim.addDevice(this.pfHsDev, a.oProj.yBatch, nHs);
                this.sniff("attn", l, nHs);
                Prim.rmsnormBatchDevice(this.pfXnDev, this.pfHsDev,
                    d.postAttentionLayernorm.deviceWeight(),
                    (int64) rows, (int64) h,
                    d.postAttentionLayernorm.eps, d.normForm);
                int64 ts2 = CausalLM.pfMark();
                CausalLM.pfPrimNs = CausalLM.pfPrimNs + (ts2 - tn2);
                this.stageTag = Linear.nextStageTag();
                Linear.stageBatchFromDevice(this.pfXnDev, rows, h,
                    this.stageTag);
                CausalLM.pfStageNs = CausalLM.pfStageNs
                    + (CausalLM.pfMark() - ts2);
            } else {
                a.oProj.matmulInto(rows, proj, 0L);
                int64 tp1 = Clock.nanoTime();
                r = 0;
                while (r < rows) {
                    HostOps.addRow(hs, (int64) r * (int64) h, proj,
                        (int64) r * (int64) h, h);
                    r = r + 1;
                }

                // ── MLP sublayer ────────────────────────────────────────
                r = 0;
                while (r < rows) {
                    Prim.rmsnormRowHost(hs, (int64) r * (int64) h,
                        d.postAttentionLayernorm.weight,
                        d.postAttentionLayernorm.eps, xn,
                        (int64) r * (int64) h, h, d.normForm);
                    r = r + 1;
                }
                CausalLM.pfPrimNs = CausalLM.pfPrimNs
                    + (Clock.nanoTime() - tp1);
                this.stageTag = Linear.nextStageTag();
                Linear.stageBatch(xn, 0L, rows, h, this.stageTag);
            }
            if (d.moe != null) {
                // MoE FFN: unit 28's GROUPED dispatch — route every
                // row, serve each selected expert once per batch. The
                // dispatch is host-anchored by design (the banks read
                // expert strides through the page cache and fork device
                // vs host PER GROUP), so under the resident hidden
                // state the activations cross to the host here and the
                // expert sum crosses back — 15.19's priced seam, not a
                // leak in it.
                int64 tmoe = Clock.nanoTime();
                // Unit 41b: the whole MoE FFN runs off pfXnDev with
                // its output staying resident — no crossing at all.
                // The host path below is the fallback (capped regime,
                // pinned routing, shared expert).
                if (res && d.moe.forwardBatchRes(this.pfXnDev, rows,
                        d.activation)) {
                    Prim.addDevice(this.pfHsDev, d.moe.batchObDev(),
                        nHs);
                    CausalLM.pfPrimNs = CausalLM.pfPrimNs
                        + (Clock.nanoTime() - tmoe);
                    l = l + 1;
                    continue;
                }
                if (res) {
                    KernelStream ms = QuantKernel.stream();
                    ms.sync();
                    this.pfXnDev.download(this.pfHsHost, nHs);
                    float32[] xb = xn.hostBuffer();
                    int64 xb0 = xn.hostBase();
                    int64 cm = 0;
                    while (cm < nHs) {
                        xb[xb0 + cm] = this.pfHsHost[cm];
                        cm = cm + 1;
                    }
                }
                d.moe.forwardBatch(xn, mlpOut, rows, d.activation);
                if (res) {
                    float32[] mb = mlpOut.hostBuffer();
                    int64 mb0 = mlpOut.hostBase();
                    int64 cm2 = 0;
                    while (cm2 < nHs) {
                        this.pfHsHost[cm2] = mb[mb0 + cm2];
                        cm2 = cm2 + 1;
                    }
                    this.ensurePrefillMoe(nHs);
                    this.pfMoeDev.upload(this.pfHsHost, nHs);
                    Prim.addDevice(this.pfHsDev, this.pfMoeDev, nHs);
                }
                this.sniff("moe", l, nHs);
                CausalLM.pfPrimNs = CausalLM.pfPrimNs
                    + (Clock.nanoTime() - tmoe);
            } else if (Linear.devicePackOn()) {
                // RESIDENT MLP CHAIN (10.12.7.a): gate and up never
                // leave the device — the GLU runs in place on gate's
                // yBatch and the down projection packs straight from
                // it. 10.12.22 measured gate/up as two thirds of the
                // downloaded bytes and the GLU as the largest host
                // prim; all of it disappears here. Stream-ordered
                // throughout: keep -> keep -> glu -> pack -> down all
                // launch on the current stream, and down's launch
                // syncs.
                // 10.12.32: one fused gate|up launch; the fused GLU
                // reads the concatenated rows in place and writes the
                // compact [rows x inter] result, so the split copy a
                // separate gate/up would need never exists.
                int64 tg2 = CausalLM.pfMark();
                if (d.mlp.gateProj.fusedPairBatchKeep(d.mlp.upProj,
                        rows)) {
                    d.mlp.gateProj.ensureBatchOut(rows);
                    int64 tu0 = CausalLM.pfMark();
                    CausalLM.pfGemmNs = CausalLM.pfGemmNs + (tu0 - tg2);
                    CausalLM.pfGMlpNs = CausalLM.pfGMlpNs + (tu0 - tg2);
                    Prim.gluFusedDevice(d.mlp.gateProj.yBatch,
                        d.mlp.gateProj.fusedYBatch, (int64) rows,
                        (int64) inter, d.activation);
                    int64 tu1 = CausalLM.pfMark();
                    CausalLM.pfPrimNs = CausalLM.pfPrimNs + (tu1 - tu0);
                } else {
                    d.mlp.gateProj.matmulBatchKeep(rows);
                    d.mlp.upProj.matmulBatchKeep(rows);
                    int64 tu0 = CausalLM.pfMark();
                    CausalLM.pfGemmNs = CausalLM.pfGemmNs + (tu0 - tg2);
                    CausalLM.pfGMlpNs = CausalLM.pfGMlpNs + (tu0 - tg2);
                    Prim.gluDevice(d.mlp.gateProj.yBatch,
                        d.mlp.upProj.yBatch,
                        (int64) rows * (int64) inter, d.activation);
                    int64 tu1 = CausalLM.pfMark();
                    CausalLM.pfPrimNs = CausalLM.pfPrimNs + (tu1 - tu0);
                }
                int64 ts3 = CausalLM.pfMark();
                this.stageTag = Linear.nextStageTag();
                Linear.stageBatchFromDevice(d.mlp.gateProj.yBatch,
                    rows, inter, this.stageTag);
                int64 ts4 = CausalLM.pfMark();
                CausalLM.pfStageNs = CausalLM.pfStageNs + (ts4 - ts3);
                // With hs resident (.b) the down projection joins it on
                // the device; devicePackOn == res here, so both arms of
                // the residual agree on where hs lives.
                d.mlp.downProj.matmulBatchKeep(rows);
                int64 ta2 = CausalLM.pfMark();
                CausalLM.pfGemmNs = CausalLM.pfGemmNs + (ta2 - ts4);
                CausalLM.pfGDownNs = CausalLM.pfGDownNs + (ta2 - ts4);

                Prim.addDevice(this.pfHsDev, d.mlp.downProj.yBatch,
                    nHs);
                CausalLM.pfPrimNs = CausalLM.pfPrimNs
                    + (CausalLM.pfMark() - ta2);
            } else {
                d.mlp.gateProj.matmulInto(rows, gate, 0L);
                d.mlp.upProj.matmulInto(rows, up, 0L);
                int64 tp2 = Clock.nanoTime();
                r = 0;
                while (r < rows) {
                    int64 ri = (int64) r * (int64) inter;
                    Prim.gluRowHost(gate, ri, up, ri, gate, ri, inter,
                        d.activation);
                    r = r + 1;
                }
                CausalLM.pfPrimNs = CausalLM.pfPrimNs
                    + (Clock.nanoTime() - tp2);
                this.stageTag = Linear.nextStageTag();
                Linear.stageBatch(gate, 0L, rows, inter, this.stageTag);
                d.mlp.downProj.matmulInto(rows, mlpOut, 0L);
            }
            if (!res) {
                int64 tp3 = Clock.nanoTime();
                r = 0;
                while (r < rows) {
                    HostOps.addRow(hs, (int64) r * (int64) h, mlpOut,
                        (int64) r * (int64) h, h);
                    r = r + 1;
                }
                CausalLM.pfPrimNs = CausalLM.pfPrimNs
                    + (Clock.nanoTime() - tp3);
            }
            l = l + 1;
        }
        if (res) {
            // Only the LAST row of hs comes home (10.12.35): the sole
            // consumer after this loop is the final rmsnorm + logits
            // over row rows-1, and hs is an arena slice that dies with
            // the call — nothing reads the other rows. 16 KB down
            // instead of 8 MB + a 2M-element host copy loop.
            int64 tt0 = Clock.nanoTime();
            this.ensurePrefillLast((int64) h);
            Prim.sliceF32Device(this.pfLastDev, this.pfHsDev,
                (int64) h, (int64) (rows - 1) * (int64) h);
            KernelStream ps = QuantKernel.stream();
            ps.sync();
            this.pfLastDev.download(this.pfHsHost, (int64) h);
            float32[] hb2 = hs.hostBuffer();
            int64 hb02 = hs.hostBase()
                + (int64) (rows - 1) * (int64) h;
            int64 c2 = 0;
            while (c2 < (int64) h) {
                hb2[hb02 + c2] = this.pfHsHost[c2];
                c2 = c2 + 1;
            }
            CausalLM.pfTailHsNs = CausalLM.pfTailHsNs
                + (Clock.nanoTime() - tt0);
        }

        if (resAttn && startPos == 0
                && (CausalLM.eagerAuthOn
                    || CausalLM.forceReseed)) {
            // The deferred cache-authority pass (10.12.30): ONE sync,
            // then every layer's roped k/v out of the persistent
            // planes into the paged cache. Position dr IS the row
            // index here — that is what the startPos == 0 guard buys.
            // 10.12.38 made it LAZY by default (adoptLazy below +
            // on-demand writeback); this eager form remains for the
            // `eagerauth` arm and for `reseed`, which seeds decode
            // from the host cache and therefore needs it filled.
            int64 tda = Clock.nanoTime();
            KernelStream ks = QuantKernel.stream();
            ks.sync();
            int64 kvnD = (int64) rows * (int64) kvd;
            this.ensurePrefillKv(kvnD);
            int32 dl = 0;
            while (dl < this.model.numLayers) {
                dkv.readPlanes(dl, this.pfKScr, this.pfVScr, kvnD);
                int32 dr = 0;
                while (dr < rows) {
                    if (!this.cache.appendRowRaw(seq, dl, this.pfKScr,
                            (int64) dr * (int64) kvd, this.pfVScr,
                            (int64) dr * (int64) kvd, dr)) {
                        throw heap LlmException("kv pool exhausted at "
                            + "layer " + dl + " position " + dr);
                    }
                    dr = dr + 1;
                }
                dl = dl + 1;
            }
            CausalLM.pfAttendNs = CausalLM.pfAttendNs
                + (Clock.nanoTime() - tda);
        }

        if (dkv != null && !CausalLM.forceReseed) {
            // The planes now hold every prompt position, written by
            // `prefillAttend`, and the paged cache holds them too. Say so,
            // or the first decode token re-seeds 134 MB it already has.
            //
            // `forceReseed` is the CONTROL for that claim: it skips the
            // adopt so decode seeds from the paged cache instead. If a
            // run agrees with the host only under `reseed`, the planes
            // prefill wrote are wrong; if it disagrees either way, they
            // are fine and the difference is the softmax reassociation
            // moving a near-tied argmax.
            if (startPos == 0 && !CausalLM.eagerAuthOn) {
                // Lazy authority (10.12.38): the planes hold the rows;
                // the host cache stays behind until a host path asks.
                dkv.adoptLazy(seq, startPos + rows,
                    this.cache.lengthOf(seq, 0));
            } else {
                dkv.adopt(seq, startPos + rows);
            }
        }

        int64 tl0 = Clock.nanoTime();
        int64 lastH = (int64) (rows - 1) * (int64) h;
        Prim.rmsnormRowHost(hs, lastH, this.model.norm.weight,
            this.model.norm.eps, xn, lastH, h, this.cfg.normForm);
        if (this.lmHead != null) {
            this.lmHead.matvecInto(xn, lastH, this.pool.logits, 0);
        } else {
            HostOps.rowsDotRow(this.model.embedTokens.weight, xn, lastH,
                this.pool.logits, this.cfg.vocabSize, h);
        }
        CausalLM.pfLogitsNs = CausalLM.pfLogitsNs
            + (Clock.nanoTime() - tl0);
        return;
    }

    /**
     * Allocate the device K/V planes on first use and make them agree
     * with the paged cache (plan 10.11.2).
     *
     * A configuration the flat planes cannot serve — a windowed layer, a
     * head wider than the combine kernel's workgroup — leaves `dkv` null,
     * and `residentLayer` then runs its host attention tail. Falling back
     * is checked rather than assumed: both of those produce a silently
     * wrong answer, not a crash.
     */
    void ensureDeviceKv(int32 seq) {
        if (!CausalLM.devAttnOn || !DeviceKv.supports(this.cfg)
                || !this.residentRouted()) {
            this.syncKvToHost(seq);
            return;
        }
        DeviceKv d = this.ensureDkvSlot(seq);
        if (d == null) {
            // No slot for this sequence — the host cache stays the only
            // authority, so it must be current.
            this.syncKvToHost(seq);
            return;
        }
        if (!d.isCurrentFor(this.cache, seq)) {
            d.seed(this.cache, seq);
        }
        return;
    }

    void ensureResidentBuffers(int32 h) {
        if (this.hsDev != null) { return; }
        this.hsHost #= heap float32[(int64) h];
        this.hsDev #= heap KernelBuffer<float32>((uint64) h);
        this.xnDev #= heap KernelBuffer<float32>((uint64) h);
        // Unit 38: the MoE host-crossing's up-leg (h floats). Its own
        // buffer, not xnDev — the expert sum must not clobber the
        // normed activation mid-flight on the stream.
        this.moeDev #= heap KernelBuffer<float32>((uint64) h);
        return;
    }

    /**
     * One decoder layer with the residual stream LEFT ON THE DEVICE.
     *
     * `hs` never crosses the bus inside the stack: the two norms, the
     * SwiGLU and both residual adds all run on the device, and the
     * activation is quantized there. What still crosses is attention —
     * q, k and v come back so RoPE, the KV cache and the attend can run on
     * the host, and the attention output goes up again. Four crossings a
     * layer where the host-driven path has eleven.
     */
    void residentLayer(int32 seq, int32 li, DecoderLayer d, Attention a,
            Tensor<float32> xn, Tensor<float32> mlpOut,
            Tensor<float32> q, Tensor<float32> k, Tensor<float32> v,
            Tensor<float32> ao, Tensor<float32> scores,
            int32 h, int32 qd, int32 kvd, int32 inter,
            int32 nH, int32 nKv, int32 hd, int32 p) {
        // Attention sublayer.
        int64 tra0 = Clock.nanoTime();
        boolean oAdded = false;
        // Unit 48: norm + pack in one launch where the width allows.
        // Unit 59b: or already done by the previous layer's down tail.
        if (this.preNormedNext) {
            this.preNormedNext = false;
            Linear.stageDeviceActivationPreNormed(this.xnDev, (int64) h);
        } else if (!Linear.stageDeviceActivationNormed(this.xnDev, this.hsDev,
                d.inputLayernorm.deviceWeight(), (int64) h,
                d.inputLayernorm.eps, d.normForm)) {
            Prim.rmsnormDevice(this.xnDev, this.hsDev,
                d.inputLayernorm.deviceWeight(), (int64) h,
                d.inputLayernorm.eps, d.normForm);
            Linear.stageDeviceActivation(this.xnDev, (int64) h);
        }
        CausalLM.aSync();
        int64 ta1 = Clock.nanoTime();
        CausalLM.raNormNs = CausalLM.raNormNs + (ta1 - tra0);
        DeviceKv dkv = this.dkvOf(seq);
        if (dkv != null) {
            // THE ATTENTION TAIL NEVER LEAVES THE DEVICE (plan 10.11).
            // q, k and v stay in the projections' own output buffers;
            // RoPE rotates them there, the append writes the K/V planes
            // there, the attend reads them there, and o_proj quantizes
            // the result there. Nothing in this branch crosses the bus.
            //
            // Ordering is the stream's, not a sync's: append writes the
            // planes the attend reads and rope rewrites the q the attend
            // reads, and all of them are NoSync launches on one stream.
            // Unit 49: q|k|v in one launch where the routes allow.
            if (!a.qProj.matvecQkvStagedKeep(a.kProj, a.vProj)) {
                a.qProj.matvecStagedKeep();
                a.kProj.matvecStagedKeep();
                a.vProj.matvecStagedKeep();
            }

            CausalLM.aSync();
            int64 ta2 = Clock.nanoTime();
            CausalLM.raProjNs = CausalLM.raProjNs + (ta2 - ta1);
            // Unit 48: QK-norm (spec 5.10, BEFORE RoPE), RoPE and the
            // append in one launch; the separate verbs stay as the
            // fallback for head dims a block cannot own.
            KernelBuffer<float32> qnw = null;
            KernelBuffer<float32> knw = null;
            float32 qnEps = 0.0f;
            if (a.qNorm != null) {
                qnw = a.qNorm.deviceWeight();
                knw = a.kNorm.deviceWeight();
                qnEps = a.qNorm.eps;
            }
            if (!dkv.prep(li, a.qProj.out(), a.kProj.out(), a.vProj.out(),
                    qnw, knw, qnEps, d.normForm, p)) {
                if (a.qNorm != null) {
                    Prim.qkNormDevice(a.qProj.out(), a.kProj.out(),
                        a.qNorm.deviceWeight(), a.kNorm.deviceWeight(),
                        (int64) nH, (int64) nKv, (int64) hd, a.qNorm.eps,
                        d.normForm);
                }
                dkv.rope(li, a.qProj.out(), a.kProj.out(), p);
                dkv.append(li, a.kProj.out(), a.vProj.out(), p);
            }
            CausalLM.aSync();
            int64 ta3 = Clock.nanoTime();
            CausalLM.raRopeNs = CausalLM.raRopeNs + (ta3 - ta2);
            // Unit 50: the flash decode leaves split partials and the
            // o-projection's pack reduces them — one launch fewer, no
            // f32 attention output; the full attend + pack is the
            // fallback shape.
            boolean partials = dkv.attendPartials(li, a.qProj.out(), p,
                a.scale);
            if (!partials) {
                dkv.attend(li, a.qProj.out(), p, a.scale);
            }
            CausalLM.aSync();
            int64 ta4 = Clock.nanoTime();
            CausalLM.raAttnNs = CausalLM.raAttnNs + (ta4 - ta3);
            if (partials) {
                Linear.stageDeviceActivationFromAttnPartials(nH, (int64) qd);
            } else {
                Linear.stageDeviceActivation(dkv.out(), (int64) qd);
            }

            // Unit 48: the residual add rides the o-projection's store.
            if (a.oProj.matvecStagedAccum(this.hsDev)) {
                oAdded = true;
            } else {
                a.oProj.matvecStagedKeep();
            }
            CausalLM.raOutNs = CausalLM.raOutNs
                + (Clock.nanoTime() - ta4);
        } else {
            a.qProj.matvecStaged(q, 0L);
            a.kProj.matvecStaged(k, 0L);
            a.vProj.matvecStaged(v, 0L);
            if (a.qNorm != null) {
                // Host attend fallback: q/k are already down, so the
                // per-head norms run where the per-row path runs them.
                int32 hh = 0;
                while (hh < nH) {
                    Prim.rmsnormRowHost(q, (int64) (hh * hd),
                        a.qNorm.weight, a.qNorm.eps,
                        q, (int64) (hh * hd), hd, d.normForm);
                    hh = hh + 1;
                }
                hh = 0;
                while (hh < nKv) {
                    Prim.rmsnormRowHost(k, (int64) (hh * hd),
                        a.kNorm.weight, a.kNorm.eps,
                        k, (int64) (hh * hd), hd, d.normForm);
                    hh = hh + 1;
                }
            }
            Prim.ropeRowHost(q, 0L, nH, hd, p, a.ropeInv);
            Prim.ropeRowHost(k, 0L, nKv, hd, p, a.ropeInv);
            if (!this.cache.appendRow(seq, li, k, 0L, v, 0L, p)) {
                throw heap LlmException("kv pool exhausted at layer "
                    + li + " position " + p);
            }
            this.cache.attendRow(seq, li, q, 0L, a.scale, scores,
                ao, 0L, nH, nKv, hd);
            a.oProj.matvecKeepOnDevice(ao, 0L);
        }
        if (!oAdded) {
            Prim.addDevice(this.hsDev, a.oProj.out(), (int64) h);
        }
        this.sniffRow("attn", li, h);
        if (CausalLM.phaseSyncOn) {
            KernelStream ps = QuantKernel.stream();
            ps.sync();
        }
        int64 trm0 = Clock.nanoTime();
        CausalLM.rlAttnNs = CausalLM.rlAttnNs + (trm0 - tra0);

        // MLP sublayer.
        // Unit 48: for the zero-sync MoE route the norm packs its
        // output straight into the route's activation stage.
        boolean normPacked = false;
        boolean routed = false;
        if (d.moe != null) {
            // Unit 59: norm + pack + router + top-k in one launch.
            routed = d.moe.normRouteZeroSync(this.xnDev, this.hsDev,
                d.postAttentionLayernorm.deviceWeight(),
                d.postAttentionLayernorm.eps, d.normForm);
            normPacked = routed;
        }
        if (d.moe != null && !normPacked) {
            KernelBuffer<int8> zx = d.moe.zeroSyncPackedXn((int64) h);
            if (zx != null) {
                normPacked = Prim.rmsnormPackDevice(this.xnDev, zx,
                    this.hsDev, d.postAttentionLayernorm.deviceWeight(),
                    (int64) h, d.postAttentionLayernorm.eps, d.normForm);
            }
        }
        if (!normPacked) {
            Prim.rmsnormDevice(this.xnDev, this.hsDev,
                d.postAttentionLayernorm.deviceWeight(), (int64) h,
                d.postAttentionLayernorm.eps, d.normForm);
        }
        if (d.moe != null) {
            // MoE FFN via the HOST CROSSING (unit 38; unit 39 keeps
            // the chain on the device): the normed activation comes
            // down, the expert forward runs exactly as the host path
            // runs it — resident slots or windowed, spec 3.3.2 — and
            // the expert sum goes back up onto the residual stream.
            // The unit-29 prefill seam, per decode row. The sync is
            // the layer's only one, and it is what unit 39 removes.
            // Unit 40: the zero-sync route first — routing, selection,
            // the indirected bank dispatches and the combine all ride
            // the stream, so the layer needs NO sync and NO download.
            // 41e: the zero-sync combine accumulates straight onto
            // the residual stream — hsDev is the accumulator.
            // Unit 59b: arm the down-combine tail with the NEXT layer's
            // input norm, so its norm + pack launch is gone.
            if (li + 1 < this.model.numLayers) {
                DecoderLayer dn = this.model.layerArr[li + 1];
                d.moe.armDownNormTail(this.xnDev, Linear.stagedPacked((int64) h),
                    dn.inputLayernorm.deviceWeight(), dn.inputLayernorm.eps,
                    dn.normForm);
            }
            if (d.moe.forwardRowZeroSync(this.xnDev, this.hsDev,
                    d.activation, normPacked, routed)) {
                this.preNormedNext = d.moe.downTailRan();
                if (CausalLM.phaseSyncOn) {
                    KernelStream ps2 = QuantKernel.stream();
                    ps2.sync();
                }
                CausalLM.rlMoeNs = CausalLM.rlMoeNs
                    + (Clock.nanoTime() - trm0);
                return;
            }
            KernelStream ms = QuantKernel.stream();
            ms.sync();
            this.xnDev.download(this.hsHost, (int64) h);
            float32[] xb = xn.hostBuffer();
            int64 xo = xn.hostBase();
            int64 cm = 0;
            while (cm < (int64) h) {
                xb[xo + cm] = this.hsHost[cm];
                cm = cm + 1;
            }
            // Unit 39: the expert chain as stream launches, nothing
            // crossing per expert; `moeDev` is the accumulator. The
            // whole-host crossing below stays for the shapes the chain
            // declines (a shared expert).
            if (d.moe.forwardRowResident(this.xnDev, xn, 0L,
                    this.moeDev, d.activation)) {
                Prim.addDevice(this.hsDev, this.moeDev, (int64) h);
                this.sniffRow("moe-39", li, h);
                return;
            }
            d.moe.forwardRow(xn, 0L, mlpOut, 0L, d.activation);
            float32[] mb = mlpOut.hostBuffer();
            int64 mo = mlpOut.hostBase();
            cm = 0;
            while (cm < (int64) h) {
                this.hsHost[cm] = mb[mo + cm];
                cm = cm + 1;
            }
            this.moeDev.upload(this.hsHost, (int64) h);
            Prim.addDevice(this.hsDev, this.moeDev, (int64) h);
            return;
        }
        Linear.stageDeviceActivation(this.xnDev, (int64) h);
        d.mlp.gateProj.matvecStagedKeep();
        d.mlp.upProj.matvecStagedKeep();
        Prim.gluDevice(d.mlp.gateProj.out(), d.mlp.upProj.out(),
            (int64) inter, d.activation);
        Linear.stageDeviceActivation(d.mlp.gateProj.out(), (int64) inter);
        d.mlp.downProj.matvecStagedKeep();
        Prim.addDevice(this.hsDev, d.mlp.downProj.out(), (int64) h);
        return;
    }

}
