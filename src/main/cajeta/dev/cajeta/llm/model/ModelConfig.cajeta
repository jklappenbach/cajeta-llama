package dev.cajeta.llm.model;

import cajeta.codec.json.Json;
import dev.cajeta.llm.io.GgufFile;
import cajeta.codec.json.JsonObject;
import cajeta.codec.json.JsonValue;
import cajeta.io.file.File;
import cajeta.lang.Math;
import cajeta.math.Tensor;
import cajeta.lang.String;
import dev.cajeta.llm.LlmException;

/**
 * The decoder-stack configuration, parsed from a Hugging Face
 * `config.json` (plan 6.2.3; spec 4.4, 4.5, 4.7, 4.8). GGUF metadata maps
 * onto the same fields in Unit 16.
 *
 * Two config keys are load-bearing rather than informational (spec 4.7,
 * 4.8): an explicit `head_dim` overrides the `hidden/heads` quotient
 * (Gemma 3 declares 256, which is NOT that quotient; Llama 3.2 declares
 * it too), and `tie_word_embeddings` means the checkpoint carries no
 * `lmHead.weight` — the output projection reuses the embedding matrix.
 */
public final class ModelConfig {
    public String architecture;
    public int32 hiddenSize;
    public int32 intermediateSize;
    public int32 numLayers;
    public int32 numHeads;
    public int32 numKvHeads;
    public int32 headDim;
    public int32 vocabSize;
    public int32 maxPositionEmbeddings;
    public float32 rmsNormEps;
    public float32 ropeTheta;
    public boolean tieWordEmbeddings;

    // ── Unit 7: per-layer attention defaults (spec §5 preamble) ─────────
    // Layers inherit these; uniform models are every layer at the default.

    /** Attention window `w` in tokens; 0 = infinite (HF `sliding_window`). */
    public int32 slidingWindow;
    /** RoPE scaling: 0 none, 1 linear, 2 ntk/dynamic, 3 yarn, 4 llama3
     *  (HF `rope_scaling.rope_type`). */
    /**
     * Per-dimension RoPE frequency factors, `headDim/2` long, or null.
     * This is how llama.cpp ships Llama-3.1's `llama3` rope scaling: the
     * converter precomputes the factors into a `rope_freqs.weight` TENSOR
     * and writes NO `rope.scaling.*` metadata keys at all, so a loader
     * that only reads keys silently runs unscaled RoPE. Applied as
     * llama.cpp does: theta_d /= ropeFreqs[d].
     */
    public float32[] ropeFreqs;

    public int32 ropeScalingType;
    public float32 ropeScalingFactor;
    /** llama3: `low_freq_factor`; yarn: `beta_slow`. */
    public float32 ropeLowFreq;
    /** llama3: `high_freq_factor`; yarn: `beta_fast`. */
    public float32 ropeHighFreq;
    /** llama3/yarn: `original_max_position_embeddings`. */
    public int32 ropeOrigMaxPos;
    /** Query scale; 0 = default `1/sqrt(head_dim)` (spec 5.13). Parsed
     *  from Gemma's `query_pre_attn_scalar` as `1/sqrt(scalar)`. */
    public float32 queryScale;
    /** MLP activation: 0 = SiLU (SwiGLU), 1 = gelu_pytorch_tanh (GeGLU)
     *  (HF `hidden_act` / `hidden_activation`; spec 5.4). */
    public int32 activation;
    /** RMSNorm form: 0 = Llama `·w`, 1 = Gemma zero-centered `·(1+w)`
     *  (spec 5.12). */
    public int32 normForm;
    /** RMSNorm on Q and K before RoPE (spec 5.10). */
    public boolean qkNorm;
    /** Four RMSNorms per block — pre/post around both sublayers
     *  (spec 5.11). */
    public boolean fourNorm;
    /** Per-layer windows from HF `layer_types` ("sliding_attention" /
     *  "full_attention", the Gemma 3 local/global pattern); null = every
     *  layer at `slidingWindow` (spec §5 preamble: layers inherit the
     *  model default). */
    public int32[] layerWindows;
    /** KV-cache block size in tokens (spec 6.3). Engine tuning knob, not
     *  an HF key; the CLI exposes it in Unit 19. */
    public int32 blockTokens;

    // Spec §15: MoE hyperparameters. expertCount 0 = dense. expertFfn 0
    // = no width key in the file — qwen2moe ships none (measured on the
    // witness 2026-08-31), so the slab is the authority at bind.
    public int32 expertCount;
    public int32 expertUsedCount;
    public int32 expertFfn;
    // 15.6: router knobs. Gating uses gguf's enum (1 softmax,
    // 2 sigmoid); normTopk renormalizes the top-k weights by their
    // sum; scale 0 means none. NO witness carries any of the three
    // keys (measured 2026-08-31), so the defaults ARE llama.cpp's
    // per-arch hard-coding.
    public int32 expertGating;
    public boolean expertNormTopk;
    public float32 expertScale;
    public int32 sharedExpertFfn;

    ModelConfig() {
        this.architecture = null;
        this.hiddenSize = 0;
        this.intermediateSize = 0;
        this.numLayers = 0;
        this.numHeads = 0;
        this.numKvHeads = 0;
        this.headDim = 0;
        this.vocabSize = 0;
        this.maxPositionEmbeddings = 0;
        this.rmsNormEps = 0.00001f;
        this.ropeTheta = 10000.0f;
        this.tieWordEmbeddings = false;
        this.slidingWindow = 0;
        this.ropeFreqs = null;
        this.ropeScalingType = 0;
        this.ropeScalingFactor = 1.0f;
        this.ropeLowFreq = 1.0f;
        this.ropeHighFreq = 4.0f;
        this.ropeOrigMaxPos = 0;
        this.queryScale = 0.0f;
        this.activation = 0;
        this.normForm = 0;
        this.qkNorm = false;
        this.expertCount = 0;
        this.expertUsedCount = 0;
        this.expertFfn = 0;
        this.expertGating = 1;
        this.expertNormTopk = false;
        this.expertScale = 0.0f;
        this.sharedExpertFfn = 0;
        this.fourNorm = false;
        this.layerWindows = null;
        this.blockTokens = 16;
    }

    /** The attention window of layer `l`: the per-layer declaration when
     *  present, else the model default. 0 = infinite. */
    public int32 windowForLayer(int32 l) {
        if (this.layerWindows != null) {
            return this.layerWindows[l];
        }
        return this.slidingWindow;
    }

    public int32 qDim() {
        return this.numHeads * this.headDim;
    }

    public int32 kvDim() {
        return this.numKvHeads * this.headDim;
    }

    /**
     * Populate the config from GGUF metadata alone — no `config.json`
     * (spec 9.3, plan 16.2.2). The `llama.*` key family maps one-to-one
     * onto the HF fields `parse` reads; `general.architecture "llama"`
     * is the HF `CausalLM`. Defaults mirror `parse`'s.
     */
    public static #ModelConfig fromGguf(GgufFile f) {
        String arch = f.metaString("general.architecture");
        if (arch == null) {
            throw heap LlmException("gguf config: no "
                + "general.architecture");
        }
        // The hyperparameter keys live under the FILE'S OWN architecture
        // prefix (spec 9.6) — `llama.*`, `qwen2vl.*`. Reading a hard-coded
        // family is what made a second architecture look like a rewrite.
        String kp #= "" + arch + ".";
        String hfArch = null;
        if (arch.equals("llama")) {
            hfArch = "LlamaForCausalLM";
        } else if (arch.equals("qwen2") || arch.equals("qwen2vl")) {
            // EXTERNAL vocabulary: the HF name for both is Qwen2's, and
            // qwen2vl's text stack IS qwen2 (the vision tower is a
            // separate file this loader does not read).
            hfArch = "Qwen2ForCausalLM";
        } else if (arch.equals("qwen2moe")) {
            hfArch = "Qwen2MoeForCausalLM";
        } else if (arch.equals("qwen3")) {
            // Dense Qwen3 (Qwen3-8B and kin): the llama graph plus the
            // per-head q/k norms — llama.cpp's build_qwen3 vs build_llama
            // differ in exactly that pair of build_norm calls.
            hfArch = "Qwen3ForCausalLM";
        } else if (arch.equals("qwen3moe")) {
            hfArch = "Qwen3MoeForCausalLM";
        } else {
            throw heap LlmException("gguf config: general.architecture '"
                + arch + "' is unsupported (supported: llama, qwen2, "
                + "qwen2vl, qwen2moe, qwen3, qwen3moe)");
        }
        ModelConfig c = heap ModelConfig();
        c.architecture #= hfArch;
        c.hiddenSize = (int32) f.metaInt(kp + "embedding_length", -1);
        c.intermediateSize = (int32) f.metaInt(kp + "feed_forward_length",
            -1);
        c.numLayers = (int32) f.metaInt(kp + "block_count", -1);
        c.numHeads = (int32) f.metaInt(kp + "attention.head_count", -1);
        if (c.hiddenSize <= 0 || c.intermediateSize <= 0
                || c.numLayers <= 0 || c.numHeads <= 0) {
            throw heap LlmException("gguf config: missing a required "
                + kp + "* hyperparameter (embedding_length, "
                + "feed_forward_length, block_count, attention.head_count)");
        }
        c.numKvHeads = (int32) f.metaInt(kp + "attention.head_count_kv",
            (int64) c.numHeads);
        // qwen3moe declares its (non-derivable) head dim as
        // attention.key_length and ships NO rope.dimension_count —
        // 2048/32 heads would derive 64 where the real dim is 128.
        int64 hdDefault = f.metaInt(kp + "rope.dimension_count",
            (int64) (c.hiddenSize / c.numHeads));
        c.headDim = (int32) f.metaInt(kp + "attention.key_length",
            hdDefault);
        c.vocabSize = (int32) f.metaInt(kp + "vocab_size", -1);
        if (c.vocabSize <= 0) {
            c.vocabSize = f.tokCount;
        }
        if (c.vocabSize <= 0) {
            throw heap LlmException("gguf config: no " + kp
                + "vocab_size "
                + "and no embedded tokenizer to count");
        }
        c.maxPositionEmbeddings = (int32) f.metaInt(kp + "context_length",
            2048L);
        c.rmsNormEps = (float32) f.metaFloat(
            kp + "attention.layer_norm_rms_epsilon", 0.00001);
        c.ropeTheta = (float32) f.metaFloat(kp + "rope.freq_base", 10000.0);
        // qwen3 and qwen3moe apply per-head q/k RMS norms
        // unconditionally; the file carries the tensors, not a flag
        // (measured: blk.N.attn_q_norm.weight [head_dim] on the
        // Qwen3-Coder witness).
        if (arch.equals("qwen3") || arch.equals("qwen3moe")) {
            c.qkNorm = true;
        }
        // Spec §15: MoE is indicated ONLY by expert_count — Mixtral's
        // arch string is plain `llama` (measured 2026-08-31), so keying
        // on the arch would accept it as dense and then fail binding
        // FFN tensors that do not exist.
        c.expertCount = (int32) f.metaInt(kp + "expert_count", 0L);
        if (c.expertCount > 0) {
            c.expertUsedCount = (int32) f.metaInt(
                kp + "expert_used_count", 0L);
            if (c.expertUsedCount <= 0
                    || c.expertUsedCount > c.expertCount) {
                // 15.4: actionable — name the architecture AND the gap.
                throw heap LlmException("moe: architecture '" + arch
                    + "' declares " + c.expertCount + " experts but "
                    + kp + "expert_used_count is "
                    + c.expertUsedCount
                    + " — this file cannot be routed");
            }
            c.expertFfn = (int32) f.metaInt(
                kp + "expert_feed_forward_length", 0L);
            c.sharedExpertFfn = (int32) f.metaInt(
                kp + "expert_shared_feed_forward_length", 0L);
            // Gating knobs, read when present (15.6). llama.cpp
            // hard-codes these per arch and READS NONE OF THEM for
            // qwen2moe/qwen3moe/llama (measured in build_moe_ffn's
            // call sites, 2026-08-31): softmax everywhere; top-k
            // renorm everywhere EXCEPT qwen2moe; no scale. The
            // witnesses omit all three keys, so honoring a present
            // key and defaulting per arch are the same behavior on
            // every file that exists.
            int64 normDflt = 1L;
            if (arch.equals("qwen2moe")) {
                normDflt = 0L;
            }
            c.expertNormTopk = f.metaInt(
                kp + "expert_weights_norm", normDflt) != 0L;
            c.expertGating = (int32) f.metaInt(
                kp + "expert_gating_func", 1L);
            c.expertScale = (float32) f.metaFloat(
                kp + "expert_weights_scale", 0.0);
        }
        // `rope.dimension_sections` (Qwen2-VL's M-RoPE) needs nothing here
        // for TEXT: the sections choose which of (t, h, w) feeds each
        // frequency band, and for a text token all three ARE the token
        // position, so the rotation is the ordinary one (spec 4.13).
        // Image/video positions are not in scope for this path.
        // Llama-3.1 carries its llama3 rope scaling as a TENSOR, not keys
        // (the file has no rope.scaling.* metadata whatsoever). Without
        // this the rotations are unscaled and the model answers plausibly
        // but wrongly — "The capital of France is" -> " a" instead of
        // " Paris.".
        if (f.contains("rope_freqs.weight")) {
            Tensor<float32> rf #= f.loadF32("rope_freqs.weight");
            int32 nf = (int32) rf.shapeAt(0);
            float32[] fac #= heap float32[nf];
            int32 fi = 0;
            while (fi < nf) {
                fac[fi] = rf.flatGet((int64) fi);
                fi = fi + 1;
            }
            c.ropeFreqs #= fac;
        }
        // llama.cpp emits output.weight only when untied; a missing tensor
        // means the embedding doubles as the head.
        return #c;
    }

    public static #ModelConfig parse(String path) {
        int8[] raw = File.readAllBytes(path);
        int64 rawLen = (int64) raw.count();
        if (rawLen <= 0) {
            throw heap LlmException("model config: '" + path
                + "' is missing or empty");
        }
        JsonValue v #= Json.parse(raw, rawLen);
        JsonObject root = v.object();

        JsonValue archs = root.get("architectures");
        if (archs == null || archs.array().count() < 1) {
            throw heap LlmException("model config: '" + path
                + "' declares no architectures");
        }
        String arch #= archs.array().get(0).asString();
        // The HF config's `architectures` value — EXTERNAL vocabulary,
        // not our driver class (that is CausalLM; the checkpoints say
        // LlamaForCausalLM and always will).
        if (!arch.equals("LlamaForCausalLM")) {
            // Spec 4.5: the error lists the supported architectures.
            throw heap LlmException("model config: architecture '" + arch
                + "' is not supported; supported: LlamaForCausalLM");
        }

        ModelConfig c = heap ModelConfig();
        c.architecture #= arch;
        c.hiddenSize = ModelConfig.reqInt(root, "hidden_size", path);
        c.intermediateSize = ModelConfig.reqInt(root, "intermediate_size", path);
        c.numLayers = ModelConfig.reqInt(root, "num_hidden_layers", path);
        c.numHeads = ModelConfig.reqInt(root, "num_attention_heads", path);
        c.vocabSize = ModelConfig.reqInt(root, "vocab_size", path);
        c.numKvHeads = ModelConfig.optInt(root, "num_key_value_heads", c.numHeads);
        // Spec 4.8: explicit head_dim wins over the derived quotient.
        c.headDim = ModelConfig.optInt(root, "head_dim",
            c.hiddenSize / c.numHeads);
        c.maxPositionEmbeddings = ModelConfig.optInt(root,
            "max_position_embeddings", 2048);
        c.rmsNormEps = ModelConfig.optFloat(root, "rms_norm_eps", 0.00001f);
        c.ropeTheta = ModelConfig.optFloat(root, "rope_theta", 10000.0f);
        JsonValue tie = root.get("tie_word_embeddings");
        if (tie != null) {
            c.tieWordEmbeddings = tie.asBoolean();
        }
        c.slidingWindow = ModelConfig.optInt(root, "sliding_window", 0);
        JsonValue qpas = root.get("query_pre_attn_scalar");
        if (qpas != null) {
            c.queryScale = 1.0f / Math.sqrt((float32) qpas.asFloat64());
        }
        JsonValue act = root.get("hidden_act");
        if (act == null) {
            act = root.get("hidden_activation");
        }
        if (act != null) {
            String a2 #= act.asString();
            if (a2.equals("silu")) {
                c.activation = 0;
            } else if (a2.equals("gelu_pytorch_tanh")) {
                c.activation = 1;
            } else {
                throw heap LlmException("model config: activation '" + a2
                    + "' is not supported; supported: silu, gelu_pytorch_tanh");
            }
        }
        JsonValue rs = root.get("rope_scaling");
        if (rs != null && !rs.isNull()) {
            JsonObject ro = rs.object();
            JsonValue ty = ro.get("rope_type");
            if (ty == null) {
                ty = ro.get("type");
            }
            if (ty != null) {
                String tn #= ty.asString();
                if (tn.equals("linear")) {
                    c.ropeScalingType = 1;
                } else if (tn.equals("dynamic") || tn.equals("ntk")) {
                    c.ropeScalingType = 2;
                } else if (tn.equals("yarn")) {
                    c.ropeScalingType = 3;
                } else if (tn.equals("llama3")) {
                    c.ropeScalingType = 4;
                } else {
                    throw heap LlmException("model config: rope_scaling type '"
                        + tn + "' is not supported; supported: linear, "
                        + "dynamic, yarn, llama3");
                }
            }
            c.ropeScalingFactor = ModelConfig.optFloat(ro, "factor", 1.0f);
            c.ropeLowFreq = ModelConfig.optFloat(ro, "low_freq_factor",
                ModelConfig.optFloat(ro, "beta_slow", 1.0f));
            c.ropeHighFreq = ModelConfig.optFloat(ro, "high_freq_factor",
                ModelConfig.optFloat(ro, "beta_fast", 4.0f));
            c.ropeOrigMaxPos = ModelConfig.optInt(ro,
                "original_max_position_embeddings", c.maxPositionEmbeddings);
        }
        JsonValue qkn = root.get("qk_norm");
        if (qkn != null) {
            c.qkNorm = qkn.asBoolean();
        }
        JsonValue lt = root.get("layer_types");
        if (lt != null && !lt.isNull()) {
            int32 n = lt.array().count();
            if (n != c.numLayers) {
                throw heap LlmException("model config: layer_types has "
                    + n + " entries for " + c.numLayers + " layers");
            }
            int32[] lw = heap int32[n];
            int32 li = 0;
            while (li < n) {
                String tname #= lt.array().get(li).asString();
                if (tname.equals("sliding_attention")) {
                    lw[li] = c.slidingWindow;
                } else if (tname.equals("full_attention")) {
                    lw[li] = 0;
                } else {
                    throw heap LlmException("model config: layer type '"
                        + tname + "' is not supported; supported: "
                        + "sliding_attention, full_attention");
                }
                li = li + 1;
            }
            c.layerWindows #= lw;
        }
        return #c;
    }

    static int32 reqInt(JsonObject root, String key, String path) {
        JsonValue j = root.get(key);
        if (j == null) {
            throw heap LlmException("model config: '" + path
                + "' is missing required key '" + key + "'");
        }
        return j.asInt32();
    }

    static int32 optInt(JsonObject root, String key, int32 dflt) {
        JsonValue j = root.get(key);
        if (j == null) {
            return dflt;
        }
        return j.asInt32();
    }

    static float32 optFloat(JsonObject root, String key, float32 dflt) {
        JsonValue j = root.get(key);
        if (j == null) {
            return dflt;
        }
        return (float32) j.asFloat64();
    }
}
