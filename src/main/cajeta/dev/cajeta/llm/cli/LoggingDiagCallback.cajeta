package dev.cajeta.llm.cli;

import cajeta.lang.String;
import dev.cajeta.llm.DiagCallback;
import dev.cajeta.llm.DiagRecord;
import dev.cajeta.logging.Logger;

/**
 * Bridges the engine's `DiagCallback` records onto `dev.cajeta.logging`,
 * for the `cajeta-llm` CLI. The FORMATTING lives here on purpose: the
 * engine emits typed records and no strings (spec 11.8.2); rendering is
 * consumer policy, and this consumer renders one line per record.
 *
 * DIAGNOSTICS NEED A CHANNEL OF THEIR OWN, and stderr is not it. That
 * was settled once already (Julian, 2026-08-27, recorded in `Diag`):
 * stderr is a SEVERITY channel, so IDEs and log collectors paint it red
 * and alert on it, and "we picked the batched kernel" gets laundered
 * into "something went wrong". With diagnostics on their own channel,
 * ANY output on stderr is a real problem, so stderr stays a signal.
 *
 * This lives in the `cli` package on purpose. The artifact depends on
 * `dev.cajeta.logging` (Julian's call, 2026-08-30), but the LIBRARY
 * packages still import no logging backend (11.8.6), so the rule `Diag`
 * states — a library must not choose a backend for its embedder —
 * stays visibly true in the code embedders compile against.
 *
 * Levels: route/scheduling chatter is DEBUG — tuning detail, not news
 * (at INFO it would recreate the console noise the hook exists to
 * stop). "launch-failure" alone goes to ERROR: a dispatch that never
 * ran means output computed on garbage, and that IS news, at any
 * threshold.
 */
public final class LoggingDiagCallback implements DiagCallback {

    // OWNED: `Log.at` hands back a `#Logger` and the callback outlives
    // the call that built it, so a plain `=` would record a borrow of a
    // logger nobody else holds.
    Logger log;

    public LoggingDiagCallback(#Logger l) {
        this.log #= l;
        return;
    }

    public void onRecord(DiagRecord r) {
        if (r.category.equals("launch-failure")) {
            this.log.error("LAUNCH FAILURE: " + r.v0
                + " dispatch(es) never ran in step " + r.v1
                + " (session " + r.session + ")");
            return;
        }
        this.log.debug(LoggingDiagCallback.render(r));
        return;
    }

    /** One line per record, mirroring the categories `DiagRecord`
     *  documents. Unknown categories render generically rather than
     *  dropping — a new engine record must not vanish because the CLI
     *  lagged. */
    static #String render(DiagRecord r) {
        if (r.category.equals("prefill-mode")) {
            return #= "prefill: " + r.name + " projections rows=" + r.v0
                + " refusals=" + r.v1;
        }
        if (r.category.equals("batch-refused")) {
            return #= "batch-refused: " + r.name + " layer=" + r.v0
                + " rows=" + r.v1;
        }
        if (r.category.equals("decode-mode")) {
            return #= "decode: " + r.name + " path";
        }
        if (r.category.equals("kernel-avail")) {
            return #= "kernel-avail: mask=" + r.v0
                + " (b0 q4Mw8 b1 q4Mw4 b2 q6Mw8 b3 q6Mw4 b4 q5Mw8"
                + " b5 q80Mw8 b6 q2Mw8 b7 q3Mw8) — absent variants"
                + " take the next kernel down";
        }
        if (r.category.equals("expert-cache")) {
            // moe-expert-cache spec 8.1: one MoE layer call's split.
            return #= "expert-cache: " + r.name + " layer=" + r.v0
                + " hits=" + r.v1 + " t0=" + r.v2 + " admits=" + r.v3
                + " admitB=" + r.v4 + " residentB=" + r.v5;
        }
        if (r.category.equals("batch-route")) {
            return #= "batch-route: " + r.name + " out=" + r.v0
                + " in=" + r.v1;
        }
        if (r.category.equals("sched-step")) {
            return #= "sched step=" + r.v0 + " req=" + r.session
                + " slot=" + r.v1 + " cachedLen=" + r.v2 + " n=" + r.v3
                + " totalLen=" + r.v4 + " cacheLen=" + r.v5;
        }
        if (r.category.equals("sched-admit")) {
            return #= "sched admit req=" + r.session + " -> slot=" + r.v0
                + " (" + r.name + ") cacheLen=" + r.v1;
        }
        if (r.category.equals("kv-ceiling")) {
            return #= "device kv ceiling: " + (r.v0 / 1048576L)
                + " MiB (" + r.v1 + " slots x " + r.v2
                + " ctx), allocated per slot on first use";
        }
        String nm = r.name != null ? r.name : "-";
        return #= r.category + " s=" + r.session + " " + nm + " "
            + r.v0 + " " + r.v1 + " " + r.v2 + " " + r.v3 + " "
            + r.v4 + " " + r.v5;
    }
}
