package dev.cajeta.llm.bench;

import cajeta.io.file.File;
import cajeta.io.file.OpenMode;
import cajeta.lang.String;
import cajeta.lang.System;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.model.ExpertBank;

/** Standalone twin of MoeResidencyTest's flow, step-printed, for
 *  isolating the suite SIGSEGV. */
public class ResidencyProbe {

    static void putU32(int8[] b, int64 at, int64 v) {
        b[at] = (int8) (v & 255L);
        b[at + 1L] = (int8) ((v >> 8) & 255L);
        b[at + 2L] = (int8) ((v >> 16) & 255L);
        b[at + 3L] = (int8) ((v >> 24) & 255L);
        return;
    }

    static void putU64(int8[] b, int64 at, int64 v) {
        int32 k = 0;
        while (k < 8) {
            b[at + (int64) k] = (int8) ((v >> (8 * k)) & 255L);
            k = k + 1;
        }
        return;
    }

    public static void run(String[] args) {
        int32 experts = 128;
        int32 rows = 1024;
        int32 cols = 8192;
        String path #= "tmp/residency_probe_big.gguf";
        String name = "blk.0.ffn_gate_exps.weight";
        int8[] nb #= name.toBytes();
        int64 nlen = (int64) nb.count();
        int64 hlen = 24L + 8L + nlen + 4L + 24L + 4L + 8L;
        int8[] hb = heap int8[hlen];
        ResidencyProbe.putU32(hb, 0L, 0x46554747L);
        ResidencyProbe.putU32(hb, 4L, 3L);
        ResidencyProbe.putU64(hb, 8L, 1L);
        ResidencyProbe.putU64(hb, 16L, 0L);
        int64 p = 24L;
        ResidencyProbe.putU64(hb, p, nlen);
        p = p + 8L;
        int64 i = 0;
        while (i < nlen) {
            hb[p + i] = nb[i];
            i = i + 1;
        }
        p = p + nlen;
        ResidencyProbe.putU32(hb, p, 3L);
        p = p + 4L;
        ResidencyProbe.putU64(hb, p, (int64) cols);
        ResidencyProbe.putU64(hb, p + 8L, (int64) rows);
        ResidencyProbe.putU64(hb, p + 16L, (int64) experts);
        p = p + 24L;
        ResidencyProbe.putU32(hb, p, 12L);
        p = p + 4L;
        ResidencyProbe.putU64(hb, p, 0L);
        File.writeAllBytes(path, hb, hlen);
        int64 dataStart = (hlen + 31L) / 32L * 32L;
        int64 rowBytes = (int64) cols / 256L * 144L;
        int64 payload = (int64) experts * (int64) rows * rowBytes;
        File f #= File.open(path, OpenMode.READ_WRITE);
        f.truncate(dataStart + payload);
        f.close();
        System.stdout.println("file written, payload " + payload);

        Checkpoint ck #= Checkpoint.open(path);
        System.stdout.println("checkpoint open");
        ExpertBank b = heap ExpertBank();
        b.bind(ck, name, experts, rows, cols);
        System.stdout.println("bound: bytesHeld " + b.bytesHeld()
            + " devWin " + b.deviceWindowBytes());

        float32[] x = heap float32[cols];
        float32[] y = heap float32[rows];
        int32 j = 0;
        while (j < cols) {
            x[j] = 1.0f;
            j = j + 1;
        }
        System.stdout.println("calling matvecAt(0)");
        b.matvecAt(0, x, 0L, y, 0L);
        System.stdout.println("matvecAt(0) done, y[0]=" + y[0]);
        b.matvecAt(77, x, 0L, y, 0L);
        System.stdout.println("matvecAt(77) done, touched0="
            + b.touchedBytes(0) + " touched77=" + b.touchedBytes(77));
        ck.close();
        return;
    }
}
