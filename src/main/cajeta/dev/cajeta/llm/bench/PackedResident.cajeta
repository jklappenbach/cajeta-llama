package dev.cajeta.llm.bench;

import cajeta.io.file.File;
import cajeta.io.file.OpenMode;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.collection.ArrayList;
import dev.cajeta.llm.io.Checkpoint;
import dev.cajeta.llm.io.QuantKernel;
import dev.cajeta.llm.io.Quant;
import dev.cajeta.llm.io.WmmaKernel;
import dev.cajeta.llm.model.AttnKernel;
import dev.cajeta.llm.model.Linear;
import dev.cajeta.llm.model.CausalLM;
import dev.cajeta.llm.model.Prim;
import dev.cajeta.llm.model.ModelConfig;

/**
 * Resident-memory and decode measurement for a REAL quantized checkpoint
 * (plan 15.1.7, spec 12.11), driven by raw token ids so the tokenizer is
 * not in the way — the point is what the WEIGHTS cost and how fast they
 * multiply, not text handling.
 */
public class PackedResident {

    /**
     * The `dotAccum` ceiling with no memory in the loop (plan 10.12.9).
     * Reports MAC/s at two iteration counts; if the second is not
     * ~2x the first in TIME, the loop was hoisted and the number is a
     * fiction.
     */
    static void dotCeiling() {
        int64 groups = 16384L;
        KernelBuffer<int8> src #= heap KernelBuffer<int8>((uint64) 256);
        int8[] sh #= heap int8[256L];
        int64 i = 0;
        while (i < 256L) { sh[i] = (int8) ((i % 7) - 3); i = i + 1; }
        src.upload(sh);
        KernelBuffer<float32> out #= heap KernelBuffer<float32>(
            (uint64) (groups * 32L));
        // Warm.
        QuantKernel.dotCeilingLaunch(out, src, groups, 64);
        int32 it = 512;
        while (it <= 2048) {
            int64 t0 = Clock.nanoTime();
            QuantKernel.dotCeilingLaunch(out, src, groups, it);
            float64 ms = (float64) (Clock.nanoTime() - t0) / 1000000.0;
            // 4 dots x 32 lanes x 32 elements per iteration per workgroup.
            float64 macs = (float64) groups * 32.0 * (float64) it * 4.0
                * 32.0;
            System.stdout.println("iters " + it + "  ms " + ms
                + "  TMAC/s " + (macs / (ms / 1000.0) / 1.0e12));
            it = it * 2;
        }
        return;
    }

    /** The margin between the best and second-best logit of the step just
     *  taken, RELATIVE to the best. A divergence at a gap of ~1e-3 is the
     *  two runs disagreeing about a coin flip; one at a wide gap is a
     *  defect. */
    static float32 top2Gap(CausalLM m, int32 vocab) {
        float32 b0 = 0.0f - 3.0e38f;
        float32 b1 = 0.0f - 3.0e38f;
        int32 i = 0;
        while (i < vocab) {
            float32 x = m.logitAt(i);
            if (x > b0) { b1 = b0; b0 = x; }
            else if (x > b1) { b1 = x; }
            i = i + 1;
        }
        float32 mag = b0;
        if (mag < 0.0f) { mag = 0.0f - mag; }
        if (mag < 1.0e-6f) { mag = 1.0e-6f; }
        return (b0 - b1) / mag;
    }

    /**
     * 10.12.32 follow-up (Julian): GEMM efficiency vs LAUNCH WIDTH at
     * constant work. The fusion refutation left a non-monotone puzzle
     * — 32 WGs ~1 TMAC/s, 128 -> 3.4, 192 -> 2.0, 448 -> 5.2, 896 ->
     * 4.1 — but those widths were confounded with tensor identity and
     * cache history. Here: ONE synthetic 28672 x 4096 Q4_K matrix
     * (the fused gate|up shape) at 512 tokens, partitioned into
     * launches of controlled width; same bytes, same tiles, same Mw8
     * kernel — only the partitioning varies. Slice buffers are carved
     * OUTSIDE the timed section; three rounds, order reversed per
     * round.
     */
    static void gridSweep() {
        int64 rowsW = 28672L;
        int64 cols = 4096L;
        int64 toks = 512L;
        int64 bpr = cols / 256L;
        int64 rowBytes = bpr * 144L;
        int64 pn = rowsW * rowBytes;
        int8[] ph #= heap int8[pn];
        int64 i = 0;
        while (i < pn) {
            ph[i] = (int8) ((i * 31L + 7L) % 251L - 125L);
            i = i + 1;
        }
        KernelBuffer<int8> pDev #= heap KernelBuffer<int8>((uint64) pn);
        pDev.upload(ph);
        KernelBuffer<int8> deqDev #= heap KernelBuffer<int8>(
            (uint64) (rowsW * cols));
        WmmaKernel.q4kWidenLaunch(deqDev, pDev, rowsW, cols);
        float32[] x #= heap float32[toks * cols];
        i = 0;
        while (i < toks * cols) {
            x[i] = ((float32) ((i * 37L) % 1000L)) * 0.001f - 0.5f;
            i = i + 1;
        }
        int64 pb = Quant.q8kPackedBytes(cols);
        int8[] xph #= heap int8[toks * pb];
        int64 r = 0;
        while (r < toks) {
            Quant.q8kPack(x, r * cols, cols, xph, r * pb);
            r = r + 1;
        }
        KernelBuffer<int8> xp #= heap KernelBuffer<int8>(
            (uint64) (toks * pb));
        xp.upload(xph);
        KernelBuffer<float32> y #= heap KernelBuffer<float32>(
            (uint64) (toks * rowsW));
        KernelStream s #= KernelStream.current();
        s.sync();
        // tilesN8 per slice -> WGs per launch = 4x that.
        int32[] cfg = heap int32[9];
        cfg[0] = 6;   cfg[1] = 8;   cfg[2] = 12;  cfg[3] = 16;
        cfg[4] = 24;  cfg[5] = 32;  cfg[6] = 56;  cfg[7] = 112;
        cfg[8] = 224;
        int64 totalTiles = rowsW / 128L;   // 224
        float64 gmac = (float64) (toks * rowsW * cols) / 1.0e9;
        int32 round = 0;
        while (round < 3) {
            int32 ci = 0;
            while (ci < 9) {
                int32 pick = ci;
                if (round % 2 == 1) { pick = 8 - ci; }
                int64 st = (int64) cfg[pick];
                // Carve the slices OUTSIDE the timed window.
                int64 nSlices = (totalTiles + st - 1L) / st;
                int64 done = 0L;
                int64 si = 0;
                // Slice sets live in ArrayLists (the Sink model:
                // add transfers, get lends to the launch).
                ArrayList<KernelBuffer<int8>> sp =
                    heap ArrayList<KernelBuffer<int8>>();
                ArrayList<KernelBuffer<int8>> sd =
                    heap ArrayList<KernelBuffer<int8>>();
                int64[] srows = heap int64[nSlices];
                while (si < nSlices) {
                    int64 t0tiles = si * st;
                    int64 tCount = st;
                    if (t0tiles + tCount > totalTiles) {
                        tCount = totalTiles - t0tiles;
                    }
                    int64 sr = tCount * 128L;
                    srows[si] = sr;
                    KernelBuffer<int8> bp #= heap KernelBuffer<int8>(
                        (uint64) (sr * rowBytes));
                    WmmaKernel.sliceI8Launch(bp, pDev,
                        sr * rowBytes, t0tiles * 128L * rowBytes);
                    sp.add(#bp);
                    KernelBuffer<int8> bd #= heap KernelBuffer<int8>(
                        (uint64) (sr * cols));
                    WmmaKernel.sliceI8Launch(bd, deqDev,
                        sr * cols, t0tiles * 128L * cols);
                    sd.add(#bd);
                    si = si + 1;
                }
                s.sync();
                int64 t0 = Clock.nanoTime();
                si = 0;
                while (si < nSlices) {
                    WmmaKernel.q4kWmmaDeqMw8Launch(y,
                        sp.get((int32) si), sd.get((int32) si),
                        xp, toks, srows[si], cols);
                    si = si + 1;
                }
                s.sync();
                float64 ms = (float64) (Clock.nanoTime() - t0)
                    / 1000000.0;
                System.stdout.println("gridsweep r" + round
                    + "  wgs " + (cfg[pick] * 4)
                    + "  launches " + nSlices
                    + "  ms " + ms
                    + "  tmacs " + (gmac / ms));
                ci = ci + 1;
            }
            round = round + 1;
        }
        return;
    }

    public static void run(String[] args) {
        String path = args[0];
        if (args.count() > 1 && args[1].equals("gridsweep")) {
            PackedResident.gridSweep();
            return;
        }
        if (args.count() > 1 && args[1].equals("dotceil")) {
            PackedResident.dotCeiling();
            return;
        }
        // Arm selection (plan 7.1.1): `serial` forces every packed mat-vec
        // back to its host path so the two arms can be compared in the same
        // session, on the same binary, one flag apart.
        boolean routed = true;
        if (args.count() > 1 && args[1].equals("serial")) { routed = false; }
        if (args.count() > 1 && args[1].equals("nomatvec")) {
            QuantKernel.setSkipMatvecForMeasurement(true);
        }
        // `skipN` — time a token with host primitives removed
        // (1 rmsnorm, 2 glu, 4 rope, 8 attend), projections also off.
        int32 mv = -1;
        if (args.count() > 1) {
            if (args[1].equals("skip1"))  { mv = 1; }
            if (args[1].equals("skip2"))  { mv = 2; }
            if (args[1].equals("skip4"))  { mv = 4; }
            if (args[1].equals("skip8"))  { mv = 8; }
            if (args[1].equals("skip15")) { mv = 15; }
            if (args[1].equals("skip16")) { mv = 16; }
            if (args[1].equals("skip32")) { mv = 32; }
            if (args[1].equals("skip48")) { mv = 48; }
            if (args[1].equals("skip63")) { mv = 63; }
        }
        if (mv >= 0) {
            QuantKernel.setSkipMatvecForMeasurement(true);
            Prim.setSkipMaskForMeasurement(mv);
        }
        QuantKernel.setRoutingEnabled(routed);
        // `time` as a THIRD argument, not a fourth arm: the phase timers
        // must run on the very arm being characterized, so they are a
        // modifier of `routed`, never a substitute for it.
        // `uni` in any argument slot: Unified (managed) activation buffers.
        boolean uni = false;
        // `ctxN` — prefill N tokens before the timed decode, so the attend
        // is measured at a context that resembles a real one. The default 8
        // makes the host attend almost free (count <= 12) and would let a
        // device attend look like a wash for the wrong reason.
        int32 preLen = 8;
        int32 decN = 4;
        int64 ai = 1L;
        int64 nargs = (int64) args.count();
        while (ai < nargs) {
            if (args[ai].equals("uni")) { uni = true; }
            // `syncall` restores one sync per DISPATCH (the pre-10.3 arm).
            if (args[ai].equals("res")) {
                Linear.setDeviceResident(true);
            }
            if (args[ai].equals("nores")) {
                Linear.setDeviceResident(false);
            }
            if (args[ai].equals("noWave")) {
                Linear.setWaveMatVec(false);
            }
            // `vkwmma`: force the batched WMMA route past the Vulkan latch —
            // the KHR coop-matrix prefill measurement arm (see
            // Linear.setWmmaBackendOverride).
            if (args[ai].equals("vkwmma")) {
                Linear.setWmmaBackendOverride(true);
            }
            if (args[ai].equals("syncall")) {
                Linear.setOneSyncPerProjection(false);
            }
            if (args[ai].equals("async")) { Linear.setAsyncTransfers(true); }
            // HOST-ATTENTION-TAIL arms (plan 10.11). Unlike `skipN`, these
            // leave the projections ON — the question is what the host
            // attention tail costs INSIDE a real token, and `skipN` answers
            // a different question because it disables the mat-vecs too.
            // Output is garbage on any of them, by construction.
            if (args[ai].equals("noRope")) {
                Prim.setSkipMaskForMeasurement(4);
            }
            if (args[ai].equals("noKv")) {
                Prim.setSkipMaskForMeasurement(48);
            }
            if (args[ai].equals("noAttn")) {
                Prim.setSkipMaskForMeasurement(52);
            }
            if (args[ai].equals("devattn")) {
                CausalLM.setDeviceAttention(true);
            }
            if (args[ai].equals("nodevattn")) {
                CausalLM.setDeviceAttention(false);
            }
            // 10.11.7 attribution: skip individual attention launches.
            if (args[ai].equals("askip1"))  { AttnKernel.setSkipForMeasurement(1); }
            if (args[ai].equals("askip2"))  { AttnKernel.setSkipForMeasurement(2); }
            if (args[ai].equals("askip4"))  { AttnKernel.setSkipForMeasurement(4); }
            if (args[ai].equals("askip8"))  { AttnKernel.setSkipForMeasurement(8); }
            if (args[ai].equals("askip12")) { AttnKernel.setSkipForMeasurement(12); }
            if (args[ai].equals("askip15")) { AttnKernel.setSkipForMeasurement(15); }
            // Decode length. The device K/V seed is ONE-TIME and O(context)
            // — 134 MB at 512 positions — so a 4-token decode amortizes it
            // over four tokens and reports a steady state that does not
            // exist. Anything claiming a ms/token at long context has to
            // say which of these it used.
            if (args[ai].equals("dec16")) { decN = 16; }
            if (args[ai].equals("dec32")) { decN = 32; }
            if (args[ai].equals("dec64")) { decN = 64; }
            if (args[ai].equals("tb4")) { QuantKernel.setBatch4(true); }
            if (args[ai].equals("nodecode")) {
                QuantKernel.setBatchMode(1);
            }
            if (args[ai].equals("nowmma")) { Linear.setWmma(false); }
            if (args[ai].equals("nommq")) { Linear.setMmq(false); }
            // lm-head fuse A/B: the two-round-trip host tail.
            if (args[ai].equals("nofuse")) {
                CausalLM.setFuseTail(false);
            }
            // coop GEMM A/B: back to the dp4a mmq route.
            if (args[ai].equals("nocoop")) { Linear.setCoop(false); }
            // Attribution: sync at every prefill phase boundary so the
            // pf buckets hold GPU time by phase (perturbs the total).
            if (args[ai].equals("pfsync")) { CausalLM.setPfSync(true); }
            // 10.12.23: Q6_K back on the dotAccum fallback, the A/B arm.
            if (args[ai].equals("noq6")) { Linear.setWmma6(false); }
            // Epilogue plan U3: `noepi` reverts Q6_K to its spill
            // seam; `q4epi` opts Q4_K INTO the (measured-slower) epi
            // kernels for re-measurement.
            if (args[ai].equals("noepi")) { Linear.setEpi(false); }
            if (args[ai].equals("q4epi")) { Linear.setQ4Epi(true); }
            // 10.12.21: the register-tiled T=2 deq kernel.
            if (args[ai].equals("deqt2")) { Linear.setQ4T2(true); }
            // 10.12.21 iter 2: N=4 output tiling, A reused in registers.
            if (args[ai].equals("deqn4")) { Linear.setQ4N4(true); }
            // 10.12.21 FINAL: multi-wave + dual-verb register epilogue.
            // Now the DEFAULT; `nomw` reverts to the spill champion.
            if (args[ai].equals("deqmw")) { Linear.setQ4Mw(true); }
            if (args[ai].equals("nomw")) { Linear.setQ4Mw(false); }
            // 10.12.21 token blocking: 64 tokens/WG, 4x less weight
            // traffic against the ~155 GB/s wall. Now the DEFAULT;
            // `nomw4` reverts to Mw.
            if (args[ai].equals("deqmw4")) { Linear.setQ4Mw4(true); }
            if (args[ai].equals("nomw4")) { Linear.setQ4Mw4(false); }
            // 10.12.28: T=8 token blocking — now the DEFAULT; `nomw8`
            // reverts to Mw4.
            if (args[ai].equals("deqmw8")) { Linear.setQ4Mw8(true); }
            if (args[ai].equals("nomw8")) { Linear.setQ4Mw8(false); }
            // 10.12.32: fused q|k|v and gate|up projections.
            if (args[ai].equals("fuse")) { Linear.setFuse(true); }
            // 10.12.34: ~32-WG partitioned launches — the DEFAULT;
            // `nopart32` reverts to monolithic.
            if (args[ai].equals("part32")) { Linear.setPart32(true); }
            if (args[ai].equals("nopart32")) { Linear.setPart32(false); }
            // 10.12.29: wave-per-(row,head) prefill score kernel —
            // now the DEFAULT; `oldscore` reverts.
            if (args[ai].equals("rowscore")) {
                AttnKernel.setRowScore(true);
            }
            if (args[ai].equals("oldscore")) {
                AttnKernel.setRowScore(false);
            }
            // 10.12.42: partition width sweep — retunes the ~32-WG
            // slice width the retiled kernel launches with.
            if (args[ai].equals("partw24")) { WmmaKernel.setPartWgs(24L); }
            if (args[ai].equals("partw40")) { WmmaKernel.setPartWgs(40L); }
            if (args[ai].equals("partw48")) { WmmaKernel.setPartWgs(48L); }
            if (args[ai].equals("partw64")) { WmmaKernel.setPartWgs(64L); }
            if (args[ai].equals("partw96")) { WmmaKernel.setPartWgs(96L); }
            // 10.12.38: lazy cache authority is the DEFAULT; `eagerauth`
            // restores the on-clock authority pass (the ~36 ms control).
            if (args[ai].equals("eagerauth")) {
                CausalLM.setEagerAuth(true);
            }
            // 10.12.38: v2 operator-efficient prefill attention — the
            // DEFAULT; `noattnv2` reverts to the v1 kernel pair.
            if (args[ai].equals("attnv2")) { AttnKernel.setAttnV2(true); }
            if (args[ai].equals("noattnv2")) { AttnKernel.setAttnV2(false); }
            // 10.12.43: fused online-softmax prefill attention — the
            // DEFAULT; `noflash` falls back to the v2 pair.
            if (args[ai].equals("noflash")) {
                AttnKernel.setAttnFlash(false);
            }
            // 2026-08-25: fused flash DECODE — the DEFAULT; `nofd` falls
            // back to the score+combine pair; `fdchunk<N>` tunes the
            // positions-per-split target.
            if (args[ai].equals("nofd")) {
                AttnKernel.setFlashDecode(false);
            }
            if (args[ai].equals("fdchunk8")) {
                AttnKernel.setFlashDecodeChunk(8);
            }
            if (args[ai].equals("fdchunk32")) {
                AttnKernel.setFlashDecodeChunk(32);
            }
            if (args[ai].equals("fdchunk64")) {
                AttnKernel.setFlashDecodeChunk(64);
            }
            // 10.12.27: Q6_K on the token-blocked deq route. Now the
            // DEFAULT in deq mode; `noq6mw4` reverts to the epi kernel.
            if (args[ai].equals("q6mw4")) { Linear.setQ6Mw4(true); }
            if (args[ai].equals("noq6mw4")) { Linear.setQ6Mw4(false); }
            // 10.12.39: the Q6 T=8 twin — the DEFAULT; `noq6mw8`
            // reverts to the Mw4 kernel.
            if (args[ai].equals("noq6mw8")) { Linear.setQ6Mw8(false); }
            // 10.12.16: the int8 prefill-weight mode ("packed" stays
            // the default, so the arm turns it ON).
            if (args[ai].equals("deq")) { Linear.setDeqPrefill(true); }
            if (args[ai].equals("hostpack")) {
                Linear.setDeviceBatchPack(false);
            }
            if (args[ai].equals("nodmins")) {
                QuantKernel.setBatchMode(4);
            }
            if (args[ai].equals("nonibble")) {
                QuantKernel.setBatchMode(3);
            }
            if (args[ai].equals("noactload")) {
                QuantKernel.setBatchMode(2);
            }
            if (args[ai].equals("reseed")) {
                CausalLM.setForceReseed(true);
            }
            if (args[ai].equals("ctx128"))  { preLen = 128; }
            if (args[ai].equals("ctx512"))  { preLen = 512; }
            if (args[ai].equals("ctx1024")) { preLen = 1024; }
            if (args[ai].equals("ctx2048")) { preLen = 2048; }
            if (args[ai].equals("q8"))  { Linear.setQ8Route(true); }
            if (args[ai].equals("f32")) { Linear.setQ8Route(false); }
            if (args[ai].equals("x2")) { Linear.setTransferReps(1); }
            if (args[ai].equals("x4")) { Linear.setTransferReps(3); }
            if (args[ai].equals("notrans")) {
                Linear.setSkipTransfersForMeasurement(true);
                System.stdout.println("SKIPPING TRANSFERS - output is "
                    + "garbage by construction");
            }
            ai = ai + 1L;
        }
        Linear.setUnifiedActivations(uni);
        System.stdout.println("unified activations: " + uni);
        boolean timed = args.count() > 2 && args[2].equals("time");
        Linear.setDeviceTimingEnabled(timed);
        // Fourth argument: launch-chunk size in MiB (0/absent = one launch
        // per weight, the shipped behaviour).
        if (args.count() > 3) {
            int64 r = 0L;
            if (args[3].equals("2048"))  { r = 2048L; }
            if (args[3].equals("3072"))  { r = 3072L; }
            if (args[3].equals("4096"))  { r = 4096L; }
            if (args[3].equals("5120"))  { r = 5120L; }
            if (args[3].equals("6144"))  { r = 6144L; }
            if (args[3].equals("8192"))  { r = 8192L; }
            // ONLY when the argument actually named a chunk size. An
            // unrecognised value here used to fall through to r = 0, which
            // means chunking OFF — and an unchunked lm_head is 10 GB/s. That
            // silently confounded three separate measurements and got filed
            // once as a compiler defect (10.7) before it was understood.
            if (r > 0L) {
                Linear.setLaunchChunkRows(r);
                System.stdout.println("chunk rows: " + r);
            } else if (!args[3].equals("nochunk")) {
                System.stdout.println("note: '" + args[3] + "' is not a chunk"
                    + " size and is being ignored, not applied as 0");
            } else {
                Linear.setLaunchChunkRows(0L);
                System.stdout.println("chunk rows: 0 (chunking OFF)");
            }
        }
        System.stdout.println("arm: " + (routed ? "routed" : "serial")
            + "  prefill: " + preLen);
        int32 ctxCap = preLen + decN + 64;
        int64 t0 = Clock.nanoTime();
        Checkpoint ck #= Checkpoint.open(path);
        ModelConfig cfg #= ModelConfig.fromGguf(ck.gguf());
        cfg.blockTokens = 16;
        System.stdout.println("layers: " + cfg.numLayers
            + "  hidden: " + cfg.hiddenSize
            + "  vocab: " + cfg.vocabSize);
        CausalLM m = heap CausalLM(#cfg, ctxCap, 1, 0);
        m.bind(ck, false);
        ck.close();
        // Off the prefill clock (profiling audit): the int8 policy's
        // per-tensor widens are load work, not prompt latency.
        m.prewarmPrefillWeights();
        float64 loadMs = (float64) (Clock.nanoTime() - t0) / 1000000.0;
        System.stdout.println("load ms: " + loadMs);
        System.stdout.println("rssKb after bind: " + PackedResident.rssKb());

        int32[] toks #= heap int32[preLen];
        int32 i = 0;
        while (i < preLen) { toks[i] = 1000 + i * 7; i = i + 1; }
        // "warm": a full throwaway prefill first, then reset the
        // sequence. Every device buffer is then allocated AND touched,
        // so the timed prefill below is STEADY STATE — what llama-bench
        // reports (r repetitions) and what a resident server does. The
        // default (cold) number keeps the first-prompt-after-load cost.
        boolean warmArm = false;
        int32 wai = 0;
        while (wai < (int32) args.count()) {
            if (args[wai].equals("warm")) { warmArm = true; }
            wai = wai + 1;
        }
        if (warmArm) {
            m.prefill(toks, preLen);
            m.resetSeq(0);
            System.stdout.println("warmup prefill done (discarded)");
        }
        Linear.resetBatchTimers();
        int64 p0 = Clock.nanoTime();
        int32 nxt = m.prefill(toks, preLen);
        float64 preMs = (float64) (Clock.nanoTime() - p0) / 1000000.0;
        System.stdout.println("prefill(" + preLen + ") ms: " + preMs
            + "  next: " + nxt);
        if (Linear.batchCalls() > 0L) {
            System.stdout.println("  prefill phases ms:  pack "
                + ((float64) Linear.batchPackNs() / 1000000.0)
                + "  upload " + ((float64) Linear.batchUploadNs() / 1000000.0)
                + "  launch " + ((float64) Linear.batchLaunchNs() / 1000000.0)
                + "  download " + ((float64) Linear.batchDownNs() / 1000000.0)
                + "  copyOut " + ((float64) Linear.batchCopyNs() / 1000000.0)
                + "  calls " + Linear.batchCalls()
                + "   [WMMA-deq " + Linear.wmmaDeqCallCount()
                + " / WMMA " + Linear.wmmaCallCount()
                + " / WMMA6 " + Linear.wmma6CallCount()
                + " / dotAccum " + Linear.batchFallbackCount()
                + (Linear.q6Mw4Enabled() && Linear.deqPrefillOn()
                    ? " / q6mw4"
                    : (Linear.epiEnabled() ? " / q6epi" : " / q6spill"))
                + (Linear.q4EpiEnabled() ? " q4epi" : " q4spill") + "]");
            // 10.12.22: the launch SPLIT by route, and the phases the
            // batch timers cannot see — so prefill sums to its parts.
            System.stdout.println("  launch by route ms:  deq "
                + ((float64) Linear.batchDeqNs() / 1000000.0)
                + "  wmma " + ((float64) Linear.batchWmmaNs() / 1000000.0)
                + "  wmma6 " + ((float64) Linear.batchQ6Ns() / 1000000.0)
                + "  dotAccum " + ((float64) Linear.batchFbNs() / 1000000.0));
            System.stdout.println("  prefill host ms:  prims "
                + ((float64) CausalLM.prefillPrimNs() / 1000000.0)
                + "  rope+append "
                + ((float64) CausalLM.prefillRopeNs() / 1000000.0)
                + "  attend "
                + ((float64) CausalLM.prefillAttendNs() / 1000000.0)
                + "  head "
                + ((float64) CausalLM.prefillHeadNs() / 1000000.0)
                + "  tailHs "
                + ((float64) CausalLM.prefillTailHsNs() / 1000000.0)
                + "  logits "
                + ((float64) CausalLM.prefillLogitsNs() / 1000000.0));
            System.stdout.println("  prefill gpu-by-phase ms:  gemm "
                + ((float64) CausalLM.prefillGemmNs() / 1000000.0)
                + "  stage "
                + ((float64) CausalLM.prefillStageNs() / 1000000.0)
                + "  (buckets are GPU time only under the pfsync arm)");
            System.stdout.println("  prefill gemm split ms:  qkv "
                + ((float64) CausalLM.prefillGQkvNs() / 1000000.0)
                + "  o " + ((float64) CausalLM.prefillGONs() / 1000000.0)
                + "  gate+up "
                + ((float64) CausalLM.prefillGMlpNs() / 1000000.0)
                + "  down "
                + ((float64) CausalLM.prefillGDownNs() / 1000000.0));
        }

        int32 cfgVocab = m.vocabSize();
        int32[] one #= heap int32[1];
        one[0] = nxt;
        Linear.resetDeviceTimers();
        Prim.resetDevOpTimers();
        Linear.resetStageCounts();
        CausalLM.resetDecodeTimers();
        int64 d0 = Clock.nanoTime();
        int32 steps = 0;
        int32 want = decN;
        // The token SEQUENCE, not just a count: 7.1.1's bar is that serial
        // and routed decode the same tokens, and a timing that does not say
        // what was produced cannot show that.
        String seq #= "" + nxt;
        String gaps #= "";
        // ENGINE time is summed over the stepSeq calls alone. The first
        // decode attribution (2026-08-25) found the old whole-loop timer
        // charging the engine for the harness's own per-token work —
        // `top2Gap` is a 128k-element scan through a method call per
        // element, plus two growing string appends — which llama-bench's
        // tg does not do and llama.cpp was never billed for.
        int64 dEng = 0;
        while (steps < want) {
            int64 s0 = Clock.nanoTime();
            int32 tok = m.stepSeq(0, one, 0, 1);
            dEng = dEng + (Clock.nanoTime() - s0);
            one[0] = tok;
            seq #= seq + " " + one[0];
            // The TOP-2 GAP at each step, because token agreement alone
            // cannot say whether a divergence is a bug or a near-tie the
            // attend's reassociation tipped. GreedyAgreement carries the
            // same clause for the same reason.
            gaps #= gaps + " " + PackedResident.top2Gap(m, cfgVocab);
            steps = steps + 1;
        }
        float64 decMs = (float64) dEng / 1000000.0;
        float64 loopMs = (float64) (Clock.nanoTime() - d0) / 1000000.0;
        System.stdout.println("tokens: " + seq);
        System.stdout.println("top2gap:" + gaps);
        System.stdout.println("decode " + decN + " tokens ms: " + decMs
            + "  (" + (decMs / (float64) decN) + " ms/token)");
        System.stdout.println("  harness overhead ms/token: "
            + ((loopMs - decMs) / (float64) decN));
        if (CausalLM.decodeTokens() > 0L) {
            float64 dtn = (float64) CausalLM.decodeTokens();
            System.stdout.println("  tail ms/token:  pre "
                + ((float64) CausalLM.decodePreNs() / dtn / 1000000.0)
                + "  sync "
                + ((float64) CausalLM.decodeSyncNs() / dtn / 1000000.0)
                + "  hsDown "
                + ((float64) CausalLM.decodeHsDownNs() / dtn / 1000000.0)
                + "  norm "
                + ((float64) CausalLM.decodeNormNs() / dtn / 1000000.0)
                + "  lmHead "
                + ((float64) CausalLM.decodeLmHeadNs() / dtn / 1000000.0)
                + "  argmax "
                + ((float64) CausalLM.decodeArgmaxNs() / dtn / 1000000.0));
        }
        if (timed) {
            float64 n = (float64) Linear.devCalls();
            System.stdout.println("dev calls: " + Linear.devCalls());
            System.stdout.println("dev copyIn ms: "
                + ((float64) Linear.devCopyInNs() / 1000000.0)
                + "  upload ms: " + ((float64) Linear.devUploadNs() / 1000000.0)
                + "  launch ms: " + ((float64) Linear.devLaunchNs() / 1000000.0)
                + "  download ms: " + ((float64) Linear.devDownloadNs() / 1000000.0)
                + "  copyOut ms: " + ((float64) Linear.devCopyOutNs() / 1000000.0));
            if (n > 0.0) {
                System.stdout.println("per call us:  copyIn "
                    + ((float64) Linear.devCopyInNs() / n / 1000.0)
                    + "  upload " + ((float64) Linear.devUploadNs() / n / 1000.0)
                    + "  launch " + ((float64) Linear.devLaunchNs() / n / 1000.0)
                    + "  download " + ((float64) Linear.devDownloadNs() / n / 1000.0)
                    + "  copyOut " + ((float64) Linear.devCopyOutNs() / n / 1000.0));
            }
            System.stdout.println("dev ops ms:  norm "
                + ((float64) Prim.devNormNs() / 1000000.0)
                + " x" + Prim.devNormCalls()
                + "   add " + ((float64) Prim.devAddNs() / 1000000.0)
                + " x" + Prim.devAddCalls()
                + "   glu " + ((float64) Prim.devGluNs() / 1000000.0)
                + " x" + Prim.devGluCalls());
            System.stdout.println("pack ms: "
                + ((float64) Linear.devPackNs() / 1000000.0)
                + "  packs: " + Linear.devPackCalls()
                + "  upload calls: " + Linear.devUploadCalls()
                + "  upload-minus-pack ms: "
                + ((float64) (Linear.devUploadNs() - Linear.devPackNs())
                    / 1000000.0));
            int32 b = 0;
            while (b < Linear.devBucketCount()) {
                float64 mb = (float64) Linear.devBucketBytes(b) / 1048576.0;
                float64 us = (float64) Linear.devBucketNs(b)
                    / (float64) Linear.devBucketCalls(b) / 1000.0;
                System.stdout.println("  shape " + mb + " MB / "
                    + Linear.devBucketRows(b) + " rows  x"
                    + Linear.devBucketCalls(b) + "  " + us + " us/launch  "
                    + (mb / us * 1000000.0 / 1024.0) + " GB/s"
                    + "   min " + ((float64) Linear.devBucketMinNs(b) / 1000.0)
                    + " us  max " + ((float64) Linear.devBucketMaxNs(b) / 1000.0)
                    + " us");
                b = b + 1;
            }
        }
        System.stdout.println("stage hits: " + Linear.stageHits()
            + "  misses: " + Linear.stageMisses());
        System.stdout.println("rssKb peak: " + PackedResident.rssKb());
        return;
    }

    /** VmRSS in KiB from /proc/self/status — streaming read, since procfs
     *  files fstat as size 0 (the SafetensorsTest helper's shape). */
    static int64 rssKb() {
        File f #= File.open("/proc/self/status", OpenMode.READ);
        int8[] st #= heap int8[8192];
        int64 n = f.read(st, 0, 8192);
        f.close();
        int64 i = 0;
        while (i < n - 6L) {
            if (st[i] == 86 && st[i + 1L] == 109 && st[i + 2L] == 82
                    && st[i + 3L] == 83 && st[i + 4L] == 83
                    && st[i + 5L] == 58) {
                int64 j = i + 6L;
                int64 v = 0;
                while (j < n && st[j] != 10) {
                    if (st[j] >= 48 && st[j] <= 57) {
                        v = v * 10L + (int64) (st[j] - 48);
                    }
                    j = j + 1L;
                }
                return v;
            }
            i = i + 1L;
        }
        return 0;
    }
}
