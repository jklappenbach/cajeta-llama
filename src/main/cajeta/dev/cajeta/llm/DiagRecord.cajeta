package dev.cajeta.llm;

import cajeta.lang.String;

/**
 * One structured diagnostic (spec 11.8.2): category, session, typed
 * fields. The engine BUILDS these and hands them to the registered
 * callback; it never formats a string and never stores a record
 * (11.8.3 — buffering is consumer policy).
 *
 * LIFETIME: a record is valid only DURING the callback invocation. The
 * engine reuses one scratch record per emission to keep an observed
 * diagnostic allocation-free, and `category`/`name` are stored as
 * borrows of the caller's strings (they are string literals at every
 * engine call site). A consumer that keeps history copies the fields
 * into its own ring — which it must do anyway to buffer (11.8.3).
 *
 * Categories and their fields (v-slots unused by a category are 0):
 *
 *   "prefill-mode"    name=route ("batched"/"per-row")  v0=rows
 *                     v1=refusing projections (0 when batched)
 *   "batch-refused"   name="<proj> <format>: <reason>"  v0=layer
 *                     v1=rows  v2=ggml type — once per distinct name for
 *                     the life of the model, just before "prefill-mode"
 *                     (prefill-routes plan 1.2.1: a per-row prefill names
 *                     the tensor that refused the batched route)
 *   "decode-mode"     name=path ("resident"/"host") — said once per
 *                     engine at the first decode row (unit 38)
 *   "kernel-avail"    v0=bitmask (b0 q4Mw8, b1 q4Mw4, b2 q6Mw8,
 *                     b3 q6Mw4, b4 q5Mw8, b5 q80Mw8, b6 q2Mw8,
 *                     b7 q3Mw8) — emitted only when something is absent
 *   "batch-route"     name=kernel route  v0=outDim  v1=inDim
 *   "sched-step"      session=req  v0=step  v1=slot  v2=cachedLen
 *                     v3=n  v4=totalLen  v5=cacheLen
 *   "sched-admit"     session=req  name="new"/"resume"  v0=slot
 *                     v1=cacheLen
 *   "kv-ceiling"      v0=bytes  v1=maxSeqs  v2=ctx
 *   "launch-failure"  session=sole running req, or -1  v0=delta
 *                     v1=step (21.2.5 — the counter moved inside this
 *                     step's window)
 */
public final class DiagRecord {

    /** Which decision this record describes. A borrow — copy to keep. */
    public String category;
    /** The session (request id) it belongs to; -1 = engine-wide. */
    public int32 session;
    /** Category-specific name (route, kernel, admit kind); may be
     *  null. A borrow — copy to keep. */
    public String name;
    public int64 v0;
    public int64 v1;
    public int64 v2;
    public int64 v3;
    public int64 v4;
    public int64 v5;

    public DiagRecord() {
        this.session = 0 - 1;
        return;
    }
}
