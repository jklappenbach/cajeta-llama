package dev.cajeta.llama.chat;

import cajeta.lang.String;

/**
 * A parsed chat template: a FLAT node table (`grammar/ChatTemplate.g4`).
 *
 * Nodes are records of `W` int32 fields in one array plus a parallel
 * `String` payload — a pointer-chasing AST of small classes would cost
 * an allocation per node and buy nothing, since every traversal is an
 * index walk. Statement sequences chain through `nx`; so do call and
 * macro-parameter argument lists.
 */
public final class Tpl {

    static final int32 W = 8;      // kind, a, b, c, d, nx, line, e

    // ── statement kinds ────────────────────────────────────────────────
    static final int32 N_TEXT = 0;   // str = literal
    static final int32 N_OUT = 1;    // a = expr
    static final int32 N_IF = 2;     // a = cond, b = then, c = else
    static final int32 N_FOR = 3;    // a = iter, b = body, c = else,
                                     // str = "k" or "k,v", d = name count,
                                     // e = loop filter or -1
                                     //   `{% for x in seq if cond %}`
    static final int32 N_SET = 4;    // str = name, a = expr
    static final int32 N_MACRO = 5;  // str = name, a = params, b = body

    // ── expression kinds ───────────────────────────────────────────────
    static final int32 E_STR = 10;   // str
    static final int32 E_NUM = 11;   // str (decimal text)
    static final int32 E_TRUE = 12;
    static final int32 E_FALSE = 13;
    static final int32 E_NONE = 14;
    static final int32 E_NAME = 15;  // str
    static final int32 E_ATTR = 16;  // a = obj, str = attr
    static final int32 E_INDEX = 17; // a = obj, b = index
    static final int32 E_SLICE = 18; // a = obj, b = start|-1, c = stop|-1
    static final int32 E_CALL = 19;  // a = callee, b = args chain
    static final int32 E_FILTER = 20; // a = value, str = name, b = args
    static final int32 E_TEST = 21;  // a = value, str = name, d = negated
    static final int32 E_BIN = 22;   // a, b, str = op
    static final int32 E_NOT = 23;   // a
    static final int32 E_NEG = 24;   // a
    static final int32 E_COND = 25;  // a = cond, b = then, c = else
    static final int32 E_LIST = 26;  // a = items chain
    static final int32 E_DICT = 27;  // a = pairs chain
    static final int32 E_PAIR = 28;  // a = key, b = value
    static final int32 E_KWARG = 29; // str = name, a = value|-1

    int32[] f;
    String[] str;
    int32 n;
    int32 root;
    String name;      // for diagnostics

    Tpl(int32 capacity, String name) {
        int32 c = 64;
        while (c < capacity) {
            c = c * 2;
        }
        this.f = heap int32[c * Tpl.W];
        this.str = heap String[c];
        this.n = 0;
        this.root = 0 - 1;
        this.name = "" + name;
    }

    int32 add(int32 kind, int32 line) {
        if (this.n >= (int32) this.str.count()) {
            int32 cap = this.n * 2;
            int32[] nf = heap int32[cap * Tpl.W];
            String[] ns = heap String[cap];
            int32 i = 0;
            while (i < this.n * Tpl.W) {
                nf[i] = this.f[i];
                i = i + 1;
            }
            i = 0;
            while (i < this.n) {
                ns[i] = this.str[i];
                i = i + 1;
            }
            this.f #= nf;
            this.str #= ns;
        }
        int32 at = this.n;
        int32 base = at * Tpl.W;
        this.f[base] = kind;
        this.f[base + 1] = 0 - 1;
        this.f[base + 2] = 0 - 1;
        this.f[base + 3] = 0 - 1;
        this.f[base + 4] = 0;
        this.f[base + 5] = 0 - 1;
        this.f[base + 6] = line;
        this.f[base + 7] = 0 - 1;
        this.n = at + 1;
        return at;
    }

    int32 k(int32 i) {
        return this.f[i * Tpl.W];
    }

    int32 a(int32 i) {
        return this.f[i * Tpl.W + 1];
    }

    int32 b(int32 i) {
        return this.f[i * Tpl.W + 2];
    }

    int32 c(int32 i) {
        return this.f[i * Tpl.W + 3];
    }

    int32 d(int32 i) {
        return this.f[i * Tpl.W + 4];
    }

    int32 nx(int32 i) {
        return this.f[i * Tpl.W + 5];
    }

    int32 line(int32 i) {
        return this.f[i * Tpl.W + 6];
    }

    /** N_FOR only: the `if` loop filter expression, or -1. */
    int32 e(int32 i) {
        return this.f[i * Tpl.W + 7];
    }

    void setE(int32 i, int32 v) {
        this.f[i * Tpl.W + 7] = v;
    }

    void setA(int32 i, int32 v) {
        this.f[i * Tpl.W + 1] = v;
    }

    void setB(int32 i, int32 v) {
        this.f[i * Tpl.W + 2] = v;
    }

    void setC(int32 i, int32 v) {
        this.f[i * Tpl.W + 3] = v;
    }

    void setD(int32 i, int32 v) {
        this.f[i * Tpl.W + 4] = v;
    }

    void setNx(int32 i, int32 v) {
        this.f[i * Tpl.W + 5] = v;
    }

    void setStr(int32 i, #String s) {
        this.str[i] #= s;
    }

    String strOf(int32 i) {
        return this.str[i];
    }
}
