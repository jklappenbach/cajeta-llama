package dev.cajeta.llama.model;

import cajeta.lang.String;
import cajeta.math.Tensor;
import dev.cajeta.llama.LlamaException;
import dev.cajeta.llama.io.Checkpoint;

/**
 * A bias-free linear projection. The weight is held in cajeta orientation
 * `[in, out]` for the plain `x·W` the forward path computes; torch stores
 * `nn.Linear` as `[out, in]` (it computes `x·Wᵀ`), so {@link #bind}
 * transposes on import — the ONE place that conversion lives (plan 6.1.3,
 * the `Checkpoints.transposeLinearWeights` discipline).
 */
public final class Linear extends InfModule {
    Tensor<float32> weight;
    int32 inDim;
    int32 outDim;

    Linear(int32 inDim, int32 outDim) {
        this.weight = null;
        this.inDim = inDim;
        this.outDim = outDim;
    }

    void bind(Checkpoint ckpt, String name, boolean toDevice) {
        Tensor<float32> t = ckpt.loadF32(name);
        if (t.ndim() != 2) {
            throw heap LlamaException("weight binding: '" + name
                + "' has rank " + (int32) t.ndim() + "; expected 2");
        }
        if (t.shapeAt(0) != (int64) this.outDim
                || t.shapeAt(1) != (int64) this.inDim) {
            throw heap LlamaException("weight binding: '" + name
                + "' has torch shape [" + (int32) t.shapeAt(0) + ", "
                + (int32) t.shapeAt(1) + "]; expected [out, in] = ["
                + this.outDim + ", " + this.inDim + "]");
        }
        Tensor<float32> tv = t.transpose();
        Tensor<float32> c = tv.copy();
        if (toDevice) {
            c.gpu();
        }
        this.weight #= c;
    }
}
