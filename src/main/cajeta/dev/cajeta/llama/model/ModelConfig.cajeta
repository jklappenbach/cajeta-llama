package dev.cajeta.llama.model;

import cajeta.codec.json.Json;
import cajeta.codec.json.JsonObject;
import cajeta.codec.json.JsonValue;
import cajeta.io.file.File;
import cajeta.lang.Math;
import cajeta.lang.String;
import dev.cajeta.llama.LlamaException;

/**
 * The decoder-stack configuration, parsed from a Hugging Face
 * `config.json` (plan 6.2.3; spec 4.4, 4.5, 4.7, 4.8). GGUF metadata maps
 * onto the same fields in Unit 16.
 *
 * Two config keys are load-bearing rather than informational (spec 4.7,
 * 4.8): an explicit `head_dim` overrides the `hidden/heads` quotient
 * (Gemma 3 declares 256, which is NOT that quotient; Llama 3.2 declares
 * it too), and `tie_word_embeddings` means the checkpoint carries no
 * `lm_head.weight` — the output projection reuses the embedding matrix.
 */
public final class ModelConfig {
    public String architecture;
    public int32 hiddenSize;
    public int32 intermediateSize;
    public int32 numLayers;
    public int32 numHeads;
    public int32 numKvHeads;
    public int32 headDim;
    public int32 vocabSize;
    public int32 maxPositionEmbeddings;
    public float32 rmsNormEps;
    public float32 ropeTheta;
    public boolean tieWordEmbeddings;

    // ── Unit 7: per-layer attention defaults (spec §5 preamble) ─────────
    // Layers inherit these; uniform models are every layer at the default.

    /** Attention window `w` in tokens; 0 = infinite (HF `sliding_window`). */
    public int32 slidingWindow;
    /** RoPE scaling: 0 none, 1 linear, 2 ntk/dynamic, 3 yarn, 4 llama3
     *  (HF `rope_scaling.rope_type`). */
    public int32 ropeScalingType;
    public float32 ropeScalingFactor;
    /** llama3: `low_freq_factor`; yarn: `beta_slow`. */
    public float32 ropeLowFreq;
    /** llama3: `high_freq_factor`; yarn: `beta_fast`. */
    public float32 ropeHighFreq;
    /** llama3/yarn: `original_max_position_embeddings`. */
    public int32 ropeOrigMaxPos;
    /** Query scale; 0 = default `1/sqrt(head_dim)` (spec 5.13). Parsed
     *  from Gemma's `query_pre_attn_scalar` as `1/sqrt(scalar)`. */
    public float32 queryScale;
    /** MLP activation: 0 = SiLU (SwiGLU), 1 = gelu_pytorch_tanh (GeGLU)
     *  (HF `hidden_act` / `hidden_activation`; spec 5.4). */
    public int32 activation;
    /** RMSNorm form: 0 = Llama `·w`, 1 = Gemma zero-centered `·(1+w)`
     *  (spec 5.12). */
    public int32 normForm;
    /** RMSNorm on Q and K before RoPE (spec 5.10). */
    public boolean qkNorm;
    /** Four RMSNorms per block — pre/post around both sublayers
     *  (spec 5.11). */
    public boolean fourNorm;
    /** Per-layer windows from HF `layer_types` ("sliding_attention" /
     *  "full_attention", the Gemma 3 local/global pattern); null = every
     *  layer at `slidingWindow` (spec §5 preamble: layers inherit the
     *  model default). */
    public int32[] layerWindows;
    /** KV-cache block size in tokens (spec 6.3). Engine tuning knob, not
     *  an HF key; the CLI exposes it in Unit 19. */
    public int32 blockTokens;

    ModelConfig() {
        this.architecture = null;
        this.hiddenSize = 0;
        this.intermediateSize = 0;
        this.numLayers = 0;
        this.numHeads = 0;
        this.numKvHeads = 0;
        this.headDim = 0;
        this.vocabSize = 0;
        this.maxPositionEmbeddings = 0;
        this.rmsNormEps = 0.00001f;
        this.ropeTheta = 10000.0f;
        this.tieWordEmbeddings = false;
        this.slidingWindow = 0;
        this.ropeScalingType = 0;
        this.ropeScalingFactor = 1.0f;
        this.ropeLowFreq = 1.0f;
        this.ropeHighFreq = 4.0f;
        this.ropeOrigMaxPos = 0;
        this.queryScale = 0.0f;
        this.activation = 0;
        this.normForm = 0;
        this.qkNorm = false;
        this.fourNorm = false;
        this.layerWindows = null;
        this.blockTokens = 16;
    }

    /** The attention window of layer `l`: the per-layer declaration when
     *  present, else the model default. 0 = infinite. */
    public int32 windowForLayer(int32 l) {
        if (this.layerWindows != null) {
            return this.layerWindows[l];
        }
        return this.slidingWindow;
    }

    public int32 qDim() {
        return this.numHeads * this.headDim;
    }

    public int32 kvDim() {
        return this.numKvHeads * this.headDim;
    }

    public static #ModelConfig parse(String path) {
        int8[] raw = File.readAllBytes(path);
        int64 rawLen = (int64) raw.count();
        if (rawLen <= 0) {
            throw heap LlamaException("model config: '" + path
                + "' is missing or empty");
        }
        JsonValue v #= Json.parse(raw, rawLen);
        JsonObject root = v.object();

        JsonValue archs = root.get("architectures");
        if (archs == null || archs.array().count() < 1) {
            throw heap LlamaException("model config: '" + path
                + "' declares no architectures");
        }
        String arch = archs.array().get(0).asString();
        if (!arch.equals("LlamaForCausalLM")) {
            // Spec 4.5: the error lists the supported architectures.
            throw heap LlamaException("model config: architecture '" + arch
                + "' is not supported; supported: LlamaForCausalLM");
        }

        ModelConfig c = heap ModelConfig();
        c.architecture #= arch;
        c.hiddenSize = ModelConfig.reqInt(root, "hidden_size", path);
        c.intermediateSize = ModelConfig.reqInt(root, "intermediate_size", path);
        c.numLayers = ModelConfig.reqInt(root, "num_hidden_layers", path);
        c.numHeads = ModelConfig.reqInt(root, "num_attention_heads", path);
        c.vocabSize = ModelConfig.reqInt(root, "vocab_size", path);
        c.numKvHeads = ModelConfig.optInt(root, "num_key_value_heads", c.numHeads);
        // Spec 4.8: explicit head_dim wins over the derived quotient.
        c.headDim = ModelConfig.optInt(root, "head_dim",
            c.hiddenSize / c.numHeads);
        c.maxPositionEmbeddings = ModelConfig.optInt(root,
            "max_position_embeddings", 2048);
        c.rmsNormEps = ModelConfig.optFloat(root, "rms_norm_eps", 0.00001f);
        c.ropeTheta = ModelConfig.optFloat(root, "rope_theta", 10000.0f);
        JsonValue tie = root.get("tie_word_embeddings");
        if (tie != null) {
            c.tieWordEmbeddings = tie.asBoolean();
        }
        c.slidingWindow = ModelConfig.optInt(root, "sliding_window", 0);
        JsonValue qpas = root.get("query_pre_attn_scalar");
        if (qpas != null) {
            c.queryScale = 1.0f / Math.sqrt((float32) qpas.asFloat64());
        }
        JsonValue act = root.get("hidden_act");
        if (act == null) {
            act = root.get("hidden_activation");
        }
        if (act != null) {
            String a2 = act.asString();
            if (a2.equals("silu")) {
                c.activation = 0;
            } else if (a2.equals("gelu_pytorch_tanh")) {
                c.activation = 1;
            } else {
                throw heap LlamaException("model config: activation '" + a2
                    + "' is not supported; supported: silu, gelu_pytorch_tanh");
            }
        }
        JsonValue rs = root.get("rope_scaling");
        if (rs != null && !rs.isNull()) {
            JsonObject ro = rs.object();
            JsonValue ty = ro.get("rope_type");
            if (ty == null) {
                ty = ro.get("type");
            }
            if (ty != null) {
                String tn = ty.asString();
                if (tn.equals("linear")) {
                    c.ropeScalingType = 1;
                } else if (tn.equals("dynamic") || tn.equals("ntk")) {
                    c.ropeScalingType = 2;
                } else if (tn.equals("yarn")) {
                    c.ropeScalingType = 3;
                } else if (tn.equals("llama3")) {
                    c.ropeScalingType = 4;
                } else {
                    throw heap LlamaException("model config: rope_scaling type '"
                        + tn + "' is not supported; supported: linear, "
                        + "dynamic, yarn, llama3");
                }
            }
            c.ropeScalingFactor = ModelConfig.optFloat(ro, "factor", 1.0f);
            c.ropeLowFreq = ModelConfig.optFloat(ro, "low_freq_factor",
                ModelConfig.optFloat(ro, "beta_slow", 1.0f));
            c.ropeHighFreq = ModelConfig.optFloat(ro, "high_freq_factor",
                ModelConfig.optFloat(ro, "beta_fast", 4.0f));
            c.ropeOrigMaxPos = ModelConfig.optInt(ro,
                "original_max_position_embeddings", c.maxPositionEmbeddings);
        }
        JsonValue qkn = root.get("qk_norm");
        if (qkn != null) {
            c.qkNorm = qkn.asBoolean();
        }
        JsonValue lt = root.get("layer_types");
        if (lt != null && !lt.isNull()) {
            int32 n = lt.array().count();
            if (n != c.numLayers) {
                throw heap LlamaException("model config: layer_types has "
                    + n + " entries for " + c.numLayers + " layers");
            }
            int32[] lw = heap int32[n];
            int32 li = 0;
            while (li < n) {
                String tname = lt.array().get(li).asString();
                if (tname.equals("sliding_attention")) {
                    lw[li] = c.slidingWindow;
                } else if (tname.equals("full_attention")) {
                    lw[li] = 0;
                } else {
                    throw heap LlamaException("model config: layer type '"
                        + tname + "' is not supported; supported: "
                        + "sliding_attention, full_attention");
                }
                li = li + 1;
            }
            c.layerWindows #= lw;
        }
        return #c;
    }

    static int32 reqInt(JsonObject root, String key, String path) {
        JsonValue j = root.get(key);
        if (j == null) {
            throw heap LlamaException("model config: '" + path
                + "' is missing required key '" + key + "'");
        }
        return j.asInt32();
    }

    static int32 optInt(JsonObject root, String key, int32 dflt) {
        JsonValue j = root.get(key);
        if (j == null) {
            return dflt;
        }
        return j.asInt32();
    }

    static float32 optFloat(JsonObject root, String key, float32 dflt) {
        JsonValue j = root.get(key);
        if (j == null) {
            return dflt;
        }
        return (float32) j.asFloat64();
    }
}
